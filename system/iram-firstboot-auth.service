[Unit]
Description=IRAM OS First Boot Security Hardening
ConditionPathExists=!/var/lib/iram/.auth_secured
# Must finish before any greeter, or an autologin can race this hardening.
Before=display-manager.service greetd.service getty@tty1.service
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/env iram-firstboot-auth
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
