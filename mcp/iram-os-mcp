def send_response(response_dict):
    body = json.dumps(response_dict, separators=(',', ':'))
    sys.stdout.write(body + "\n")
    sys.stdout.flush()

def handle_request(req):
    msg_id = req.get("id")
    method = req.get("method")
    params = req.get("params", {})

    if method == "initialize":
        return {
            "jsonrpc": "2.0",
            "id": msg_id,
            "result": {
                "protocolVersion": PROTOCOL_VERSION,
                "capabilities": {
                    "tools": {}
                },
                "serverInfo": {
                    "name": SERVER_NAME,
                    "version": SERVER_VERSION
                }
            }
        }

    elif method == "notifications/initialized":
        # Notification, no return
        return None

    elif method == "ping":
        return {
            "jsonrpc": "2.0",
            "id": msg_id,
            "result": {}
        }

    elif method == "tools/list":
        return {
            "jsonrpc": "2.0",
            "id": msg_id,
            "result": {
                "tools": TOOLS_MANIFEST
            }
        }

    elif method == "tools/call":
        tool_name = params.get("name")
        args = params.get("arguments", {})

        result_payload = None
        try:
            if tool_name == "switch_theme":
                result_payload = tool_switch_theme(args)
            elif tool_name == "manage_windows":
                result_payload = tool_manage_windows(args)
            elif tool_name == "service_diagnostics":
                result_payload = tool_service_diagnostics(args)
            elif tool_name == "audio_display_control":
                result_payload = tool_audio_display_control(args)
            elif tool_name == "system_telemetry":
                result_payload = tool_system_telemetry()
            elif tool_name == "watchdog_report":
                result_payload = tool_watchdog_report(args)
            else:
                return {
                    "jsonrpc": "2.0",
                    "id": msg_id,
                    "error": {
                        "code": -32601,
                        "message": f"Method/Tool '{tool_name}' not found"
                    }
                }
        except Exception as ex:
            result_payload = {"error": str(ex)}

        text_output = json.dumps(result_payload, indent=2) if isinstance(result_payload, (dict, list)) else str(result_payload)
        return {
            "jsonrpc": "2.0",
            "id": msg_id,
            "result": {
                "content": [
                    {
                        "type": "text",
                        "text": text_output
                    }
                ]
            }
        }

    else:
        if msg_id is not None:
            return {
                "jsonrpc": "2.0",
                "id": msg_id,
                "error": {
                    "code": -32601,
                    "message": f"Method '{method}' not implemented"
                }
            }
        return None

def main():
    while True:
        try:
            line = sys.stdin.readline()
            if not line:
                break
            line = line.strip()
            if not line:
                continue

            # Check for Content-Length framing if present
            if line.startswith("Content-Length:"):
                length = int(line.split(":")[1].strip())
                # Read empty line
                sys.stdin.readline()
                raw_payload = sys.stdin.read(length)
                req = json.loads(raw_payload)
            else:
                req = json.loads(line)

            res = handle_request(req)
            if res is not None:
                send_response(res)
        except (KeyboardInterrupt, SystemExit):
            break
        except Exception as e:
            # Send standard JSON-RPC internal error if id is available
            try:
                err_resp = {
                    "jsonrpc": "2.0",
                    "id": None,
                    "error": {"code": -32603, "message": f"Internal JSON-RPC error: {str(e)}"}
                }
                send_response(err_resp)
            except Exception:
                pass

if __name__ == "__main__":
    main()
