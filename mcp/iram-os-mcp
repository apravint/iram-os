#!/usr/bin/env python3
"""
IRAM OS - Native Model Context Protocol (MCP) System Control Server (iram-os-mcp)
Zero-config JSON-RPC stdio server using pure Python 3 standard library.
Compatible with Ubuntu LTS, Debian, Antigravity, Claude Code, and Gemini.

Tools Exposed:
1. switch_theme(theme_name)
2. manage_windows(action, workspace, window_address)
3. service_diagnostics(unit_name, action)
4. audio_display_control(target, command)
5. system_telemetry()
6. watchdog_report(lines)
"""

import sys
import os
import json
import shutil
import subprocess
import glob

SERVER_NAME = "iram-os-mcp"
SERVER_VERSION = "26.04.2"
PROTOCOL_VERSION = "2024-11-05"

# Helper for executing shell commands safely
def run_cmd(cmd_list, timeout=10):
    try:
        res = subprocess.run(cmd_list, capture_output=True, text=True, timeout=timeout)
        return res.returncode, res.stdout.strip(), res.stderr.strip()
    except subprocess.TimeoutExpired:
        return -1, "", "Command timed out"
    except Exception as e:
        return -1, "", str(e)

