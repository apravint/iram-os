#!/usr/bin/env python3
"""
IRAM OS - Autonomous AI Theme Generator
Powered by ui-ux-pro-max-skill design intelligence.
Generates complete, contrast-compliant IRAM OS themes on the fly.
https://github.com/apravint/iram-os
"""

import os
import sys
import json
import shutil
import subprocess
import argparse
import re

SEARCH_SCRIPT = os.path.expanduser("~/.agents/skills/ui-ux-pro-max/scripts/search.py")
THEMES_DIR = os.path.expanduser("~/iram-os/themes")

def hex_to_rgb(hex_code: str) -> tuple:
    clean = hex_code.lstrip("#")
    if len(clean) == 3:
        clean = "".join([c*2 for c in clean])
    if len(clean) >= 6:
        return int(clean[0:2], 16), int(clean[2:4], 16), int(clean[4:6], 16)
    return (255, 255, 255)

def adjust_brightness(hex_code: str, factor: float) -> str:
    r, g, b = hex_to_rgb(hex_code)
    r = max(0, min(255, int(r * factor)))
    g = max(0, min(255, int(g * factor)))
    b = max(0, min(255, int(b * factor)))
    return f"#{r:02x}{g:02x}{b:02x}"

def slugify(text: str) -> str:
    slug = re.sub(r'[^a-zA-Z0-9]+', '-', text).strip('-').lower()
    return slug or "ai-custom-theme"

def main():
    parser = argparse.ArgumentParser(
        prog="iram-theme-generate",
        description="Generate and apply custom IRAM OS themes using UI/UX Pro Max AI design intelligence"
    )
    parser.add_argument("query", help="Vibe, industry, style, or visual description (e.g. 'cyberpunk synthwave', 'nordic ice minimal', 'obsidian matrix')")
    parser.add_argument("-n", "--name", default="", help="Custom theme display name (default: auto-generated from query)")
    parser.add_argument("--variance", type=int, choices=range(1, 11), default=5, help="Design variance dial: 1 (minimal) to 10 (bold/asymmetric)")
    parser.add_argument("--density", type=int, choices=range(1, 11), default=6, help="Visual density dial: 1 (airy) to 10 (compact dashboard)")
    parser.add_argument("--no-apply", action="store_true", help="Generate theme files without immediately applying it")
    
    args = parser.parse_args()

    if not os.path.isfile(SEARCH_SCRIPT):
        print(f"Error: UI/UX Pro Max search engine not found at {SEARCH_SCRIPT}", file=sys.stderr)
        print("Please install via: npx -y ui-ux-pro-max-cli init --ai universal --global", file=sys.stderr)
        sys.exit(1)

    print(f"\n🎨 Querying UI/UX Pro Max design engine for: '{args.query}' ...")
    cmd = [
        sys.executable,
        SEARCH_SCRIPT,
        args.query,
        "--design-system",
        "--json",
        "--variance", str(args.variance),
        "--density", str(args.density)
    ]
    if args.name:
        cmd.extend(["-p", args.name])

    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, check=True)
        data = json.loads(proc.stdout)
    except Exception as e:
        print(f"Error executing design system search: {e}", file=sys.stderr)
        sys.exit(1)

    ds = data.get("design_system", {})
    colors = ds.get("colors", {})
    style = ds.get("style", {})
    typography = ds.get("typography", {})
    pattern = ds.get("pattern", {})

    theme_display_name = args.name or ds.get("project_name", args.query.title())
    slug = slugify(theme_display_name)
    target_dir = os.path.join(THEMES_DIR, slug)

    os.makedirs(target_dir, exist_ok=True)

    # Core theme palette mapping
    bg = colors.get("background", "#0e0e12")
    fg = colors.get("foreground", "#f0f0f4")
    accent = colors.get("accent", colors.get("primary", "#3b82f6"))
    secondary = colors.get("secondary", "#8b5cf6")
    card = colors.get("card", adjust_brightness(bg, 1.25))
    muted = colors.get("muted_foreground", colors.get("muted", "#64748b"))
    border = colors.get("border", adjust_brightness(bg, 1.5))
    
    # Calculate luminance to determine light or dark mode
    r_bg, g_bg, b_bg = hex_to_rgb(bg)
    luminance = 0.299 * r_bg + 0.587 * g_bg + 0.114 * b_bg
    is_dark = luminance < 128
    mode = "dark" if is_dark else "light"

    if is_dark:
        dark_bg = adjust_brightness(bg, 0.85)
        darker_bg = adjust_brightness(bg, 0.65)
        lighter_bg = card
        dark_fg = muted
        light_fg = fg
        bright_fg = "#ffffff"
    else:
        dark_bg = adjust_brightness(bg, 0.95)
        darker_bg = adjust_brightness(bg, 0.90)
        lighter_bg = "#ffffff"
        dark_fg = fg
        light_fg = muted
        bright_fg = "#000000"

    # Hex to clean rgb representation for Hyprland borders
    r_acc, g_acc, b_acc = hex_to_rgb(accent)
    r_sec, g_sec, b_sec = hex_to_rgb(secondary)
    hypr_border = f"rgb({accent.lstrip('#')}) rgb({secondary.lstrip('#')}) 45deg"

    # Generate colors.toml
    colors_toml_content = f"""# IRAM OS Theme: {theme_display_name}
# Generated by UI/UX Pro Max Design Intelligence
# Style: {style.get('name', 'Modern')}
mode = "{mode}"

accent = "{accent}"
secondary = "{secondary}"
selection = "{card}"
muted = "{muted}"

background = "{bg}"
dark_background = "{dark_bg}"
darker_background = "{darker_bg}"
lighter_background = "{lighter_bg}"

foreground = "{fg}"
dark_foreground = "{dark_fg}"
light_foreground = "{light_fg}"
bright_foreground = "{bright_fg}"

red = "{colors.get('destructive', '#ef4444')}"
yellow = "{colors.get('yellow', '#eab308')}"
green = "{colors.get('green', '#22c55e')}"
cyan = "{colors.get('cyan', '#06b6d4')}"
blue = "{colors.get('blue', '#3b82f6')}"
magenta = "{colors.get('magenta', '#d946ef')}"
orange = "{colors.get('orange', '#f97316')}"
brown = "#a27b5c"

bright_red = "{colors.get('destructive', '#f87171')}"
bright_yellow = "#fde047"
bright_green = "#4ade80"
bright_cyan = "#22d3ee"
bright_blue = "{accent}"
bright_magenta = "{secondary}"

hyprland_active_border = "{hypr_border}"
"""
    with open(os.path.join(target_dir, "colors.toml"), "w", encoding="utf-8") as f:
        f.write(colors_toml_content)

    # Generate vscode.json theme bridge
    vscode_content = {
        "workbench.colorTheme": "Default Dark Modern",
        "workbench.colorCustomizations": {
            "activityBar.background": bg,
            "sideBar.background": dark_bg,
            "editor.background": bg,
            "editor.foreground": fg,
            "focusBorder": accent
        }
    }
    with open(os.path.join(target_dir, "vscode.json"), "w", encoding="utf-8") as f:
        json.dump(vscode_content, f, indent=2)

    # Generate neovim.lua
    neovim_content = f"""-- Theme: {theme_display_name}
vim.cmd("set background=dark")
"""
    with open(os.path.join(target_dir, "neovim.lua"), "w", encoding="utf-8") as f:
        f.write(neovim_content)

    # Write Theme Documentation
    readme_content = f"""# {theme_display_name}

Generated by **IRAM OS UI/UX Pro Max Design Engine**.

- **Visual Style:** {style.get('name', 'Modern')}
- **Keywords:** {style.get('keywords', '')}
- **Typography:** {typography.get('heading', 'Inter')} / {typography.get('body', 'Inter')}
- **Primary Accent:** `{accent}`
- **Secondary Accent:** `{secondary}`
- **Background:** `{bg}`
- **Surface / Card:** `{card}`
- **Hyprland Active Border:** `{hypr_border}`
"""
    with open(os.path.join(target_dir, "README.md"), "w", encoding="utf-8") as f:
        f.write(readme_content)

    print(f"✨ Successfully generated theme in: {target_dir}")
    print(f"   • Style: {style.get('name', 'Modern')}")
    print(f"   • Primary Accent: {accent}")
    print(f"   • Background:     {bg}")
    print(f"   • Hyprland Border: {hypr_border}")

    if not args.no_apply:
        print("\n🚀 Applying theme across IRAM OS desktop ...")
        subprocess.run(["iram", "theme", "set", slug], check=False)
        sync_all = os.path.expanduser("~/.local/bin/iram-theme-sync-all")
        if os.path.isfile(sync_all) and os.access(sync_all, os.X_OK):
            subprocess.run([sync_all], check=False)
        subprocess.run([
            "notify-send",
            "-a", "IRAM OS",
            "Theme Generated & Applied",
            f"Active: {theme_display_name} ({style.get('name', 'Modern')})"
        ], check=False)
        print("✓ Theme applied with zero restarts!")

if __name__ == "__main__":
    main()
