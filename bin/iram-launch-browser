#!/usr/bin/env bash
# ==============================================================================
# Universal Browser Launcher for IRAM OS
# Prioritizes installed modern browsers without recursive self-calling
# ==============================================================================
set -euo pipefail

# 1. Flatpak Google Chrome (Primary packaged version on IRAM OS)
if command -v flatpak >/dev/null 2>&1 && flatpak info com.google.Chrome >/dev/null 2>&1; then
    exec flatpak run com.google.Chrome "$@"
fi

# 2. Native Google Chrome / Chrome Stable (excluding this launcher)
CHROME_BIN=$(which google-chrome 2>/dev/null || true)
if [ -n "$CHROME_BIN" ] && [ "$CHROME_BIN" != "$0" ] && [ "$CHROME_BIN" != "$HOME/.local/bin/google-chrome" ]; then
    exec "$CHROME_BIN" "$@"
fi

# 3. Native or Snap Firefox
FIREFOX_BIN=$(which firefox 2>/dev/null || true)
if [ -n "$FIREFOX_BIN" ] && [ "$FIREFOX_BIN" != "$0" ]; then
    exec "$FIREFOX_BIN" "$@"
fi

# 4. Chromium / Brave
for b in chromium-browser chromium brave-browser; do
    if command -v "$b" >/dev/null 2>&1; then
        exec "$b" "$@"
    fi
done

# 5. Default system handler
exec xdg-open "https://google.com"
