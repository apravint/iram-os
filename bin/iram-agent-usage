#!/usr/bin/env python3
# ==============================================================================
# IRAM OS AI Agent Usage & Quota Collector (Engineered for IRAM OS)
# Collects live metrics, conversation states, and token telemetry across agents
# Outputs structured JSON to ~/.local/state/iram/agents/usage/<agent>.json
# ==============================================================================
import json
import os
import sys
import time
import sqlite3
import urllib.request
from pathlib import Path
from datetime import datetime, timezone

USAGE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "iram/agents/usage"
USAGE_DIR.mkdir(parents=True, exist_ok=True)

def collect_agy_usage():
    """Live telemetry from Google Antigravity CLI."""
    gemini_dir = Path.home() / ".gemini/antigravity-cli"
    db_path = gemini_dir / "conversation_summaries.db"
    settings_path = gemini_dir / "settings.json"
    history_path = gemini_dir / "history.jsonl"

    model_name = "Gemini 3.8 Flash (High)"
    if settings_path.exists():
        try:
            with open(settings_path) as f:
                cfg = json.load(f)
                model_name = cfg.get("model", model_name)
        except Exception:
            pass

    conv_count = 0
    total_steps = 0
    if db_path.exists():
        try:
            conn = sqlite3.connect(db_path)
            c = conn.cursor()
            c.execute("SELECT count(*), sum(step_count) FROM conversation_summaries")
            row = c.fetchone()
            conv_count = row[0] or 0
            total_steps = row[1] or 0
            conn.close()
        except Exception:
            pass

    commands_executed = 0
    if history_path.exists():
        try:
            with open(history_path, "r", encoding="utf-8", errors="ignore") as f:
                commands_executed = sum(1 for _ in f)
        except Exception:
            pass

    record = {
        "agent": "agy",
        "name": "Google Antigravity",
        "updated_at": int(time.time()),
        "status": "online",
        "plan": "Pro / Infinite Workspace",
        "active_model": model_name,
        "metrics": {
            "conversations": conv_count,
            "total_steps": total_steps,
            "history_entries": commands_executed
        },
        "limits": [
            {
                "type": "workspace_steps",
                "used": total_steps,
                "limit": 100000,
                "percent": round(min(100.0, (total_steps / 100000.0) * 100), 1),
                "resets_in": "Rolling"
            },
            {
                "type": "active_conversations",
                "used": conv_count,
                "limit": 50,
                "percent": round(min(100.0, (conv_count / 50.0) * 100), 1),
                "resets_in": "Managed"
            }
        ]
    }
    with open(USAGE_DIR / "agy.json", "w") as f:
        json.dump(record, f, indent=2)
    return record

def collect_ollama_usage():
    """Live telemetry from local Ollama runtime."""
    ollama_url = os.environ.get("OLLAMA_BASE_URL", "http://127.0.0.1:11434").rstrip("/")
    models = []
    status = "offline"
    try:
        req = urllib.request.Request(f"{ollama_url}/api/tags")
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            data = json.loads(resp.read().decode())
            for m in data.get("models", []):
                size_gb = round(m.get("size", 0) / (1024**3), 2)
                models.append({"name": m.get("name"), "size_gb": size_gb})
            status = "online"
    except Exception:
        status = "offline"

    record = {
        "agent": "ollama",
        "name": "Local Ollama Runtime",
        "updated_at": int(time.time()),
        "status": status,
        "endpoint": ollama_url,
        "models_installed": [m["name"] for m in models],
        "models_detail": models,
        "active_model": models[0]["name"] if models else "None",
        "limits": [
            {
                "type": "local_inference",
                "used": len(models),
                "limit": 20,
                "percent": round((len(models) / 20.0) * 100, 1),
                "resets_in": "Local (Uncapped)"
            }
        ]
    }
    with open(USAGE_DIR / "ollama.json", "w") as f:
        json.dump(record, f, indent=2)
    return record

def collect_claude_usage():
    """Telemetry from Claude Code CLI."""
    claude_bin = Path.home() / ".local/bin/claude"
    claude_dir = Path.home() / ".claude"
    is_installed = claude_bin.exists() or Path("/usr/local/bin/claude").exists()
    
    sessions_count = 0
    if (claude_dir / "sessions").exists():
        try:
            sessions_count = len(list((claude_dir / "sessions").glob("*")))
        except Exception:
            pass

    record = {
        "agent": "claude",
        "name": "Claude Code",
        "updated_at": int(time.time()),
        "status": "ready" if is_installed else "standby",
        "plan": "Claude CLI Tier",
        "active_model": "claude-3-7-sonnet",
        "metrics": {
            "installed": is_installed,
            "sessions": sessions_count
        },
        "limits": [
            {
                "type": "session_allowance",
                "used": sessions_count,
                "limit": 50,
                "percent": round(min(100.0, (sessions_count / 50.0) * 100), 1),
                "resets_in": "5h rolling"
            }
        ]
    }
    with open(USAGE_DIR / "claude.json", "w") as f:
        json.dump(record, f, indent=2)
    return record

def main():
    agy = collect_agy_usage()
    ollama = collect_ollama_usage()
    claude = collect_claude_usage()

    if "--json" in sys.argv:
        print(json.dumps({"agy": agy, "ollama": ollama, "claude": claude}, indent=2))
    else:
        print(f"✓ IRAM OS AI Agent Telemetry synchronized in: {USAGE_DIR}")
        print(f"  ● {agy['name']}: {agy['active_model']} ({agy['metrics']['total_steps']} steps, {agy['metrics']['conversations']} sessions)")
        print(f"  ● {ollama['name']} ({ollama['status']}): {len(ollama['models_installed'])} models available ({', '.join(ollama['models_installed'][:3])})")
        print(f"  ● {claude['name']}: {'Ready' if claude['status'] == 'ready' else 'Standby'}")

if __name__ == "__main__":
    main()
