#!/usr/bin/env bash
# Iram Interactive Capture Menu
set -euo pipefail

if ! command -v wofi >/dev/null 2>&1; then
    notify-send -u critical "Capture Menu" "wofi is not installed." 2>/dev/null || echo "wofi not installed" >&2
    exit 1
fi

IS_RECORDING=$(pgrep -x wf-recorder >/dev/null 2>&1 && echo "yes" || echo "no")

OPTIONS="📸  Capture Region (Snipping Tool)
🖥️  Capture Full Screen
🪟  Capture Active Window"

if [[ "$IS_RECORDING" == "yes" ]]; then
    OPTIONS="${OPTIONS}
⏹️  Stop Screen Recording"
else
    OPTIONS="${OPTIONS}
🎥  Record Screen Region (MP4)"
fi

OPTIONS="${OPTIONS}
🎨  Color Picker (Eyedropper)"

CHOICE=$(echo -e "$OPTIONS" | wofi --dmenu --prompt "Capture / Record:" --width 380 --height 320)

case "$CHOICE" in
    *"Capture Region"*)
        ~/.local/bin/iram-screenshot region
        ;;
    *"Capture Full Screen"*)
        ~/.local/bin/iram-screenshot fullscreen
        ;;
    *"Capture Active Window"*)
        ~/.local/bin/iram-screenshot window
        ;;
    *"Record Screen Region"*)
        ~/.local/bin/iram-screenrecord
        ;;
    *"Stop Screen Recording"*)
        ~/.local/bin/iram-screenrecord
        ;;
    *"Color Picker"*)
        ~/.local/bin/iram-color-picker
        ;;
esac
