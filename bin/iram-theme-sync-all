#!/usr/bin/env python3
"""
Iram Full Desktop Theme Synchronization Engine
Synchronizes active Iram theme colors across:
- Waybar (glass acrylic theme + dynamic accent borders & pills)
- Hyprland (live window border gradients)
- Wofi (application launcher & menus)
- Mako (system notifications)
- Swaybg (active wallpaper)
"""

import os
import re
import colorsys
import subprocess

def hex_to_rgb(hex_code):
    hex_code = hex_code.lstrip("#")
    if len(hex_code) == 6:
        return int(hex_code[0:2], 16), int(hex_code[2:4], 16), int(hex_code[4:6], 16)
    return (26, 27, 38)

def compute_animated_border(colors):
    """
    Computes a vibrant 2-color 45-degree gradient for Hyprland's continuous
    borderangle rotation animation. Ensures every theme has glowing animated borders.
    """
    hab = colors.get("hyprland_active_border", "").strip()
    if hab:
        if "deg" not in hab and " " in hab:
            hab += " 45deg"
        return hab

    accent = colors.get("accent", "#7aa2f7").strip()
    if not accent.startswith("#") or len(accent) != 7:
        accent = "#7aa2f7"

    candidates = [
        "secondary",
        "bright_magenta", "magenta",
        "bright_cyan", "cyan",
        "bright_blue", "blue",
        "bright_yellow", "yellow",
        "orange",
        "bright_green", "green",
        "bright_red", "red"
    ]

    sec = None
    acc_lower = accent.lower()
    for k in candidates:
        val = colors.get(k)
        if val and isinstance(val, str) and val.startswith("#") and len(val) == 7:
            if val.lower() != acc_lower:
                sec = val.lower()
                break

    if not sec:
        r, g, b = hex_to_rgb(accent)
        h, s, v = colorsys.rgb_to_hsv(r / 255.0, g / 255.0, b / 255.0)
        h2 = (h + 0.15) % 1.0  # 54 degree triadic hue shift
        r2, g2, b2 = colorsys.hsv_to_rgb(h2, max(s, 0.65), max(v, 0.85))
        sec = f"#{int(r2 * 255):02x}{int(g2 * 255):02x}{int(b2 * 255):02x}"

    c1 = accent.lstrip("#")
    c2 = sec.lstrip("#")
    return f"rgba({c1}ee) rgba({c2}ee) 45deg"

def main():
    home = os.path.expanduser("~")
    toml_path = os.path.join(home, ".local/state/iram/current/theme/colors.toml")
    if not os.path.exists(toml_path):
        alt_toml = os.path.join(home, ".local/state/omarchy/current/theme/colors.toml")
        if os.path.exists(alt_toml):
            toml_path = alt_toml
    
    colors = {
        "mode": "dark",
        "background": "#1a1b26",
        "dark_background": "#16161e",
        "foreground": "#c0caf5",
        "accent": "#7aa2f7",
        "selection": "#292e42",
        "muted": "#565f89",
        "hyprland_active_border": ""
    }

    if os.path.exists(toml_path):
        with open(toml_path, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line.startswith("#") or not line:
                    continue
                m = re.match(r'^([a-zA-Z0-9_]+)\s*=\s*["\']([^"\']+)["\']', line)
                if m:
                    colors[m.group(1)] = m.group(2)

    bg = colors.get("dark_background", colors.get("background", "#1a1b26"))
    fg = colors.get("foreground", "#c0caf5")
    accent = colors.get("accent", "#7aa2f7")
    muted = colors.get("muted", "#565f89")
    selection = colors.get("selection", "#292e42")

    r_bg, g_bg, b_bg = hex_to_rgb(bg)
    r_acc, g_acc, b_acc = hex_to_rgb(accent)
    r_sel, g_sel, b_sel = hex_to_rgb(selection)

    # 1. Update Waybar colors.css
    waybar_dir = os.path.join(home, ".config/waybar")
    os.makedirs(waybar_dir, exist_ok=True)
    waybar_colors_css = os.path.join(waybar_dir, "colors.css")

    css_content = f"""/* Auto-generated by Iram Theme Engine */
@define-color bg rgba({r_bg}, {g_bg}, {b_bg}, 0.85);
@define-color fg {fg};
@define-color accent {accent};
@define-color accent_rgba rgba({r_acc}, {g_acc}, {b_acc}, 0.25);
@define-color accent_glow rgba({r_acc}, {g_acc}, {b_acc}, 0.45);
@define-color muted {muted};
@define-color border rgba({r_acc}, {g_acc}, {b_acc}, 0.35);
@define-color selection rgba({r_sel}, {g_sel}, {b_sel}, 0.8);
"""
    with open(waybar_colors_css, "w", encoding="utf-8") as f:
        f.write(css_content)

    # Signal Waybar to reload styles
    subprocess.run(["pkill", "-SIGUSR2", "waybar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 2. Update Wofi style
    wofi_dir = os.path.join(home, ".config/wofi")
    os.makedirs(wofi_dir, exist_ok=True)
    wofi_style_css = os.path.join(wofi_dir, "style.css")

    wofi_content = f"""/* Auto-generated by Iram Theme Engine (Sharp Edge Edition) */
#window, window {{
    margin: 0px;
    background-color: rgba({r_bg}, {g_bg}, {b_bg}, 0.98);
    border-radius: 0px;
    border: 2px solid rgba({r_acc}, {g_acc}, {b_acc}, 0.85);
    font-family: "JetBrainsMono Nerd Font", monospace;
    font-size: 14px;
    color: {fg};
}}

#outer-box {{
    margin: 0px;
    background-color: rgba({r_bg}, {g_bg}, {b_bg}, 0.98);
}}

#input {{
    margin: 12px 14px 8px 14px;
    border-radius: 0px;
    border: 1px solid rgba({r_acc}, {g_acc}, {b_acc}, 0.5);
    background-color: rgba({r_sel}, {g_sel}, {b_sel}, 0.85);
    color: {fg};
    padding: 10px 14px;
    font-size: 14px;
}}

#inner-box {{
    margin: 4px 14px 14px 14px;
    background-color: transparent;
}}

#scroll {{
    margin: 0px;
    border: none;
}}

#entry {{
    padding: 8px 12px;
    border-radius: 0px;
    margin: 2px 0px;
    color: {fg};
}}

#entry:selected {{
    background-color: {accent};
    color: #1a1b26;
}}

#entry:selected #text {{
    color: #1a1b26;
    font-weight: bold;
}}

#text {{
    margin-left: 10px;
    color: {fg};
}}

#img {{
    margin-right: 6px;
}}
"""
    with open(wofi_style_css, "w", encoding="utf-8") as f:
        f.write(wofi_content)

    # 3. Update Hyprland window borders live & persist to ~/.config/hypr/theme.conf
    hypr_active = compute_animated_border(colors)
    hypr_inactive = f"rgba({r_sel:02x}{g_sel:02x}{b_sel:02x}88)"

    hypr_dir = os.path.join(home, ".config/hypr")
    os.makedirs(hypr_dir, exist_ok=True)
    hypr_theme_conf = os.path.join(hypr_dir, "theme.conf")
    hypr_theme_content = f"""# Auto-generated by IRAM Theme Engine
general {{
    col.active_border = {hypr_active}
    col.inactive_border = {hypr_inactive}
}}
"""
    try:
        with open(hypr_theme_conf, "w", encoding="utf-8") as f:
            f.write(hypr_theme_content)
    except Exception:
        pass

    if os.environ.get("WAYLAND_DISPLAY") or os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        subprocess.run(["hyprctl", "keyword", "general:col.active_border", hypr_active], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["hyprctl", "keyword", "general:col.inactive_border", hypr_inactive], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 4. Update Mako Notification Daemon
    mako_dir = os.path.join(home, ".config/mako")
    os.makedirs(mako_dir, exist_ok=True)
    mako_conf = os.path.join(mako_dir, "config")

    mako_content = f"""# Auto-generated by Iram Theme Engine
font=JetBrainsMono Nerd Font 10
background-color={bg}E6
text-color={fg}
border-color={accent}
border-size=2
border-radius=0
padding=10,14
default-timeout=4000
width=360
height=140

[mode=dnd]
invisible=1
"""
    with open(mako_conf, "w", encoding="utf-8") as f:
        f.write(mako_content)
    subprocess.run(["makoctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 5. Refresh Wallpaper
    bg_link = os.path.join(home, ".local/state/iram/current/background")
    if os.path.islink(bg_link) or os.path.exists(bg_link):
        target_bg = os.path.realpath(bg_link)
        if os.path.isfile(target_bg):
            subprocess.run(["pkill", "swaybg"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.Popen(["swaybg", "-i", target_bg, "-m", "fill"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

    # 6. Ensure Alacritty theme TOML has proper newlines
    alacritty_toml = os.path.join(home, ".local/state/iram/current/theme/alacritty.toml")
    if os.path.isfile(alacritty_toml):
        try:
            with open(alacritty_toml, "r", encoding="utf-8") as f:
                content = f.read().strip()
            if content and "\n" not in content:
                formatted = re.sub(r"(\[[^\]]+\])", r"\n\1\n", content)
                formatted = re.sub(r'("[^"]*"\s*)([a-zA-Z0-9_]+\s*=)', r"\1\n\2", formatted)
                lines = [l.strip() for l in formatted.splitlines() if l.strip()]
                out = []
                for l in lines:
                    if l.startswith("[") and out and out[-1] != "":
                        out.append("")
                    out.append(l)
                with open(alacritty_toml, "w", encoding="utf-8") as f:
                    f.write("\n".join(out).strip() + "\n")
        except Exception:
            pass

    print("Iram desktop theme synchronized across Waybar, Wofi, Hyprland, Mako, and Swaybg.")

if __name__ == "__main__":
    main()
