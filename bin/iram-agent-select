#!/usr/bin/env bash
# iram:summary=Select and switch system-wide default AI coding agent (agy, claude, gemini, codex, kimi, ollama)
# iram:tags=agent,ai,switcher
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/iram"
CONFIG_FILE="$CONFIG_DIR/default-agent"
mkdir -p "$CONFIG_DIR"

AGENTS=(
    "agy:Google Antigravity CLI (Default)"
    "claude:Anthropic Claude Code"
    "gemini:Google Gemini CLI"
    "codex:OpenAI Codex CLI"
    "kimi:Moonshot Kimi CLI"
    "ollama:Local Ollama Model"
)

VALID_AGENTS=()
for a in "${AGENTS[@]}"; do
    VALID_AGENTS+=("${a%%:*}")
done

subcmd="${1:-}"

case "$subcmd" in
    list)
        for a in "${VALID_AGENTS[@]}"; do
            echo "$a"
        done
        exit 0
        ;;
    status|current)
        cat "$CONFIG_FILE" 2>/dev/null || echo "agy"
        exit 0
        ;;
esac

selected=""
if [ -n "$subcmd" ]; then
    # Validate requested agent
    for valid in "${VALID_AGENTS[@]}"; do
        if [ "$subcmd" = "$valid" ]; then
            selected="$subcmd"
            break
        fi
    done
    if [ -z "$selected" ]; then
        echo "Error: Unknown agent '$subcmd'. Available agents: ${VALID_AGENTS[*]}" >&2
        exit 1
    fi
else
    current=$(cat "$CONFIG_FILE" 2>/dev/null || echo "agy")
    if command -v wofi >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
        choice=$(printf '%s\n' "${AGENTS[@]}" | wofi --dmenu --prompt "Default AI Agent (Current: $current):" --width 450 --height 300 || true)
        if [ -n "$choice" ]; then
            selected=$(echo "$choice" | cut -d: -f1)
        fi
    else
        echo "=== Select Default AI Agent ==="
        echo "Current: $current"
        for i in "${!AGENTS[@]}"; do
            echo "$((i+1)). ${AGENTS[$i]}"
        done
        read -rp "Enter choice [1-${#AGENTS[@]}]: " idx
        if [[ "$idx" =~ ^[0-9]+$ ]] && [ "$idx" -ge 1 ] && [ "$idx" -le "${#AGENTS[@]}" ]; then
            selected=$(echo "${AGENTS[$((idx-1))]}" | cut -d: -f1)
        fi
    fi
fi

if [ -n "$selected" ]; then
    echo "$selected" > "$CONFIG_FILE"
    # Sync to iram-os alias
    mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/iram-os"
    echo "$selected" > "${XDG_CONFIG_HOME:-$HOME/.config}/iram-os/default-agent"
    
    notify-send -a "IRAM OS" "AI Agent Switched" "Default agent set to: $selected" 2>/dev/null || true
    echo "✓ Default AI agent set to: $selected"
else
    cat "$CONFIG_FILE" 2>/dev/null || echo "agy"
fi
