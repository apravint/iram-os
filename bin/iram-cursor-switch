#!/bin/bash
# Iram Cursor Theme Switcher
# Synchronizes cursor across Hyprland, Hyprcursor, GSettings, GTK 3/4, X11/XWayland, and KDE

THEMES=()

# Discover installed cursor themes
for dir in /usr/share/icons/* ~/.icons/* ~/.local/share/icons/*; do
  if [[ -d "$dir/cursors" || -d "$dir/hyprcursors" ]]; then
    THEME_NAME=$(basename "$dir")
    [[ "$THEME_NAME" != "default" && "$THEME_NAME" != "hicolor" ]] && THEMES+=("$THEME_NAME")
  fi
done

# Remove duplicates
mapfile -t UNIQUE_THEMES < <(printf '%s\n' "${THEMES[@]}" | sort -u)

SELECTED="$1"
if [[ -z "$SELECTED" ]]; then
  SELECTED=$(printf '%s\n' "${UNIQUE_THEMES[@]}" | wofi --dmenu --prompt "Select Cursor Theme:" --lines 10 -i)
fi

[[ -z "$SELECTED" ]] && exit 0

CURSOR_SIZE=24

# 1. Apply cursor to Hyprland immediately
hyprctl setcursor "$SELECTED" "$CURSOR_SIZE" >/dev/null 2>&1 || true
hyprctl keyword cursor:no_hardware_cursors true >/dev/null 2>&1 || true

# 2. Apply to GNOME / GTK GSettings
gsettings set org.gnome.desktop.interface cursor-theme "$SELECTED" >/dev/null 2>&1 || true
gsettings set org.gnome.desktop.interface cursor-size "$CURSOR_SIZE" >/dev/null 2>&1 || true

# 3. Persist X11/XWayland default cursor
mkdir -p ~/.icons/default
cat << CURSOR_EOF > ~/.icons/default/index.theme
[Icon Theme]
Name=Default
Comment=Default Cursor Theme
Inherits=$SELECTED
CURSOR_EOF

# 4. Persist for Hyprland config (native cursor block + no_hardware_cursors)
mkdir -p ~/.config/hypr
cat << CURSOR_EOF > ~/.config/hypr/cursor.conf
# Dynamic Cursor Theme (generated by iram-cursor-switch)
env = XCURSOR_THEME,$SELECTED
env = XCURSOR_SIZE,$CURSOR_SIZE
env = HYPRCURSOR_THEME,$SELECTED
env = HYPRCURSOR_SIZE,$CURSOR_SIZE

# Hyprland 0.53+ Native Cursor Engine & NVIDIA Hardware Cursor Fix
cursor {
    no_hardware_cursors = true
    enable_hyprcursor = true
    sync_gsettings_theme = true
    no_warps = false
}
CURSOR_EOF

# 5. Update GTK 3 and GTK 4 settings.ini
for gtk_ini in ~/.config/gtk-3.0/settings.ini ~/.config/gtk-4.0/settings.ini; do
  if [[ -f "$gtk_ini" ]]; then
    sed -i "s/^gtk-cursor-theme-name=.*/gtk-cursor-theme-name=$SELECTED/" "$gtk_ini"
    sed -i "s/^gtk-cursor-theme-size=.*/gtk-cursor-theme-size=$CURSOR_SIZE/" "$gtk_ini"
  fi
done

# 6. Update xsettingsd if present
if [[ -f ~/.config/xsettingsd/xsettingsd.conf ]]; then
  sed -i "s/^Gtk\/CursorThemeName .*/Gtk\/CursorThemeName \"$SELECTED\"/" ~/.config/xsettingsd/xsettingsd.conf
  sed -i "s/^Gtk\/CursorThemeSize .*/Gtk\/CursorThemeSize $CURSOR_SIZE/" ~/.config/xsettingsd/xsettingsd.conf
fi

# 7. Update KDE defaults if present
if [[ -f ~/.config/kdedefaults/kcminputrc ]]; then
  sed -i "s/^cursorTheme=.*/cursorTheme=$SELECTED/" ~/.config/kdedefaults/kcminputrc
  sed -i "s/^cursorSize=.*/cursorSize=$CURSOR_SIZE/" ~/.config/kdedefaults/kcminputrc
fi

# 8. Update ~/.Xresources
if [[ -f ~/.Xresources ]]; then
  sed -i '/Xcursor.theme/d' ~/.Xresources
  sed -i '/Xcursor.size/d' ~/.Xresources
  printf "Xcursor.theme: %s\nXcursor.size:  %s\n" "$SELECTED" "$CURSOR_SIZE" >> ~/.Xresources
  xrdb -merge ~/.Xresources 2>/dev/null || true
fi

# 9. Reload Hyprland to apply updated cursor.conf
hyprctl reload >/dev/null 2>&1 || true

iram-notification-send -g 󰇀 "Cursor Theme Updated" "Active cursor set to: $SELECTED ($CURSOR_SIZE px)" 2>/dev/null || true
