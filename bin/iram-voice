#!/usr/bin/env bash
# ==============================================================================
# IRAM OS VoiceStudio Unified CLI
# Open-Source Voice Cloning, Voice Design, Speech Synthesis & Video Dubbing
# iram:summary=Open-Source VoiceStudio (Voice Cloning, Voice Design & Speech Synthesis)
# ==============================================================================
set -euo pipefail

REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
IRAM_DIR="$(cd "$(dirname "$REAL_PATH")/.." && pwd)"
export PYTHONPATH="${IRAM_DIR}:/home/apravint/iram-voice:${PYTHONPATH:-}"

if [ "${1:-}" = "mcp" ]; then
    shift
    exec python3 -m iram_voice.mcp_server "$@"
fi

exec python3 -m iram_voice.core "$@"
