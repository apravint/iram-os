#!/usr/bin/env python3
"""
Iram AI Security Guard & Firewall Monitor (iram-security-guard)
Audits listening ports, SSH/sudo login attempts, firewall status, and anomalous network traffic.
https://github.com/apravint/iram-os
"""

import sys
import os
import subprocess
import json

def run_cmd(cmd):
    try:
        res = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=8)
        return res.stdout.strip()
    except Exception as e:
        return ""

def notify(title, message, urgency="normal"):
    print(f"[{urgency.upper()}] {title}: {message}")
    # Message text can carry process and network names, so it must never reach a shell.
    subprocess.run(["notify-send", "-u", urgency, "-a", "Iram Security Guard", title, message])

def audit_security():
    issues = []
    print("🛡️ Running Iram Security Guard Audit...")

    # 1. Audit Listening Sockets
    ports_out = run_cmd("ss -tulpn | grep LISTEN")
    listening_ports = []
    if ports_out:
        for line in ports_out.split("\n"):
            if not any(loopback in line for loopback in ["127.", "localhost", "::1"]):
                listening_ports.append(line.split()[4] if len(line.split()) >= 5 else line)

    if listening_ports:
        issues.append(f"🌐 Public Listening Ports Detected: {', '.join(listening_ports[:4])}")

    # 2. Audit Failed Sudo / Auth Logs
    auth_out = run_cmd("journalctl _COMM=sudo -n 10 --no-pager 2>/dev/null | grep -i 'authentication failure'")
    if auth_out:
        failed_count = len(auth_out.split("\n"))
        issues.append(f"⚠️ {failed_count} Recent Sudo Authentication Failures Detected.")

    # 3. Audit UFW Firewall Status
    ufw_status = run_cmd("systemctl is-active ufw")
    if ufw_status != "active":
        issues.append("🔥 UFW Firewall is INACTIVE! Recommended: sudo ufw enable")

    # 4. Notify Summary
    if issues:
        summary = "\n".join(issues)
        notify("🛡️ Security Guard Risk Alert", summary, urgency="critical")
    else:
        print("✨ All firewall rules, listening sockets, and authentication logs are secure.")
        # Routine check is silent - only notify if security risks or unauthorized attempts are detected

if __name__ == "__main__":
    audit_security()
