#!/usr/bin/env python3
"""
IRAM OS Modular Skills Engine (iram-skills)
Integrates:
- Built-in IRAM OS System Skills (superpowers, git-workflow, pipewire-audio, hyprland-geometry)
- 177 K-Dense Scientific Agent Skills (~/.local/share/iram/scientific-agent-skills)
- Google Antigravity & Agent Skills standard (~/.agents/skills and ~/.config/iram/skills)

https://github.com/apravint/iram-os
"""

import sys
import os
import re
import argparse
from typing import Dict, List, Optional, Tuple

USER_SKILLS_DIR = os.path.expanduser("~/.config/iram/skills")
AGENTS_SKILLS_DIR = os.path.expanduser("~/.agents/skills")
SCI_REPO_SKILLS_DIR = os.path.expanduser("~/.local/share/iram/scientific-agent-skills/skills")

os.makedirs(USER_SKILLS_DIR, exist_ok=True)
os.makedirs(AGENTS_SKILLS_DIR, exist_ok=True)

# Built-in Default Skills
BUILTIN_SKILLS = {
    "superpowers": {
        "description": "Transforms vague tasks into verifiable TDD plans with execution checkpoints.",
        "instructions": (
            "# Superpowers Skill: Test-Driven Planning & Verification Checkpoints\n"
            "1. Clarify Requirements: Identify the single core behavior that must change.\n"
            "2. Write/Identify Tests First: Specify how success will be verified before altering code.\n"
            "3. Make Minimal Atomic Edit: Keep diffs focused strictly on the objective.\n"
            "4. Execute Verification: Run compilation (bash -n / py_compile / tests).\n"
            "5. Rollback on Failure: Never commit broken state; adapt and retry.\n"
        )
    },
    "git-workflow": {
        "description": "Standardized conventional commit drafting, clean diff inspection, and safe branch hygiene.",
        "instructions": (
            "# Git Workflow Skill\n"
            "- Inspect staged diff using `git diff --staged` before finalizing.\n"
            "- Craft conventional commits: `feat:`, `fix:`, `refactor:`, `docs:`.\n"
            "- Never force-push to main or include uncommitted merge markers.\n"
        )
    },
    "pipewire-audio": {
        "description": "Diagnoses PipeWire/WirePlumber streams, ALSA converter priorities, and sink routing.",
        "instructions": (
            "# PipeWire Audio Routing Skill\n"
            "- Inspect sinks: `wpctl status`\n"
            "- Toggle active default sink: `iram-audio-toggle`\n"
            "- Ensure HDMI monitor converters are unmuted: `iram-audio-init`\n"
        )
    },
    "hyprland-geometry": {
        "description": "Multi-monitor geometry collision prevention and window rules management.",
        "instructions": (
            "# Hyprland Geometry Skill\n"
            "- Audit display coordinates: `iram-displays-gui` or `hyprctl monitors`\n"
            "- Verify 0x0 offset collision avoidance on secondary 4K and TV screens.\n"
            "- Verify config syntax: `hyprctl configerrors`.\n"
        )
    }
}

SUITES = {
    "core-science": [
        "database-lookup",
        "paperclip",
        "scientific-writing",
        "scientific-slides",
        "experimental-design"
    ],
    "bio": [
        "scanpy",
        "anndata",
        "bulk-rnaseq",
        "pydeseq2",
        "biopython",
        "scvelo",
        "pathway-enrichment"
    ],
    "chem": [
        "rdkit",
        "datamol",
        "deepchem",
        "molecular-dynamics",
        "medchem"
    ],
    "cad": [
        "lab-hardware-cad"
    ],
    "quantum": [
        "qiskit",
        "pennylane",
        "qutip",
        "cirq"
    ]
}

# ANSI Colors
GREEN = "\033[0;32m"
CYAN = "\033[0;36m"
YELLOW = "\033[1;33m"
BOLD = "\033[1m"
RED = "\033[0;31m"
NC = "\033[0m"


def extract_skill_description(skill_dir: str) -> str:
    skill_md = os.path.join(skill_dir, "SKILL.md")
    if not os.path.isfile(skill_md):
        return "No description available."
    try:
        with open(skill_md, "r", encoding="utf-8", errors="ignore") as f:
            content = f.read(2048)
        # Check for YAML frontmatter description
        m = re.search(r"^description:\s*([^\n]+)", content, re.MULTILINE)
        if m:
            desc = m.group(1).strip().strip('"').strip("'")
            return desc
        # Fallback to first non-header line
        for line in content.splitlines():
            line = line.strip()
            if line and not line.startswith("#") and not line.startswith("---") and not line.startswith("name:"):
                return line[:100]
    except Exception:
        pass
    return "No description available."


def get_installed_skills() -> Dict[str, str]:
    installed = {}
    # 1. Builtins
    for name, data in BUILTIN_SKILLS.items():
        installed[name] = ("builtin", data["description"])

    # 2. Check ~/.config/iram/skills and ~/.agents/skills
    for target_dir in [USER_SKILLS_DIR, AGENTS_SKILLS_DIR]:
        if not os.path.isdir(target_dir):
            continue
        for entry in sorted(os.listdir(target_dir)):
            full = os.path.join(target_dir, entry)
            if entry in installed:
                continue
            if os.path.isdir(full):
                desc = extract_skill_description(full)
                installed[entry] = ("installed", desc)
            elif entry.endswith(".md"):
                sname = entry[:-3]
                installed[sname] = ("custom", "Local custom markdown skill")
    return installed


def list_skills(show_all: bool = False):
    installed = get_installed_skills()
    print(f"{BOLD}{CYAN}⚡ IRAM OS Active Modular Skills ({len(installed)}):{NC}")
    for name, (src, desc) in installed.items():
        tag = f"{GREEN}[active]{NC}" if src == "installed" else f"{CYAN}[{src}]{NC}"
        print(f"  • {BOLD}{name:<24}{NC} {tag} {desc}")

    if show_all and os.path.isdir(SCI_REPO_SKILLS_DIR):
        all_sci = sorted(os.listdir(SCI_REPO_SKILLS_DIR))
        uninstalled = [s for s in all_sci if s not in installed and os.path.isdir(os.path.join(SCI_REPO_SKILLS_DIR, s))]
        print(f"\n{BOLD}{YELLOW}📚 Available Scientific Skills in Catalog ({len(uninstalled)} uninstalled):{NC}")
        for s in uninstalled[:25]:
            desc = extract_skill_description(os.path.join(SCI_REPO_SKILLS_DIR, s))
            print(f"  ○ {BOLD}{s:<24}{NC} {desc}")
        if len(uninstalled) > 25:
            print(f"  ... and {len(uninstalled) - 25} more. Run {BOLD}iram-skills search <term>{NC} to explore.")


def search_skills(query: str):
    q = query.lower()
    print(f"{BOLD}{CYAN}🔍 Searching IRAM OS Skills for '{query}'...{NC}\n")
    found = 0
    installed = get_installed_skills()

    # Search installed
    for name, (src, desc) in installed.items():
        if q in name.lower() or q in desc.lower():
            print(f"  • {BOLD}{name:<24}{NC} {GREEN}[installed]{NC} {desc}")
            found += 1

    # Search repo catalog
    if os.path.isdir(SCI_REPO_SKILLS_DIR):
        for s in sorted(os.listdir(SCI_REPO_SKILLS_DIR)):
            if s in installed:
                continue
            full = os.path.join(SCI_REPO_SKILLS_DIR, s)
            if os.path.isdir(full):
                desc = extract_skill_description(full)
                if q in s.lower() or q in desc.lower():
                    print(f"  ○ {BOLD}{s:<24}{NC} {YELLOW}[available]{NC} {desc}")
                    found += 1

    if found == 0:
        print(f"{RED}No skills matched '{query}'.{NC}")
    else:
        print(f"\n{BOLD}Total matches: {found}.{NC} To install: {BOLD}iram-skills install <name>{NC}")


def install_skill(skill_name: str) -> bool:
    source_dir = os.path.join(SCI_REPO_SKILLS_DIR, skill_name)
    if not os.path.isdir(source_dir):
        print(f"{RED}Error: Skill '{skill_name}' not found in catalog ({SCI_REPO_SKILLS_DIR}).{NC}")
        return False

    # Link to USER_SKILLS_DIR and AGENTS_SKILLS_DIR
    for target_dir in [USER_SKILLS_DIR, AGENTS_SKILLS_DIR]:
        os.makedirs(target_dir, exist_ok=True)
        dest = os.path.join(target_dir, skill_name)
        if os.path.islink(dest) or os.path.exists(dest):
            try:
                os.unlink(dest)
            except Exception:
                pass
        os.symlink(source_dir, dest)

    desc = extract_skill_description(source_dir)
    print(f"{GREEN}✓ Installed skill:{NC} {BOLD}{skill_name}{NC} — {desc}")
    print(f"  Active in: {USER_SKILLS_DIR}/{skill_name}")
    print(f"  Active in: {AGENTS_SKILLS_DIR}/{skill_name}")
    return True


def remove_skill(skill_name: str) -> bool:
    removed = False
    for target_dir in [USER_SKILLS_DIR, AGENTS_SKILLS_DIR]:
        dest = os.path.join(target_dir, skill_name)
        if os.path.islink(dest) or os.path.exists(dest):
            try:
                if os.path.islink(dest):
                    os.unlink(dest)
                removed = True
            except Exception as e:
                print(f"{RED}Error removing {dest}: {e}{NC}")
    if removed:
        print(f"{GREEN}✓ Removed skill:{NC} {BOLD}{skill_name}{NC}")
    else:
        print(f"{YELLOW}Skill '{skill_name}' is not currently installed.{NC}")
    return removed


def view_skill(skill_name: str):
    if skill_name in BUILTIN_SKILLS:
        print(f"{BOLD}Skill: {skill_name}{NC}\n")
        print(BUILTIN_SKILLS[skill_name]["instructions"])
        return

    # Check installed or catalog
    paths = [
        os.path.join(USER_SKILLS_DIR, skill_name, "SKILL.md"),
        os.path.join(AGENTS_SKILLS_DIR, skill_name, "SKILL.md"),
        os.path.join(SCI_REPO_SKILLS_DIR, skill_name, "SKILL.md"),
        os.path.join(USER_SKILLS_DIR, f"{skill_name}.md")
    ]
    for p in paths:
        if os.path.isfile(p):
            print(f"{BOLD}Skill: {skill_name} ({p}){NC}\n")
            with open(p, "r", encoding="utf-8", errors="ignore") as f:
                print(f.read())
            return

    print(f"{RED}Skill '{skill_name}' not found. List active skills with: iram-skills list{NC}")


def install_suite(suite_name: str):
    if suite_name not in SUITES:
        print(f"{RED}Unknown suite '{suite_name}'. Available suites: {', '.join(SUITES.keys())}{NC}")
        return

    skills = SUITES[suite_name]
    print(f"{BOLD}{CYAN}⚡ Installing '{suite_name}' Suite ({len(skills)} skills)...{NC}")
    for s in skills:
        install_skill(s)
    print(f"\n{GREEN}✓ '{suite_name}' suite installation complete!{NC}")


def main():
    parser = argparse.ArgumentParser(description="IRAM OS Modular Skills Engine")
    subparsers = parser.add_subparsers(dest="subcommand")

    p_list = subparsers.add_parser("list", help="List available modular skills")
    p_list.add_argument("-a", "--all", action="store_true", help="Include available catalog skills")

    p_search = subparsers.add_parser("search", help="Search skills by keyword")
    p_search.add_argument("query", help="Keyword to search")

    p_install = subparsers.add_parser("install", help="Install a skill from catalog")
    p_install.add_argument("name", help="Name of skill to install")

    p_remove = subparsers.add_parser("remove", help="Remove an installed skill")
    p_remove.add_argument("name", help="Name of skill to remove")

    p_view = subparsers.add_parser("view", help="View instructions for a specific skill")
    p_view.add_argument("name", help="Name of skill")

    p_suite = subparsers.add_parser("suite", help="Install a curated suite of skills")
    p_suite.add_argument("name", choices=list(SUITES.keys()), help="Name of suite to install")

    args = parser.parse_args()

    if args.subcommand == "list" or not args.subcommand:
        list_skills(show_all=getattr(args, "all", False))
    elif args.subcommand == "search":
        search_skills(args.query)
    elif args.subcommand == "install":
        install_skill(args.name)
    elif args.subcommand == "remove":
        remove_skill(args.name)
    elif args.subcommand == "view":
        view_skill(args.name)
    elif args.subcommand == "suite":
        install_suite(args.name)


if __name__ == "__main__":
    main()
