#!/usr/bin/env bash
# ==============================================================================
# Iram Agentic OS Assistant (Super + A)
# Powered by Harness² Modular Architecture, Local-First AI & Hindsight Memory
# Prompt-driven autonomous actions and window management
# ==============================================================================

set -euo pipefail

PROMPT="${1:-}"

# If no command line prompt passed, open Wofi GUI prompt
if [ -z "$PROMPT" ]; then
    PROMPT=$(wofi --dmenu --prompt "🤖 Ask Iram Agentic OS..." --width 600 --height 150 2>/dev/null || true)
fi

if [ -z "$PROMPT" ]; then
    exit 0
fi

# Send desktop notification
if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Iram Agent" "🤖 Processing Request..." "$PROMPT" -t 2500
fi

python3 - "$PROMPT" << 'EOF'
import sys
import json
import re
import shlex
import subprocess
import os
import datetime

# Import AI Core & Hindsight
SCRIPT_DIR = os.path.expanduser("~/iram-os/bin")
if SCRIPT_DIR not in sys.path:
    sys.path.insert(0, SCRIPT_DIR)

from iram_ai_core import (
    query_llm,
    hindsight_recall,
    hindsight_retain,
    clean_bash_command
)

prompt = sys.argv[1]
print(f"🤖 Iram Agent executing: {prompt}")

# ------------------------------------------------------------------------------
# 1. Harness² Component Loader
# ------------------------------------------------------------------------------
AGENT_DIR = os.path.expanduser("~/.config/iram/agent")
SYSTEM_PROMPT_FILE = os.path.join(AGENT_DIR, "system_prompt.md")
GUARDRAILS_FILE = os.path.join(AGENT_DIR, "guardrails.md")
TOOL_GUIDANCE_FILE = os.path.join(AGENT_DIR, "tool_guidance.md")
MEMORY_DIR = os.path.join(AGENT_DIR, "memory")
REFLECTIONS_FILE = os.path.join(MEMORY_DIR, "reflections.jsonl")

os.makedirs(MEMORY_DIR, exist_ok=True)

def read_file_safe(path: str, default: str = "") -> str:
    if os.path.isfile(path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                return f.read().strip()
        except Exception:
            pass
    return default

sys_prompt_content = read_file_safe(SYSTEM_PROMPT_FILE, "You are the Iram Agentic OS assistant running on IRAM OS Hyprland.")
guardrails_content = read_file_safe(GUARDRAILS_FILE, "")
tool_guidance_content = read_file_safe(TOOL_GUIDANCE_FILE, "")

# Recall relevant Hindsight long-term memory
recalled_memories = hindsight_recall(prompt, limit=3)
memory_context = ""
if recalled_memories:
    mem_lines = [f"• {m['fact']}" for m in recalled_memories if m.get("score", 0) > 0.5]
    if mem_lines:
        memory_context = "## Prior Learned System Memory (Hindsight)\n" + "\n".join(mem_lines) + "\n"

# Build composite prompt from Harness components
composite_system_prompt = f"""{sys_prompt_content}

## Guardrails
{guardrails_content}

## Tool Guidance
{tool_guidance_content}

{memory_context}
When replying, provide an explanation and list executable bash commands on separate lines starting with hyprctl, iram, wpctl, pactl, craft-, or notify-send.
"""

# ------------------------------------------------------------------------------
# 2. Model Dispatch (Instant Local-First via AI Core)
# ------------------------------------------------------------------------------
user_task = f"User Request: {prompt}\nResponse:"
answer, provider = query_llm(user_task, system_prompt=composite_system_prompt, num_predict=384)

if not answer:
    print("Error: Could not reach agent model (Ollama offline).")
    subprocess.run(["notify-send", "-a", "Iram Agent", "⚠️ Model Unavailable", "Please ensure Ollama is running."])
    sys.exit(1)

print(f"► Agent Response [{provider}]:\n{answer}")

# ------------------------------------------------------------------------------
# 3. Guardrails & Propose-Probe-Compose Execution
# ------------------------------------------------------------------------------
executed_commands = []
failed_commands = []

ALLOWED_PREFIXES = ["hyprctl", "iram", "notify-send", "pactl", "wpctl", "craft-"]
FORBIDDEN_PATTERNS = ["rm -rf", "mkfs", "dd if=", ":(){ :|:& };:", "chmod -R 777 /"]

candidates = []

# Try parsing structured JSON actions first
try:
    json_match = re.search(r"(\[.*\]|\{.*\})", answer, re.DOTALL)
    if json_match:
        parsed_json = json.loads(json_match.group(1))
        if isinstance(parsed_json, list):
            for item in parsed_json:
                if isinstance(item, dict) and "action" in item:
                    act = item["action"]
                    if isinstance(act, list):
                        import shlex
                        candidates.append(" ".join(shlex.quote(str(x)) for x in act))
                    elif isinstance(act, str):
                        candidates.append(act)
except Exception:
    pass

# Also extract plain lines
for raw_line in answer.split("\n"):
    clean_line = raw_line.strip().strip("`").strip()
    if clean_line:
        candidates.append(clean_line)

for clean_line in candidates:
    if not clean_line:
        continue

    # Invariant Guardrail Check
    if any(fp in clean_line for fp in FORBIDDEN_PATTERNS):
        print(f"⛔ Blocked by Guardrail: {clean_line}")
        continue

    if any(clean_line.startswith(prefix) for prefix in ALLOWED_PREFIXES):
        print(f"⚡ Dispatching: {clean_line}")
        res = subprocess.run(clean_line, shell=True, text=True, capture_output=True)
        if res.returncode == 0:
            executed_commands.append(clean_line)
        else:
            print(f"⚠️ Command error ({res.returncode}): {res.stderr.strip()}")
            failed_commands.append({"cmd": clean_line, "code": res.returncode, "err": res.stderr.strip()})

# ------------------------------------------------------------------------------
# 4. Hindsight Memory & Reflection Persistence
# ------------------------------------------------------------------------------
if executed_commands:
    hindsight_retain(
        f"Agent task '{prompt}' executed: {', '.join(executed_commands)}",
        category="agent",
        importance=4
    )

if failed_commands:
    hindsight_retain(
        f"Agent task '{prompt}' failed command(s): {json.dumps(failed_commands)}",
        category="reflection",
        importance=5
    )
    reflection_record = {
        "timestamp": datetime.datetime.now().isoformat(),
        "prompt": prompt,
        "failed": failed_commands,
        "executed": executed_commands
    }
    try:
        with open(REFLECTIONS_FILE, "a", encoding="utf-8") as f:
            f.write(json.dumps(reflection_record) + "\n")
    except Exception:
        pass

msg = f"Executed {len(executed_commands)} action(s)." if executed_commands else "Processed query."
subprocess.run(["notify-send", "-a", "Iram Agent", f"✓ Completed [{provider}]", f"{msg}\n{prompt[:60]}"])
EOF
