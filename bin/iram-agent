#!/usr/bin/env bash
# ==============================================================================
# Iram Agentic OS Assistant (Super + A)
# Powered by Harness² Modular Architecture & K-Dense Skills
# Prompt-driven autonomous actions and window management
# ==============================================================================

set -euo pipefail

PROMPT="${1:-}"

# If no command line prompt passed, open Wofi GUI prompt
if [ -z "$PROMPT" ]; then
    PROMPT=$(wofi --dmenu --prompt "🤖 Ask Iram Agentic OS..." --width 600 --height 150 2>/dev/null || true)
fi

if [ -z "$PROMPT" ]; then
    exit 0
fi

# Send desktop notification
if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Iram Agent" "🤖 Processing Request..." "$PROMPT" -t 2500
fi

python3 - "$PROMPT" << 'EOF'
import sys
import json
import urllib.request
import subprocess
import os
import datetime

prompt = sys.argv[1]
print(f"🤖 Iram Agent executing: {prompt}")

# ------------------------------------------------------------------------------
# 1. Harness² Component Loader
# ------------------------------------------------------------------------------
AGENT_DIR = os.path.expanduser("~/.config/iram/agent")
SYSTEM_PROMPT_FILE = os.path.join(AGENT_DIR, "system_prompt.md")
GUARDRAILS_FILE = os.path.join(AGENT_DIR, "guardrails.md")
TOOL_GUIDANCE_FILE = os.path.join(AGENT_DIR, "tool_guidance.md")
MEMORY_DIR = os.path.join(AGENT_DIR, "memory")
REFLECTIONS_FILE = os.path.join(MEMORY_DIR, "reflections.jsonl")

os.makedirs(MEMORY_DIR, exist_ok=True)

def read_file_safe(path: str, default: str = "") -> str:
    if os.path.isfile(path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                return f.read().strip()
        except Exception:
            pass
    return default

sys_prompt_content = read_file_safe(SYSTEM_PROMPT_FILE, "You are the Iram Agentic OS assistant running on IRAM OS Hyprland.")
guardrails_content = read_file_safe(GUARDRAILS_FILE, "")
tool_guidance_content = read_file_safe(TOOL_GUIDANCE_FILE, "")

# Build composite prompt from Harness components
composite_system_prompt = f"""{sys_prompt_content}

## Guardrails
{guardrails_content}

## Tool Guidance
{tool_guidance_content}

When replying, provide an explanation and list executable bash commands on separate lines starting with hyprctl, iram, wpctl, pactl, craft-, or notify-send.
"""

# ------------------------------------------------------------------------------
# 2. Model Dispatch (Gemini API / Local Ollama fallback)
# ------------------------------------------------------------------------------
def get_api_key():
    key = os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY")
    if key:
        return key
    env_file = os.path.expanduser("~/.config/environment.d/20-gemini.conf")
    if os.path.exists(env_file):
        try:
            with open(env_file, "r") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("GEMINI_API_KEY=") or line.startswith("GOOGLE_API_KEY="):
                        val = line.split("=", 1)[1].strip().strip('"').strip("'")
                        if val:
                            return val
        except Exception:
            pass
    zshrc = os.path.expanduser("~/.zshrc")
    if os.path.exists(zshrc):
        try:
            with open(zshrc, "r") as f:
                for line in f:
                    if "GEMINI_API_KEY=" in line and not line.strip().startswith("#"):
                        return line.split("GEMINI_API_KEY=", 1)[1].strip().strip('"').strip("'")
        except Exception:
            pass
    return ""

answer = ""
api_key = get_api_key()

if api_key:
    try:
        gemini_model = os.environ.get("GEMINI_MODEL", "gemini-3.5-flash-lite")
        gemini_url = f"https://generativelanguage.googleapis.com/v1beta/models/{gemini_model}:generateContent"
        payload = {
            "contents": [{"parts": [{"text": f"{composite_system_prompt}\nUser Request: {prompt}\nResponse:"}]}]
        }
        req = urllib.request.Request(
            gemini_url,
            data=json.dumps(payload).encode("utf-8"),
            headers={"Content-Type": "application/json", "x-goog-api-key": api_key}
        )
        with urllib.request.urlopen(req, timeout=12) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            answer = data["candidates"][0]["content"]["parts"][0]["text"].strip()
    except Exception as e:
        print(f"Gemini API request note: {e}")

if not answer:
    url = "http://localhost:11434/api/generate"
    ollama_model = os.environ.get("OLLAMA_MODEL", "qwen2.5:1.5b")
    data = json.dumps({
        "model": ollama_model,
        "prompt": f"{composite_system_prompt}\nUser Request: {prompt}\nResponse:",
        "stream": False
    }).encode("utf-8")

    try:
        req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=15) as resp:
            res = json.loads(resp.read().decode("utf-8"))
            answer = res.get("response", "").strip()
    except Exception as e:
        print(f"Error contacting agent model: {e}")
        subprocess.run(["notify-send", "-a", "Iram Agent", "⚠️ Model Unavailable", "Please ensure GEMINI_API_KEY or Ollama is running."])
        sys.exit(1)

print("► Agent Response:\n", answer)

# ------------------------------------------------------------------------------
# 3. Guardrails & Propose-Probe-Compose Execution
# ------------------------------------------------------------------------------
executed_commands = []
failed_commands = []

ALLOWED_PREFIXES = ["hyprctl", "iram", "notify-send", "pactl", "wpctl", "craft-"]
FORBIDDEN_PATTERNS = ["rm -rf", "mkfs", "dd if=", ":(){ :|:& };:", "chmod -R 777 /"]

for raw_line in answer.split("\n"):
    clean_line = raw_line.strip().strip("`").strip()
    if not clean_line:
        continue

    # Invariant Guardrail Check
    if any(fp in clean_line for fp in FORBIDDEN_PATTERNS):
        print(f"⛔ Blocked by Guardrail: {clean_line}")
        continue

    if any(clean_line.startswith(prefix) for prefix in ALLOWED_PREFIXES):
        print(f"⚡ Dispatching: {clean_line}")
        res = subprocess.run(clean_line, shell=True, text=True, capture_output=True)
        if res.returncode == 0:
            executed_commands.append(clean_line)
        else:
            print(f"⚠️ Command error ({res.returncode}): {res.stderr.strip()}")
            failed_commands.append({"cmd": clean_line, "code": res.returncode, "err": res.stderr.strip()})

# ------------------------------------------------------------------------------
# 4. Harnessing-Level Reflection Persistence
# ------------------------------------------------------------------------------
if failed_commands:
    reflection_record = {
        "timestamp": datetime.datetime.now().isoformat(),
        "prompt": prompt,
        "failed": failed_commands,
        "executed": executed_commands
    }
    try:
        with open(REFLECTIONS_FILE, "a", encoding="utf-8") as f:
            f.write(json.dumps(reflection_record) + "\n")
    except Exception:
        pass

msg = f"Executed {len(executed_commands)} action(s)." if executed_commands else "Processed query."
subprocess.run(["notify-send", "-a", "Iram Agent", "✓ Action Completed", f"{msg}\n{prompt[:60]}"])
EOF
