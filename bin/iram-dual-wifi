#!/usr/bin/env bash
# ==============================================================================
# IRAM OS Dual Wi-Fi & Multi-WAN Load Balancer
# ==============================================================================
# Aggregates two active Wi-Fi adapters (PCIe + USB) for combined bandwidth,
# load-balancing, and connection resilience.
# ==============================================================================

set -eo pipefail

IF_PCI="wlp4s0"
IF_USB="wlx503eaaec4cdb"

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

get_ip() {
    ip -4 addr show dev "$1" 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n1 || true
}

get_gw() {
    ip route show dev "$1" default 2>/dev/null | awk '{print $3}' | head -n1 || true
}

get_ssid() {
    nmcli -t -f DEVICE,CONNECTION dev | grep "^$1:" | cut -d':' -f2 || echo "None"
}

get_signal() {
    nmcli -t -f IN-USE,SIGNAL,SSID dev wifi list ifname "$1" 2>/dev/null | grep '^\*' | cut -d':' -f2 || echo "N/A"
}

show_status() {
    echo -e "${BLUE}======================================================${NC}"
    echo -e "${CYAN}📡 IRAM OS Dual Wi-Fi Status${NC}"
    echo -e "${BLUE}======================================================${NC}"
    
    IP1=$(get_ip "$IF_PCI")
    GW1=$(get_gw "$IF_PCI")
    SSID1=$(get_ssid "$IF_PCI")
    SIG1=$(get_signal "$IF_PCI")

    IP2=$(get_ip "$IF_USB")
    GW2=$(get_gw "$IF_USB")
    SSID2=$(get_ssid "$IF_USB")
    SIG2=$(get_signal "$IF_USB")

    echo -e "Adapter 1 (PCIe Qualcomm): ${GREEN}${IF_PCI}${NC}"
    echo -e "  SSID       : ${YELLOW}${SSID1}${NC} (Signal: ${SIG1}%)"
    echo -e "  IP Address : ${IP1:-Not Connected}"
    echo -e "  Gateway    : ${GW1:-N/A}"
    echo ""
    echo -e "Adapter 2 (USB Archer T2U): ${GREEN}${IF_USB}${NC}"
    echo -e "  SSID       : ${YELLOW}${SSID2}${NC} (Signal: ${SIG2}%)"
    echo -e "  IP Address : ${IP2:-Not Connected}"
    echo -e "  Gateway    : ${GW2:-N/A}"
    echo ""
    echo -e "${CYAN}Current Default Route:${NC}"
    ip route show default
    echo -e "${BLUE}======================================================${NC}"
}

enable_balance() {
    IP1=$(get_ip "$IF_PCI")
    GW1=$(get_gw "$IF_PCI")
    IP2=$(get_ip "$IF_USB")
    GW2=$(get_gw "$IF_USB")

    if [ -z "$IP1" ] || [ -z "$IP2" ]; then
        echo -e "${RED}❌ Error: Both adapters must be connected with valid IP addresses.${NC}"
        echo -e "Run '${YELLOW}iram-dual-wifi status${NC}' to inspect adapter status."
        exit 1
    fi

    echo -e "${CYAN}Configuring Dual Wi-Fi ECMP Multi-Path Balancing...${NC}"

    # 1. ARP Flux Prevention
    sudo sysctl -w net.ipv4.conf.all.arp_ignore=1 >/dev/null 2>&1 || true
    sudo sysctl -w net.ipv4.conf.all.arp_announce=2 >/dev/null 2>&1 || true
    sudo sysctl -w net.ipv4.conf.all.rp_filter=2 >/dev/null 2>&1 || true

    # 2. Layer 4 Flow Hashing (balances TCP/UDP flows evenly)
    sudo sysctl -w net.ipv4.fib_multipath_hash_policy=1 >/dev/null 2>&1 || true

    # 3. Policy Routing Tables
    sudo ip route replace default via "$GW1" dev "$IF_PCI" table 100 2>/dev/null || sudo ip route add default via "$GW1" dev "$IF_PCI" table 100
    sudo ip route replace default via "$GW2" dev "$IF_USB" table 200 2>/dev/null || sudo ip route add default via "$GW2" dev "$IF_USB" table 200

    sudo ip rule del from "$IP1" table 100 2>/dev/null || true
    sudo ip rule add from "$IP1" table 100 2>/dev/null || true

    sudo ip rule del from "$IP2" table 200 2>/dev/null || true
    sudo ip rule add from "$IP2" table 200 2>/dev/null || true

    # 4. Multi-path Equal Cost Route
    sudo ip route replace default scope global \
        nexthop via "$GW1" dev "$IF_PCI" weight 1 \
        nexthop via "$GW2" dev "$IF_USB" weight 1

    echo -e "${GREEN}✅ Dual Wi-Fi Load Balancing Active!${NC}"
    echo -e "Traffic flows are now balanced across ${GREEN}${IF_PCI}${NC} and ${GREEN}${IF_USB}${NC}."
    echo ""
    ip route show default
}

keepalive() {
    echo -e "${CYAN}IRAM OS Dual Wi-Fi Keepalive Daemon started for ${IF_USB}...${NC}"
    while true; do
        IP2=$(get_ip "$IF_USB")
        GW2=$(get_gw "$IF_USB")
        if [ -n "$IP2" ] && [ -n "$GW2" ]; then
            ping -c 1 -W 2 -I "$IP2" "$GW2" >/dev/null 2>&1 || true
            sleep 5
        else
            # Adapter disconnected or awaiting DHCP; sleep calmly without crash-looping
            sleep 15
        fi
    done
}

clean_balance() {
    echo -e "${YELLOW}Restoring single default route...${NC}"
    GW1=$(get_gw "$IF_PCI")
    if [ -n "$GW1" ]; then
        sudo ip route replace default via "$GW1" dev "$IF_PCI" 2>/dev/null || true
    fi
    echo -e "${GREEN}✅ Default routing restored.${NC}"
}

case "$1" in
    status)
        show_status
        ;;
    balance)
        enable_balance
        ;;
    keepalive)
        keepalive
        ;;
    clean)
        clean_balance
        ;;
    *)
        echo "Usage: iram-dual-wifi {status|balance|keepalive|clean}"
        exit 1
        ;;
esac
