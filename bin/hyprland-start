#!/usr/bin/env bash
# ==============================================================================
# Hyprland & Iram Session Launcher
# Ensures all Wayland, toolkit, and GPU environment variables are properly exported.
# ==============================================================================

export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Hyprland

# Toolkit Wayland backends
export GDK_BACKEND="wayland,x11,*"
export QT_QPA_PLATFORM="wayland;xcb"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export CLUTTER_BACKEND=wayland
export SDL_VIDEODRIVER=wayland
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
export _JAVA_AWT_WM_NONREPARENTING=1

# Virtual Machine & Hardware Cursor Detection
VIRT=$(systemd-detect-virt 2>/dev/null || echo "none")
if [ "$VIRT" != "none" ]; then
    export WLR_NO_HARDWARE_CURSORS=1
    export LIBVA_DRIVER_NAME=sw
else
    # Default to 1 if no discrete GPU driver overrides
    export WLR_NO_HARDWARE_CURSORS=1
fi

# Launch Hyprland compositor via official start-hyprland watchdog wrapper if available
if command -v start-hyprland >/dev/null 2>&1; then
    exec start-hyprland "$@"
else
    exec Hyprland "$@"
fi
