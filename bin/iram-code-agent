#!/usr/bin/env python3
"""
Iram Code-as-Action Agent (iram-code-agent)
Executes autonomous desktop actions and complex workflows with:
- Rootless Bubblewrap (bwrap) sandboxing for code execution
- Human-in-the-Loop elevated action gates via zenity / ToolGate
- Deterministic execution limits and failure isolation
https://github.com/apravint/iram-os
"""

import sys
import os
import re
import json
import time
import subprocess
import argparse
from typing import Tuple, List, Dict, Any

# ToolGate Risk Evaluation Rules
CRITICAL_DENY_PATTERNS = [
    r"rm\s+(-[a-zA-Z]*r[a-zA-Z]*f[a-zA-Z]*|-[a-zA-Z]*f[a-zA-Z]*r[a-zA-Z]*)\s+(/|/\*|~|~/\*|\$HOME|\$HOME/\*)",
    r"mkfs\.[a-z0-9]+",
    r"dd\s+if=.*of=/dev/(sd[a-z]|nvme[0-9]n[0-9])",
    r":\(\)\s*\{\s*:\s*\|\s*:\s*&\s*\}\s*;\s*:",  # fork bomb
    r"chmod\s+(-R\s+)?777\s+(/|/etc|/boot|/usr)",
    r">\s*/dev/sd[a-z]",
]

PROMPT_PATTERNS = [
    r"systemctl\s+(stop|disable|mask|restart)\s+",
    r"iptables\s+-F",
    r"git\s+push\s+.*--force",
    r"git\s+reset\s+--hard",
    r"sudo\s+",
    r"rm\s+-[a-zA-Z]*r[a-zA-Z]*\s+",
]

def evaluate_code_risk(code_or_cmd: str) -> Tuple[str, List[str]]:
    """
    Evaluates safety risk before executing code or actions.
    Returns: ('ALLOW' | 'PROMPT' | 'DENY', flags)
    """
    flags = []
    for p in CRITICAL_DENY_PATTERNS:
        if re.search(p, code_or_cmd):
            flags.append(f"CRITICAL: Unsafe pattern detected: {p}")
            return "DENY", flags

    for p in PROMPT_PATTERNS:
        if re.search(p, code_or_cmd):
            flags.append(f"HIGH: Elevated action requires user authorization: {p}")
            return "PROMPT", flags

    return "ALLOW", ["Passes baseline safety filters"]

def prompt_human_approval(action_summary: str, details: str = "") -> bool:
    """
    Displays an unskippable modal confirmation via zenity (or terminal fallback).
    """
    has_display = bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))
    if has_display and subprocess.run(["which", "zenity"], capture_output=True).returncode == 0:
        try:
            msg = (
                f"⚠️ IRAM AI Agent Security Gate\n\n"
                f"Action: {action_summary}\n\n"
                f"Details:\n{details[:300]}\n\n"
                f"Do you want to authorize this action?"
            )
            res = subprocess.run([
                "zenity", "--question",
                "--title=IRAM Security Gate",
                "--text=" + msg,
                "--ok-label=Authorize",
                "--cancel-label=Deny",
                "--default-cancel",
                "--width=440",
                "--timeout=20"
            ])
            return (res.returncode == 0)
        except Exception:
            pass

    # Terminal fallback
    try:
        print(f"\n⚠️  [IRAM SECURITY GATE] Elevated Action Requested:\n   {action_summary}")
        ans = input("   Authorize execution? (y/N): ")
        return ans.strip().lower() == "y"
    except Exception:
        return False

# Desktop & System Tools
def get_desktop_windows() -> str:
    try:
        out = subprocess.check_output(["hyprctl", "clients", "-j"], text=True)
        clients = json.loads(out)
        summary = [{"address": c.get("address"), "class": c.get("class"), "title": c.get("title"), "workspace": c.get("workspace", {}).get("name")} for c in clients if c.get("mapped")]
        return json.dumps(summary)
    except Exception as e:
        return f"Error: {e}"

def focus_window_by_name(target: str) -> str:
    try:
        out = subprocess.check_output(["hyprctl", "clients", "-j"], text=True)
        clients = json.loads(out)
        for c in clients:
            if target.lower() in c.get("class", "").lower() or target.lower() in c.get("title", "").lower():
                addr = c.get("address")
                subprocess.run(["hyprctl", "dispatch", "focuswindow", f"address:{addr}"], check=True)
                return f"Successfully focused window {c.get('class')} ({addr})"
        return f"Window '{target}' not found."
    except Exception as e:
        return f"Error: {e}"

def execute_hyprctl(dispatcher: str, args: str = "") -> str:
    try:
        cmd = ["hyprctl", "dispatch", dispatcher]
        if args:
            cmd.append(args)
        res = subprocess.run(cmd, capture_output=True, text=True)
        return res.stdout.strip() or f"Dispatched {dispatcher}"
    except Exception as e:
        return f"Error: {e}"

def search_code_qdrant(query: str, limit: int = 3) -> str:
    try:
        res = subprocess.run(["iram-qdrant", "search", query, "-n", str(limit)], capture_output=True, text=True, timeout=5)
        return res.stdout.strip() or "No vector matches found."
    except Exception as e:
        return f"Vector search fallback (offline/safe mode): {e}"

def run_sandboxed_code(code_str: str, timeout_sec: int = 15) -> Tuple[bool, str]:
    """
    Executes Python code inside an immutable, rootless bubblewrap sandbox.
    Prevents modifying system directories, protects credentials, and limits runtime.
    """
    has_bwrap = (subprocess.run(["which", "bwrap"], capture_output=True).returncode == 0)
    home = os.path.expanduser("~")

    wrapper_script = f"""
import sys
import os
import json

# Preloaded helper primitives
def get_desktop_windows():
    import subprocess
    try:
        out = subprocess.check_output(["hyprctl", "clients", "-j"], text=True)
        return out
    except Exception as e:
        return str(e)

try:
{chr(10).join('    ' + line for line in code_str.splitlines())}
except Exception as e:
    print(f"Runtime Exception: {{e}}", file=sys.stderr)
    sys.exit(1)
"""

    if has_bwrap:
        cmd = [
            "bwrap",
            "--ro-bind", "/", "/",
            "--dev", "/dev",
            "--proc", "/proc",
            "--tmpfs", "/tmp",
            "--bind", home, home,
            "--ro-bind-try", os.path.join(home, ".ssh"), os.path.join(home, ".ssh"),
            "--ro-bind-try", os.path.join(home, ".gnupg"), os.path.join(home, ".gnupg"),
            "python3", "-c", wrapper_script
        ]
    else:
        # Fallback without bwrap
        cmd = ["python3", "-c", wrapper_script]

    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout_sec)
        out = (res.stdout + res.stderr).strip()
        return (res.returncode == 0, out or "Code executed with 0 return code.")
    except subprocess.TimeoutExpired:
        return (False, f"Execution timed out ({timeout_sec}s limit exceeded). Process killed.")
    except Exception as e:
        return (False, f"Sandbox error: {e}")

def main():
    parser = argparse.ArgumentParser(description="Iram Secure Code-as-Action Agent with Bubblewrap Sandboxing")
    parser.add_argument("prompt_or_code", help="Action prompt or Python code to execute")
    parser.add_argument("-c", "--code", action="store_true", help="Execute input directly as Python code action")
    parser.add_argument("--no-sandbox", action="store_true", help="Bypass bubblewrap containment (use with caution)")
    args = parser.parse_args()

    input_text = args.prompt_or_code

    # 1. Pre-execution Safety Evaluation
    verdict, flags = evaluate_code_risk(input_text)
    if verdict == "DENY":
        print(f"🛑 [SECURITY BLOCK] Action blocked by IRAM Guardrails:")
        for f in flags:
            print(f"   ✗ {f}")
        sys.exit(1)
    elif verdict == "PROMPT":
        approved = prompt_human_approval("Elevated Agent Action", input_text)
        if not approved:
            print("🚫 Action denied by user.")
            sys.exit(2)
        print("✓ Authorized by user.")

    # 2. Synthesize Code Action if given a natural language prompt
    if not args.code and not any(k in input_text for k in ["def ", "import ", "print(", "=", ";"]):
        prompt = input_text.lower()
        if "focus" in prompt or "window" in prompt or "switch" in prompt:
            target = prompt.replace("focus", "").replace("switch to", "").replace("window", "").strip()
            print(f"🤖 Focusing window: {target}")
            print(focus_window_by_name(target))
            return
        elif "workspace" in prompt:
            m = re.search(r"\d+", prompt)
            ws = m.group(0) if m else "1"
            print(f"🤖 Switching workspace: {ws}")
            print(execute_hyprctl("workspace", ws))
            return
        elif "search" in prompt or "find" in prompt:
            query = prompt.replace("search", "").replace("find", "").strip()
            print(f"🤖 Querying local vector store: {query}")
            print(search_code_qdrant(query))
            return

    # 3. Execute inside Bubblewrap Sandbox
    print("🔒 Executing code action inside rootless Bubblewrap sandbox...")
    success, output = run_sandboxed_code(input_text)
    status_emoji = "✓" if success else "✗"
    print(f"{status_emoji} Result:\n{output}")
    sys.exit(0 if success else 1)

if __name__ == "__main__":
    main()
