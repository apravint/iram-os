#!/usr/bin/env python3
"""
IRAM OS Waybar MCP Status Module (iram-mcp-status)
Outputs real-time JSON telemetry for Waybar status pill including total tools
and actively executing agentic tasks / in-flight tool calls.
"""
import json
import urllib.request
import subprocess
import os

def count_mcp_tools():
    for candidate in [
        os.path.expanduser("~/.local/bin/iram-mcp-server"),
        "/home/apravint/iram-os/bin/iram-mcp-server",
        "/usr/local/bin/iram-mcp-server",
        "/usr/share/iram/bin/iram-mcp-server"
    ]:
        if os.path.isfile(candidate):
            try:
                import re
                with open(candidate, "r", encoding="utf-8") as f:
                    tools = re.findall(r"@mcp\.tool\(\)\s*(?:async\s+)?def\s+([a-zA-Z0-9_]+)", f.read())
                    if tools:
                        return len(tools)
            except Exception:
                pass
    return 38

def get_active_tasks():
    tasks = []
    # 1. Ollama model inference
    try:
        req = urllib.request.Request("http://127.0.0.1:11434/api/ps", headers={"User-Agent": "Waybar"})
        with urllib.request.urlopen(req, timeout=0.25) as resp:
            data = json.loads(resp.read().decode())
            for m in data.get("models", []):
                tasks.append(f"LLM Inference ({m.get('name', 'Active')})")
    except Exception:
        pass

    # 2. Processes executing real agentic / multimedia workloads
    monitored = [
        ("iram-video", "Video Render Engine"),
        ("iram-audit", "Security Guard Scanner"),
        ("iram-voice", "VoiceStudio Synthesis"),
        ("iram-crawl", "Crawl4AI Web Scraper"),
        ("iram-qdrant", "Qdrant Vector Indexer"),
        ("iram-music", "Music Synth Engine"),
        ("wf-recorder", "Screen Recording (MP4)"),
        ("iram-agent-interactive", "Interactive Copilot"),
        ("agy", "Antigravity AI (Pair Programmer)")
    ]

    my_pid = os.getpid()
    for pattern, label in monitored:
        try:
            res = subprocess.run(["pgrep", "-f", pattern], capture_output=True, text=True)
            pids = [int(p) for p in res.stdout.strip().split() if p and int(p) != my_pid]
            if pids:
                tasks.append(label)
        except Exception:
            pass

    return tasks

def main():
    hub_url = "http://127.0.0.1:8990/api/status"
    mcp_active = False
    tools_count = count_mcp_tools()
    cpu = 0
    ram_gb = 0

    try:
        req = urllib.request.Request(hub_url, headers={"User-Agent": "Waybar-MCP"})
        with urllib.request.urlopen(req, timeout=0.8) as response:
            if response.status == 200:
                data = json.loads(response.read().decode())
                if data.get("ok"):
                    mcp_active = True
                    cpu = data.get("cpu_percent", 0)
                    ram_gb = data.get("memory", {}).get("used_gb", 0)
    except Exception:
        pass

    try:
        req_mcp = urllib.request.Request("http://127.0.0.1:8990/api/mcp", headers={"User-Agent": "Waybar-MCP"})
        with urllib.request.urlopen(req_mcp, timeout=0.5) as r:
            mcp_data = json.loads(r.read().decode())
            tools_list = mcp_data.get("tools", [])
            if tools_list:
                tools_count = len(tools_list)
    except Exception:
        pass

    # Check if iram-mcp-server process is running
    try:
        proc = subprocess.run(["pgrep", "-f", "iram-mcp-server"], stdout=subprocess.DEVNULL)
        if proc.returncode == 0:
            mcp_active = True
    except Exception:
        pass

    active_tasks = get_active_tasks()
    active_count = len(active_tasks)

    if mcp_active:
        if active_count > 0:
            status_text = f"🛡️ MCP [{tools_count} | ⚡ {active_count} active]"
            css_class = "busy"
            active_details = "\n".join([f"  ⚡ {t}" for t in active_tasks])
            active_info = f"• Actively Working: {active_count} In-Flight Task(s)\n{active_details}"
        else:
            status_text = f"🛡️ MCP [{tools_count} | idle]"
            css_class = "active"
            active_info = "• In-Flight: Standby (Zero Idle Compute)"

        out = {
            "text": status_text,
            "tooltip": (
                f"🛡️ IRAM Sovereign FastMCP Gateway\n"
                f"• Status: ACTIVE (Stdio + REST Port 8990)\n"
                f"• Total Tools: {tools_count} High-Performance Tools\n"
                f"{active_info}\n"
                f"• CPU Load: {cpu}%\n"
                f"• RAM Used: {ram_gb} GB\n"
                f"• PipeWire: Calibrated 48kHz Studio DSP\n\n"
                f"🖱️ Left-Click: Open Sovereign Command Hub\n"
                f"🖱️ Right-Click: Open System Resource Monitor"
            ),
            "class": css_class
        }
    else:
        out = {
            "text": "🛡️ MCP [IDLE]",
            "tooltip": "IRAM FastMCP Gateway Idle\nClick to launch Sovereign Command Hub",
            "class": "idle"
        }

    print(json.dumps(out))

if __name__ == "__main__":
    main()
