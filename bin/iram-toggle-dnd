#!/usr/bin/env bash
# ==============================================================================
# IRAM OS - Do Not Disturb (DND) / Notification Silencing Toggle
# Silences desktop notifications via SwayNC.
# Inspired by Omarchy 4.5
# https://github.com/apravint/iram-os
# ==============================================================================
set -euo pipefail

is_dnd() {
    [ "$(swaync-client --get-dnd 2>/dev/null)" = "true" ]
}

ACTION="${1:-toggle}"

case "$ACTION" in
    on|enable|silence)
        swaync-client --dnd-on >/dev/null 2>&1 || true
        notify-send -a "IRAM OS" "🔕 Do Not Disturb: ON" "Desktop notifications are silenced" -i "notifications-disabled" -t 2000
        echo "dnd: enabled"
        ;;
    off|disable|restore)
        swaync-client --dnd-off >/dev/null 2>&1 || true
        notify-send -a "IRAM OS" "🔔 Do Not Disturb: OFF" "Desktop notifications restored" -i "dialog-information" -t 2000
        echo "dnd: disabled"
        ;;
    status)
        if is_dnd; then
            echo "enabled"
        else
            echo "disabled"
        fi
        ;;
    toggle|*)
        if is_dnd; then
            swaync-client --dnd-off >/dev/null 2>&1 || true
            notify-send -a "IRAM OS" "🔔 Do Not Disturb: OFF" "Desktop notifications restored" -i "dialog-information" -t 2000
            echo "dnd: disabled"
        else
            swaync-client --dnd-on >/dev/null 2>&1 || true
            notify-send -a "IRAM OS" "🔕 Do Not Disturb: ON" "Desktop notifications are silenced" -i "notifications-disabled" -t 2000
            echo "dnd: enabled"
        fi
        ;;
esac
