#!/usr/bin/env python3
"""
IRAM OS - First-Boot Onboarding Guide & Welcome Wizard (iram-welcome)
Runs on first boot until ~/.config/iram-os/.welcomed exists.
Displays core keybindings cheat-sheet and quick action launchers for
iram ai-setup, iram doctor, and disk installation.
https://github.com/apravint/iram-os
"""

import sys
import os
import shutil
import subprocess

WELCOMED_FLAG = os.path.expanduser("~/.config/iram-os/.welcomed")
LEGACY_FLAG = os.path.expanduser("~/.local/state/iram/.onboarded")

SHORTCUTS = [
    ("Super + ` (Grave)", "AI Agent Floating Scratchpad (Google Antigravity)"),
    ("Super + Shift + Space", "AI Prompt Bar (injects Wayland clipboard)"),
    ("Super + Shift + V", "Screen Vision OCR & Code Bug Fixer"),
    ("Super + V", "Wayland Clipboard History Manager"),
    ("Super + Space", "Wofi Application Launcher"),
    ("Super + Return", "Terminal (Alacritty / Foot)"),
    ("Super + L", "Lock Screen (Dynamic Hyprlock)"),
    ("Super + Alt + T", "Sovereign 43-Theme Switcher"),
    ("Super + Escape", "Power & Session Logout Menu")
]

def mark_welcomed():
    os.makedirs(os.path.dirname(WELCOMED_FLAG), exist_ok=True)
    with open(WELCOMED_FLAG, "w") as f:
        f.write("1\n")
    os.makedirs(os.path.dirname(LEGACY_FLAG), exist_ok=True)
    with open(LEGACY_FLAG, "w") as f:
        f.write("1\n")

def run_in_terminal(cmd):
    terminal = shutil.which("alacritty") or shutil.which("foot")
    if terminal and "alacritty" in terminal:
        subprocess.Popen(["alacritty", "--class", "iram-agy-float", "--title", "IRAM Task", "-e", "bash", "-c", cmd])
    elif terminal:
        subprocess.Popen(["foot", "--app-id", "iram-agy-float", "--title", "IRAM Task", "bash", "-c", cmd])
    else:
        subprocess.Popen(["x-terminal-emulator", "-e", cmd])

def launch_gui():
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk, Gdk
    except Exception:
        return False

    CSS = b"""
    * { font-family: 'JetBrainsMono Nerd Font', 'JetBrains Mono', sans-serif; }
    window { background-color: #0f111a; }
    .header-title { font-size: 24px; font-weight: 800; color: #7aa2f7; margin-bottom: 2px; }
    .header-sub { font-size: 13px; color: #a9b1d6; margin-bottom: 12px; }
    .card { background-color: #1a1b26; border: 1px solid rgba(122, 162, 247, 0.3); padding: 12px; margin: 4px; }
    .shortcut-key { background-color: #24283b; color: #7dcfff; font-size: 12px; font-weight: 700; padding: 4px 10px; border: 1px solid #414868; }
    .shortcut-desc { font-size: 13px; color: #c0caf5; }
    .btn-action { background-color: #24283b; color: #c0caf5; font-weight: 700; font-size: 13px; border: 1px solid #7aa2f7; padding: 8px 16px; }
    .btn-action:hover { background-color: rgba(122, 162, 247, 0.25); color: #ffffff; }
    .btn-primary { background-color: #7aa2f7; color: #15161e; font-weight: 800; font-size: 14px; border: none; padding: 10px 24px; }
    .btn-primary:hover { background-color: #89b4fa; }
    """

    class WelcomeWindow(Gtk.Window):
        def __init__(self):
            super().__init__(title="Welcome to IRAM OS")
            self.set_default_size(780, 620)
            self.set_position(Gtk.WindowPosition.CENTER)

            main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            main_box.set_margin_top(20)
            main_box.set_margin_bottom(20)
            main_box.set_margin_start(24)
            main_box.set_margin_end(24)
            self.add(main_box)

            # Header
            title = Gtk.Label(label="⚡ Welcome to IRAM OS (v26.04.1)")
            title.get_style_context().add_class("header-title")
            title.set_xalign(0)
            main_box.pack_start(title, False, False, 0)

            sub = Gtk.Label(label="Autonomous Agentic Desktop • Hyprland • Waybar • Storytold Craft Suite")
            sub.get_style_context().add_class("header-sub")
            sub.set_xalign(0)
            main_box.pack_start(sub, False, False, 0)

            # Action Buttons Box
            btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            
            btn_ai = Gtk.Button(label="🧠 Setup Local AI (Ollama)")
            btn_ai.get_style_context().add_class("btn-action")
            btn_ai.connect("clicked", lambda w: run_in_terminal("iram ai-setup; echo 'Done. Press Enter...'; read"))
            btn_box.pack_start(btn_ai, True, True, 0)

            btn_doc = Gtk.Button(label="🩺 Run System Doctor")
            btn_doc.get_style_context().add_class("btn-action")
            btn_doc.connect("clicked", lambda w: run_in_terminal("iram doctor; echo 'Done. Press Enter...'; read"))
            btn_box.pack_start(btn_doc, True, True, 0)

            if shutil.which("iram-install-disk") and "boot=casper" in open("/proc/cmdline").read():
                btn_install = Gtk.Button(label="💿 Install to Disk")
                btn_install.get_style_context().add_class("btn-action")
                btn_install.connect("clicked", lambda w: run_in_terminal("sudo iram-install-disk; echo 'Done. Press Enter...'; read"))
                btn_box.pack_start(btn_install, True, True, 0)

            main_box.pack_start(btn_box, False, False, 4)

            # Shortcuts Scroll Area
            scroller = Gtk.ScrolledWindow()
            scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroller.set_min_content_height(340)

            shortcuts_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            shortcuts_box.get_style_context().add_class("card")

            lbl_sec = Gtk.Label(label="<b>Essential Keyboard Shortcuts:</b>", use_markup=True)
            lbl_sec.set_xalign(0)
            lbl_sec.set_margin_bottom(6)
            shortcuts_box.pack_start(lbl_sec, False, False, 0)

            grid = Gtk.Grid()
            grid.set_column_spacing(16)
            grid.set_row_spacing(8)

            for i, (key, desc) in enumerate(SHORTCUTS):
                k_lbl = Gtk.Label(label=key)
                k_lbl.get_style_context().add_class("shortcut-key")
                k_lbl.set_xalign(0)
                grid.attach(k_lbl, 0, i, 1, 1)

                d_lbl = Gtk.Label(label=desc)
                d_lbl.get_style_context().add_class("shortcut-desc")
                d_lbl.set_xalign(0)
                grid.attach(d_lbl, 1, i, 1, 1)

            shortcuts_box.pack_start(grid, True, True, 0)
            scroller.add(shortcuts_box)
            main_box.pack_start(scroller, True, True, 0)

            # Footer
            bottom_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            lbl_hint = Gtk.Label(label="Press <b>Super + K</b> anytime for the complete hotkeys sheet.", use_markup=True)
            lbl_hint.set_xalign(0)
            bottom_box.pack_start(lbl_hint, True, True, 0)

            btn_finish = Gtk.Button(label="Get Started 🚀")
            btn_finish.get_style_context().add_class("btn-primary")
            btn_finish.connect("clicked", self.on_finish)
            bottom_box.pack_start(btn_finish, False, False, 0)

            main_box.pack_start(bottom_box, False, False, 6)

        def on_finish(self, widget):
            mark_welcomed()
            self.destroy()

    css_provider = Gtk.CssProvider()
    css_provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(),
        css_provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    win = WelcomeWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
    return True

def launch_cli():
    BOLD = '\033[1m'
    GREEN = '\033[0;32m'
    BLUE = '\033[0;34m'
    YELLOW = '\033[1;33m'
    CYAN = '\033[0;36m'
    NC = '\033[0m'

    print(f"\n{BLUE}========================================================================{NC}")
    print(f"{BOLD}{CYAN}             WELCOME TO IRAM OS (v26.04.1){NC}")
    print(f"{BLUE}========================================================================{NC}\n")

    print(f"{BOLD}ESSENTIAL KEYBOARD SHORTCUTS:{NC}")
    for key, desc in SHORTCUTS:
        print(f"  {YELLOW}{key:<24}{NC} {desc}")

    print(f"\n{BOLD}QUICK SETUP ACTIONS:{NC}")
    print(f"  1) Run AI Accelerator Setup (iram ai-setup)")
    print(f"  2) Run System Health Doctor (iram doctor)")
    print(f"  3) Mark as Welcomed & Continue")
    print(f"  4) Exit\n")

    try:
        choice = input("Select an option [1-4] (default: 3): ").strip() or "3"
        if choice == "1":
            subprocess.run(["iram", "ai-setup"])
        elif choice == "2":
            subprocess.run(["iram", "doctor"])
        mark_welcomed()
        print(f"\n{GREEN}✓ Welcome setup completed!{NC}\n")
    except (KeyboardInterrupt, EOFError):
        print("")

def main():
    if "--force" not in sys.argv and os.path.exists(WELCOMED_FLAG):
        sys.exit(0)

    if not launch_gui():
        launch_cli()

if __name__ == "__main__":
    main()
