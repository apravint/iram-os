#!/usr/bin/env bash
# ==============================================================================
# IRAM OS - Boot & Mechanical Disk I/O Optimizer
# Diagnoses boot bottlenecks on rotational disks (HDDs) and configures
# systemd timer deferrals and I/O prioritization to prevent startup lag.
# ==============================================================================
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

echo -e "${BOLD}${BLUE}=== IRAM OS Boot & I/O Optimizer ===${NC}\n"

# 1. Detect Disk Type
ROOT_DEV=$(df / | tail -n 1 | awk '{print $1}' | sed 's/[0-9]*$//' | sed 's/\/dev\///')
ROTATIONAL="0"
if [ -f "/sys/block/${ROOT_DEV}/queue/rotational" ]; then
    ROTATIONAL=$(cat "/sys/block/${ROOT_DEV}/queue/rotational")
fi

echo -e "Root Device: ${BOLD}/dev/${ROOT_DEV}${NC}"
if [ "$ROTATIONAL" = "1" ]; then
    echo -e "Disk Type:   ${YELLOW}Mechanical Hard Disk Drive (Rotational HDD)${NC}"
    echo -e "Diagnosis:   High concurrent I/O at boot degrades responsiveness."
else
    echo -e "Disk Type:   ${GREEN}Solid State Drive (SSD / NVMe)${NC}"
fi

# 2. Display Systemd Blame Highlights
echo -e "\n${BOLD}Top Startup Bottlenecks (from systemd-analyze blame):${NC}"
systemd-analyze blame 2>/dev/null | head -n 6 || true

# 3. Optimization Prescription
echo -e "\n${BOLD}Recommended Optimizations:${NC}"
echo -e "  1. Defer plocate-updatedb.timer by 15 minutes after boot"
echo -e "  2. Defer apt-daily.timer & apt-daily-upgrade.timer by 20-30 minutes"
echo -e "  3. Defer fwupd-refresh.timer by 25 minutes"
echo -e "  4. Defer dpkg-db-backup.timer by 35 minutes"
echo -e "  5. Set background maintenance I/O scheduling to Idle class"

if [ "$(id -u)" -ne 0 ]; then
    echo -e "\n${YELLOW}To apply these optimizations with elevated privileges, run:${NC}"
    echo -e "  ${BOLD}sudo iram-optimize-boot --apply${NC}\n"
    exit 0
fi

if [ "${1:-}" != "--apply" ]; then
    echo -e "\nRun with ${BOLD}--apply${NC} to install systemd drop-in timer overrides."
    exit 0
fi

echo -e "\n${BLUE}Applying systemd timer overrides...${NC}"

# Override plocate-updatedb
mkdir -p /etc/systemd/system/plocate-updatedb.timer.d
cat << 'EOF' > /etc/systemd/system/plocate-updatedb.timer.d/override.conf
[Timer]
OnBootSec=15min
EOF

# Override apt-daily
mkdir -p /etc/systemd/system/apt-daily.timer.d
cat << 'EOF' > /etc/systemd/system/apt-daily.timer.d/override.conf
[Timer]
OnBootSec=20min
EOF

# Override apt-daily-upgrade
mkdir -p /etc/systemd/system/apt-daily-upgrade.timer.d
cat << 'EOF' > /etc/systemd/system/apt-daily-upgrade.timer.d/override.conf
[Timer]
OnBootSec=30min
EOF

# Override fwupd-refresh
mkdir -p /etc/systemd/system/fwupd-refresh.timer.d
cat << 'EOF' > /etc/systemd/system/fwupd-refresh.timer.d/override.conf
[Timer]
OnBootSec=25min
EOF

# Override dpkg-db-backup
mkdir -p /etc/systemd/system/dpkg-db-backup.timer.d
cat << 'EOF' > /etc/systemd/system/dpkg-db-backup.timer.d/override.conf
[Timer]
OnBootSec=35min
EOF

# Set background maintenance I/O priority to Idle
mkdir -p /etc/systemd/system/plocate-updatedb.service.d
cat << 'EOF' > /etc/systemd/system/plocate-updatedb.service.d/override.conf
[Service]
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
EOF

systemctl daemon-reload
echo -e "${GREEN}✔ Systemd boot timer deferrals installed successfully!${NC}"
echo -e "Mechanical HDD boot thrashing eliminated. Boot times will be reduced significantly."
