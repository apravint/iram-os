#!/usr/bin/env bash
# ==============================================================================
# IRAM OS Doctor & Diagnostic Utility (iram doctor)
# Verifies Wayland environment, XDG portals, Hyprland responsiveness,
# systemd user units, PipeWire audio, and AI agent / MCP stack.
# Prints an authoritative PASS/FAIL table.
# https://github.com/apravint/iram-os
# ==============================================================================
set -euo pipefail

BOLD='\033[1m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

declare -a CHECK_NAMES=()
declare -a CHECK_STATUSES=()
declare -a CHECK_DETAILS=()

add_result() {
    local name="$1"
    local status="$2" # PASS, FAIL, WARN
    local detail="$3"
    CHECK_NAMES+=("$name")
    CHECK_STATUSES+=("$status")
    CHECK_DETAILS+=("$detail")
}

echo -e "${BLUE}========================================================================${NC}"
echo -e "${BOLD}${CYAN}                   IRAM OS SYSTEM DOCTOR (v26.04.2)${NC}"
echo -e "${BLUE}========================================================================${NC}\n"

# 1. Wayland Session Variables
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    add_result "Wayland Display" "PASS" "Active ($WAYLAND_DISPLAY)"
else
    # Check if a display exists in /run/user/$UID
    wayland_socket=$(find "/run/user/$UID" -maxdepth 1 -name "wayland-*" 2>/dev/null | head -n 1 || true)
    if [ -n "$wayland_socket" ]; then
        add_result "Wayland Display" "WARN" "Found socket $(basename "$wayland_socket") but variable unset in subshell"
    else
        add_result "Wayland Display" "FAIL" "WAYLAND_DISPLAY not found"
    fi
fi

if [[ "${XDG_CURRENT_DESKTOP:-}" == *"Hyprland"* ]]; then
    add_result "Desktop Session" "PASS" "XDG_CURRENT_DESKTOP contains Hyprland"
else
    add_result "Desktop Session" "WARN" "Desktop: ${XDG_CURRENT_DESKTOP:-unset}"
fi

# 2. XDG Portals
if pgrep -f "xdg-desktop-portal-hyprland" >/dev/null 2>&1; then
    add_result "XDG Portal (Hyprland)" "PASS" "xdg-desktop-portal-hyprland running"
elif pgrep -f "xdg-desktop-portal-wlr" >/dev/null 2>&1 || dpkg -s xdg-desktop-portal-wlr >/dev/null 2>&1; then
    add_result "XDG Portal (Wayland/WLR)" "PASS" "xdg-desktop-portal-wlr active"
elif pgrep -f "xdg-desktop-portal" >/dev/null 2>&1; then
    add_result "XDG Portal" "PASS" "xdg-desktop-portal daemon running"
else
    add_result "XDG Portal" "WARN" "xdg-desktop-portal not running"
fi

if pgrep -f "xdg-desktop-portal-gtk" >/dev/null 2>&1 || dpkg -s xdg-desktop-portal-gtk >/dev/null 2>&1; then
    add_result "XDG Portal (GTK)" "PASS" "xdg-desktop-portal-gtk present"
else
    add_result "XDG Portal (GTK)" "WARN" "xdg-desktop-portal-gtk missing"
fi

# 3. Hyprctl Responsiveness
if command -v hyprctl >/dev/null 2>&1; then
    if hypr_ver=$(hyprctl version 2>/dev/null | grep -i "tag:" | head -n 1 | awk '{print $2}'); then
        add_result "Hyprland IPC" "PASS" "hyprctl responding (v${hypr_ver:-active})"
    else
        add_result "Hyprland IPC" "WARN" "hyprctl installed (not connected to live session)"
    fi
else
    add_result "Hyprland IPC" "FAIL" "hyprctl not installed"
fi

# 4. Systemd User Units
for unit in hyprland-session.target waybar.service swaybg.service swaync.service hypridle.service iram-cliphist.service iram-polkit-agent.service iram-watchdog.service; do
    if systemctl --user is-active --quiet "$unit" 2>/dev/null; then
        add_result "Service: $unit" "PASS" "active (running)"
    elif systemctl --user is-enabled --quiet "$unit" 2>/dev/null; then
        add_result "Service: $unit" "WARN" "enabled (currently inactive)"
    elif [ -f "$HOME/.config/systemd/user/$unit" ] || [ -f "/usr/share/iram/systemd/user/$unit" ]; then
        add_result "Service: $unit" "WARN" "unit file installed but not enabled"
    else
        # If waybar or swaybg are running directly as processes
        proc_name="${unit%.service}"
        if pgrep -x "$proc_name" >/dev/null 2>&1; then
            add_result "Service: $unit" "PASS" "running as direct background daemon"
        else
            add_result "Service: $unit" "FAIL" "unit or process inactive"
        fi
    fi
done

# 5. PipeWire Audio Sinks
if command -v pactl >/dev/null 2>&1; then
    sinks_count=$(pactl list sinks short 2>/dev/null | wc -l || echo "0")
    if [ "$sinks_count" -gt 0 ]; then
        default_sink=$(pactl get-default-sink 2>/dev/null || echo "default")
        add_result "PipeWire Audio Sinks" "PASS" "$sinks_count sink(s) active ($default_sink)"
    else
        add_result "PipeWire Audio Sinks" "WARN" "PipeWire active but no sinks enumerated"
    fi
else
    add_result "PipeWire Audio Sinks" "FAIL" "pactl / pulseaudio-utils not found"
fi

# 6. AI Agent Stack (agy)
if command -v agy >/dev/null 2>&1; then
    add_result "Antigravity CLI (agy)" "PASS" "Installed and executable"
else
    add_result "Antigravity CLI (agy)" "WARN" "agy not found in PATH (~/.gemini/antigravity-cli)"
fi

# 7. Local LLM Engine (ollama)
if command -v ollama >/dev/null 2>&1; then
    if curl -s --max-time 1 "http://127.0.0.1:11434/api/tags" >/dev/null 2>&1; then
        model_count=$(curl -s "http://127.0.0.1:11434/api/tags" | jq '.models | length' 2>/dev/null || echo "0")
        add_result "Ollama LLM Engine" "PASS" "daemon online ($model_count model(s) available)"
    else
        add_result "Ollama LLM Engine" "WARN" "installed but daemon inactive (start via: ollama serve)"
    fi
else
    add_result "Ollama LLM Engine" "WARN" "ollama not installed (run 'iram ai-setup')"
fi

# 8. IRAM MCP Server
if [ -x "$HOME/.local/bin/iram-os-mcp" ] || [ -x "/usr/local/bin/iram-os-mcp" ] || [ -f "$HOME/iram-os/mcp/iram-os-mcp" ]; then
    add_result "IRAM OS MCP Server" "PASS" "iram-os-mcp stdio server ready"
elif [ -x "$HOME/.local/bin/iram-mcp-server" ] || [ -x "/usr/local/bin/iram-mcp-server" ]; then
    add_result "IRAM OS MCP Server" "PASS" "iram-mcp-server ready"
else
    add_result "IRAM OS MCP Server" "FAIL" "mcp server script missing"
fi

# 9. Print PASS/FAIL Table
printf "${BOLD}%-26s | %-8s | %-38s${NC}\n" "SUBSYSTEM COMPONENT" "STATUS" "DETAILS"
echo "---------------------------+----------+---------------------------------------"

total_pass=0
total_warn=0
total_fail=0

for i in "${!CHECK_NAMES[@]}"; do
    name="${CHECK_NAMES[$i]}"
    status="${CHECK_STATUSES[$i]}"
    detail="${CHECK_DETAILS[$i]}"

    case "$status" in
        PASS)
            status_colored="${GREEN}PASS${NC}    "
            total_pass=$((total_pass + 1))
            ;;
        WARN)
            status_colored="${YELLOW}WARN${NC}    "
            total_warn=$((total_warn + 1))
            ;;
        FAIL)
            status_colored="${RED}FAIL${NC}    "
            total_fail=$((total_fail + 1))
            ;;
    esac

    printf "%-26s | %b | %-38s\n" "$name" "$status_colored" "$detail"
done

echo "---------------------------+----------+---------------------------------------"
echo -e "\n${BOLD}SCORECARD:${NC} ${GREEN}${total_pass} PASS${NC}  |  ${YELLOW}${total_warn} WARN${NC}  |  ${RED}${total_fail} FAIL${NC}\n"

if [ "$total_fail" -eq 0 ]; then
    echo -e "${GREEN}✓ All core IRAM OS subsystems and desktop dependencies are verified!${NC}\n"
    exit 0
else
    echo -e "${RED}✗ System has $total_fail failed component(s). Review details above.${NC}\n"
    exit 1
fi
