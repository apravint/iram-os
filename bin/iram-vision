#!/usr/bin/env python3
"""
Iram Visual AI Analyst & OCR Extractor (iram-vision)
Captures screen regions and uses Multimodal Vision AI / Tesseract OCR / Qwen
to analyze code errors, tables, and UI layouts, or extract text directly to clipboard (--ocr).
https://github.com/apravint/iram-os
"""

import sys
import os
import subprocess
import json
import base64
import urllib.request

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    from iram_ai_core import (
        is_gemini_healthy,
        get_gemini_api_key,
        mark_gemini_failed,
        query_llm
    )
except ImportError:
    from iram_os.bin.iram_ai_core import (
        is_gemini_healthy, get_gemini_api_key, mark_gemini_failed, query_llm
    )

IMG_PATH = "/tmp/iram_vision.png"


def capture_region():
    try:
        subprocess.run(f"grim -g \"$(slurp)\" {IMG_PATH}", shell=True, check=True)
        return True
    except Exception:
        return False


def get_wofi_prompt():
    try:
        cmd = ["wofi", "--dmenu", "--prompt", "👁️ Vision AI Query (e.g., Explain error, extract table)...", "--width", "650", "--height", "150"]
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)
        out, _ = proc.communicate()
        prompt = out.strip()
        return prompt if prompt else "Analyze and explain what is visible in this image in detail."
    except Exception:
        return "Analyze and explain what is visible in this image in detail."


def run_tesseract_ocr(img_path):
    """Instant local OCR fallback using Tesseract."""
    try:
        res = subprocess.run(["tesseract", img_path, "stdout"], capture_output=True, text=True, timeout=5)
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()
    except Exception:
        pass
    return ""


def analyze_image_gemini(img_path, prompt):
    if not is_gemini_healthy() or not os.path.exists(img_path):
        return ""
    api_key = get_gemini_api_key()
    if not api_key:
        return ""
    try:
        with open(img_path, "rb") as f:
            img_b64 = base64.b64encode(f.read()).decode("utf-8")
        model = os.environ.get("GEMINI_VISION_MODEL", "gemini-2.5-flash")
        url = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent"
        payload = {
            "contents": [{
                "parts": [
                    {"text": prompt},
                    {"inlineData": {"mimeType": "image/png", "data": img_b64}}
                ]
            }]
        }
        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode("utf-8"),
            headers={"Content-Type": "application/json", "x-goog-api-key": api_key}
        )
        with urllib.request.urlopen(req, timeout=3.0) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return data["candidates"][0]["content"]["parts"][0]["text"].strip()
    except Exception as e:
        mark_gemini_failed(str(e))
        return ""


def analyze_image_ollama(img_path, prompt):
    if not os.path.exists(img_path):
        return ""

    # Check if an Ollama vision model exists
    vision_model = os.environ.get("OLLAMA_VISION_MODEL", "")
    if not vision_model:
        try:
            req = urllib.request.Request("http://localhost:11434/api/tags")
            with urllib.request.urlopen(req, timeout=0.5) as r:
                tags = json.loads(r.read())
                models = [m.get("name", "") for m in tags.get("models", [])]
                for m in models:
                    if any(v in m.lower() for v in ["vl", "vision", "llava", "moondream", "minicpm"]):
                        vision_model = m
                        break
        except Exception:
            pass

    if not vision_model:
        return ""

    with open(img_path, "rb") as f:
        img_b64 = base64.b64encode(f.read()).decode("utf-8")

    url = "http://localhost:11434/api/generate"
    payload = {
        "model": vision_model,
        "prompt": prompt,
        "images": [img_b64],
        "stream": False
    }

    try:
        req = urllib.request.Request(url, data=json.dumps(payload).encode("utf-8"), headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=20) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return data.get("response", "").strip()
    except Exception:
        return ""


def main():
    is_ocr = "--ocr" in sys.argv

    if is_ocr:
        subprocess.run("notify-send -a 'Iram Vision' '📝 Select Text to Extract' 'Drag a box over text, code, or terminal.' -t 2000", shell=True)
    else:
        subprocess.run("notify-send -a 'Iram Vision' '👁️ Select Screen Region' 'Drag a box over the region you want to analyze.' -t 2000", shell=True)

    if not capture_region():
        sys.exit(0)

    analysis = ""
    provider = "Local Tesseract OCR"

    if is_ocr:
        # For pure OCR: Tesseract is instant (0.1s) and 100% offline
        analysis = run_tesseract_ocr(IMG_PATH)
        if not analysis:
            # Fallback to Gemini if tesseract failed
            prompt = "Extract all text from this image accurately. Return only the extracted text."
            analysis = analyze_image_gemini(IMG_PATH, prompt)
            provider = "Gemini OCR"
    else:
        prompt = get_wofi_prompt()
        subprocess.run("notify-send -a 'Iram Vision' '🤖 Analyzing Image...' 'Processing visual model analysis...' -t 2000", shell=True)

        # 1. Try Gemini Vision if healthy
        analysis = analyze_image_gemini(IMG_PATH, prompt)
        provider = "Gemini Vision"

        # 2. Try Ollama Vision if available
        if not analysis:
            analysis = analyze_image_ollama(IMG_PATH, prompt)
            provider = "Ollama Vision"

        # 3. Hybrid Fallback: Tesseract OCR + Local Qwen Reasoning
        if not analysis:
            ocr_text = run_tesseract_ocr(IMG_PATH)
            if ocr_text:
                hybrid_prompt = f"The user asked: '{prompt}' about a screen region containing this text:\n\n```\n{ocr_text}\n```\nProvide a clear and helpful explanation:"
                reasoning, p_name = query_llm(hybrid_prompt)
                if reasoning:
                    analysis = f"{reasoning}\n\n[Extracted Screen Text]:\n{ocr_text[:300]}"
                    provider = f"Hybrid ({p_name} + OCR)"

    if not analysis:
        subprocess.run('notify-send -a "Iram Vision AI" "⚠️ Extraction Failed" "No text or visual content could be analyzed."', shell=True)
        sys.exit(1)

    # Copy analysis result to clipboard
    subprocess.run(["wl-copy"], input=analysis.encode("utf-8"))

    # Display desktop alert summary
    short_summary = analysis[:250] + ("..." if len(analysis) > 250 else "")
    title = f"✨ Text Copied! [{provider}]" if is_ocr else f"👁️ Vision Analysis [{provider}]"
    subprocess.run(["notify-send", "-a", "Iram Vision AI", title, short_summary])


if __name__ == "__main__":
    main()
