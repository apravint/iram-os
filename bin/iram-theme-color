#!/usr/bin/env python3
"""
IRAM OS Theme Color Resolver (iram-theme-color)
Single reader of colors.toml for shell consumers. Adds the derived names that
templates expect (legacy colorN, selection_*, purple, theme_type) to what a theme
defines, so a sparse palette still renders every template.

  iram-theme-color --file colors.toml --all     key<TAB>value, one per line
  iram-theme-color --file colors.toml KEY       one value; exit 1 if unknown
https://github.com/apravint/iram-os
"""

import argparse
import sys

try:
    import tomllib
except ModuleNotFoundError:
    tomllib = None

ANSI_ORDER = ("black", "red", "green", "yellow", "blue", "magenta", "cyan", "white")


def parse_flat_toml(text):
    """Fallback for Python < 3.11: colors.toml only holds flat key = "value" pairs."""
    values = {}
    for line in text.splitlines():
        line = line.split("#", 1)[0] if '"' not in line else line
        key, sep, value = line.partition("=")
        if sep:
            values[key.strip()] = value.strip().strip('"').strip("'")
    return values


def load(path):
    with open(path, "rb") as f:
        raw = f.read()
    if tomllib:
        data = tomllib.loads(raw.decode("utf-8"))
    else:
        data = parse_flat_toml(raw.decode("utf-8"))
    return {k: str(v) for k, v in data.items() if isinstance(v, (str, int, float))}


def resolve(colors):
    resolved = dict(colors)
    background = resolved.get("background", "#000000")
    foreground = resolved.get("foreground", "#ffffff")

    def default(key, *fallbacks):
        if key not in resolved:
            for candidate in fallbacks:
                if candidate in resolved:
                    resolved[key] = resolved[candidate]
                    return
                if candidate.startswith("#"):
                    resolved[key] = candidate
                    return

    # A palette may define only colorN; give the named keys those values first.
    for index, name in enumerate(ANSI_ORDER):
        default(name, f"color{index}")
        default(f"bright_{name}", f"color{index + 8}")

    default("accent", "blue", foreground)
    default("muted", "dark_foreground", "bright_black", foreground)
    default("selection", "selection_background", "lighter_background", background)
    default("selection_background", "selection")
    default("selection_foreground", foreground)
    default("cursor", foreground)
    default("purple", "magenta", "accent")
    default("orange", "yellow", "accent")
    default("brown", "orange", "red", "accent")
    default("black", "dark_background", background)
    default("white", "light_foreground", foreground)
    for key in ("dark_background", "darker_background", "lighter_background"):
        default(key, background)
    for key in ("dark_foreground", "light_foreground", "bright_foreground"):
        default(key, foreground)

    for index, name in enumerate(ANSI_ORDER):
        default(f"bright_{name}", name)
        default(f"color{index}", name, foreground)
        default(f"color{index + 8}", f"bright_{name}", foreground)

    resolved.setdefault("mode", colors.get("theme_type", "dark"))
    resolved.setdefault("theme_type", resolved["mode"])
    return resolved


def main():
    parser = argparse.ArgumentParser(description="Resolve colors from a theme's colors.toml")
    parser.add_argument("--file", required=True)
    parser.add_argument("--all", action="store_true")
    parser.add_argument("key", nargs="?")
    args = parser.parse_args()

    try:
        colors = resolve(load(args.file))
    except (OSError, ValueError) as e:
        print(f"iram-theme-color: {args.file}: {e}", file=sys.stderr)
        return 1

    if args.all:
        for key in sorted(colors):
            print(f"{key}\t{colors[key]}")
        return 0
    if args.key in colors:
        print(colors[args.key])
        return 0
    return 1


if __name__ == "__main__":
    sys.exit(main())
