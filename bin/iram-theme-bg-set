#!/usr/bin/env bash
# Iram Background Setter for IRAM OS / Wayland
set -euo pipefail

if [[ -z ${1:-} ]]; then
  echo "Usage: iram-theme-bg-set <path-to-media>" >&2
  exit 1
fi

BACKGROUND="$(realpath "$1")"
CURRENT_BACKGROUND_LINK="$HOME/.local/state/iram/current/background"

if [[ ! -f $BACKGROUND ]]; then
  echo "File does not exist: $BACKGROUND" >&2
  exit 1
fi

mkdir -p "$HOME/.local/state/iram/current"
ln -nsf "$BACKGROUND" "$CURRENT_BACKGROUND_LINK"

# If swaybg is active or WAYLAND_DISPLAY is set, update wallpaper immediately
if pgrep -x swaybg >/dev/null 2>&1 || [[ -n ${WAYLAND_DISPLAY:-} ]]; then
  if ! systemctl --user restart swaybg.service 2>/dev/null; then
    pkill swaybg 2>/dev/null || true
    nohup swaybg -i "$BACKGROUND" -m fill >/dev/null 2>&1 &
  fi
fi

# Also ping iram-shell if present
if command -v iram-shell >/dev/null 2>&1; then
  iram-shell -q background set "$BACKGROUND" 2>/dev/null || true
fi

echo "Background updated: $BACKGROUND"
