#!/usr/bin/env bash
# Iram Clipboard History Menu
set -euo pipefail

if ! command -v cliphist >/dev/null 2>&1 || ! command -v wofi >/dev/null 2>&1; then
    notify-send -u critical "Clipboard Menu" "cliphist or wofi is not installed." 2>/dev/null || echo "cliphist or wofi not installed" >&2
    exit 1
fi

SELECTED=$(cliphist list | wofi --dmenu --prompt "Clipboard History:" --width 650 --height 450 || true)

if [[ -n "$SELECTED" ]]; then
    echo "$SELECTED" | cliphist decode | wl-copy
    notify-send -u low "Clipboard" "Copied item to clipboard" 2>/dev/null || true
fi
