#!/usr/bin/env python3
"""
Iram AI Smart Clipboard & Code Assistant (iram-ai-clipboard)
Provides 1-click AI transformations on copied text: Summarize, Refactor Code, Translate, Extract Actions.
Fast, local-first inference powered by Ollama and Gemini with context condensing and Hindsight.
https://github.com/apravint/iram-os
"""

import sys
import os
import subprocess

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    from iram_ai_core import (
        query_llm,
        condense_context,
        hindsight_retain
    )
except ImportError:
    from iram_os.bin.iram_ai_core import (
        query_llm, condense_context, hindsight_retain
    )


def get_clipboard_text():
    try:
        return subprocess.check_output(["wl-paste"], text=True).strip()
    except Exception:
        return ""


def show_wofi_actions(clip_text):
    if not clip_text:
        subprocess.run(['notify-send', '-a', 'Iram AI Clipboard', 'Clipboard Empty', 'Please copy text first!'])
        sys.exit(0)

    short_clip = (clip_text[:50] + "...") if len(clip_text) > 50 else clip_text
    actions = [
        f"🪄 Summarize Selection ({short_clip})",
        f"💻 Refactor & Fix Code Snippet",
        f"🌐 Translate to English / Tamil",
        f"📌 Extract Key Action Items"
    ]
    wofi_input = "\n".join(actions)

    cmd = ["wofi", "--dmenu", "--prompt", "🪄 AI Clipboard Action...", "--width", "700", "--height", "220"]
    try:
        proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
        selected_action, _ = proc.communicate(input=wofi_input)
        selected_action = selected_action.strip()

        if not selected_action:
            sys.exit(0)

        subprocess.run(['notify-send', '-a', 'Iram AI Clipboard', '🤖 Processing AI Action...', selected_action], check=False)

        # Condense large clipboard text (e.g. huge logs or stack traces)
        processed_content = clip_text
        if len(clip_text.splitlines()) > 35:
            processed_content = condense_context(clip_text, query="error exception warning func def", max_lines=35)

        system_instruction = "You are an intelligent desktop assistant. Format the response clearly and concisely."
        if "Refactor" in selected_action:
            system_instruction = "You are an expert software engineer. Refactor this code, fix bugs, optimize performance, and output clean code."
            task_prompt = f"Refactor and optimize this code:\n\n```\n{processed_content}\n```"
        elif "Translate" in selected_action:
            system_instruction = "You are a professional translator fluent in English and Tamil."
            task_prompt = f"Translate the following text accurately into Tamil and clean English:\n\n{processed_content}"
        elif "Action Items" in selected_action:
            system_instruction = "You are an executive assistant. Extract actionable items."
            task_prompt = f"Extract bullet point key action items and takeaways from this text:\n\n{processed_content}"
        else:
            task_prompt = f"Summarize this text concisely into 3 punchy bullet points:\n\n{processed_content}"

        result, provider = query_llm(task_prompt, system_prompt=system_instruction, num_predict=512)

        if not result:
            subprocess.run(['notify-send', '-a', 'Iram AI Clipboard', '⚠️ AI Error', 'Could not process clipboard text.'])
            sys.exit(1)

        # Copy back to clipboard
        subprocess.run(["wl-copy"], input=result.encode("utf-8"))

        # Save to Hindsight memory if action items or summary
        if "Action Items" in selected_action or "Summarize" in selected_action:
            hindsight_retain(f"Clipboard action '{selected_action[:30]}': {result[:180]}", category="clipboard", importance=3)

        summary = result[:200] + ("..." if len(result) > 200 else "")
        subprocess.run(['notify-send', '-a', 'Iram AI Clipboard', f'✅ Result Copied! [{provider}]', summary])
    except Exception as e:
        print(f"Error: {e}")


if __name__ == "__main__":
    clip = get_clipboard_text()
    show_wofi_actions(clip)
