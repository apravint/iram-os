#!/usr/bin/env python3
"""
IRAM OS Waybar Unified AI & MCP Telemetry Provider (iram-waybar-agent)
Unified status pill for Nexus Copilot Chat, FastMCP 38 Tools, and Active In-Flight Workloads.
https://github.com/apravint/iram-os
"""
import os
import sys
import json
import time
import subprocess
import urllib.request

STATUS_FILE = os.path.expanduser("~/.local/state/iram/agent_status.json")
TRACES_FILE = os.path.expanduser("~/.local/state/iram/agent_traces.jsonl")
GRAPH_FILE = os.path.expanduser("~/.local/state/iram/knowledge_graph.json")

def get_api_key():
    key = os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY")
    if key:
        return key
    env_file = os.path.expanduser("~/.config/environment.d/20-gemini.conf")
    if os.path.exists(env_file):
        try:
            with open(env_file, "r") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("GEMINI_API_KEY=") or line.startswith("GOOGLE_API_KEY="):
                        val = line.split("=", 1)[1].strip().strip('"').strip("'")
                        if val:
                            return val
        except Exception:
            pass
    return ""

def count_mcp_tools():
    for candidate in [
        os.path.expanduser("~/.local/bin/iram-mcp-server"),
        os.path.expanduser("~/iram-os/bin/iram-mcp-server"),
        "/usr/local/bin/iram-mcp-server",
        "/usr/share/iram/bin/iram-mcp-server"
    ]:
        if os.path.isfile(candidate):
            try:
                import re
                with open(candidate, "r", encoding="utf-8") as f:
                    tools = re.findall(r"@mcp\.tool\(\)\s*(?:async\s+)?def\s+([a-zA-Z0-9_]+)", f.read())
                    if tools:
                        return len(tools)
            except Exception:
                pass
    return 38

def get_active_tasks():
    tasks = []
    # 1. Ollama model inference
    try:
        req = urllib.request.Request("http://127.0.0.1:11434/api/ps", headers={"User-Agent": "Waybar"})
        with urllib.request.urlopen(req, timeout=0.2) as resp:
            data = json.loads(resp.read().decode())
            for m in data.get("models", []):
                tasks.append(f"LLM: {m.get('name', 'Active')}")
    except Exception:
        pass

    # 2. Monitored real-time pipelines
    monitored = [
        ("iram-video", "Video Render"),
        ("iram-audit", "Security Audit"),
        ("iram-voice", "Voice TTS"),
        ("wf-recorder", "Screen Record"),
        ("iram-agent-interactive", "Copilot Chat"),
        ("agy", "Antigravity AI")
    ]
    my_pid = os.getpid()
    for pattern, label in monitored:
        try:
            res = subprocess.run(["pgrep", "-f", pattern], capture_output=True, text=True)
            pids = [int(p) for p in res.stdout.strip().split() if p and int(p) != my_pid]
            if pids:
                tasks.append(label)
        except Exception:
            pass
    return tasks

def main():
    api_key = get_api_key()
    tools_count = count_mcp_tools()
    active_tasks = get_active_tasks()
    active_count = len(active_tasks)

    agent_state = "idle"
    details = ""

    if os.path.exists(STATUS_FILE):
        try:
            with open(STATUS_FILE, "r") as f:
                st = json.load(f)
                if time.time() - st.get("timestamp", 0) < 30:
                    agent_state = st.get("state", "idle")
                    details = st.get("details", "")
        except Exception:
            pass

    # Dynamic compact label & styling
    if agent_state == "thinking":
        icon = "󰑮"
        label = f"Nexus [Thinking...]"
        css_class = "thinking"
    elif agent_state == "executing" or active_count > 0:
        icon = "✨"
        label = f"Nexus [{tools_count} | ⚡{active_count}]" if active_count > 0 else f"Nexus [{tools_count}]"
        css_class = "executing"
    elif agent_state == "error":
        icon = "󰅚"
        label = f"Nexus [Error]"
        css_class = "error"
    else:
        icon = "✨" if api_key else "󱙺"
        label = f"Nexus [{tools_count}]"
        css_class = "idle"

    text = f"{icon} {label}"

    # Active workloads summary for tooltip
    if active_tasks:
        active_summary = "• In-Flight Workloads:\n" + "\n".join([f"  ⚡ {t}" for t in active_tasks]) + "\n"
    else:
        active_summary = "• In-Flight Workloads: Standby (Zero Idle Compute)\n"

    tooltip = (
        f"🤖 IRAM OS Sovereign AI & MCP Gateway\n"
        f"• Status: {agent_state.upper()} {f'({details})' if details else ''}\n"
        f"• FastMCP Gateway: {tools_count} Registered Tools (Port 8990/8991)\n"
        f"{active_summary}"
        f"• Model: Gemini 3.5 Flash / Local Ollama\n\n"
        f"🖱️ Left-Click: Open Nexus Copilot Chat (Super+Shift+A)\n"
        f"🖱️ Right-Click: Open Sovereign Command Hub (:8990)\n"
        f"🖱️ Middle-Click: AI Model Manager GUI"
    )

    print(json.dumps({"text": text, "tooltip": tooltip, "class": css_class}))

if __name__ == "__main__":
    main()
