def web_search(query: str, max_results: int = 3) -> str:
    """Performs live web search without requiring external API keys."""
    try:
        from ddgs import DDGS
        with DDGS() as ddgs:
            results = list(ddgs.text(query, max_results=max_results))
            if not results:
                return "No relevant web results found."
            formatted = []
            for r in results:
                title = r.get("title", "Untitled")
                body = r.get("body", "")
                href = r.get("href", "")
                formatted.append(f"• **{title}**\n  {body}\n  Link: {href}")
            return "\n\n".join(formatted)
    except Exception as e:
        return f"Web search could not be completed: {e}"


def run_tool_command(cmd: str) -> str:
    """Safely executes a tool command on the local machine and captures stdout/stderr."""
    if not is_safe_command(cmd):
        return "Blocked: Execution of potentially destructive system command prevented by IRAM Safety Guardrails."

    try:
        proc = subprocess.run(
            cmd,
            shell=True,
            capture_output=True,
            text=True,
            timeout=35
        )
        out = proc.stdout.strip() if proc.stdout else proc.stderr.strip()
        return out if out else "(Command executed with no output)"
    except subprocess.TimeoutExpired:
        return f"Tool execution timed out after 35s for command: `{cmd}`"
    except Exception as e:
        return f"Tool execution error: {str(e)}"


def parse_tool_invocation(text: str):
    """Detects if model response contains a tool call like [TOOL: <command>]."""
    # 1. Standard format: [TOOL: command]
    m = re.search(r'\[TOOL:\s*(.+?)\]', text, re.IGNORECASE)
    if m:
        return m.group(1).strip()
    # 2. Alternative format: [EXEC: command]
    m = re.search(r'\[EXEC:\s*(.+?)\]', text, re.IGNORECASE)
    if m:
        return m.group(1).strip()
    # 3. Direct bracket command format: [iram network] or [df -h]
    m = re.search(r'\[\s*(iram\s+[a-z0-9_\-]+|df\s+-[a-zA-Z0-9]+|free\s+-[a-zA-Z0-9]+|hyprctl\s+dispatch\s+[^\n\]]+)\s*\]', text)
    if m:
        return m.group(1).strip()
    return None


def execute_agentic_turn(user_input: str, conversation_turns: list):
    """
    Executes an autonomous ReAct loop:
    1. Sends user input to LLM with tool instructions.
    2. If LLM calls [TOOL: <command>], executes it on the computer.
    3. Feeds real tool output back to the LLM to synthesize the final natural language answer.
    """
    current_prompt = user_input
    MAX_TOOL_STEPS = 2

    for step in range(MAX_TOOL_STEPS):
        # Format conversation history
        history_text = "\n".join([f"{t['role'].upper()}: {t['content']}" for t in conversation_turns[-4:]])
        full_query = f"{history_text}\nUSER: {current_prompt}\nASSISTANT:"

        # Query model (Ollama or Gemini)
        res, provider = query_llm(full_query, system_prompt=SYSTEM_PROMPT, num_predict=256)
        res = res.strip() if res else ""

        # Check if the model invoked a tool
        tool_cmd = parse_tool_invocation(res)

        if not tool_cmd:
            # Final natural language answer reached
            print(f"\n{CYAN}{BOLD}🤖 Sidecar ► {NC}", end="")
            print(res)
            conversation_turns.append({"role": "user", "content": user_input})
            conversation_turns.append({"role": "assistant", "content": res})
            print()
            return

        # Model called a tool! Execute it on the computer
        print(f"\n{CYAN}⚡ Autonomous Tool Call: `{tool_cmd}`...{NC}")
        tool_output = run_tool_command(tool_cmd)

        # Print the live tool output directly so the user gets the rich visual UI immediately
        print(f"\n{tool_output}\n")

        # Synthesize follow-up prompt with tool output for final natural language summary
        truncated_out = tool_output[:1200] + ("..." if len(tool_output) > 1200 else "")
        current_prompt = (
            f"I ran `{tool_cmd}` on your computer. Here is the actual system output:\n"
            f"```\n{truncated_out}\n```\n"
            f"Now provide a concise, friendly 1-2 sentence response summarizing the key takeaway for the user."
        )

    # Print final response after tool execution
    final_res, _ = query_llm(current_prompt, system_prompt="You are the IRAM OS Assistant. Summarize the tool findings concisely in 1-2 friendly sentences.", num_predict=128)
    if final_res:
        print(f"{CYAN}{BOLD}🤖 Sidecar ► {NC}{final_res.strip()}\n")
        conversation_turns.append({"role": "user", "content": user_input})
        conversation_turns.append({"role": "assistant", "content": final_res.strip()})


def handle_slash_command(user_input: str) -> bool:
    """Handles direct slash shortcuts (/net, /quant, /info, /theme, /tools, etc.)"""
    parts = user_input.split(maxsplit=1)
    cmd = parts[0].lower()
    arg = parts[1].strip() if len(parts) > 1 else ""

    if cmd in ["/net", "/wifi", "/network"]:
        sub = arg if arg else "scan"
        subprocess.run(f"iram network {sub}", shell=True)
        return True

    elif cmd in ["/quant", "/stocks", "/screener"]:
        sub = arg if arg else "all"
        subprocess.run(f"iram quant {sub}", shell=True)
        return True

    elif cmd in ["/info", "/status"]:
        subprocess.run("iram info", shell=True)
        return True

    elif cmd in ["/theme", "/themes"]:
        if arg:
            subprocess.run(f"iram theme set '{arg}'", shell=True)
        else:
            subprocess.run("iram theme list", shell=True)
        return True

    elif cmd in ["/tools", "/commands"]:
        subprocess.run("iram commands", shell=True)
        return True

    elif cmd in ["/exec", "/sh", "/run"]:
        if arg:
            print(f"\n{YELLOW}⚡ Running: `{arg}`{NC}")
            subprocess.run(arg, shell=True)
            print()
        else:
            print("Usage: /exec <bash command>")
        return True

    elif cmd in ["/clear", "/cls"]:
        os.system("clear")
        print_header()
        return True

    elif cmd in ["/help", "/?"]:
        show_help_menu()
        return True

    return False


def main():
    print_header()
    conversation_turns = []

    while True:
        try:
            user_input = input(f"{GREEN}{BOLD}󱙺 User ► {NC}").strip()
            if not user_input:
                continue
            if user_input.lower() in ["exit", "quit", "q"]:
                print(f"\n{CYAN}Sidecar session ended. Have a productive day!{NC}")
                break

            # 1. Direct Slash Commands (Convenience shortcuts)
            if user_input.startswith("/"):
                if handle_slash_command(user_input):
                    continue

            # 2. Check Model Switch
            if user_input.startswith("/model"):
                parts = user_input.split(maxsplit=1)
                if len(parts) > 1:
                    new_model = parts[1].strip()
                    os.environ["OLLAMA_MODEL"] = new_model
                    print(f"{GREEN}✓ Switched active local model to: {new_model}{NC}\n")
                else:
                    print(f"{CYAN}Active Gemini Model: {get_gemini_model()}{NC}")
                    print(f"{CYAN}Active Ollama Model: {get_ollama_model()}{NC}\n")
                continue

            # 3. Autonomous Natural Language Computer-Use Loop
            execute_agentic_turn(user_input, conversation_turns)

        except (KeyboardInterrupt, EOFError):
            print(f"\n\n{CYAN}Agent Sidecar closed.{NC}")
            break


if __name__ == "__main__":
    main()
