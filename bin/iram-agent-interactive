        engine_str = f"{YELLOW}🖥️ Local Ollama ({get_ollama_model()}){NC} {GREEN}[Sovereign · 0ms Latency]{NC}"

    theme_name = "Tokyo Storm"
    theme_file = os.path.expanduser("~/.local/state/iram/current/theme.name")
    if os.path.exists(theme_file):
        try:
            theme_name = open(theme_file).read().strip()
        except Exception:
            pass

    print(f"{BLUE}╔══════════════════════════════════════════════════════════════════════════╗{NC}")
    print(f"{BLUE}║{GREEN}{BOLD}                     🤖 IRAM AGENTIC OS SIDECAR CHAT                      {BLUE}║{NC}")
    print(f"{BLUE}╠══════════════════════════════════════════════════════════════════════════╣{NC}")
    print(f"{BLUE}║{NC}  ► Engine: {engine_str:<70}{BLUE}║{NC}")
    print(f"{BLUE}║{NC}  ► Theme:  {MAGENTA}{theme_name:<20}{NC} | Compositor: {CYAN}Hyprland 0.56.2{NC}            {BLUE}║{NC}")
    print(f"{BLUE}║{NC}  ► Power:  {YELLOW}Autonomous Tool Calling Enabled • Natural Language Computer-Use{NC} {BLUE}║{NC}")
    print(f"{BLUE}║{NC}  ► Commands: {YELLOW}/net{NC} • {YELLOW}/quant{NC} • {YELLOW}/info{NC} • {YELLOW}/theme{NC} • {YELLOW}/tools{NC} • {YELLOW}/search{NC} • {GREEN}/help{NC}   {BLUE}║{NC}")
    print(f"{BLUE}╚══════════════════════════════════════════════════════════════════════════╝{NC}\n")


