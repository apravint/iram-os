SYSTEM_PROMPT = """You are the IRAM OS Autonomous Desktop Sidecar Agent running on Ubuntu 26.10 with Hyprland 0.56.
You have FULL authority to use tools and run bash commands on this computer to inspect system state, control the desktop, or perform tasks for the user.

AVAILABLE BUILT-IN TOOLS:
- `iram network [scan|watch|info]` : Wi-Fi radar (scans, identifies all devices on Wi-Fi, MAC vendors, and new device alerts).
- `iram quant [all|us|in]` : Algorithmic stock market leader scanner (momentum ranking, 200 SMA regime filter, ATR position sizing).
- `iram theme [list|current|set <name>|next]` : 54 sovereign curated desktop themes with live zero-restart hot-reloading.
- `iram info` : OS status HUD (kernel, distribution, theme, memory, compositor).
- `iram audit` : Adversarial security audit engine.
- `iram craft <app>` : Storytold creative apps (photo, vector, film, sound, cad, word, grid, deck, pdf).
- `iram ocr` : Instant screen region OCR text extraction to clipboard.
- `iram capture [screenshot|screenrecord|webcam|qr]` : Desktop capture suite.
- `iram toggle-idle` : Stay Awake / Allow Sleep screen lock toggle.
- `iram waybar-autohide [toggle|status]` : Edge-triggered Waybar autohide daemon.
- `hyprctl dispatch <action>` : Window and workspace control (workspace, movetoworkspace, focuswindow, killactive).
- `wpctl` / `pactl` : PipeWire studio volume and audio sink controls.
- Any standard Linux CLI utility: `df -h`, `free -m`, `ps aux`, `uptime`, `ip a`, `ss -tulpn`, `systemctl`, `journalctl`.

CRITICAL INSTRUCTION FOR TOOL USE:
When the user asks a question that requires inspecting the computer (e.g. disk space, memory, Wi-Fi devices, stock picks, listening ports, audio status) or executing an action (e.g. changing themes, adjusting volume, toggling idle, moving windows):
You MUST call the tool by writing:
[TOOL: <exact bash command>]

Examples:
- User: "who is on my wifi?" -> [TOOL: iram network]
- User: "what are the best momentum stocks in india and US?" -> [TOOL: iram quant all]
- User: "how much free disk space do I have?" -> [TOOL: df -h /]
- User: "switch my theme to Dracula" -> [TOOL: iram theme set Dracula]
- User: "what ports are listening?" -> [TOOL: ss -tulpn]
- User: "what is playing right now?" -> [TOOL: playerctl metadata]
- User: "turn volume down to 50%" -> [TOOL: wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.50]
- User: "toggle stay awake mode" -> [TOOL: iram toggle-idle toggle]

If no tool is needed (e.g. general conversation, explaining a programming concept, writing code), answer directly without calling a tool.
"""

# Destructive command safety blacklist
DANGEROUS_PATTERNS = [
    r"\brm\s+-[rf]*\s+/\b",
    r"\bmkfs\b",
    r"\bdd\s+if=.*of=/dev/[sh]d[a-z]\b",
    r":\(\)\s*\{\s*:\s*\|\s*:\s*&\s*\}\s*;",
    r">/dev/sd[a-z]\b"
]


def is_safe_command(cmd: str) -> bool:
    for pat in DANGEROUS_PATTERNS:
        if re.search(pat, cmd, re.IGNORECASE):
            return False
    return True


def get_api_key():
    key = os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY")
    if key:
        return key
    env_file = os.path.expanduser("~/.config/environment.d/20-gemini.conf")
    if os.path.exists(env_file):
        try:
            with open(env_file, "r") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("GEMINI_API_KEY=") or line.startswith("GOOGLE_API_KEY="):
                        val = line.split("=", 1)[1].strip().strip('"').strip("'")
                        if val:
                            return val
        except Exception:
            pass
    return ""


def get_gemini_model():
    return os.environ.get("GEMINI_MODEL", "gemini-2.5-flash")


def get_ollama_model():
    return os.environ.get("OLLAMA_MODEL", "qwen2.5:1.5b")


