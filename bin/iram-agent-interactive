#!/usr/bin/env python3
"""
Iram Interactive Agent Sidecar (iram-agent-interactive)
Real-time, streaming conversational AI terminal interface powered by Sovereign Local Ollama & Google Gemini,
with Hindsight Long-Term Memory, Internet Web Search, and Desktop System Control.
https://github.com/apravint/iram-os
"""

import sys
import os
import json
import urllib.request
import urllib.error
import subprocess
import re

# AI Core & Hindsight Integration
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    from iram_ai_core import (
        is_ollama_available,
        is_gemini_healthy,
        prefer_local_first,
        hindsight_recall,
        hindsight_retain,
        mark_gemini_failed
    )
except ImportError:
    from iram_os.bin.iram_ai_core import (
        is_ollama_available, is_gemini_healthy, prefer_local_first,
        hindsight_recall, hindsight_retain, mark_gemini_failed
    )

CYAN = "\033[0;36m"
GREEN = "\033[0;32m"
YELLOW = "\033[1;33m"
BLUE = "\033[0;34m"
MAGENTA = "\033[0;35m"
BOLD = "\033[1m"
DIM = "\033[2m"
NC = "\033[0m"

SYSTEM_PROMPT = """You are the Iram Agentic OS Desktop Assistant running natively on IRAM OS with Hyprland.
You help the user control their desktop, windows, workspaces, themes, audio, and Linux system tasks.
You also have live internet search and long-term memory access.
Be concise, practical, and conversational.
If a user request can be accomplished with a command, provide the exact bash or hyprctl command on a clear single line.
Common dispatches:
- hyprctl dispatch workspace <N>
- hyprctl dispatch focuswindow <class>
- iram theme set "<theme_name>"
- pactl set-sink-volume @DEFAULT_AUDIO_SINK@ <level>%
"""

def get_api_key():
    key = os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY")
    if key:
        return key
    env_file = os.path.expanduser("~/.config/environment.d/20-gemini.conf")
    if os.path.exists(env_file):
        try:
            with open(env_file, "r") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("GEMINI_API_KEY=") or line.startswith("GOOGLE_API_KEY="):
                        val = line.split("=", 1)[1].strip().strip('"').strip("'")
                        if val:
                            return val
        except Exception:
            pass
    return ""

def get_gemini_model():
    return os.environ.get("GEMINI_MODEL", "gemini-2.5-flash")

def get_ollama_model():
    return os.environ.get("OLLAMA_MODEL", "qwen2.5:1.5b")

def print_header():
    if not prefer_local_first() and is_gemini_healthy():
        engine_str = f"{CYAN}✨ Google Gemini ({get_gemini_model()}){NC} {GREEN}[Cloud TPU]{NC}"
    else:
        engine_str = f"{YELLOW}🖥️ Local Ollama ({get_ollama_model()}){NC} {GREEN}[Sovereign · 0ms Latency]{NC}"

    print(f"{BLUE}╔════════════════════════════════════════════════════════════════════╗{NC}")
    print(f"{BLUE}║{GREEN}{BOLD}               🤖 IRAM AGENTIC OS SIDECAR CHAT                  {BLUE}║{NC}")
    print(f"{BLUE}╠════════════════════════════════════════════════════════════════════╣{NC}")
    print(f"{BLUE}║{NC}  ► Engine: {engine_str:<66}{BLUE}║{NC}")
    print(f"{BLUE}║{NC}  ► Capabilities: {MAGENTA}Hindsight Memory • Web Search • Hyprland • Audio{NC}   {BLUE}║{NC}")
    print(f"{BLUE}║{NC}  ► Commands: {YELLOW}/search <query>{NC} • {YELLOW}/model <name>{NC} • {GREEN}exit{NC}                   {BLUE}║{NC}")
    print(f"{BLUE}╚════════════════════════════════════════════════════════════════════╝{NC}\n")

def web_search(query: str, max_results: int = 3) -> str:
    """Performs live web search using DDGS without requiring external API keys."""
    try:
        from ddgs import DDGS
        with DDGS() as ddgs:
            results = list(ddgs.text(query, max_results=max_results))
            if not results:
                return "No relevant web results found."
            formatted = []
            for r in results:
                title = r.get("title", "Untitled")
                body = r.get("body", "")
                href = r.get("href", "")
                formatted.append(f"• **{title}**\n  {body}\n  Link: {href}")
            return "\n\n".join(formatted)
    except Exception as e:
        return f"Web search could not be completed: {e}"

def should_trigger_web_search(user_text: str) -> bool:
    keywords = [
        "search", "google", "lookup", "weather", "news", "price", "stock",
        "latest", "current", "release date", "what is happening", "who won"
    ]
    text_lower = user_text.lower()
    return any(re.search(r'\b' + re.escape(w) + r'\b', text_lower) for w in keywords)

def stream_gemini(conversation_turns):
    api_key = get_api_key()
    if not api_key:
        return None
    model = get_gemini_model()
    url = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:streamGenerateContent?alt=sse"

    contents = []
    for turn in conversation_turns:
        role = "user" if turn["role"] == "user" else "model"
        contents.append({"role": role, "parts": [{"text": turn["content"]}]})

    payload = {
        "systemInstruction": {"parts": [{"text": SYSTEM_PROMPT}]},
        "contents": contents
    }

    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json", "x-goog-api-key": api_key}
    )

    full_response = []
    try:
        with urllib.request.urlopen(req, timeout=2.5) as resp:
            for line in resp:
                line = line.decode("utf-8").strip()
                if line.startswith("data: "):
                    try:
                        chunk = json.loads(line[6:])
                        parts = chunk.get("candidates", [{}])[0].get("content", {}).get("parts", [])
                        for p in parts:
                            txt = p.get("text", "")
                            sys.stdout.write(txt)
                            sys.stdout.flush()
                            full_response.append(txt)
                    except Exception:
                        pass
        print()
        return "".join(full_response)
    except Exception as e:
        mark_gemini_failed(str(e))
        return None

def stream_ollama(conversation_turns):
    url = "http://localhost:11434/api/chat"
    model = get_ollama_model()
    messages = [{"role": "system", "content": SYSTEM_PROMPT}] + conversation_turns

    payload = {
        "model": model,
        "messages": messages,
        "stream": True,
        "options": {"num_ctx": 4096, "num_predict": 512}
    }
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json"})

    full_response = []
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            for line in resp:
                if line:
                    chunk = json.loads(line.decode("utf-8"))
                    msg = chunk.get("message", {}).get("content", "")
                    sys.stdout.write(msg)
                    sys.stdout.flush()
                    full_response.append(msg)
        print()
        return "".join(full_response)
    except urllib.error.URLError:
        print(f"\n{YELLOW}⚠️ Local Ollama is offline. Starting daemon...{NC}")
        subprocess.run(["systemctl", "--user", "start", "ollama"], check=False)
        return "Could not connect to Ollama. Please ensure it is running."
    except Exception as e:
        print(f"\n{YELLOW}⚠️ Local inference error: {e}{NC}")
        return f"Error: {e}"

def chat_stream(conversation_turns):
    # Local-first sovereign inference check
    if prefer_local_first() or not is_gemini_healthy():
        if is_ollama_available():
            return stream_ollama(conversation_turns)

    # Cloud attempt
    if is_gemini_healthy():
        res = stream_gemini(conversation_turns)
        if res:
            return res
        print(f"\n{YELLOW}ℹ️ Cloud unavailable; routing to local Ollama...{NC}\n")

    return stream_ollama(conversation_turns)

def main():
    print_header()
    conversation_turns = []

    while True:
        try:
            user_input = input(f"{GREEN}{BOLD}󱙺 User ► {NC}").strip()
            if not user_input:
                continue
            if user_input.lower() in ["exit", "quit", "q"]:
                print(f"\n{CYAN}Session ended. Have a great day!{NC}")
                break

            # Handle model inspection / switch
            if user_input.startswith("/model"):
                parts = user_input.split(maxsplit=1)
                if len(parts) > 1:
                    new_model = parts[1].strip()
                    os.environ["OLLAMA_MODEL"] = new_model
                    print(f"{GREEN}✓ Switched active local model to: {new_model}{NC}\n")
                else:
                    print(f"{CYAN}Active Gemini Model: {get_gemini_model()}{NC}")
                    print(f"{CYAN}Active Ollama Model: {get_ollama_model()}{NC}\n")
                continue

            # Query Hindsight memory
            memories = hindsight_recall(user_input, limit=2)
            if memories:
                for m in memories:
                    if m.get("score", 0) > 0.8:
                        print(f"{DIM}🧠 [Hindsight Recall]: {m['fact']}{NC}")

            # Handle manual /search command or automatic live search heuristic
            search_query = None
            if user_input.startswith("/search "):
                search_query = user_input[8:].strip()
            elif should_trigger_web_search(user_input):
                search_query = user_input

            if search_query:
                print(f"{MAGENTA}🌐 Searching web for: {search_query}...{NC}")
                search_results = web_search(search_query)
                augmented_prompt = f"""[Live Web Search Context for '{search_query}']
{search_results}

User Question:
{user_input}"""
                conversation_turns.append({"role": "user", "content": augmented_prompt})
            else:
                conversation_turns.append({"role": "user", "content": user_input})

            print(f"\n{CYAN}{BOLD}🤖 Agent ► {NC}", end="")
            assistant_reply = chat_stream(conversation_turns)
            conversation_turns.append({"role": "assistant", "content": assistant_reply})

            # Check if command was suggested and offer execution
            lines = [l.strip().strip("`") for l in assistant_reply.split("\n")]
            exec_candidate = None
            for l in lines:
                if any(l.startswith(prefix) for prefix in ["hyprctl dispatch", "iram theme", "pactl set-sink", "systemctl", "wpctl"]):
                    exec_candidate = l
                    break

            if exec_candidate:
                confirm = input(f"\n{YELLOW}⚡ Execute suggested action: `{exec_candidate}`? [Y/n]: {NC}").strip().lower()
                if confirm in ["", "y", "yes"]:
                    subprocess.run(exec_candidate, shell=True)
                    hindsight_retain(f"Interactive user executed '{exec_candidate}' for '{user_input}'", category="agent", importance=4)
                    print(f"{GREEN}✓ Executed successfully.{NC}\n")
                else:
                    print(f"{DIM}Skipped execution.{NC}\n")
            else:
                print()

        except (KeyboardInterrupt, EOFError):
            print(f"\n\n{CYAN}Agent Sidecar closed.{NC}")
            break

if __name__ == "__main__":
    main()
