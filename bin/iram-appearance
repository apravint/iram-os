    def build_typography_tab(self):
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        content.set_margin_top(12)
        content.set_margin_bottom(16)
        content.set_margin_start(20)
        content.set_margin_end(20)

        # Fonts Box
        font_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        font_box.get_style_context().add_class("card-box")

        f_lbl = Gtk.Label(label="🔤 Desktop & Coding Typography")
        f_lbl.set_xalign(0)
        f_lbl.get_style_context().add_class("section-header")
