        bg = c.get('dark_background', '#0a0a0f')
        card = c.get('background', '#12121a')
        card_light = c.get('lighter_background', '#1c1c28')
        fg = c.get('foreground', '#f0f0f5')
        accent = c.get('accent', '#7aa2f7')
        border = c.get('border', '#303650')

        css_data = f"""
        * {{
            font-family: 'JetBrainsMono Nerd Font', 'JetBrains Mono', monospace;
            font-size: 13px;
        }}
        window {{
            background-color: {bg};
            color: {fg};
        }}
        .header-panel {{
            background-color: {card};
            border-bottom: 1px solid {border};
            padding: 12px 20px;
        }}
        .title-label {{
            font-size: 17px;
            font-weight: 800;
            color: {accent};
        }}
        .subtitle-label {{
            font-size: 11px;
            color: alpha({fg}, 0.6);
        }}
        .nav-switcher button {{
            background-color: {card};
            color: {fg};
            border: 1px solid {border};
            border-radius: 6px;
            padding: 6px 14px;
            margin: 2px;
            font-weight: 600;
        }}
        .nav-switcher button:checked {{
            background-color: {accent};
            color: #0c0b0c;
            border-color: {accent};
        }}
        .card-box {{
            background-color: {card};
            border: 1px solid {border};
            border-radius: 8px;
            padding: 16px;
        }}
        .card-box:hover {{
            border-color: {accent};
        }}
        .section-header {{
            font-size: 14px;
            font-weight: 700;
            color: {accent};
            margin-bottom: 8px;
        }}
        .btn-action {{
            background-color: {card_light};
            color: {fg};
            border: 1px solid {border};
            border-radius: 6px;
            padding: 7px 14px;
            font-weight: 600;
        }}
        .btn-action:hover {{
            background-color: {border};
            color: #ffffff;
        }}
        .btn-save {{
            background-color: {accent};
            color: #0c0b0c;
            border: 1px solid {accent};
            border-radius: 6px;
            padding: 7px 18px;
            font-weight: 800;
        }}
        .btn-save:hover {{
            background-color: alpha({accent}, 0.85);
        }}
        .status-panel {{
            background-color: {card};
            border-top: 1px solid {border};
            padding: 8px 18px;
            font-size: 11px;
        }}
        .theme-card {{
            background-color: {card};
            border: 1px solid {border};
            border-radius: 8px;
            padding: 8px;
        }}
        .theme-card-active {{
            border: 2px solid {accent};
            background-color: {card_light};
        }}
        scale highlight {{
            background-color: {accent};
        }}
        scale trough {{
            background-color: {border};
        }}
        """

        provider = Gtk.CssProvider()
        provider.load_from_data(css_data.encode('utf-8'))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

