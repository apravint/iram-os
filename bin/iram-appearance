    def build_bar_dock_tab(self):
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        content.set_margin_top(12)
        content.set_margin_bottom(16)
        content.set_margin_start(20)
        content.set_margin_end(20)

        # Waybar Island Aesthetics
        waybar_frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        waybar_frame.get_style_context().add_class("card-box")

        w_lbl = Gtk.Label(label="📊 Top Bar (Waybar) Island Aesthetics")
        w_lbl.set_xalign(0)
        w_lbl.get_style_context().add_class("section-header")
        waybar_frame.pack_start(w_lbl, False, False, 0)

        wb_desc = Gtk.Label(label="Select Waybar corner geometry and floating island style. Updates instantly via SIGUSR2.")
        wb_desc.set_xalign(0)
        wb_desc.get_style_context().add_class("subtitle-label")
        waybar_frame.pack_start(wb_desc, False, False, 0)

        # Style Options
        wb_btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        wb_styles = [
            ("📐 Sovereign Sharp (0px)", "sharp", 0),
            ("🧼 Rounded Island (8px)", "rounded", 8),
            ("🫧 Pill Island (16px)", "pill", 16),
            ("📏 Flush Edge-to-Edge", "flush", 0)
        ]
        for title, key, rad in wb_styles:
            btn = Gtk.Button(label=title)
            btn.get_style_context().add_class("btn-action")
            btn.connect("clicked", self.make_waybar_style_handler(key, rad))
            wb_btn_box.pack_start(btn, True, True, 0)

        waybar_frame.pack_start(wb_btn_box, False, False, 0)
        content.pack_start(waybar_frame, False, False, 0)

        # macOS-like Floating Dock Frame
        dock_frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        dock_frame.get_style_context().add_class("card-box")

        d_lbl = Gtk.Label(label="🍎 macOS-Style Floating Dock (iram-dock)")
        d_lbl.set_xalign(0)
        d_lbl.get_style_context().add_class("section-header")
        dock_frame.pack_start(d_lbl, False, False, 0)

        # Check dock status
        ok, d_out, _ = run_cmd(['iram-dock', 'status'])
        is_dock_running = "running" in d_out.lower()

        # Dock Toggle
        d_switch_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        d_switch_lbl = Gtk.Label(label="Dock Service Active (Appears on Floating Workspaces or Persistent)")
        d_switch_lbl.set_xalign(0)
        self.switch_dock = Gtk.Switch()
        self.switch_dock.set_active(is_dock_running)
        self.switch_dock.connect("state-set", self.on_dock_toggle)
        d_switch_box.pack_start(d_switch_lbl, True, True, 0)
        d_switch_box.pack_end(self.switch_dock, False, False, 0)
        dock_frame.pack_start(d_switch_box, False, False, 0)

        # Dock Position
        d_pos_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        d_pos_lbl = Gtk.Label(label="Screen Edge Position:")
        d_pos_lbl.set_xalign(0)
        d_pos_box.pack_start(d_pos_lbl, False, False, 0)

        for pos in ["bottom", "top", "left", "right"]:
            btn_pos = Gtk.Button(label=pos.capitalize())
            btn_pos.get_style_context().add_class("btn-action")
            btn_pos.connect("clicked", lambda b, p=pos: self.on_dock_position_clicked(p))
            d_pos_box.pack_start(btn_pos, True, True, 0)
        dock_frame.pack_start(d_pos_box, False, False, 0)

        # Dock Autohide
        d_auto_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        d_auto_lbl = Gtk.Label(label="Auto-Hide Dock When Windows Overlap")
        d_auto_lbl.set_xalign(0)
        self.switch_dock_auto = Gtk.Switch()
        self.switch_dock_auto.set_active(False)
        self.switch_dock_auto.connect("state-set", self.on_dock_autohide_toggle)
        d_auto_box.pack_start(d_auto_lbl, True, True, 0)
        d_auto_box.pack_end(self.switch_dock_auto, False, False, 0)
        dock_frame.pack_start(d_auto_box, False, False, 0)

        content.pack_start(dock_frame, False, False, 0)

        scroller.add(content)
        return scroller

    def make_waybar_style_handler(self, key, rad):
        def handler(btn):
            self.waybar_style = key
            css_rules = ""
            if key == "flush":
                css_rules = """
                /* Flush Edge-to-Edge Waybar */
                window#waybar {
                    background: @bar_bg;
                }
                .modules-left,
                .modules-center,
                .modules-right {
                    background: transparent;
                    border: none;
                    border-radius: 0px;
                }
                """
            else:
                css_rules = f"""
                /* Floating Islands with {rad}px radius */
                window#waybar {{
                    background: transparent;
                }}
                .modules-left,
                .modules-center,
                .modules-right {{
                    background: @bar_bg;
                    border: 1px solid @border;
                    border-radius: {rad}px;
                }}
                """
            try:
                with open(WAYBAR_APPEARANCE_CSS, 'w', encoding='utf-8') as f:
                    f.write(css_rules)
                subprocess.run(['killall', '-SIGUSR2', 'waybar'], check=False)
                self.set_status(f"✓ Waybar style updated: {key.capitalize()} ({rad}px radius)")
            except Exception as e:
                self.set_status(f"✗ Failed to update Waybar style: {e}")
        return handler

    def on_dock_toggle(self, sw, state):
        cmd = 'start' if state else 'stop'
        def worker():
            run_cmd(['iram-dock', cmd])
            GLib.idle_add(self.set_status, f"IRAM Dock {cmd}ed successfully")
        threading.Thread(target=worker, daemon=True).start()
        return True

    def on_dock_position_clicked(self, pos):
        def worker():
            run_cmd(['iram-dock', 'position', pos])
            GLib.idle_add(self.set_status, f"IRAM Dock moved to {pos}")
        threading.Thread(target=worker, daemon=True).start()

    def on_dock_autohide_toggle(self, sw, state):
        cmd = 'on' if state else 'off'
        def worker():
            run_cmd(['iram-dock', 'autohide', cmd])
            GLib.idle_add(self.set_status, f"IRAM Dock autohide {cmd}")
        threading.Thread(target=worker, daemon=True).start()
        return True

