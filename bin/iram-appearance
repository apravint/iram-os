    def make_preset_handler(self, r, b, gi, go):
        def handler(btn):
            self.scale_rounding.slider.set_value(r)
            self.scale_border.slider.set_value(b)
            self.scale_gaps_in.slider.set_value(gi)
            self.scale_gaps_out.slider.set_value(go)
            self.set_status(f"Applied preset: Rounding={r}px, Border={b}px, Gaps={gi}/{go}px")
        return handler

    def create_slider(self, label_text, min_val, max_val, step, cur_val, cb, unit=""):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)

        lbl = Gtk.Label(label=label_text)
        lbl.set_xalign(0)

        val_lbl = Gtk.Label(label=f"{cur_val} {unit}".strip())
        val_lbl.set_xalign(1)
        val_lbl.get_style_context().add_class("subtitle-label")

        hbox.pack_start(lbl, True, True, 0)
        hbox.pack_end(val_lbl, False, False, 0)
        vbox.pack_start(hbox, False, False, 0)

        slider = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, min_val, max_val, step)
        slider.set_value(cur_val)
        slider.set_draw_value(False)

        def on_change(s):
            val = s.get_value()
            if isinstance(min_val, int) and isinstance(step, int):
                val = int(val)
                val_lbl.set_text(f"{val} {unit}".strip())
            else:
                val_lbl.set_text(f"{val:.2f} {unit}".strip())
            cb(s)

        slider.connect("value-changed", on_change)
        vbox.pack_start(slider, False, False, 0)

        vbox.slider = slider
        vbox.val_lbl = val_lbl
        return vbox

    def on_rounding_changed(self, val):
        self.val_rounding = val
        hypr_set('decoration:rounding', val)
        self.desktop_preview.queue_draw()
        self.set_status(f"Live Rounding: {val}px")

    def on_border_changed(self, val):
        self.val_border_size = val
        hypr_set('general:border_size', val)
        self.desktop_preview.queue_draw()
        self.set_status(f"Live Border Width: {val}px")

    def on_gaps_in_changed(self, val):
        self.val_gaps_in = val
        hypr_set('general:gaps_in', val)
        self.desktop_preview.queue_draw()
        self.set_status(f"Live Inner Gaps: {val}px")

    def on_gaps_out_changed(self, val):
        self.val_gaps_out = val
        hypr_set('general:gaps_out', val)
        self.desktop_preview.queue_draw()
        self.set_status(f"Live Outer Gaps: {val}px")

