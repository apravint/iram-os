    def make_fx_preset_handler(self, b_en, b_p, b_s, act_o, inact_o, sh_en, dim_en):
        def handler(btn):
            self.switch_blur.set_active(b_en)
            self.scale_blur_passes.slider.set_value(b_p)
            self.scale_blur_size.slider.set_value(b_s)
            self.scale_active_opacity.slider.set_value(act_o)
            self.scale_inactive_opacity.slider.set_value(inact_o)
            self.switch_shadow.set_active(sh_en)
            self.switch_dim.set_active(dim_en)
            self.set_status(f"Applied Visual FX preset (Blur={b_en}, Opacity={act_o}/{inact_o}, Shadow={sh_en})")
        return handler

    def on_blur_toggle(self, sw, state):
        self.val_blur_enabled = state
        hypr_set('decoration:blur:enabled', 'true' if state else 'false')
        self.set_status(f"Blur {'enabled' if state else 'disabled'}")
        return True

    def on_blur_passes_changed(self, val):
        self.val_blur_passes = val
        hypr_set('decoration:blur:passes', val)
        self.set_status(f"Blur passes: {val}")

    def on_blur_size_changed(self, val):
        self.val_blur_size = val
        hypr_set('decoration:blur:size', val)
        self.set_status(f"Blur size: {val}px")

    def on_active_opacity_changed(self, val):
        self.val_active_opacity = val
        hypr_set('decoration:active_opacity', f"{val:.2f}")
        self.desktop_preview.queue_draw()
        self.set_status(f"Active Opacity: {val:.2f}")

    def on_inactive_opacity_changed(self, val):
        self.val_inactive_opacity = val
        hypr_set('decoration:inactive_opacity', f"{val:.2f}")
        self.desktop_preview.queue_draw()
        self.set_status(f"Inactive Opacity: {val:.2f}")

    def on_shadow_toggle(self, sw, state):
        self.val_shadow_enabled = state
        hypr_set('decoration:shadow:enabled', 'true' if state else 'false')
        self.set_status(f"Shadows {'enabled' if state else 'disabled'}")
        return True

    def on_dim_toggle(self, sw, state):
        self.val_dim_inactive = state
        hypr_set('decoration:dim_inactive', 'true' if state else 'false')
        self.set_status(f"Dim inactive {'enabled' if state else 'disabled'}")
        return True

    # --------------------------------------------------------------------------
    # TAB 3: 🎨 55 PALETTES & THEMES
    # --------------------------------------------------------------------------
    def build_palettes_tab(self):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        vbox.set_margin_top(10)
        vbox.set_margin_bottom(12)
        vbox.set_margin_start(20)
        vbox.set_margin_end(20)

        # Filter & Search Bar
        search_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

        self.theme_search_entry = Gtk.SearchEntry()
        self.theme_search_entry.set_placeholder_text("Search 55 Curated Sovereign Palettes (e.g. Dracula, Tokyo, Cyberpunk)...")
        self.theme_search_entry.connect("search-changed", self.on_theme_search_changed)
        search_box.pack_start(self.theme_search_entry, True, True, 0)

        # Category Chips
        cats = [("all", "All (55)"), ("cyber", "Cyber"), ("earth", "Earth"), ("minimal", "Minimal"), ("light", "Light")]
        self.cat_buttons = {}
        for cat_id, cat_lbl in cats:
            btn = Gtk.RadioButton.new_with_label_from_widget(
                self.cat_buttons.get("all"), cat_lbl
            ) if "all" in self.cat_buttons else Gtk.RadioButton.new_with_label(None, cat_lbl)
            btn.set_mode(False)
            btn.get_style_context().add_class("btn-action")
            btn.connect("toggled", self.make_category_handler(cat_id))
            self.cat_buttons[cat_id] = btn
            search_box.pack_start(btn, False, False, 0)

        vbox.pack_start(search_box, False, False, 0)

        # FlowBox of theme cards inside ScrolledWindow
        self.theme_scroller = Gtk.ScrolledWindow()
        self.theme_scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        self.flowbox = Gtk.FlowBox()
        self.flowbox.set_valign(Gtk.Align.START)
        self.flowbox.set_max_children_per_line(3)
        self.flowbox.set_min_children_per_line(2)
        self.flowbox.set_selection_mode(Gtk.SelectionMode.NONE)
        self.flowbox.set_row_spacing(10)
        self.flowbox.set_column_spacing(10)

        self.theme_cards = []
        for t in self.all_themes:
            card = self.create_theme_card(t)
            self.theme_cards.append((t, card))
            self.flowbox.add(card)

        self.theme_scroller.add(self.flowbox)
        vbox.pack_start(self.theme_scroller, True, True, 0)
        return vbox

    def create_theme_card(self, t):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        card.get_style_context().add_class("theme-card")
        is_cur = (t['name'].lower() == self.current_theme.lower())
        if is_cur:
            card.get_style_context().add_class("theme-card-active")

        # Top row: title & swatches
        top_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        lbl_name = Gtk.Label(label=t['name'].replace('-', ' ').title())
        lbl_name.set_xalign(0)
        lbl_name.set_ellipsize(Pango.EllipsizeMode.END)
        top_row.pack_start(lbl_name, True, True, 0)

        if is_cur:
            badge = Gtk.Label(label="ACTIVE")
            badge.get_style_context().add_class("btn-save")
            top_row.pack_end(badge, False, False, 0)

        card.pack_start(top_row, False, False, 0)

        # Color Swatches
        swatch_widget = ColorSwatches(t['swatches'])
        card.pack_start(swatch_widget, False, False, 0)

        # Preview Image or Skeleton
        img = Gtk.Image()
        img.set_size_request(280, 110)
        card.pack_start(img, False, False, 0)

        # Async Thumbnail loader
        def load_img():
            prev = t.get('preview')
            if prev and os.path.isfile(prev):
                try:
                    pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(prev, 280, 110, True)
                    GLib.idle_add(img.set_from_pixbuf, pb)
                except Exception:
                    pass
        THREAD_POOL.submit(load_img)

        # Apply Button
        btn_apply = Gtk.Button(label="Apply Palette")
        btn_apply.get_style_context().add_class("btn-action")
        btn_apply.connect("clicked", lambda b, tn=t['name']: self.on_apply_theme_clicked(tn))
        card.pack_start(btn_apply, False, False, 0)

        card.show_all()
        return card

    def make_category_handler(self, cat_id):
        def handler(btn):
            if btn.get_active():
                self.active_category = cat_id
                self.filter_themes()
        return handler

    def on_theme_search_changed(self, entry):
        self.filter_themes()

    def filter_themes(self):
        query = self.theme_search_entry.get_text().strip().lower()
        cat = getattr(self, 'active_category', 'all')

        for t, card in self.theme_cards:
            matches_cat = (cat == 'all' or cat in t.get('categories', []))
            matches_q = (not query or query in t['name'].lower())
            card.set_visible(matches_cat and matches_q)

    def on_apply_theme_clicked(self, theme_name):
        self.set_status(f"Switching theme to '{theme_name}'...")
        def worker():
            ok, out, err = run_cmd(['iram', 'theme', 'set', theme_name])
            GLib.idle_add(self.finish_apply_theme, theme_name, ok)
        threading.Thread(target=worker, daemon=True).start()

    def finish_apply_theme(self, theme_name, ok):
        if ok:
            self.current_theme = theme_name
            self.active_colors = read_active_theme_colors()
            self.apply_dynamic_css()
            self.desktop_preview.queue_draw()
            # Refresh card badges
            for t, card in self.theme_cards:
                is_cur = (t['name'].lower() == theme_name.lower())
                ctx = card.get_style_context()
                if is_cur:
                    ctx.add_class("theme-card-active")
                else:
                    ctx.remove_class("theme-card-active")
            self.set_status(f"✓ Theme successfully switched to: {theme_name.title()}")
        else:
            self.set_status(f"✗ Failed to switch theme to {theme_name}")

    def on_random_theme_clicked(self, btn):
        self.set_status("Picking random sovereign palette...")
        def worker():
            ok, out, _ = run_cmd(['iram', 'theme', 'random'])
            cur = get_current_theme_name()
            GLib.idle_add(self.finish_apply_theme, cur, ok)
        threading.Thread(target=worker, daemon=True).start()

    def on_next_wallpaper_clicked(self, btn):
        self.set_status("Cycling wallpaper background...")
        def worker():
            run_cmd(['iram', 'theme', 'bg', 'next'])
            GLib.idle_add(self.set_status, "✓ Wallpaper background cycled successfully")
        threading.Thread(target=worker, daemon=True).start()

