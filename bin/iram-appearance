THREAD_POOL = ThreadPoolExecutor(max_workers=4, thread_name_prefix="AppearanceWorker")


def run_cmd(cmd_list, timeout=10):
    try:
        res = subprocess.run(cmd_list, capture_output=True, text=True, timeout=timeout)
        return res.returncode == 0, res.stdout.strip(), res.stderr.strip()
    except Exception as e:
        return False, "", str(e)


def hypr_set(keyword, value):
    try:
        subprocess.run(['hyprctl', 'keyword', keyword, str(value)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def hypr_get(opt, default=None):
    try:
        ok, out, _ = run_cmd(['hyprctl', 'getoption', opt])
        if ok:
            for line in out.splitlines():
                line = line.strip()
                if line.startswith('int:'):
                    return int(line.split(':', 1)[1].strip())
                elif line.startswith('float:'):
                    return float(line.split(':', 1)[1].strip())
                elif line.startswith('custom type:'):
                    vals = line.split(':', 1)[1].strip().split()
                    return int(vals[0]) if vals else default
    except Exception:
        pass
    return default


def hex_to_rgb_float(hex_code):
    if not hex_code:
        return 0.5, 0.5, 0.5
    h = hex_code.lstrip("#")
    if len(h) in (6, 8):
        try:
            return int(h[0:2], 16) / 255.0, int(h[2:4], 16) / 255.0, int(h[4:6], 16) / 255.0
        except ValueError:
            pass
    return 0.5, 0.5, 0.5


def read_active_theme_colors():
    colors = {
        'background': '#0c0b0c',
        'dark_background': '#090809',
        'lighter_background': '#161517',
        'foreground': '#f0f0f5',
        'accent': '#7aa2f7',
        'selection': '#363b54',
        'border': '#3b4261',
        'cyan': '#7dcfff',
        'green': '#73daca',
        'red': '#f7768e',
        'yellow': '#e0af68'
    }
    p = os.path.join(STATE_DIR, 'current', 'theme', 'colors.toml')
    if os.path.isfile(p):
        try:
            with open(p, 'r', encoding='utf-8') as f:
                for line in f:
                    line = line.strip()
                    if '=' in line and not line.startswith('#'):
                        k, v = line.split('=', 1)
                        colors[k.strip()] = v.strip().strip('\"\'')
        except Exception:
            pass
    return colors


def read_theme_colors(theme_dir):
    colors = {}
    p = os.path.join(theme_dir, 'colors.toml')
    if os.path.isfile(p):
        try:
            with open(p, 'r', encoding='utf-8') as f:
                for line in f:
                    line = line.strip()
                    if '=' in line and not line.startswith('#'):
                        k, v = line.split('=', 1)
                        colors[k.strip()] = v.strip().strip('\"\'')
        except Exception:
            pass
    return colors


def get_swatches(colors):
    bg = colors.get('background', colors.get('dark_background', '#181825'))
    sel = colors.get('selection', colors.get('lighter_background', '#313244'))
    acc = colors.get('accent', '#89b4fa')
    c1 = colors.get('cyan', colors.get('green', colors.get('blue', '#94e2d5')))
    c2 = colors.get('bright_magenta', colors.get('magenta', colors.get('red', '#f38ba8')))
    return [bg, sel, acc, c1, c2]


def find_theme_preview(theme_path):
    bg_dir = os.path.join(theme_path, 'backgrounds')
    if os.path.isdir(bg_dir):
        for f in sorted(os.listdir(bg_dir)):
            if f.lower().endswith(('.jpg', '.jpeg', '.png', '.webp')):
                return os.path.join(bg_dir, f)
    for name in ['preview.png', 'preview.jpg', 'preview.jpeg', 'preview.webp']:
        p = os.path.join(theme_path, name)
        if os.path.isfile(p):
            return p
    return None


def get_all_themes():
    themes = {}
    for base_dir in THEMES_DIRS:
        if not os.path.isdir(base_dir):
            continue
        for entry in sorted(os.listdir(base_dir)):
            full_path = os.path.join(base_dir, entry)
            if os.path.isdir(full_path) and entry not in themes:
                colors = read_theme_colors(full_path)
                preview = find_theme_preview(full_path)
                swatches = get_swatches(colors)
                mode = colors.get('mode', 'dark').lower()

                cats = ["all"]
                if entry in MODERN_THEME_IDS:
                    cats.append("modern")
                if entry in CATEGORY_MAP["cyber"]:
                    cats.append("cyber")
                if entry in CATEGORY_MAP["earth"]:
                    cats.append("earth")
                if entry in CATEGORY_MAP["minimal"]:
                    cats.append("minimal")
                if mode == "light" or entry in CATEGORY_MAP["light"]:
                    cats.append("light")

                themes[entry] = {
                    'name': entry,
                    'path': full_path,
                    'preview': preview,
                    'colors': colors,
                    'swatches': swatches,
                    'categories': cats,
                    'mode': mode
                }

    ordered = []
    for mod_id in MODERN_THEME_IDS:
        if mod_id in themes:
            ordered.append(themes[mod_id])
    others = [t for t in themes.values() if t['name'] not in MODERN_THEME_IDS]
    others.sort(key=lambda x: x['name'])
    ordered.extend(others)
    return ordered


def get_current_theme_name():
    if os.path.exists(CURRENT_THEME_FILE):
        try:
            with open(CURRENT_THEME_FILE, 'r', encoding='utf-8') as f:
                val = f.read().strip()
                if val:
                    return val.lower().replace(' ', '-')
        except Exception:
            pass
    return "tokyo-night"


# ==============================================================================
# CAIRO MINI DESKTOP WORKSPACE PREVIEW
# ==============================================================================
class DesktopPreviewWidget(Gtk.DrawingArea):
    """Real-time Cairo simulation of Hyprland desktop windows, gaps, and borders."""
    def __init__(self, tuner):
        super().__init__()
        self.tuner = tuner
        self.set_size_request(320, 220)
        self.connect("draw", self.on_draw)

    def on_draw(self, widget, cr):
        w = widget.get_allocated_width()
        h = widget.get_allocated_height()

        colors = self.tuner.active_colors
        bg_r, bg_g, bg_b = hex_to_rgb_float(colors.get('dark_background', '#08080a'))
        card_r, card_g, card_b = hex_to_rgb_float(colors.get('background', '#121217'))
        acc_r, acc_g, acc_b = hex_to_rgb_float(colors.get('accent', '#7aa2f7'))
        bdr_r, bdr_g, bdr_b = hex_to_rgb_float(colors.get('border', '#3b4261'))

        # Desktop background
        cr.set_source_rgb(bg_r, bg_g, bg_b)
        cr.rectangle(0, 0, w, h)
        cr.fill()

        # Subtle desktop grid pattern
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.03)
        cr.set_line_width(1.0)
        for gx in range(0, w, 20):
            cr.move_to(gx, 0)
            cr.line_to(gx, h)
        for gy in range(0, h, 20):
            cr.move_to(0, gy)
            cr.line_to(w, gy)
        cr.stroke()

        # Dynamic values from tuner
        rounding = float(self.tuner.val_rounding)
        border_size = float(self.tuner.val_border_size)
        gaps_in = float(self.tuner.val_gaps_in)
        gaps_out = float(self.tuner.val_gaps_out)

        # Scale down gaps for preview canvas proportionally
        scale = 0.85
        p_gaps_out = max(6.0, gaps_out * scale)
        p_gaps_in = max(4.0, gaps_in * scale)
        p_border = max(1.0, border_size)
        p_radius = min(rounding * scale, 18.0)

        # Draw 2 tiled windows side-by-side
        avail_w = w - (2 * p_gaps_out) - p_gaps_in
        win_w = avail_w / 2.0
        win_h = h - (2 * p_gaps_out)

        # Left Window (Focused Terminal)
        self.draw_sim_window(cr, p_gaps_out, p_gaps_out, win_w, win_h,
                             p_radius, p_border, is_active=True,
                             acc_rgb=(acc_r, acc_g, acc_b),
                             card_rgb=(card_r, card_g, card_b),
                             title=f"terminal ~ {HOME}")

        # Right Window (Unfocused Editor)
        self.draw_sim_window(cr, p_gaps_out + win_w + p_gaps_in, p_gaps_out, win_w, win_h,
                             p_radius, p_border, is_active=False,
                             acc_rgb=(bdr_r, bdr_g, bdr_b),
                             card_rgb=(card_r, card_g, card_b),
                             title="editor • Sovereign.rs")

        # Outer border around preview frame
        cr.set_source_rgba(acc_r, acc_g, acc_b, 0.25)
        cr.set_line_width(1.0)
        cr.rectangle(0, 0, w, h)
        cr.stroke()
        return False

    def draw_sim_window(self, cr, x, y, width, height, radius, border, is_active, acc_rgb, card_rgb, title):
        if width <= 0 or height <= 0:
            return

        cr.save()
        # Window path with rounded corners
        degrees = 3.14159265 / 180.0
        cr.new_sub_path()
        cr.arc(x + width - radius, y + radius, radius, -90 * degrees, 0 * degrees)
        cr.arc(x + width - radius, y + height - radius, radius, 0 * degrees, 90 * degrees)
        cr.arc(x + radius, y + height - radius, radius, 90 * degrees, 180 * degrees)
        cr.arc(x + radius, y + radius, radius, 180 * degrees, 270 * degrees)
        cr.close_path()

        # Window body fill
        opacity = float(self.tuner.val_active_opacity if is_active else self.tuner.val_inactive_opacity)
        r, g, b = card_rgb
        cr.set_source_rgba(r, g, b, opacity)
        cr.fill_preserve()

        # Window Border
        if border > 0:
            cr.set_line_width(border)
            if is_active:
                cr.set_source_rgb(acc_rgb[0], acc_rgb[1], acc_rgb[2])
            else:
                cr.set_source_rgba(acc_rgb[0], acc_rgb[1], acc_rgb[2], 0.6)
            cr.stroke()
        else:
            cr.new_path()

        # Mock Titlebar line
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.08)
        cr.rectangle(x + 2, y + 2, width - 4, 18)
        cr.fill()

        # Dots
        dot_r = 3.0
        dot_y = y + 11
        for i, c in enumerate([(0.97, 0.46, 0.56), (0.88, 0.69, 0.41), (0.45, 0.85, 0.79)]):
            cr.set_source_rgb(*c)
            cr.arc(x + 10 + (i * 10), dot_y, dot_r, 0, 2 * 3.14159265)
            cr.fill()

        # Mock code lines
        cr.set_source_rgba(1.0, 1.0, 1.0, 0.25 if is_active else 0.12)
        cr.rectangle(x + 12, y + 32, width * 0.65, 4)
        cr.fill()
        cr.rectangle(x + 12, y + 44, width * 0.45, 4)
        cr.fill()
        cr.rectangle(x + 12, y + 56, width * 0.75, 4)
        cr.fill()
        cr.rectangle(x + 12, y + 68, width * 0.35, 4)
        cr.fill()

        cr.restore()


# ==============================================================================
# COLOR SWATCH DRAWING COMPONENT
# ==============================================================================
class ColorSwatches(Gtk.DrawingArea):
    """5 circular color pills with crisp rim borders."""
    def __init__(self, hex_colors):
        super().__init__()
        self.hex_colors = hex_colors[:5] if hex_colors else []
        self.set_size_request(88, 16)
        self.connect("draw", self.on_draw)

    def on_draw(self, widget, cr):
        radius = 5.5
        gap = 4.5
        x = radius + 2.0
        y = widget.get_allocated_height() / 2.0

        for hex_code in self.hex_colors:
            r, g, b = hex_to_rgb_float(hex_code)
            cr.set_source_rgba(0.0, 0.0, 0.0, 0.4)
            cr.arc(x, y + 1.0, radius, 0, 2 * 3.14159265)
            cr.fill()

            cr.set_source_rgb(r, g, b)
            cr.arc(x, y, radius, 0, 2 * 3.14159265)
            cr.fill_preserve()

            cr.set_source_rgba(1.0, 1.0, 1.0, 0.3)
            cr.set_line_width(1.0)
            cr.stroke()
            x += radius * 2 + gap
        return False


# ==============================================================================
# MAIN RICE TUNER APPLICATION WINDOW
# ==============================================================================
class IramAppearanceWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="IRAM OS Rice Tuner")
        self.set_default_size(1040, 720)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_role("iram-appearance")

        # Load active colors & existing state
        self.active_colors = read_active_theme_colors()
        self.current_theme = get_current_theme_name()
        self.all_themes = get_all_themes()
        self.thumbnail_cache = {}

        self.load_state_from_system()
        self.apply_dynamic_css()

        # Build Main UI
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(main_box)

        # Header Bar
        header = self.build_header_bar()
        main_box.pack_start(header, False, False, 0)

        # Stack & StackSwitcher
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_transition_duration(180)

        # Tabs
        self.tab_geometry = self.build_geometry_tab()
        self.tab_glass = self.build_glass_tab()
        self.tab_palettes = self.build_palettes_tab()
        self.tab_bar_dock = self.build_bar_dock_tab()
        self.tab_typography = self.build_typography_tab()

        self.stack.add_titled(self.tab_geometry, "geometry", "🪟 Geometry & Gaps")
        self.stack.add_titled(self.tab_glass, "glass", "✨ Glass & FX")
        self.stack.add_titled(self.tab_palettes, "palettes", "🎨 55 Palettes")
        self.stack.add_titled(self.tab_bar_dock, "bar_dock", "📊 Bar & Dock")
        self.stack.add_titled(self.tab_typography, "typography", "🔤 Typography & Cursor")

        # Navigation Bar (StackSwitcher)
        nav_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        nav_box.set_margin_top(8)
        nav_box.set_margin_bottom(8)
        nav_box.set_margin_start(20)
        nav_box.set_margin_end(20)

        switcher = Gtk.StackSwitcher()
        switcher.set_stack(self.stack)
        nav_box.pack_start(switcher, True, True, 0)

        main_box.pack_start(nav_box, False, False, 0)
        main_box.pack_start(self.stack, True, True, 0)

        # Status & Feedback Bar
        status_bar = self.build_status_bar()
        main_box.pack_end(status_bar, False, False, 0)

        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.on_key_press)

    def load_state_from_system(self):
        # Query Hyprland runtime or defaults
        self.val_rounding = hypr_get('decoration:rounding', DEFAULT_STATE['geometry']['rounding'])
        self.val_border_size = hypr_get('general:border_size', DEFAULT_STATE['geometry']['border_size'])
        self.val_gaps_in = hypr_get('general:gaps_in', DEFAULT_STATE['geometry']['gaps_in'])
        self.val_gaps_out = hypr_get('general:gaps_out', DEFAULT_STATE['geometry']['gaps_out'])

        self.val_blur_enabled = bool(hypr_get('decoration:blur:enabled', 1))
        self.val_blur_passes = hypr_get('decoration:blur:passes', DEFAULT_STATE['glass_fx']['blur_passes'])
        self.val_blur_size = hypr_get('decoration:blur:size', DEFAULT_STATE['glass_fx']['blur_size'])
        self.val_active_opacity = hypr_get('decoration:active_opacity', DEFAULT_STATE['glass_fx']['active_opacity'])
        self.val_inactive_opacity = hypr_get('decoration:inactive_opacity', DEFAULT_STATE['glass_fx']['inactive_opacity'])
        self.val_shadow_enabled = bool(hypr_get('decoration:shadow:enabled', 0))
        self.val_dim_inactive = bool(hypr_get('decoration:dim_inactive', 1))
        self.val_dim_strength = hypr_get('decoration:dim_strength', DEFAULT_STATE['glass_fx']['dim_strength'])

        # Load persisted JSON if available
        self.saved_json = DEFAULT_STATE.copy()
        if os.path.isfile(APPEARANCE_JSON):
            try:
                with open(APPEARANCE_JSON, 'r', encoding='utf-8') as f:
                    self.saved_json = json.load(f)
            except Exception:
                pass

        self.waybar_style = self.saved_json.get('bar_dock', {}).get('waybar_style', 'sharp')

