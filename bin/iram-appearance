    # --------------------------------------------------------------------------
    # PERSISTENCE & ACTIONS
    # --------------------------------------------------------------------------
    def on_save_rice_clicked(self, btn):
        self.set_status("Saving rice configuration to appearance.conf...")

        # 1. Write ~/.config/hypr/appearance.conf
        conf_content = f"""# ==============================================================================
# IRAM OS - Unified Appearance & Rice Tuner Overrides
# Dynamically managed by iram-appearance (iram appearance)
# ==============================================================================

general {{
    border_size = {self.val_border_size}
    gaps_in = {self.val_gaps_in}
    gaps_out = {self.val_gaps_out}
}}

decoration {{
    rounding = {self.val_rounding}
    active_opacity = {self.val_active_opacity:.2f}
    inactive_opacity = {self.val_inactive_opacity:.2f}
    dim_inactive = {'true' if self.val_dim_inactive else 'false'}
    dim_strength = {self.val_dim_strength:.2f}

    blur {{
        enabled = {'true' if self.val_blur_enabled else 'false'}
        size = {self.val_blur_size}
        passes = {self.val_blur_passes}
    }}

    shadow {{
        enabled = {'true' if self.val_shadow_enabled else 'false'}
    }}
}}
"""
        try:
            with open(APPEARANCE_CONF, 'w', encoding='utf-8') as f:
                f.write(conf_content)
            # Also keep iram-os repo template in sync if exists
            repo_conf = os.path.join(HOME, 'iram-os', 'config', 'hypr', 'appearance.conf')
            if os.path.isdir(os.path.dirname(repo_conf)):
                with open(repo_conf, 'w', encoding='utf-8') as f:
                    f.write(conf_content)
        except Exception as e:
            self.set_status(f"✗ Error saving appearance.conf: {e}")
            return

        # 2. Write ~/.config/iram/appearance.json
        state_data = {
            "geometry": {
                "rounding": self.val_rounding,
                "border_size": self.val_border_size,
                "gaps_in": self.val_gaps_in,
                "gaps_out": self.val_gaps_out
            },
            "glass_fx": {
                "blur_enabled": self.val_blur_enabled,
                "blur_passes": self.val_blur_passes,
                "blur_size": self.val_blur_size,
                "active_opacity": self.val_active_opacity,
                "inactive_opacity": self.val_inactive_opacity,
                "shadow_enabled": self.val_shadow_enabled,
                "dim_inactive": self.val_dim_inactive,
                "dim_strength": self.val_dim_strength
            },
            "bar_dock": {
                "waybar_style": self.waybar_style
            }
        }
        try:
            with open(APPEARANCE_JSON, 'w', encoding='utf-8') as f:
                json.dump(state_data, f, indent=2)
        except Exception:
            pass

        # 3. Reload Hyprland
        subprocess.run(['hyprctl', 'reload'], check=False)

        # 4. Notify
        run_cmd(['notify-send', '-a', 'IRAM OS', 'Rice Tuner Locked',
                 f'Saved profile: {self.val_rounding}px rounding, {self.val_border_size}px borders, {self.val_gaps_in}/{self.val_gaps_out}px gaps'])
        self.set_status("✓ Rice settings permanently saved and locked to appearance.conf!")

    def on_reset_defaults_clicked(self, btn):
        self.set_status("Restoring Sovereign 0px Brutalist defaults...")
        self.scale_rounding.slider.set_value(DEFAULT_STATE['geometry']['rounding'])
        self.scale_border.slider.set_value(DEFAULT_STATE['geometry']['border_size'])
        self.scale_gaps_in.slider.set_value(DEFAULT_STATE['geometry']['gaps_in'])
        self.scale_gaps_out.slider.set_value(DEFAULT_STATE['geometry']['gaps_out'])
        self.switch_blur.set_active(DEFAULT_STATE['glass_fx']['blur_enabled'])
        self.scale_blur_passes.slider.set_value(DEFAULT_STATE['glass_fx']['blur_passes'])
        self.scale_blur_size.slider.set_value(DEFAULT_STATE['glass_fx']['blur_size'])
        self.scale_active_opacity.slider.set_value(DEFAULT_STATE['glass_fx']['active_opacity'])
        self.scale_inactive_opacity.slider.set_value(DEFAULT_STATE['glass_fx']['inactive_opacity'])
        self.switch_shadow.set_active(DEFAULT_STATE['glass_fx']['shadow_enabled'])
        self.switch_dim.set_active(DEFAULT_STATE['glass_fx']['dim_inactive'])
        self.on_save_rice_clicked(None)
        self.set_status("✓ Restored Sovereign Brutalist standard defaults")

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.destroy()
            return True
        return False


def check_single_instance_toggle():
    if not os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'):
        return False
    try:
        ok, clients_json, _ = run_cmd(['hyprctl', 'clients', '-j'])
        if ok and clients_json:
            clients = json.loads(clients_json)
            for c in clients:
                if c.get('class') == 'iram-appearance':
                    addr = c.get('address')
                    ok_act, act_json, _ = run_cmd(['hyprctl', 'activewindow', '-j'])
                    if ok_act and act_json:
                        act = json.loads(act_json)
                        if act.get('class') == 'iram-appearance':
                            run_cmd(['hyprctl', 'dispatch', 'closewindow', f"address:{addr}"])
                            return True
                    run_cmd(['hyprctl', 'dispatch', 'movetoworkspace', f"current,address:{addr}"])
                    run_cmd(['hyprctl', 'dispatch', 'focuswindow', f"address:{addr}"])
                    return True
    except Exception:
        pass
    return False


def main():
    if check_single_instance_toggle():
        return
    win = IramAppearanceWindow()
    win.show_all()
    Gtk.main()


if __name__ == '__main__':
    main()
