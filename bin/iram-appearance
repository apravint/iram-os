    def discover_fonts(self):
        fonts = ["JetBrains Mono", "Cascadia Code", "Fira Code", "Hack", "IBM Plex Mono", "Segoe UI"]
        try:
            ok, out, _ = run_cmd(['fc-list', ':', 'family'])
            if ok:
                for line in out.splitlines():
                    fn = line.split(',')[0].strip()
                    if any(k in fn.lower() for k in ['nerd', 'mono', 'code', 'hack', 'jetbrains', 'ubuntu']):
                        if fn not in fonts:
                            fonts.append(fn)
        except Exception:
            pass
        return sorted(list(set(fonts)))

    def get_active_font(self):
        try:
            ok, out, _ = run_cmd(['gsettings', 'get', 'org.gnome.desktop.interface', 'monospace-font-name'])
            if ok:
                return out.strip("'\"")
        except Exception:
            pass
        return "JetBrainsMono Nerd Font"

    def discover_cursors(self):
        cursors = []
        for d in ['/usr/share/icons', os.path.expanduser('~/.icons'), os.path.expanduser('~/.local/share/icons')]:
            if os.path.isdir(d):
                for entry in os.listdir(d):
                    full = os.path.join(d, entry)
                    if os.path.isdir(os.path.join(full, 'cursors')) or os.path.isdir(os.path.join(full, 'hyprcursors')):
                        if entry not in ['default', 'hicolor'] and entry not in cursors:
                            cursors.append(entry)
        return sorted(cursors) or ["catppuccin-mocha-lavender-cursors", "Adwaita"]

    def get_active_cursor(self):
        try:
            ok, out, _ = run_cmd(['gsettings', 'get', 'org.gnome.desktop.interface', 'cursor-theme'])
            if ok:
                return out.strip("'\"")
        except Exception:
            pass
        return "catppuccin-mocha-lavender-cursors"

    def on_font_preview_update(self):
        pass

    def on_apply_font_clicked(self, btn):
        font_name = self.font_combo.get_active_text() or "JetBrainsMono Nerd Font"
        size = int(self.scale_font_size.slider.get_value())
        self.set_status(f"Applying font: {font_name} ({size}pt)...")

        def worker():
            run_cmd(['gsettings', 'set', 'org.gnome.desktop.interface', 'monospace-font-name', f"{font_name} {size}"])
            run_cmd(['gsettings', 'set', 'org.gnome.desktop.interface', 'font-name', f"{font_name} {size}"])
            # Save font state
            with open(os.path.join(CONFIG_IRAM, 'font.name'), 'w') as f:
                f.write(font_name)
            GLib.idle_add(self.set_status, f"✓ Font set to {font_name} ({size}pt)")
        threading.Thread(target=worker, daemon=True).start()

    def on_cursor_size_clicked(self, sz):
        self.cur_cursor_size = sz
        self.set_status(f"Cursor size set to {sz}px (Click Apply to activate)")

    def on_apply_cursor_clicked(self, btn):
        cname = self.cursor_combo.get_active_text() or "catppuccin-mocha-lavender-cursors"
        sz = self.cur_cursor_size
        self.set_status(f"Applying cursor: {cname} ({sz}px)...")

        def worker():
            run_cmd([os.path.join(LOCAL_BIN, 'iram-cursor-switch'), cname])
            GLib.idle_add(self.set_status, f"✓ Cursor theme set to {cname} ({sz}px)")
        threading.Thread(target=worker, daemon=True).start()

