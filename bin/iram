#!/usr/bin/env bash
# ==============================================================================
# IRAM OS Unified Command Center & Dynamic Agentic Router
# Inspired by Omarchy (by DHH) & Engineered for IRAM OS (Ubuntu 26.10 + Hyprland 0.56)
# ==============================================================================
set -e

SCRIPT_SRC="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
IRAM_DIR="$(cd -- "$(dirname -- "$SCRIPT_SRC")/.." && pwd)"
if [ ! -d "$IRAM_DIR/build" ] && [ -d "$HOME/iram-os/build" ]; then
    IRAM_DIR="$HOME/iram-os"
fi
IRAM_BIN_DIR="$IRAM_DIR/bin"
LOCAL_BIN="$HOME/.local/bin"

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

# Default configuration directory
CONFIG_DIR="$HOME/.config/iram"
mkdir -p "$CONFIG_DIR"

show_banner() {
    echo -e "${BOLD}${CYAN}IRAM OS Command Center${NC} ${GREEN}(v26.10-stonking-enhanced)${NC}"
    echo -e "Autonomous Agentic Desktop • Hyprland • Waybar • Storytold Craft Suite\n"
}

show_help() {
    show_banner
    echo -e "${BOLD}USAGE:${NC}"
    echo -e "  iram <command> [arguments...]"
    echo -e "  iram <group> <subcommand> [arguments...]"
    echo -e "  iram commands [--json] [--all]\n"
    
    echo -e "${BOLD}CORE COMMAND GROUPS:${NC}"
    echo -e "  ${CYAN}hub${NC} [dashboard]           Sovereign Command Hub (3D, Voice, Agent Swarm & System)"
    echo -e "  ${CYAN}agent${NC} [prompt|account|usage] Autonomous coding agent, direct prompting & multi-account failover"
    echo -e "  ${CYAN}nexus${NC} [gui|3d]              Toggle IRAM Nexus floating desktop intelligence (or 'sidecar')"
    echo -e "  ${CYAN}openclaw${NC} [cmd]            OpenClaw multi-channel gateway & agent daemon"
    echo -e "  ${CYAN}video${NC} [prompt] [opts]     Universal Film & Video Studio (Shorts, Film, Cinema)"
    echo -e "  ${CYAN}voice${NC} [speak|clone|design] Open-source VoiceStudio engine (cloning, design & dubbing)"
    echo -e "  ${CYAN}craft${NC} [app]               Storytold Creative Suite (photo, vector, film, sound, cad...)"
    echo -e "  ${CYAN}theme${NC} [list|set|generate|timeline] Live zero-restart theme switcher (49 curated palettes & AI Generator)"
    echo -e "  ${CYAN}fetch${NC} [alpora|watch]       Faceted polygon mountain system card synchronized with theme"
    echo -e "  ${CYAN}audio${NC} [tuning|toggle|init] PipeWire studio audio routing & calibrated hardware DSP tuning"
    echo -e "  ${CYAN}network${NC} [scan|watch|info] Wi-Fi network radar: scan & monitor connected devices"
    echo -e "  ${CYAN}quant${NC} [us|in|all]         Cross-market algorithmic stock leader scanner (US & NSE)"
    echo -e "  ${CYAN}migrate${NC} [run|status|create] Non-destructive timestamped system migrations engine"
    echo -e "  ${CYAN}lifecycle${NC} [dispatch|list] System hooks dispatcher (theme-set, battery-low, post-update)"
    echo -e "  ${CYAN}webapp${NC} [install|list|rm]  Isolated desktop PWA generation with Launch-or-Focus"
    echo -e "  ${CYAN}capture${NC} [qr|text|webcam]  Desktop intelligence: local QR decode, OCR & webcam PiP"
    echo -e "  ${CYAN}toggle${NC} [nightlight|dnd|idle|anim] Quick system state switchboard (Super+Ctrl+O)"
    echo -e "  ${CYAN}screensaver${NC}               Ambient generative cyber screensaver (Super+Ctrl+S)"
    echo -e "  ${CYAN}terminal${NC}                  Context-aware terminal preserving active window CWD"
    echo -e "  ${CYAN}display${NC}                  Multi-monitor arrangement & refresh rate GUI"
    echo -e "  ${CYAN}brightness${NC} [+5%|-5%|N%]   Internal panel & external DDC/CI monitor brightness"
    echo -e "  ${CYAN}dictation${NC} [toggle|start|stop] Push-to-talk universal voice dictation (Super+D)"
    echo -e "  ${CYAN}reminder${NC} <mins> [msg]     Systemd user countdown timer & notification (Super+Ctrl+R)"
    echo -e "  ${CYAN}clamshell${NC} [close|open|status] Laptop lid event handler & external display migration"
    echo -e "  ${CYAN}clipboard${NC}                Clipboard history and fuzzy search"
    echo -e "  ${CYAN}default${NC} agent [name]     Select default AI coding agent (agy, openclaw, claude...)"
    echo -e "  ${CYAN}memory${NC}                   Embedded Qdrant vector retrieval & conversation memory"
    echo -e "  ${CYAN}workflow${NC}                 Stateful cyclic coding workflow graph (Plan->Code->Verify)"
    echo -e "  ${CYAN}weather${NC} [status|icon]     Live desktop weather telemetry"
    echo -e "  ${CYAN}info${NC}                     System health, kernel, compositor, and theme overview"
    echo -e "  ${CYAN}update${NC}                   Self-updating system, migration runner & package update"
    echo -e "  ${CYAN}package${NC} [deb|iso]        Build sovereign Debian package or live bootable ISO"
    echo -e "  ${CYAN}clean${NC}                    Clean temporary cache, thumbnails & flatpak runtimes\n"

    echo -e "${BOLD}AI AGENT QUICK SHORTCUTS:${NC}"
    echo -e "  ${YELLOW}a${NC}      -> Default coding agent     ${YELLOW}agy${NC}   -> Google Antigravity CLI"
    echo -e "  ${YELLOW}craft${NC}  -> Storytold ArtCraft Hub   ${YELLOW}video${NC} -> IRAM Film Studio Engine"
}

# Machine-readable command introspection for AI Agents
export_json_commands() {
    local json="["
    local first=true

    for cmd_path in "$IRAM_BIN_DIR"/iram-* "$LOCAL_BIN"/iram-*; do
        [ -f "$cmd_path" ] || continue
        local bname="$(basename "$cmd_path")"
        local action="${bname#iram-}"
        local summary="IRAM OS system utility"

        # Extract declared summary from script headers if present
        local header_summary=$(grep -m 1 -E '^# *(iram|omarchy):summary=' "$cmd_path" 2>/dev/null | cut -d= -f2- || true)
        if [ -n "$header_summary" ]; then
            summary="$header_summary"
        fi

        if [ "$first" = true ]; then
            first=false
        else
            json+=","
        fi
        json+="{\"command\":\"iram $action\",\"binary\":\"$bname\",\"summary\":\"$summary\",\"path\":\"$cmd_path\"}"
    done
    json+="]"
    echo "$json"
}

list_commands() {
    show_banner
    echo -e "${BOLD}AVAILABLE IRAM OS COMMANDS:${NC}\n"
    printf "  %-24s %s\n" "COMMAND" "DESCRIPTION"
    printf "  %-24s %s\n" "-------" "-----------"
    for cmd_path in "$IRAM_BIN_DIR"/iram-* "$LOCAL_BIN"/iram-*; do
        [ -f "$cmd_path" ] || continue
        local bname="$(basename "$cmd_path")"
        local action="${bname#iram-}"
        local summary=""
        local header_summary=$(grep -m 1 -E '^# *(iram|omarchy):summary=' "$cmd_path" 2>/dev/null | cut -d= -f2- || true)
        if [ -n "$header_summary" ]; then
            summary="$header_summary"
        else
            summary="IRAM OS $action utility"
        fi
        printf "  ${CYAN}%-24s${NC} %s\n" "iram $action" "$summary"
    done | sort -u
    echo ""
}

cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
    # --- COMMAND INTROSPECTION (FOR AGENTS & SHELL) ---
    commands)
        if [ "${1:-}" = "--json" ]; then
            export_json_commands
        else
            list_commands
        fi
        ;;

    welcome)
        exec "${LOCAL_BIN:-$HOME/.local/bin}/iram-welcome" "$@"
        ;;

    layout)
        exec "${LOCAL_BIN:-$HOME/.local/bin}/iram-layout-switch" "$@"
        ;;

    # --- AI AGENT SUBSYSTEM ---
    agent)
        sub="${1:-}"
        case "$sub" in
            prompt)
                shift
                exec "$LOCAL_BIN/iram-agent-prompt" "$@"
                ;;
            account|accounts)
                shift
                exec "$LOCAL_BIN/iram-agent-account" "$@"
                ;;
            usage)
                shift
                exec "$LOCAL_BIN/iram-agent-usage" "$@"
                ;;
            graph|swarm|3d)
                shift
                exec "$LOCAL_BIN/iram-agent-graph" "$@"
                ;;
            crash)
                shift
                exec "$LOCAL_BIN/iram-crash-diagnose" "$@"
                ;;
            *)
                exec "$LOCAL_BIN/iram-agent" "$@"
                ;;
        esac
        ;;
    nexus|sidecar)
        if [ "${1:-}" = "--3d" ] || [ "${1:-}" = "3d" ] || [ "${1:-}" = "graph" ]; then
            exec "$LOCAL_BIN/iram-agent-graph"
        fi
        exec "$LOCAL_BIN/iram-agent-nexus" "$@"
        ;;
    openclaw)
        exec "$LOCAL_BIN/openclaw" "$@"
        ;;
    copilot)
        exec "$LOCAL_BIN/iram-ai-cmd" "$@"
        ;;
    models)
        exec "$LOCAL_BIN/iram-models" "$@"
        ;;
    memory|qdrant)
        sub="${1:-}"
        if [ "$sub" = "retain" ] || [ "$sub" = "recall" ] || [ "$sub" = "reflect" ]; then
            exec "$LOCAL_BIN/iram-hindsight" "$@"
        fi
        exec "$LOCAL_BIN/iram-memory" "$@"
        ;;
    condense|context)
        exec "$LOCAL_BIN/iram-context-condenser" "$@"
        ;;
    audit|security-audit)
        exec "$LOCAL_BIN/iram-audit" "$@"
        ;;
    reverse|dissect)
        exec "$LOCAL_BIN/iram-reverse" "$@"
        ;;
    arch|architecture)
        exec "$LOCAL_BIN/iram-arch" "$@"
        ;;
    finance)
        exec "$LOCAL_BIN/iram-finance" "$@"
        ;;
    worldmonitor|radar)
        exec "$LOCAL_BIN/iram-worldmonitor" "$@"
        ;;
    swarm)
        if [ -x "$LOCAL_BIN/iram-swarm" ]; then
            exec "$LOCAL_BIN/iram-swarm" "$@"
        elif command -v ruflo >/dev/null 2>&1; then
            exec ruflo "$@"
        else
            exec npx -y ruflo "$@"
        fi
        ;;
    team)
        exec "$LOCAL_BIN/iram-team" "$@"
        ;;
    openrig)
        exec "$LOCAL_BIN/iram-openrig" "$@"
        ;;
    music)
        exec "$LOCAL_BIN/iram-music" "$@"
        ;;
    video)
        exec "$LOCAL_BIN/iram-video" "$@"
        ;;
    comfyui)
        exec "$LOCAL_BIN/iram-comfyui" "$@"
        ;;
    genai)
        exec "$LOCAL_BIN/iram-genai" "$@"
        ;;
    pre-push|prepush)
        exec "$LOCAL_BIN/iram-pre-push" "$@"
        ;;
    lock)
        exec "$LOCAL_BIN/iram-lock" "$@"
        ;;
    workflow)
        exec "$LOCAL_BIN/iram-workflow" "$@"
        ;;
    mcp)
        exec "$LOCAL_BIN/iram-mcp-server" "$@"
        ;;
    crawl)
        exec "$LOCAL_BIN/iram-crawl" "$@"
        ;;
    docling)
        exec "$LOCAL_BIN/iram-docling" "$@"
        ;;
    trace)
        exec "$LOCAL_BIN/iram-trace" "$@"
        ;;

    # --- DEFAULT SELECTION ---
    default)
        sub="${1:-}"
        shift 2>/dev/null || true
        case "$sub" in
            agent)
                agent_name="${1:-}"
                if [ -n "$agent_name" ]; then
                    echo "$agent_name" > "$CONFIG_DIR/default-agent"
                    echo -e "${GREEN}✓ Default coding agent set to:${NC} ${BOLD}$agent_name${NC}"
                else
                    current=$(cat "$CONFIG_DIR/default-agent" 2>/dev/null || echo "agy")
                    echo -e "Active default agent: ${BOLD}${CYAN}$current${NC}"
                    echo -e "Available options: ${YELLOW}agy, openclaw, claude, codex, opencode, copilot${NC}"
                fi
                ;;
            browser)
                browser_name="${1:-}"
                if [ -n "$browser_name" ]; then
                    echo "$browser_name" > "$CONFIG_DIR/default-browser"
                    echo -e "${GREEN}✓ Default browser set to:${NC} ${BOLD}$browser_name${NC}"
                else
                    current=$(cat "$CONFIG_DIR/default-browser" 2>/dev/null || echo "brave")
                    echo -e "Active default browser: ${BOLD}${CYAN}$current${NC}"
                fi
                ;;
            *)
                echo -e "Usage: iram default agent <name> | iram default browser <name>"
                ;;
        esac
        ;;

    # --- SOVEREIGN COMMAND HUB ---
    hub|dashboard)
        exec "$LOCAL_BIN/iram-hub" "$@"
        ;;

    # --- VOICE STUDIO SUBSYSTEM ---
    voice|voicestudio)
        exec "$LOCAL_BIN/iram-voice" "$@"
        ;;

    # --- VIDEO ENGINE SUBSYSTEM ---
    video)
        if [ "${1:-}" = "3d" ] || [ "${1:-}" = "--3d" ] || [ "${1:-}" = "intro" ]; then
            exec "$LOCAL_BIN/iram-video-3d"
        fi
        if command -v iram-video >/dev/null 2>&1; then
            exec iram-video "$@"
        elif [ -f "$HOME/iram-video/bin/iram-video" ]; then
            exec "$HOME/iram-video/bin/iram-video" "$@"
        else
            echo -e "${RED}iram-video engine not found.${NC} Install it or check ~/iram-video."
            exit 1
        fi
        ;;

    # --- STORYTOLD CRAFT SUITE ---
    craft)
        app="${1:-launcher}"
        if [ "$app" = "launcher" ] || [ "$app" = "hub" ]; then
            exec "$LOCAL_BIN/artcraft-launcher"
        else
            exec "$LOCAL_BIN/craft-app-runner" "$app"
        fi
        ;;

    # --- ZERO-RESTART THEME ENGINE ---
    theme|themes)
        sub="${1:-}"
        if [ "$sub" = "3d" ] || [ "$sub" = "--3d" ]; then
            exec "$LOCAL_BIN/iram-theme-3d"
        fi
        shift 2>/dev/null || true

        apply_iram_theme() {
            local target="$1"
            [ -n "$target" ] || return 1
            local slug=$(echo "$target" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

            # Remember current background before switching away
            local prev_theme=$(cat "$HOME/.local/state/iram/current/theme.name" 2>/dev/null || true)
            local cur_bg=$(readlink -f "$HOME/.local/state/iram/current/background" 2>/dev/null || true)
            if [ -n "$prev_theme" ] && [ -f "$cur_bg" ] && [[ "$cur_bg" != *"preview"* ]]; then
                mkdir -p "$HOME/.local/state/iram/theme-backgrounds"
                echo "$cur_bg" > "$HOME/.local/state/iram/theme-backgrounds/$prev_theme"
            fi

            # Search locations for theme
            local match=""
            local search_dirs=(
                "${IRAM_PATH:-$HOME/iram-os}/themes"
                "$HOME/.config/iram/themes"
                "$HOME/.config/omarchy/themes"
                "/usr/share/iram/themes"
                "/usr/share/omarchy/themes"
                "$HOME/.config/omarchy/themes.bak"
            )

            for sdir in "${search_dirs[@]}"; do
                if [ -d "$sdir/$slug" ]; then
                    match="$sdir/$slug"
                    break
                elif [ -d "$sdir/$target" ]; then
                    match="$sdir/$target"
                    break
                fi
            done

            local applied_via_omarchy=false
            if [ -x "/usr/local/bin/omarchy-theme-set" ]; then
                if /usr/local/bin/omarchy-theme-set "$slug" >/dev/null 2>&1; then
                    applied_via_omarchy=true
                elif /usr/local/bin/omarchy-theme-set "$target" >/dev/null 2>&1; then
                    applied_via_omarchy=true
                fi
            fi

            # Native IRAM Theme Application (fallback or standalone)
            if [ "$applied_via_omarchy" != true ] && [ -n "$match" ]; then
                local current_dir="$HOME/.local/state/iram/current"
                mkdir -p "$current_dir/next-theme"
                rm -rf "$current_dir/next-theme"/*
                cp -r "$match"/* "$current_dir/next-theme/"

                # Render dynamic config templates into next-theme
                if [ -f "$current_dir/next-theme/colors.toml" ] && [ -x "$LOCAL_BIN/iram-theme-set-templates" ]; then
                    "$LOCAL_BIN/iram-theme-set-templates" "$current_dir/next-theme" 2>/dev/null || true
                fi

                # Atomically swap next-theme to theme
                rm -rf "$current_dir/theme"
                mv "$current_dir/next-theme" "$current_dir/theme"

                # Store normalized slug
                echo "$slug" > "$current_dir/theme.name"

                # Choose desktop wallpaper (check per-theme memory first, then backgrounds/)
                local bg_file=""
                local remembered_bg="$HOME/.local/state/iram/theme-backgrounds/$slug"
                if [ -f "$remembered_bg" ] && [ -f "$(cat "$remembered_bg" 2>/dev/null)" ]; then
                    bg_file=$(cat "$remembered_bg")
                elif [ -d "$current_dir/theme/backgrounds" ]; then
                    bg_file=$(find "$current_dir/theme/backgrounds" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) | sort | head -n 1)
                fi
                if [ -z "$bg_file" ]; then
                    bg_file=$(find "$current_dir/theme" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) | grep -v 'preview' | sort | head -n 1 || true)
                fi
                if [ -n "$bg_file" ]; then
                    ln -sf "$bg_file" "$current_dir/background"
                fi
            fi

            # Ensure theme.name is the clean slug
            if [ -n "$slug" ]; then
                echo "$slug" > "$HOME/.local/state/iram/current/theme.name"
            fi

            # Ensure background symlink points to a real wallpaper, not preview thumbnail
            local cur_bg=$(readlink -f "$HOME/.local/state/iram/current/background" 2>/dev/null || true)
            if [ -z "$cur_bg" ] || [[ "$cur_bg" == *"preview"* ]]; then
                local better_bg=$(find "$HOME/.local/state/iram/current/theme/backgrounds" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) 2>/dev/null | sort | head -n 1)
                if [ -n "$better_bg" ]; then
                    ln -sf "$better_bg" "$HOME/.local/state/iram/current/background"
                fi
            fi

            # Sync GNOME / GTK mode if available
            if [ -x "/usr/share/omarchy/bin/omarchy-theme-set-gnome" ]; then
                /usr/share/omarchy/bin/omarchy-theme-set-gnome 2>/dev/null || true
            fi

            # Live broadcast ANSI OSC 10/11 escape sequences to all active terminals
            if [ -x "$LOCAL_BIN/iram-theme-osc" ]; then
                "$LOCAL_BIN/iram-theme-osc" "$HOME/.local/state/iram/current/theme/colors.toml" 2>/dev/null || true
            fi

            # Sync Claude Code CLI
            if [ -x "$LOCAL_BIN/iram-theme-set-claude" ]; then
                "$LOCAL_BIN/iram-theme-set-claude" 2>/dev/null || true
            fi

            # Sync Obsidian Vaults
            if [ -x "$LOCAL_BIN/iram-theme-set-obsidian" ]; then
                "$LOCAL_BIN/iram-theme-set-obsidian" 2>/dev/null || true
            fi

            # Sync Browser frame
            if [ -x "$LOCAL_BIN/iram-theme-set-browser" ]; then
                "$LOCAL_BIN/iram-theme-set-browser" 2>/dev/null || true
            fi

            # Synchronize desktop styling across Hyprland, Waybar, Wofi, Mako, and Swaybg
            if [ -x "$LOCAL_BIN/iram-theme-sync-all" ]; then
                "$LOCAL_BIN/iram-theme-sync-all" 2>/dev/null || true
            fi
        }

        case "$sub" in
            list)
                if [ -x "/usr/local/bin/omarchy-theme-list" ]; then
                    /usr/local/bin/omarchy-theme-list
                else
                    {
                        [ -d "$HOME/iram-os/themes" ] && ls -1 "$HOME/iram-os/themes"
                        [ -d "$HOME/.config/iram/themes" ] && ls -1 "$HOME/.config/iram/themes"
                        [ -d "/usr/share/iram/themes" ] && ls -1 "/usr/share/iram/themes"
                    } 2>/dev/null | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
                fi
                ;;
            current)
                cat "$HOME/.local/state/iram/current/theme.name" 2>/dev/null || cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || echo "Default"
                ;;
            random)
                rand_theme=$(ls -1 "$HOME/iram-os/themes" 2>/dev/null | shuf -n 1)
                if [ -n "$rand_theme" ]; then
                    apply_iram_theme "$rand_theme"
                    echo -e "${GREEN}✓ Random theme applied:${NC} ${BOLD}$rand_theme${NC}"
                fi
                ;;
            set)
                target="${1:-}"
                if [ -n "$target" ]; then
                    apply_iram_theme "$target"
                    echo -e "${GREEN}✓ Theme switched to:${NC} ${BOLD}$target${NC}"
                else
                    exec "$LOCAL_BIN/iram-theme-switch"
                fi
                ;;
            bg|background)
                sub_bg="${1:-next}"
                shift 2>/dev/null || true
                case "$sub_bg" in
                    next)
                        if [ -x "$LOCAL_BIN/iram-theme-bg-next" ]; then
                            "$LOCAL_BIN/iram-theme-bg-next"
                        elif [ -x "/usr/local/bin/omarchy-theme-bg-next" ]; then
                            /usr/local/bin/omarchy-theme-bg-next
                        fi
                        "$LOCAL_BIN/iram-theme-sync-all" 2>/dev/null || true
                        ;;
                    *)
                        "$LOCAL_BIN/iram-theme-bg-set" "$sub_bg" 2>/dev/null || true
                        "$LOCAL_BIN/iram-theme-sync-all" 2>/dev/null || true
                        ;;
                esac
                ;;
            timeline)
                exec "$LOCAL_BIN/iram-theme-timeline" "$@"
                ;;
            generate|ai|ai-generate)
                exec "$LOCAL_BIN/iram-theme-generate" "$@"
                ;;
            gui|"")
                exec "$LOCAL_BIN/iram-theme-switch"
                ;;
            *)
                # If invoked directly as: iram theme "Tokyo Storm"
                apply_iram_theme "$sub"
                echo -e "${GREEN}✓ Theme applied:${NC} ${BOLD}$sub${NC}"
                ;;
        esac
        ;;

    # --- AUDIO ROUTING & HARDWARE ---
    # --- AUDIO ROUTING & HARDWARE ---
    audio)
        sub="${1:-toggle}"
        shift 2>/dev/null || true
        case "$sub" in
            tuning)
                exec "$LOCAL_BIN/iram-audio-tuning" "$@"
                ;;
            switch|cycle)
                exec "$LOCAL_BIN/iram-audio-switch" "${1:-cycle}"
                ;;
            menu|select)
                exec "$LOCAL_BIN/iram-audio-switch" menu
                ;;
            list)
                exec "$LOCAL_BIN/iram-audio-switch" list
                ;;
            toggle)
                exec "$LOCAL_BIN/iram-audio-toggle"
                ;;
            init)
                exec "$LOCAL_BIN/iram-audio-init"
                ;;
            *)
                exec "$LOCAL_BIN/iram-audio-toggle"
                ;;
        esac
        ;;

    # --- WORKSPACE & DESKTOP TOOLS ---
    migrate|migrations)
        exec "$LOCAL_BIN/iram-migrate" "$@"
        ;;
    lifecycle|hooks)
        exec "$LOCAL_BIN/iram-lifecycle-dispatch" "$@"
        ;;
    webapp|webapps)
        exec "$LOCAL_BIN/iram-webapp" "$@"
        ;;
    display|displays)
        exec "$LOCAL_BIN/iram-displays-gui"
        ;;
    brightness)
        exec "$LOCAL_BIN/iram-brightness" "$@"
        ;;
    dictation|dictate)
        exec "$LOCAL_BIN/iram-dictation" "$@"
        ;;
    clamshell)
        exec "$LOCAL_BIN/iram-hw-clamshell" "$@"
        ;;
    toggle|toggles)
        exec "$LOCAL_BIN/iram-toggle" "$@"
        ;;
    screensaver|matrix)
        exec "$LOCAL_BIN/iram-screensaver-launch" "$@"
        ;;
    terminal|term)
        exec "$LOCAL_BIN/iram-terminal" "$@"
        ;;
    reminder|reminders)
        exec "$LOCAL_BIN/iram-reminder" "$@"
        ;;
    capture)
        sub="${1:-menu}"
        shift 2>/dev/null || true
        case "$sub" in
            qr)
                exec "$LOCAL_BIN/iram-capture-qr" "$@"
                ;;
            text)
                exec "$LOCAL_BIN/iram-capture-text" "$@"
                ;;
            webcam)
                exec "$LOCAL_BIN/iram-capture-webcam" "$@"
                ;;
            screenshot)
                exec "$LOCAL_BIN/iram-screenshot" "$@"
                ;;
            screenrecord)
                exec "$LOCAL_BIN/iram-screenrecord" "$@"
                ;;
            menu|"")
                exec "$LOCAL_BIN/iram-capture-menu"
                ;;
            *)
                exec "$LOCAL_BIN/iram-capture-menu"
                ;;
        esac
        ;;
    screenshot)
        exec "$LOCAL_BIN/iram-screenshot" "$@"
        ;;
    screenrecord)
        exec "$LOCAL_BIN/iram-screenrecord" "$@"
        ;;
    ocr)
        exec "$LOCAL_BIN/iram-capture-text" "$@"
        ;;
    clipboard)
        exec "$LOCAL_BIN/iram-clipboard-menu"
        ;;
    power)
        exec "$LOCAL_BIN/iram-power-menu"
        ;;
    quant|screener)
        exec python3 "$HOME/iram-quant/scanner.py" "$@"
        ;;
    apps|launcher)
        exec "$LOCAL_BIN/iram-app-launcher"
        ;;
    bar)
        exec "$LOCAL_BIN/iram-restart-bar"
        ;;
    weather)
        sub="${1:-status}"
        shift 2>/dev/null || true
        case "$sub" in
            icon)
                /usr/local/bin/omarchy-weather-icon 2>/dev/null || echo ""
                ;;
            status)
                /usr/local/bin/omarchy-weather-status 2>/dev/null || echo "Chennai  ·  Temp 29°C"
                ;;
            notify|notification)
                exec "$LOCAL_BIN/iram-notification-weather"
                ;;
            *)
                /usr/local/bin/omarchy-weather-status 2>/dev/null || echo "Chennai  ·  Temp 29°C"
                ;;
        esac
        ;;

    # --- SYSTEM MAINTENANCE & DIAGNOSTICS ---
    info|status)
        echo -e "${BOLD}${CYAN}=== IRAM OS STATUS HUD ===${NC}"
        echo -e "  ${BOLD}Distribution:${NC}  $(lsb_release -ds 2>/dev/null || cat /etc/os-release | grep PRETTY_NAME | cut -d= -f2 | tr -d '\"')"
        echo -e "  ${BOLD}Linux Kernel:${NC}  $(uname -r)"
        echo -e "  ${BOLD}Compositor:${NC}    Hyprland $(hyprctl version 2>/dev/null | grep -i tag | head -n 1 || echo '')"
        echo -e "  ${BOLD}Active Theme:${NC}  $(cat "$HOME/.local/state/iram/current/theme.name" 2>/dev/null || echo 'Tokyo Storm')"
        echo -e "  ${BOLD}Default Agent:${NC} $(cat "$CONFIG_DIR/default-agent" 2>/dev/null || echo 'agy (Google Antigravity)')"
        echo -e "  ${BOLD}Storytold Craft:${NC} ${GREEN}Ready${NC} ($LOCAL_BIN/artcraft-launcher)"
        echo -e "  ${BOLD}Video Studio:${NC}   ${GREEN}Ready${NC} (iram-video 1080p/4K Cinema & Shorts)"
        if pgrep -f 'openclaw' >/dev/null; then
            echo -e "  ${BOLD}OpenClaw Core:${NC}  ${GREEN}Online${NC}"
        else
            echo -e "  ${BOLD}OpenClaw Core:${NC}  ${YELLOW}Standby${NC}"
        fi
        ;;
    fetch)
        exec "$LOCAL_BIN/iram-fetch" "$@"
        ;;
    clean)
        echo "Cleaning Flatpak unused runtimes..."
        flatpak uninstall --unused -y 2>/dev/null || true
        echo "Cleaning thumbnails and temporary caches..."
        rm -rf ~/.cache/thumbnails/* 2>/dev/null || true
        echo -e "${GREEN}✓ System cleanup complete!${NC}"
        ;;
    update)
        exec "$LOCAL_BIN/iram-update" "$@"
        ;;
    pkg|package)
        sub="${1:-deb}"
        shift 2>/dev/null || true
        case "$sub" in
            deb)
                exec "$IRAM_BIN_DIR/../build/package-deb.sh" "$@"
                ;;
            iso)
                exec sudo "$IRAM_BIN_DIR/../build/build-iso.sh" "$@"
                ;;
            *)
                echo "Usage: iram package [deb|iso]"
                ;;
        esac
        ;;
    help|--help|-h)
        show_help
        ;;

    # --- DYNAMIC DISPATCH FALLBACK ---
    *)
        # 1. Try exact iram-<cmd> executable
        if [ -x "$LOCAL_BIN/iram-$cmd" ]; then
            exec "$LOCAL_BIN/iram-$cmd" "$@"
        elif [ -x "$IRAM_BIN_DIR/iram-$cmd" ]; then
            exec "$IRAM_BIN_DIR/iram-$cmd" "$@"
        # 2. Try craft-<cmd> executable
        elif [ -x "$LOCAL_BIN/craft-$cmd" ]; then
            exec "$LOCAL_BIN/craft-$cmd" "$@"
        elif [ -x "$IRAM_BIN_DIR/craft-$cmd" ]; then
            exec "$IRAM_BIN_DIR/craft-$cmd" "$@"
        fi

        echo -e "${RED}Unknown command:${NC} $cmd"
        echo -e "Run '${BOLD}iram help${NC}' or '${BOLD}iram commands${NC}' to view all capabilities."
        exit 1
        ;;
esac
