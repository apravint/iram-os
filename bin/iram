#!/usr/bin/env bash
# ==============================================================================
# IRAM OS Unified Command Center
# ==============================================================================
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

show_help() {
    echo -e "${BOLD}${CYAN}IRAM OS Command Center${NC} ${GREEN}(v1.5-quattro)${NC}"
    echo -e "Unified control CLI for system, themes, AI agents & Craft Suite\n"
    echo -e "${BOLD}USAGE:${NC}"
    echo -e "  iram <command> [arguments...]\n"
    echo -e "${BOLD}SYSTEM & WORKSPACE:${NC}"
    echo -e "  ${CYAN}theme${NC} [name]          List or switch desktop themes"
    echo -e "  ${CYAN}display${NC} | ${CYAN}displays${NC}    Open display & monitor settings GUI"
    echo -e "  ${CYAN}capture${NC}               Open screenshot & screen recording menu"
    echo -e "  ${CYAN}ocr${NC}                   Extract text from screen region to clipboard"
    echo -e "  ${CYAN}clipboard${NC}             Open clipboard history"
    echo -e "  ${CYAN}weather${NC} [icon|status]   Display current weather status & icon"
    echo -e "  ${CYAN}apps${NC}                  Open application launcher"
    echo -e "  ${CYAN}power${NC}                 Open system power menu\n"
    echo -e "${BOLD}CREATIVE SUITE (STORYTOLD CRAFT):${NC}"
    echo -e "  ${CYAN}craft${NC} [app]           Open ArtCraft Launcher or specific app:"
    echo -e "                        photo, vector, film, sound, light, cad,"
    echo -e "                        word, grid, deck, pdf, design, effect\n"
    echo -e "${BOLD}AI & AGENTIC OS:${NC}"
    echo -e "  ${CYAN}agent${NC} [prompt]        Launch IRAM Agentic OS assistant"
    echo -e "  ${CYAN}sidecar${NC}               Toggle AI Sidecar chat"
    echo -e "  ${CYAN}copilot${NC}               Launch Shell Copilot terminal"
    echo -e "  ${CYAN}models${NC}                Manage local AI models & weights\n"
    echo -e "${BOLD}DIAGNOSTICS & INFO:${NC}"
    echo -e "  ${CYAN}info${NC}                  Display system info and active theme"
    echo -e "  ${CYAN}clean${NC}                 Clean package caches and temporary files"
    echo -e "  ${CYAN}help${NC}                  Show this help overview"
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    theme|themes)
        sub="${1:-}"
        shift 2>/dev/null || true
        case "$sub" in
            list)
                /usr/local/bin/omarchy-theme-list
                ;;
            current)
                cat "$HOME/.local/state/iram/current/theme.name" 2>/dev/null || echo "Default"
                ;;
            set)
                target="${1:-}"
                if [ -n "$target" ]; then
                    /usr/local/bin/omarchy-theme-set "$target"
                    ~/.local/bin/iram-theme-sync-all 2>/dev/null || true
                else
                    exec iram-theme-switch
                fi
                ;;
            bg|background)
                sub_bg="${1:-next}"
                shift 2>/dev/null || true
                case "$sub_bg" in
                    next)
                        /usr/local/bin/omarchy-theme-bg-next
                        ~/.local/bin/iram-theme-sync-all 2>/dev/null || true
                        ;;
                    *)
                        /usr/local/bin/omarchy-theme-bg-set "$sub_bg" 2>/dev/null || /usr/local/bin/omarchy-theme-bg-next
                        ~/.local/bin/iram-theme-sync-all 2>/dev/null || true
                        ;;
                esac
                ;;
            gui)
                exec iram-theme-switch
                ;;
            "")
                exec iram-theme-switch
                ;;
            *)
                # If invoked as: iram theme "Cyberpunk Neon"
                /usr/local/bin/omarchy-theme-set "$sub"
                ~/.local/bin/iram-theme-sync-all 2>/dev/null || true
                ;;
        esac
        ;;
    craft)
        app="${1:-launcher}"
        if [ "$app" = "launcher" ] || [ "$app" = "hub" ]; then
            exec artcraft-launcher
        else
            exec craft-app-runner "$app"
        fi
        ;;
    ocr)
        exec iram-ocr
        ;;
    display|displays)
        exec iram-displays-gui
        ;;
    capture)
        exec iram-capture-menu
        ;;
    clipboard)
        exec iram-clipboard-menu
        ;;
    power)
        exec iram-power-menu
        ;;
    apps|launcher)
        exec iram-app-launcher
        ;;
    agent)
        exec iram-agent "$@"
        ;;
    sidecar)
        exec iram-agent-sidecar
        ;;
    copilot)
        exec iram-ai-cmd "$@"
        ;;
    models)
        exec iram-models
        ;;
    weather)
        sub="${1:-}"
        shift 2>/dev/null || true
        case "$sub" in
            icon)
                /usr/local/bin/omarchy-weather-icon 2>/dev/null || echo ""
                ;;
            status)
                /usr/local/bin/omarchy-weather-status 2>/dev/null || echo "Chennai  ·  Temp 29°C"
                ;;
            notify|notification)
                exec ~/.local/bin/iram-notification-weather
                ;;
            *)
                /usr/local/bin/omarchy-weather-status 2>/dev/null || echo "Chennai  ·  Temp 29°C"
                ;;
        esac
        ;;
    info|status)
        echo -e "${BOLD}${CYAN}=== IRAM OS STATUS ===${NC}"
        echo -e "  ${BOLD}OS:${NC} $(lsb_release -ds 2>/dev/null || cat /etc/os-release | grep PRETTY_NAME | cut -d= -f2 | tr -d '\"')"
        echo -e "  ${BOLD}Kernel:${NC} $(uname -r)"
        echo -e "  ${BOLD}Compositor:${NC} Hyprland $(hyprctl version 2>/dev/null | grep -i tag | head -n 1 || echo '')"
        echo -e "  ${BOLD}Active Theme:${NC} $(cat "$HOME/.local/state/iram/current/theme.name" 2>/dev/null || echo 'Default')"
        echo -e "  ${BOLD}Rust / Cargo:${NC} $(rustc --version 2>/dev/null || echo 'Not installed')"
        echo -e "  ${BOLD}Craft Suite:${NC} Ready (~/.local/bin/artcraft-launcher)"
        echo -e "  ${BOLD}Agent Status:${NC} $(pgrep -f 'openclaw|omarchy-agent' >/dev/null && echo -e '${GREEN}Active${NC}' || echo 'Idle')"
        ;;
    clean)
        echo "Cleaning Flatpak unused runtimes..."
        flatpak uninstall --unused -y 2>/dev/null || true
        echo "Cleaning thumbnails and temporary caches..."
        rm -rf ~/.cache/thumbnails/* 2>/dev/null || true
        echo -e "${GREEN}Cleanup complete!${NC}"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo -e "${RED}Unknown command:${NC} $cmd"
        echo "Run 'iram help' to see available commands."
        exit 1
        ;;
esac
