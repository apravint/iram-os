#!/usr/bin/env bash
# ==============================================================================
# IRAM OS Screen QR Code Scanner & Decoder (Inspired by Omarchy)
# Interactively selects any screen region, decodes QR codes locally,
# and copies the decoded URL/text to the system clipboard.
# ==============================================================================
set -euo pipefail

TMP_IMG=$(mktemp --suffix=.png)
trap 'rm -f "$TMP_IMG"' EXIT

if ! command -v slurp >/dev/null 2>&1 || ! command -v grim >/dev/null 2>&1; then
    echo "Error: grim and slurp are required for screen capture." >&2
    exit 1
fi

GEO=$(slurp 2>/dev/null || true)
if [ -z "$GEO" ]; then
    exit 0
fi

grim -g "$GEO" "$TMP_IMG"

DECODED=$(python3 - "$TMP_IMG" << 'EOF'
import sys
import cv2

img_path = sys.argv[1]
img = cv2.imread(img_path)
if img is None:
    sys.exit(1)

detector = cv2.QRCodeDetector()
val, points, qrcode = detector.detectAndDecode(img)
if val:
    print(val)
else:
    # Try grayscale and sharpening
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    val2, _, _ = detector.detectAndDecode(gray)
    if val2:
        print(val2)
    else:
        sys.exit(1)
EOF
) || true

if [ -n "$DECODED" ]; then
    if command -v wl-copy >/dev/null 2>&1; then
        echo -n "$DECODED" | wl-copy
    fi
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "IRAM QR" "📷 QR Code Decoded" "$DECODED" -t 6000
    fi
    echo "$DECODED"
else
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u low -a "IRAM QR" "No QR Code Found" "Could not detect a QR code in selected region." -t 3000
    fi
    echo "No QR code found." >&2
    exit 1
fi
