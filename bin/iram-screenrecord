#!/usr/bin/env bash
# Iram Screen Recording Tool for IRAM OS / Hyprland
set -euo pipefail

if ! command -v wf-recorder >/dev/null 2>&1; then
    msg="wf-recorder is not installed. Please install wf-recorder."
    echo "Error: $msg" >&2
    command -v notify-send >/dev/null 2>&1 && notify-send -u critical "Screen Record Failed" "$msg"
    exit 1
fi

RECORDING_DIR="$HOME/Videos"
mkdir -p "$RECORDING_DIR"

PID_FILE="${XDG_RUNTIME_DIR:-$HOME/.cache}/iram-screenrecord.pid"

# If already recording, stop it cleanly
if pgrep -x wf-recorder >/dev/null 2>&1; then
    pkill -SIGINT wf-recorder
    rm -f "$PID_FILE"
    notify-send -a "Iram Recording" "Recording Stopped" "Encoding and saving your video to ~/Videos..."
    exit 0
fi

TIMESTAMP=$(date +"%Y-%m-%d_%H-%M-%S")
FILENAME="screenrecording-${TIMESTAMP}.mp4"
FILEPATH="${RECORDING_DIR}/${FILENAME}"

# Select region with slurp
GEOM=$(slurp -b "#1a1b2688" -c "#7aa2f7" -s "#7aa2f722" 2>/dev/null || true)
if [[ -z "${GEOM:-}" ]]; then
    exit 0 # User cancelled selection
fi

notify-send -a "Iram Recording" "Recording Started" "Recording region to ~/Videos/${FILENAME}. Press Alt+Print to stop."

# Start recording in background
nohup wf-recorder -g "$GEOM" -f "$FILEPATH" >/dev/null 2>&1 &
echo $! > "$PID_FILE"
