#!/usr/bin/env bash
# ==============================================================================
# IRAM OS - Atomic Config Snapshots & Instant Rollback (iram-snapshot)
# Creates compressed, timestamped snapshots of core desktop configurations
# (~/.config/hypr, waybar, wofi, alacritty, systemd/user) and enables
# 1-second instant rollback if changes break the desktop environment.
# ==============================================================================
set -euo pipefail

SNAPSHOT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/iram-os/snapshots"
mkdir -p "${SNAPSHOT_DIR}"

CONFIGS=(
    "$HOME/.config/hypr"
    "$HOME/.config/waybar"
    "$HOME/.config/wofi"
    "$HOME/.config/alacritty"
    "$HOME/.config/systemd/user"
)

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

notify() {
    local title="$1"
    local msg="$2"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "IRAM Snapshot" "${title}" "${msg}" 2>/dev/null || true
    fi
}

get_active_theme() {
    local theme_file="$HOME/.local/state/iram/current/theme.name"
    if [[ -f "${theme_file}" ]]; then
        cat "${theme_file}"
    else
        echo "Default"
    fi
}

cmd_create() {
    local label="${1:-manual}"
    label=$(echo "${label}" | tr ' /:;' '____')
    local ts
    ts="$(date +%Y%m%d_%H%M%S)"
    local current_theme
    current_theme="$(get_active_theme)"

    local ext="tar.gz"
    local tar_cmd=("tar" "-czf")
    if command -v zstd >/dev/null 2>&1; then
        ext="tar.zst"
        tar_cmd=("tar" "--zstd" "-cf")
    fi

    local archive_name="iram_snapshot_${ts}_${label}.${ext}"
    local archive_path="${SNAPSHOT_DIR}/${archive_name}"
    local meta_path="${SNAPSHOT_DIR}/iram_snapshot_${ts}_${label}.json"

    # Collect existing targets relative to $HOME
    local targets=()
    for dir in "${CONFIGS[@]}"; do
        if [[ -e "${dir}" ]]; then
            local rel_path=".config/$(basename "${dir}")"
            if [[ -e "$HOME/${rel_path}" ]]; then
                targets+=("${rel_path}")
            fi
        fi
    done

    if [[ ${#targets[@]} -eq 0 ]]; then
        echo -e "${RED}[ERROR]${NC} No target configuration directories found in ~/.config/"
        return 1
    fi

    echo -e "${BLUE}[SNAPSHOT]${NC} Creating atomic archive of: ${targets[*]}..."
    (cd "$HOME" && "${tar_cmd[@]}" "${archive_path}" "${targets[@]}")

    local size
    size="$(du -h "${archive_path}" | cut -f1)"

    cat << EOF > "${meta_path}"
{
  "timestamp": "${ts}",
  "label": "${label}",
  "archive": "${archive_name}",
  "size": "${size}",
  "theme": "${current_theme}",
  "created_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF

    echo -e "${GREEN}✓ Snapshot created successfully!${NC}"
    echo -e "  File : ${BOLD}${archive_path}${NC} (${size})"
    echo -e "  Label: ${CYAN}${label}${NC} | Theme: ${YELLOW}${current_theme}${NC}"
    notify "Snapshot Created" "Saved ${label} (${size})"

    # Optional timeshift hook
    if [[ "${2:-}" == "--timeshift" ]] || [[ "${label}" == *"system"* ]]; then
        if command -v timeshift >/dev/null 2>&1; then
            echo -e "${BLUE}[TIMESHIFT]${NC} Creating host system-level snapshot..."
            sudo timeshift --create --comments "IRAM OS (${label})" || true
        fi
    fi
}

cmd_list() {
    echo -e "${BOLD}${CYAN}=== IRAM OS DESKTOP CONFIG SNAPSHOTS ===${NC}"
    echo -e "Location: ${SNAPSHOT_DIR}\n"

    local count=0
    printf "%-18s | %-20s | %-8s | %-16s | %s\n" "TIMESTAMP" "LABEL" "SIZE" "THEME" "FILE"
    echo "-------------------+----------------------+----------+------------------+-----------------------------------"

    shopt -s nullglob
    local meta_files=("${SNAPSHOT_DIR}"/iram_snapshot_*.json)
    shopt -u nullglob

    if [[ ${#meta_files[@]} -eq 0 ]]; then
        echo "No snapshots recorded yet."
        return 0
    fi

    for mf in "${meta_files[@]}"; do
        if command -v jq >/dev/null 2>&1; then
            local ts label sz th arch
            ts="$(jq -r '.timestamp // "N/A"' "$mf")"
            label="$(jq -r '.label // "N/A"' "$mf")"
            sz="$(jq -r '.size // "N/A"' "$mf")"
            th="$(jq -r '.theme // "N/A"' "$mf")"
            arch="$(jq -r '.archive // "N/A"' "$mf")"
            printf "%-18s | %-20s | %-8s | %-16s | %s\n" "$ts" "$label" "$sz" "$th" "$arch"
            count=$((count + 1))
        fi
    done
    echo ""
    echo "Total snapshots: ${count}"
}

cmd_restore() {
    local target="${1:-}"

    shopt -s nullglob
    local archives=("${SNAPSHOT_DIR}"/iram_snapshot_*.tar.*)
    shopt -u nullglob

    if [[ ${#archives[@]} -eq 0 ]]; then
        echo -e "${RED}[ERROR]${NC} No snapshot archives available in ${SNAPSHOT_DIR}"
        return 1
    fi

    local selected_archive=""

    if [[ -z "${target}" ]]; then
        # Interactive selection
        if [[ -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]] && command -v wofi >/dev/null 2>&1; then
            local options=()
            for arc in "${archives[@]}"; do
                options+=("$(basename "${arc}")")
            done
            local choice
            choice=$(printf "%s\n" "${options[@]}" | wofi --dmenu --prompt "Select Snapshot to Restore:" --width 650 --lines 10)
            if [[ -n "${choice}" ]]; then
                selected_archive="${SNAPSHOT_DIR}/${choice}"
            else
                echo "Restore cancelled."
                return 0
            fi
        else
            echo "Available Snapshots:"
            local idx=1
            for arc in "${archives[@]}"; do
                echo "  [$idx] $(basename "${arc}")"
                idx=$((idx + 1))
            done
            read -r -p "Enter number to restore (or 'q' to quit): " sel
            if [[ "$sel" =~ ^[0-9]+$ ]] && (( sel >= 1 && sel <= ${#archives[@]} )); then
                selected_archive="${archives[$((sel - 1))]}"
            else
                echo "Cancelled."
                return 0
            fi
        fi
    else
        # Match target by path, filename, or substring
        if [[ -f "${target}" ]]; then
            selected_archive="${target}"
        elif [[ -f "${SNAPSHOT_DIR}/${target}" ]]; then
            selected_archive="${SNAPSHOT_DIR}/${target}"
        else
            for arc in "${archives[@]}"; do
                if [[ "$(basename "${arc}")" == *"${target}"* ]]; then
                    selected_archive="${arc}"
                    break
                fi
            done
        fi
    fi

    if [[ -z "${selected_archive}" || ! -f "${selected_archive}" ]]; then
        echo -e "${RED}[ERROR]${NC} Snapshot archive not found: ${target}"
        return 1
    fi

    echo -e "${YELLOW}[SAFETY]${NC} Creating automatic safety checkpoint before restore..."
    cmd_create "pre-restore-safety" >/dev/null 2>&1 || true

    echo -e "${BLUE}[RESTORE]${NC} Extracting $(basename "${selected_archive}") into $HOME..."
    tar -xf "${selected_archive}" -C "$HOME"

    echo -e "${BLUE}[RELOAD]${NC} Reloading Hyprland and refreshing user services..."
    hyprctl reload 2>/dev/null || true
    systemctl --user daemon-reload 2>/dev/null || true
    systemctl --user restart waybar.service swaybg.service 2>/dev/null || true

    echo -e "${GREEN}✓ Desktop snapshot restored in <1s!${NC}"
    notify "Snapshot Restored" "Restored $(basename "${selected_archive}")"
}

cmd_auto() {
    # Create auto snapshot and prune older ones if > 10
    cmd_create "auto"
    
    # Prune oldest auto snapshots exceeding 10
    shopt -s nullglob
    local auto_metas=("${SNAPSHOT_DIR}"/iram_snapshot_*_auto.json)
    shopt -u nullglob
    
    if (( ${#auto_metas[@]} > 10 )); then
        local excess=$(( ${#auto_metas[@]} - 10 ))
        for (( i=0; i<excess; i++ )); do
            local meta="${auto_metas[$i]}"
            local arc="${meta%.json}.tar.zst"
            [[ -f "$arc" ]] || arc="${meta%.json}.tar.gz"
            rm -f "$meta" "$arc" 2>/dev/null || true
        done
        echo "Pruned ${excess} old automated snapshot(s)."
    fi
}

case "${1:-list}" in
    create|save)
        shift
        cmd_create "$@"
        ;;
    list|ls)
        cmd_list
        ;;
    restore|apply)
        shift
        cmd_restore "$@"
        ;;
    auto)
        cmd_auto
        ;;
    --help|-h|help)
        echo "Usage: iram snapshot [create|list|restore|auto]"
        echo "  create [label]   Create a new desktop config snapshot"
        echo "  list             List all saved snapshots"
        echo "  restore [target] Restore snapshot (interactive if no target specified)"
        echo "  auto             Automated snapshot (keeps last 10)"
        ;;
    *)
        cmd_list
        ;;
esac
