#!/usr/bin/env bash
# ==============================================================================
# IRAM OS - Atomic Config Snapshots & Rollback (iram-snapshot)
#
# Create writes to a temp file, verifies it, then renames it into place: a
# crash or a full disk cannot leave a damaged snapshot in the list.
#
# Restore extracts into a staging directory on the same filesystem, checks it,
# and swaps each config directory by rename. Files added since the snapshot are
# removed rather than merged, and any failure rolls the swap back.
#
# Machine state is out of scope: `--timeshift` asks Timeshift for that.
# ==============================================================================
set -euo pipefail

SNAPSHOT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/iram-os/snapshots"
mkdir -p "${SNAPSHOT_DIR}"
chmod 700 "${SNAPSHOT_DIR}"

# Relative to $HOME. Only these paths may be restored from an archive.
TARGETS=(
    ".config/hypr"
    ".config/waybar"
    ".config/wofi"
    ".config/swaync"
    ".config/alacritty"
    ".config/cava"
    ".config/btop"
    ".config/fastfetch"
    ".config/gtk-3.0"
    ".config/gtk-4.0"
    ".config/qt5ct"
    ".config/qt6ct"
    ".config/xdg-desktop-portal"
    ".config/systemd/user"
    ".config/iram/agent"
    ".config/iram/hooks"
    ".local/state/iram/current/theme.name"
)
AUTO_KEEP=10

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "IRAM Snapshot" "$1" "$2" 2>/dev/null || true
    fi
}

get_active_theme() {
    cat "$HOME/.local/state/iram/current/theme.name" 2>/dev/null || echo "Default"
}

sanitize_label() {
    local cleaned
    cleaned="$(printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_')"
    echo "${cleaned:0:48}"
}

decompress_flag() {
    case "$1" in
        *.tar.zst) echo "--zstd" ;;
        *.tar.gz) echo "--gzip" ;;
        *) return 1 ;;
    esac
}

# Accept only member paths under TARGETS, so a tampered or hand-copied archive
# cannot write through ../ or an absolute path into the rest of $HOME.
verify_archive() {
    local archive="$1" flag member target allowed
    flag="$(decompress_flag "$archive")" || { echo "Unsupported archive type: $archive" >&2; return 1; }
    while IFS= read -r member; do
        case "$member" in
            /*|../*|*/../*|*/..) echo "Unsafe path in archive: $member" >&2; return 1 ;;
        esac
        allowed=false
        for target in "${TARGETS[@]}"; do
            case "${member%/}" in
                "$target"|"$target"/*) allowed=true; break ;;
            esac
        done
        # Parents of a target appear as their own entries in some tar versions.
        case " ${TARGETS[*]} " in
            *" ${member%/}/"*) allowed=true ;;
        esac
        if [ "$allowed" != true ]; then
            echo "Unexpected path in archive: $member" >&2
            return 1
        fi
    done < <(tar "$flag" -tf "$archive")
    # A symlink member could redirect a later extraction outside the staging tree.
    if tar "$flag" -tvf "$archive" | awk '$1 ~ /^h/ || ($1 ~ /^l/ && ($NF ~ /^\// || $NF ~ /\.\./)) {found=1} END {exit !found}'; then
        echo "Archive holds links that escape the snapshot tree." >&2
        return 1
    fi
}

cmd_create() {
    local label timeshift=false
    label="manual"
    while [ $# -gt 0 ]; do
        case "$1" in
            --timeshift) timeshift=true ;;
            *) label="$(sanitize_label "$1")" ;;
        esac
        shift
    done

    local ts base ext="tar.gz" compress=(--gzip)
    ts="$(date +%Y%m%d_%H%M%S)"
    base="iram_snapshot_${ts}_${label}"
    if command -v zstd >/dev/null 2>&1; then
        ext="tar.zst"
        compress=(--zstd)
    fi
    # Two snapshots in the same second must not overwrite each other.
    local n=1
    while [ -e "${SNAPSHOT_DIR}/${base}.${ext}" ]; do
        base="iram_snapshot_${ts}_${label}-$n"
        n=$((n + 1))
    done

    local targets=() rel
    for rel in "${TARGETS[@]}"; do
        if [ -e "$HOME/$rel" ]; then targets+=("$rel"); fi
    done
    if [ ${#targets[@]} -eq 0 ]; then
        echo -e "${RED}[ERROR]${NC} No configuration found to snapshot." >&2
        return 1
    fi

    local tmp
    tmp="$(mktemp -p "${SNAPSHOT_DIR}" .creating-XXXXXX)"
    echo -e "${BLUE}[SNAPSHOT]${NC} Archiving ${#targets[@]} paths..."
    if ! tar -C "$HOME" "${compress[@]}" -cf "$tmp" "${targets[@]}"; then
        rm -f "$tmp"
        echo -e "${RED}[ERROR]${NC} Could not create the archive." >&2
        return 1
    fi
    if ! tar "${compress[@]}" -tf "$tmp" >/dev/null; then
        rm -f "$tmp"
        echo -e "${RED}[ERROR]${NC} The new archive failed verification." >&2
        return 1
    fi
    chmod 600 "$tmp"

    local archive_path="${SNAPSHOT_DIR}/${base}.${ext}" size meta_tmp
    size="$(du -h "$tmp" | cut -f1)"
    meta_tmp="$(mktemp -p "${SNAPSHOT_DIR}" .creating-XXXXXX)"
    jq -n --arg ts "$ts" --arg label "$label" --arg archive "${base}.${ext}" --arg size "$size" \
        --arg theme "$(get_active_theme)" --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '{timestamp:$ts, label:$label, archive:$archive, size:$size, theme:$theme, created_at:$created}' > "$meta_tmp"
    mv "$tmp" "$archive_path"
    mv "$meta_tmp" "${SNAPSHOT_DIR}/${base}.json"

    echo -e "${GREEN}✓ Snapshot created${NC}"
    echo -e "  File : ${BOLD}${archive_path}${NC} (${size})"
    echo -e "  Label: ${CYAN}${label}${NC} | Theme: ${YELLOW}$(get_active_theme)${NC}"
    notify "Snapshot Created" "Saved ${label} (${size})"
    SNAPSHOT_RESULT="$archive_path"

    if [ "$timeshift" = true ]; then
        if command -v timeshift >/dev/null 2>&1; then
            echo -e "${BLUE}[TIMESHIFT]${NC} Creating system-level snapshot..."
            sudo timeshift --create --comments "IRAM OS (${label})"
        else
            echo -e "${YELLOW}Timeshift is not installed; only the config snapshot was taken.${NC}"
        fi
    fi
}

cmd_list() {
    local meta count=0 json=false
    [ "${1:-}" = "--json" ] && json=true
    shopt -s nullglob
    local meta_files=("${SNAPSHOT_DIR}"/iram_snapshot_*.json)
    shopt -u nullglob

    if [ "$json" = true ]; then
        if [ ${#meta_files[@]} -eq 0 ]; then echo "[]"; else jq -s '.' "${meta_files[@]}"; fi
        return 0
    fi

    echo -e "${BOLD}${CYAN}=== IRAM OS DESKTOP CONFIG SNAPSHOTS ===${NC}"
    echo -e "Location: ${SNAPSHOT_DIR}\n"
    if [ ${#meta_files[@]} -eq 0 ]; then
        echo "No snapshots recorded yet."
        return 0
    fi
    printf "%-18s | %-20s | %-8s | %-16s | %s\n" "TIMESTAMP" "LABEL" "SIZE" "THEME" "FILE"
    for meta in "${meta_files[@]}"; do
        jq -r '[.timestamp, .label, .size, .theme, .archive] | @tsv' "$meta" | \
            awk -F'\t' '{printf "%-18s | %-20s | %-8s | %-16s | %s\n", $1, $2, $3, $4, $5}'
        count=$((count + 1))
    done
    echo -e "\nTotal snapshots: ${count}"
}

select_archive() {
    local target="$1" arc idx choice sel
    shopt -s nullglob
    local archives=("${SNAPSHOT_DIR}"/iram_snapshot_*.tar.*)
    shopt -u nullglob
    if [ ${#archives[@]} -eq 0 ]; then
        echo -e "${RED}[ERROR]${NC} No snapshots in ${SNAPSHOT_DIR}" >&2
        return 1
    fi

    if [ -n "$target" ]; then
        if [ "$target" = latest ]; then
            printf '%s\n' "${archives[-1]}"
            return 0
        fi
        if [ -f "$target" ]; then printf '%s\n' "$target"; return 0; fi
        if [ -f "${SNAPSHOT_DIR}/$target" ]; then printf '%s\n' "${SNAPSHOT_DIR}/$target"; return 0; fi
        local matches=()
        for arc in "${archives[@]}"; do
            case "$(basename "$arc")" in *"$target"*) matches+=("$arc") ;; esac
        done
        if [ ${#matches[@]} -eq 1 ]; then printf '%s\n' "${matches[0]}"; return 0; fi
        echo -e "${RED}[ERROR]${NC} '$target' matches ${#matches[@]} snapshots." >&2
        return 1
    fi

    if [ -t 0 ]; then
        idx=1
        for arc in "${archives[@]}"; do
            echo "  [$idx] $(basename "$arc")" >&2
            idx=$((idx + 1))
        done
        read -r -p "Enter number to restore (or q to quit): " sel
        if [[ "$sel" =~ ^[0-9]+$ ]] && (( sel >= 1 && sel <= ${#archives[@]} )); then
            printf '%s\n' "${archives[$((sel - 1))]}"
            return 0
        fi
    elif command -v wofi >/dev/null 2>&1; then
        choice="$(for arc in "${archives[@]}"; do basename "$arc"; done | wofi --dmenu --prompt "Select Snapshot to Restore:" --width 650 --lines 10 || true)"
        if [ -n "$choice" ]; then printf '%s\n' "${SNAPSHOT_DIR}/${choice}"; return 0; fi
    fi
    return 2
}

cmd_restore() {
    local selected status=0 no_safety=false target=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --no-safety-snapshot) no_safety=true ;;
            *) target="$1" ;;
        esac
        shift
    done
    selected="$(select_archive "$target")" || status=$?
    if [ "$status" -eq 2 ]; then echo "Restore cancelled."; return 0; fi
    [ "$status" -eq 0 ] || return "$status"

    verify_archive "$selected"

    local staging flag
    flag="$(decompress_flag "$selected")"
    staging="$(mktemp -d -p "$HOME" .iram-restore-XXXXXX)"
    # shellcheck disable=SC2064
    trap "rm -rf '$staging'" RETURN
    tar "$flag" -xf "$selected" -C "$staging" --no-same-owner

    if [ -f "$staging/.config/hypr/hyprland.conf" ] && command -v Hyprland >/dev/null 2>&1 && [ -n "${IRAM_SNAPSHOT_VERIFY_HYPR:-}" ]; then
        if ! HOME="$staging" Hyprland --verify-config --config "$staging/.config/hypr/hyprland.conf" >/dev/null 2>&1; then
            echo -e "${RED}[ERROR]${NC} hyprland.conf in that snapshot does not verify." >&2
            return 1
        fi
    fi

    if [ "$no_safety" != true ]; then
        echo -e "${YELLOW}[SAFETY]${NC} Saving the current state before restoring..."
        cmd_create "pre-restore-safety" >/dev/null || { echo -e "${RED}[ERROR]${NC} Safety snapshot failed; nothing was changed." >&2; return 1; }
        echo -e "  Saved as $(basename "$SNAPSHOT_RESULT")"
    fi

    # Swap each target by rename. Targets missing from the snapshot are left alone.
    local rel swapped=() parent failed=false
    for rel in "${TARGETS[@]}"; do
        [ -e "$staging/$rel" ] || continue
        parent="$(dirname "$HOME/$rel")"
        mkdir -p "$parent"
        if [ -e "$HOME/$rel" ]; then
            if ! mv -T "$HOME/$rel" "$staging/$rel.iram-old"; then failed=true; break; fi
        fi
        if ! mv -T "$staging/$rel" "$HOME/$rel"; then
            if [ -e "$staging/$rel.iram-old" ]; then mv -T "$staging/$rel.iram-old" "$HOME/$rel" || true; fi
            failed=true
            break
        fi
        swapped+=("$rel")
    done

    if [ "$failed" = true ]; then
        echo -e "${RED}[ERROR]${NC} Swap failed; rolling back." >&2
        for rel in "${swapped[@]}"; do
            rm -rf "${HOME:?}/$rel"
            mv -T "$staging/$rel.iram-old" "$HOME/$rel" 2>/dev/null || true
        done
        return 1
    fi

    echo -e "${BLUE}[RELOAD]${NC} Reloading Hyprland and user services..."
    if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        hyprctl reload >/dev/null 2>&1 || echo -e "${YELLOW}Notice: hyprctl reload failed.${NC}"
        systemctl --user daemon-reload 2>/dev/null || true
        systemctl --user try-restart waybar.service swaync.service 2>/dev/null || true
    fi

    echo -e "${GREEN}✓ Restored $(basename "$selected") (${#swapped[@]} paths)${NC}"
    notify "Snapshot Restored" "Restored $(basename "$selected")"
}

cmd_prune() {
    local keep="${1:-$AUTO_KEEP}" meta
    shopt -s nullglob
    local auto_metas=("${SNAPSHOT_DIR}"/iram_snapshot_*_auto*.json)
    shopt -u nullglob
    local excess=$(( ${#auto_metas[@]} - keep ))
    [ "$excess" -gt 0 ] || return 0
    for meta in "${auto_metas[@]:0:$excess}"; do
        rm -f "${meta%.json}.tar.zst" "${meta%.json}.tar.gz" "$meta"
    done
    echo "Pruned ${excess} old automated snapshot(s)."
}

case "${1:-list}" in
    create|save)
        shift
        cmd_create "$@"
        ;;
    list|ls)
        shift || true
        cmd_list "$@"
        ;;
    restore|apply|rollback)
        shift
        cmd_restore "$@"
        ;;
    auto)
        cmd_create "auto"
        cmd_prune
        ;;
    prune)
        shift
        cmd_prune "$@"
        ;;
    --help|-h|help)
        echo "Usage: iram snapshot <command>"
        echo "  create [label] [--timeshift]   Create a config snapshot"
        echo "  list [--json]                  List snapshots"
        echo "  restore [name|latest]          Atomically restore (saves current state first)"
        echo "  auto                           Automated snapshot, keeps the last $AUTO_KEEP"
        echo "  prune [keep]                   Delete old automated snapshots"
        ;;
    *)
        echo "Unknown command: $1. See: iram snapshot help" >&2
        exit 2
        ;;
esac
