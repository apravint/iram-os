#!/usr/bin/env bash
# ==============================================================================
# IRAM OS - Window Animations & Blur Performance Toggle
# Toggles Hyprland animations and blur in real-time without reloading.
# Inspired by Omarchy 4.5
# https://github.com/apravint/iram-os
# ==============================================================================
set -euo pipefail

STATE_DIR="$HOME/.local/state/iram/toggles"
STATE_FILE="$STATE_DIR/no-animations"
mkdir -p "$STATE_DIR"

current_state() {
    local val
    val=$(hyprctl getoption animations:enabled 2>/dev/null | awk '/int:/ {print $2}')
    if [[ "$val" == "0" ]]; then
        echo "disabled"
    else
        echo "enabled"
    fi
}

notify_state() {
    local state="$1"
    if [[ "$state" == "enabled" ]]; then
        notify-send -a "IRAM OS" "⚡ Desktop Animations" "Smooth window animations & blur: ON" -i "preferences-desktop-display" -t 2000
    else
        notify-send -a "IRAM OS" "⚡ Performance Mode" "Animations & blur: OFF (Instant window response)" -i "dialog-information" -t 2000
    fi
}

ACTION="${1:-toggle}"

case "$ACTION" in
    off|disable|performance)
        hyprctl keyword animations:enabled 0 >/dev/null 2>&1 || true
        hyprctl keyword decoration:blur:enabled 0 >/dev/null 2>&1 || true
        touch "$STATE_FILE"
        notify_state "disabled"
        echo "Animations disabled (Performance mode)"
        ;;
    on|enable|smooth)
        hyprctl keyword animations:enabled 1 >/dev/null 2>&1 || true
        hyprctl keyword decoration:blur:enabled 1 >/dev/null 2>&1 || true
        rm -f "$STATE_FILE"
        notify_state "enabled"
        echo "Animations enabled (Smooth mode)"
        ;;
    status)
        current_state
        ;;
    toggle|*)
        cur=$(current_state)
        if [[ "$cur" == "enabled" ]]; then
            hyprctl keyword animations:enabled 0 >/dev/null 2>&1 || true
            hyprctl keyword decoration:blur:enabled 0 >/dev/null 2>&1 || true
            touch "$STATE_FILE"
            notify_state "disabled"
            echo "Animations disabled (Performance mode)"
        else
            hyprctl keyword animations:enabled 1 >/dev/null 2>&1 || true
            hyprctl keyword decoration:blur:enabled 1 >/dev/null 2>&1 || true
            rm -f "$STATE_FILE"
            notify_state "enabled"
            echo "Animations enabled (Smooth mode)"
        fi
        ;;
esac
