#!/usr/bin/env bash
# Iram Power Menu via Wofi
set -euo pipefail

if ! command -v wofi >/dev/null 2>&1; then
    notify-send -u critical "Power Menu" "wofi is not installed." 2>/dev/null || echo "wofi not installed" >&2
    exit 1
fi

OPTIONS="🔒 Lock
⚡ Power profile ($(iram-power-profile get 2>/dev/null || echo unavailable))
💤 Suspend
🚪 Logout
🔄 Reboot
🛑 Shutdown"

CHOICE=$(echo -e "$OPTIONS" | wofi --dmenu --prompt "System:" --width 300 --height 310 || true)

case "$CHOICE" in
    *"Lock"*)
        BG=$(readlink -f "$HOME/.local/state/iram/current/background" 2>/dev/null || true)
        if [[ -n "$BG" && -f "$BG" ]]; then
            swaylock -f -i "$BG" -s fill
        else
            swaylock -f -c 1a1b26
        fi
        ;;
    *"Power profile"*)
        iram-power-profile menu
        ;;
    *"Suspend"*)
        systemctl suspend
        ;;
    *"Logout"*)
        hyprctl dispatch exit
        ;;
    *"Reboot"*)
        systemctl reboot
        ;;
    *"Shutdown"*)
        systemctl poweroff
        ;;
esac
