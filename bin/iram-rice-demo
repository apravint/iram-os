#!/usr/bin/env bash
# ==============================================================================
# IRAM OS - Flagship "r/unixporn" Rice Showcase Mode
# Keybind: Super + Shift + R
#
# Automatically switches to Workspace 8 and tiles a 4-quadrant layout:
#  1. Master Left Top:    Alacritty running fastfetch
#  2. Master Left Bottom: Alacritty running cava (or animated audio spectrum)
#  3. Right Top:          Alacritty running btop (system graphs)
#  4. Right Bottom:       Alacritty running iram doctor / telemetry
#
# Options:
#  --cycle                Automatically cycle 5 flagship themes every 2s
#  --interval <sec>       Custom cycle duration (default: 2)
#  --workspace <num>      Target workspace (default: 8)
#  --close                Close all showcase windows on target workspace
# ==============================================================================
set -euo pipefail

WORKSPACE="${WORKSPACE:-8}"
INTERVAL=2
DO_CYCLE=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --cycle|-c)
            DO_CYCLE=true
            shift
            ;;
        --interval|-i)
            INTERVAL="${2:-2}"
            shift 2
            ;;
        --workspace|-w)
            WORKSPACE="${2:-8}"
            shift 2
            ;;
        --close)
            if command -v hyprctl >/dev/null 2>&1; then
                hyprctl clients -j | jq -r ".[] | select(.workspace.id == $WORKSPACE or .workspace.name == \"$WORKSPACE\") | .address" | while read -r addr; do
                    [ -n "$addr" ] && hyprctl dispatch closewindow address:"$addr" 2>/dev/null || true
                done
            fi
            echo "Closed showcase windows on workspace $WORKSPACE."
            exit 0
            ;;
        *)
            shift
            ;;
    esac
done

FLAGSHIP_THEMES=(
    "Tokyo Night"
    "Catppuccin Mocha"
    "Gruvbox"
    "Nord"
    "Everforest"
)

echo -e "\033[1;34m========================================================\033[0m"
echo -e "\033[1;32m      ✨ IRAM OS - Flagship Rice Showcase Mode ✨\033[0m"
echo -e "\033[1;34m========================================================\033[0m"

# 1. Switch to clean showcase workspace
if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    echo "Switching to Workspace $WORKSPACE..."
    hyprctl dispatch workspace "$WORKSPACE" >/dev/null 2>&1 || true
    sleep 0.2
fi

# 2. Window 1: Fastfetch (Master Left Top)
echo "Launching Fastfetch System Card..."
alacritty \
    --class "iram-showcase-fastfetch" \
    --title "IRAM OS System Intelligence" \
    --command bash -c "fastfetch -c ~/.config/fastfetch/config.jsonc; echo ''; read -r -p '  [Press Enter to close]' || bash" &
sleep 0.35

# 3. Window 2: btop System Monitor (Right Top)
echo "Launching btop System Graph..."
alacritty \
    --class "iram-showcase-btop" \
    --title "IRAM Resource Monitor" \
    --command btop &
sleep 0.35

# 4. Window 3: Cava Audio Spectrum (Master Left Bottom)
echo "Launching Cava Audio Spectrum..."
if command -v cava >/dev/null 2>&1; then
    alacritty \
        --class "iram-showcase-cava" \
        --title "IRAM Spectrum Visualizer" \
        --command cava &
else
    # High-quality fallback equalizer simulation
    alacritty \
        --class "iram-showcase-cava" \
        --title "IRAM Spectrum Visualizer" \
        --command python3 -c '
import time, math, random, sys, os
colors = ["\033[38;2;122;162;247m", "\033[38;2;125;207;255m", "\033[38;2;187;154;247m", "\033[38;2;247;118;142m", "\033[38;2;158;206;106m"]
reset = "\033[0m"
chars = [" ", " ", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
cols = 40
print("\033[?25l\033[2J")
t = 0.0
try:
    while True:
        bars = []
        for i in range(cols):
            val = math.sin(t * 1.5 + i * 0.25) * 0.4 + math.cos(t * 2.2 - i * 0.15) * 0.3 + random.uniform(0.1, 0.3)
            idx = min(len(chars) - 1, max(0, int(val * (len(chars) - 1))))
            c = colors[i % len(colors)]
            bars.append(f"{c}{chars[idx] * 2}{reset}")
        sys.stdout.write("\r  " + " ".join(bars) + "  ")
        sys.stdout.flush()
        time.sleep(0.04)
        t += 0.08
except KeyboardInterrupt:
    print("\033[?25h")
' &
fi
sleep 0.35

# 5. Window 4: IRAM Telemetry & Doctor (Right Bottom)
echo "Launching IRAM OS Telemetry & Doctor..."
alacritty \
    --class "iram-showcase-telemetry" \
    --title "IRAM OS Health Telemetry" \
    --command bash -c "
        echo -e '\033[1;36m╭──────────────────────────────────────────────────────────╮\033[0m'
        echo -e '\033[1;36m│          🛡️  IRAM OS COMPOSITOR & SERVICE TELEMETRY      │\033[0m'
        echo -e '\033[1;36m╰──────────────────────────────────────────────────────────╯\033[0m'
        iram info 2>/dev/null || iram doctor 2>/dev/null || agy --version 2>/dev/null || uptime
        echo ''
        echo -e '\033[1;33m  ⚡ Active Keybinds:\033[0m'
        echo -e '    • Super + N               : SwayNC Notification Center'
        echo -e '    • Super + Ctrl+Shift+Space: 22-Theme Switcher'
        echo -e '    • Super + Shift + R       : Rice Showcase Mode'
        echo -e '    • Super + Shift + W       : Next Wallpaper'
        echo ''
        read -r -p '  [Press Enter to close]' || bash
    " &
sleep 0.35

# Rebalance tiles if on Hyprland
if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    hyprctl dispatch focuswindow class:iram-showcase-fastfetch >/dev/null 2>&1 || true
fi

echo -e "\033[1;32m✓ 4-Tile Rice Showcase arranged on Workspace $WORKSPACE!\033[0m"

# 6. Flagship Theme Cycling Mode
if [ "$DO_CYCLE" = true ]; then
    echo -e "\n\033[1;33m🎬 Starting Automatic Theme Carousel (Interval: ${INTERVAL}s)...\033[0m"
    echo -e "\033[0;90m   Press Ctrl + C anytime to exit theme cycle.\033[0m\n"
    
    trap 'echo -e "\n\033[1;32m✓ Theme carousel stopped.\033[0m"; exit 0' SIGINT SIGTERM
    
    while true; do
        for theme_name in "${FLAGSHIP_THEMES[@]}"; do
            echo -e "🎨 [Showcase Carousel] Applying: \033[1;36m$theme_name\033[0m ..."
            iram theme set "$theme_name" >/dev/null 2>&1 || true
            sleep "$INTERVAL"
        done
    done
fi
