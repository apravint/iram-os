#!/usr/bin/env bash
# ==============================================================================
# IRAM OS - Flagship "r/unixporn" Rice Showcase Mode
# Keybind: Super + Shift + R
#
# Automatically switches to Workspace 8 and tiles a balanced 4-quadrant layout:
#  1. Top Left:     Alacritty running fastfetch (dynamic live theme sync)
#  2. Bottom Left:  Alacritty running iram-visualizer (multi-row audio spectrum)
#  3. Top Right:    Alacritty running btop (system graphs)
#  4. Bottom Right: Alacritty running iram telemetry & doctor
#
# Options:
#  --cycle                Automatically cycle 5 flagship themes every 2.5s
#  --interval <sec>       Custom cycle duration (default: 2.5)
#  --workspace <num>      Target workspace (default: 8)
#  --close                Close all showcase windows on target workspace
# ==============================================================================
set -euo pipefail

WORKSPACE="${WORKSPACE:-8}"
INTERVAL=2.5
DO_CYCLE=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --cycle|-c)
            DO_CYCLE=true
            shift
            ;;
        --interval|-i)
            INTERVAL="${2:-2.5}"
            shift 2
            ;;
        --workspace|-w)
            WORKSPACE="${2:-8}"
            shift 2
            ;;
        --close)
            if command -v hyprctl >/dev/null 2>&1; then
                hyprctl clients -j | jq -r ".[] | select(.workspace.id == $WORKSPACE or .workspace.name == \"$WORKSPACE\") | .address" | while read -r addr; do
                    [ -n "$addr" ] && hyprctl dispatch closewindow address:"$addr" 2>/dev/null || true
                done
            fi
            echo "Closed showcase windows on workspace $WORKSPACE."
            exit 0
            ;;
        *)
            shift
            ;;
    esac
done

FLAGSHIP_THEMES=(
    "Tokyo Night"
    "Catppuccin Mocha"
    "Gruvbox"
    "Nord"
    "Everforest"
)

echo -e "\033[1;34m========================================================\033[0m"
echo -e "\033[1;32m      ✨ IRAM OS - Flagship Rice Showcase Mode ✨\033[0m"
echo -e "\033[1;34m========================================================\033[0m"

# 1. Close existing showcase windows and switch to clean showcase workspace
if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    hyprctl clients -j | jq -r ".[] | select(.class | startswith(\"iram-showcase\")) | .address" | while read -r addr; do
        [ -n "$addr" ] && hyprctl dispatch closewindow address:"$addr" 2>/dev/null || true
    done
    sleep 0.3
    hyprctl dispatch workspace "$WORKSPACE" >/dev/null 2>&1 || true
    sleep 0.3
fi

# 2. Window 1: Fastfetch (Top Left)
echo "Launching Fastfetch System Card (Top Left)..."
alacritty \
    --class "iram-showcase-fastfetch" \
    --title "IRAM OS System Intelligence" \
    --command bash -c '
        printf "\033[?25l"
        LAST=""
        while true; do
            CUR=$(cat "$HOME/.local/state/iram/current/theme.name" 2>/dev/null || echo "")
            if [ "$CUR" != "$LAST" ]; then
                clear
                fastfetch -c "$HOME/.config/fastfetch/config.jsonc"
                LAST="$CUR"
            fi
            sleep 0.4
        done
    ' &
sleep 0.55

# 3. Window 2: Preselect Right -> Btop (Top Right)
echo "Launching Btop System Monitor (Top Right)..."
if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    hyprctl dispatch layoutmsg preselect r >/dev/null 2>&1 || true
    sleep 0.15
fi
alacritty \
    --class "iram-showcase-btop" \
    --title "IRAM Resource Monitor" \
    --command btop &
sleep 0.55

# 4. Window 3: Focus Fastfetch -> Preselect Down -> Visualizer (Bottom Left)
echo "Launching Spectrum Visualizer (Bottom Left)..."
if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    hyprctl dispatch focuswindow class:iram-showcase-fastfetch >/dev/null 2>&1 || true
    sleep 0.2
    hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
    sleep 0.15
fi

VISUALIZER_CMD="iram-visualizer"
if ! command -v "$VISUALIZER_CMD" >/dev/null 2>&1; then
    VISUALIZER_CMD="$HOME/iram-os/bin/iram-visualizer"
fi

alacritty \
    --class "iram-showcase-cava" \
    --title "IRAM Live Spectrum Visualizer" \
    --command "$VISUALIZER_CMD" &
sleep 0.55

# 5. Window 4: Focus Btop -> Preselect Down -> Telemetry (Bottom Right)
echo "Launching IRAM OS Telemetry & Doctor (Bottom Right)..."
if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    hyprctl dispatch focuswindow class:iram-showcase-btop >/dev/null 2>&1 || true
    sleep 0.2
    hyprctl dispatch layoutmsg preselect d >/dev/null 2>&1 || true
    sleep 0.15
fi

alacritty \
    --class "iram-showcase-telemetry" \
    --title "IRAM OS Health Telemetry" \
    --command bash -c '
        printf "\033[?25l"
        LAST=""
        while true; do
            CUR=$(cat "$HOME/.local/state/iram/current/theme.name" 2>/dev/null || echo "")
            if [ "$CUR" != "$LAST" ]; then
                clear
                echo -e "\033[1;36m╭──────────────────────────────────────────────────────────╮\033[0m"
                echo -e "\033[1;36m│          🛡️   IRAM OS COMPOSITOR & SERVICE TELEMETRY     │\033[0m"
                echo -e "\033[1;36m╰──────────────────────────────────────────────────────────╯\033[0m"
                iram info 2>/dev/null || uptime
                echo ""
                echo -e "\033[1;33m  ⚡ Active Keybinds:\033[0m"
                echo -e "    • \033[1;37mSuper + N\033[0m               : SwayNC Notification Center"
                echo -e "    • \033[1;37mSuper + Ctrl+Shift+Space\033[0m: 22-Theme Switcher"
                echo -e "    • \033[1;37mSuper + Shift + R\033[0m       : Rice Showcase Mode"
                echo -e "    • \033[1;37mSuper + Shift + W\033[0m       : Next Wallpaper"
                echo ""
                LAST="$CUR"
            fi
            sleep 0.4
        done
    ' &
sleep 0.55

# Focus Fastfetch for clean visual aesthetics
if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    hyprctl dispatch focuswindow class:iram-showcase-fastfetch >/dev/null 2>&1 || true
fi

echo -e "\033[1;32m✓ Perfect 2x2 Rice Showcase arranged on Workspace $WORKSPACE!\033[0m"

# 6. Flagship Theme Cycling Mode
if [ "$DO_CYCLE" = true ]; then
    echo -e "\n\033[1;33m🎬 Starting Automatic Theme Carousel (Interval: ${INTERVAL}s)...\033[0m"
    echo -e "\033[0;90m   Press Ctrl + C anytime to exit theme cycle.\033[0m\n"
    
    trap 'echo -e "\n\033[1;32m✓ Theme carousel stopped.\033[0m"; exit 0' SIGINT SIGTERM
    
    while true; do
        for theme_name in "${FLAGSHIP_THEMES[@]}"; do
            echo -e "🎨 [Showcase Carousel] Applying: \033[1;36m$theme_name\033[0m ..."
            iram theme set "$theme_name" >/dev/null 2>&1 || true
            sleep "$INTERVAL"
        done
    done
fi
