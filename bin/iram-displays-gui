#!/usr/bin/env python3
"""
Iram Display Configuration GUI
Native Wayland/Hyprland display settings utility for Iram.
"""

import json
import os
import subprocess
import sys
import gi

gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk, GLib


def get_hypr_monitors():
    try:
        out = subprocess.check_output(['hyprctl', '-j', 'monitors', 'all'], text=True)
        return json.loads(out)
    except Exception as e:
        print(f"Error reading hyprctl monitors: {e}", file=sys.stderr)
        return []


def apply_monitor_setting(name, res, pos, scale):
    # Format: hyprctl keyword monitor "<name>,<res>,<pos>,<scale>"
    cmd = ['hyprctl', 'keyword', 'monitor', f"{name},{res},{pos},{scale}"]
    subprocess.run(cmd, check=False)


def save_to_hyprland_conf(monitors_data):
    conf_path = os.path.expanduser('~/.config/hypr/hyprland.conf')
    if not os.path.exists(conf_path):
        return False, "hyprland.conf not found"

    # Always create a backup before modifying
    import shutil
    try:
        shutil.copy2(conf_path, conf_path + '.bak')
    except Exception:
        pass

    with open(conf_path, 'r', encoding='utf-8') as f:
        lines = f.readlines()

    # Filter out existing monitor lines and display setup comments
    cleaned_lines = []
    for line in lines:
        stripped = line.strip()
        if (stripped.startswith('monitor =') or stripped.startswith('monitor=') or
            "Display setup generated by Iram Display Settings" in stripped):
            continue
        cleaned_lines.append(line)

    # Safety Guard: If cleaned_lines is corrupted or truncated (< 25 lines), recover from base template
    if len(cleaned_lines) < 25:
        fallback_templates = [
            os.path.expanduser('~/iram-os/config/hypr/hyprland.conf'),
            '/usr/share/iram/config/hypr/hyprland.conf'
        ]
        for fb in fallback_templates:
            if os.path.exists(fb):
                try:
                    with open(fb, 'r', encoding='utf-8') as fb_f:
                        fb_lines = fb_f.readlines()
                    fb_cleaned = [
                        l for l in fb_lines
                        if not (l.strip().startswith('monitor =') or l.strip().startswith('monitor=') or
                                "Display setup generated by Iram Display Settings" in l)
                    ]
                    if len(fb_cleaned) > len(cleaned_lines):
                        cleaned_lines = fb_cleaned
                        break
                except Exception:
                    pass

    # Insert new monitor configuration under the monitor section
    new_monitor_lines = [
        "# Display setup generated by Iram Display Settings\n"
    ]
    
    # Auto-adjust if two displays are accidentally both assigned 0x0
    active_enabled = [m for m in monitors_data if not m.get('disabled', False)]
    if len(active_enabled) > 1 and all(m.get('pos') == '0x0' for m in active_enabled):
        # Separate primary monitor and extended TV, prioritizing Samsung as primary
        def sort_key(mon):
            d = (mon.get('desc', '') + ' ' + mon.get('name', '')).lower()
            if 'samsung' in d:
                return 0
            if 'sony' in d:
                return 1
            return 0
        active_enabled.sort(key=sort_key)
        for idx, m in enumerate(active_enabled):
            m['pos'] = f"{idx * 1920}x0"

    for m in monitors_data:
        target = f"desc:{m['desc']}" if m.get('desc') else m['name']
        if m.get('disabled', False):
            new_monitor_lines.append(f"monitor = {target}, disable\n")
        else:
            new_monitor_lines.append(f"monitor = {target}, {m['res']}, {m['pos']}, {m['scale']}\n")
    new_monitor_lines.append("monitor = , preferred, auto, 1\n")

    # Find the insertion point (after monitor header comment or top of file)
    insert_idx = 0
    for idx, l in enumerate(cleaned_lines):
        if "Monitor setup" in l:
            insert_idx = idx + 1
            break

    final_lines = cleaned_lines[:insert_idx] + new_monitor_lines + cleaned_lines[insert_idx:]

    with open(conf_path, 'w', encoding='utf-8') as f:
        f.writelines(final_lines)

    return True, "Saved successfully to hyprland.conf"


class DisplayApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="Iram Display Configuration")
        self.set_default_size(700, 520)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(16)

        # Apply theme-aware Spatial/Bento styling
        colors = {
            "bg": "#0c0e16",
            "surface": "#161b28",
            "surface_elevated": "#222a3d",
            "accent": "#00f0ff",
            "secondary": "#7000ff",
            "success": "#05ffa1",
            "fg": "#f0f4fc",
            "muted": "#8b95b5",
            "border": "#28314e"
        }
        toml_path = os.path.expanduser("~/.local/state/iram/current/theme/colors.toml")
        if os.path.exists(toml_path):
            try:
                with open(toml_path, "r", encoding="utf-8") as f:
                    raw = {}
                    for line in f:
                        line = line.strip()
                        if line and not line.startswith("#") and "=" in line:
                            k, v = line.split("=", 1)
                            raw[k.strip()] = v.strip().strip('"').strip("'")
                if raw.get("background"): colors["bg"] = raw["background"]
                if raw.get("darker_background"): colors["bg"] = raw["darker_background"]
                if raw.get("dark_background"): colors["surface"] = raw["dark_background"]
                if raw.get("lighter_background"): colors["surface_elevated"] = raw["lighter_background"]
                if raw.get("accent"): colors["accent"] = raw["accent"]
                if raw.get("secondary"): colors["secondary"] = raw["secondary"]
                if raw.get("green"): colors["success"] = raw["green"]
                if raw.get("bright_foreground"): colors["fg"] = raw["bright_foreground"]
                if raw.get("muted"): colors["muted"] = raw["muted"]
                if raw.get("selection"): colors["border"] = raw["selection"]
            except Exception:
                pass

        css_provider = Gtk.CssProvider()
        css_data = f"""
        window {{
            background-color: {colors["bg"]};
            color: {colors["fg"]};
            font-family: "Google Sans", "Inter", sans-serif;
        }}
        label {{
            color: {colors["fg"]};
        }}
        .header-title {{
            font-size: 19px;
            font-weight: 800;
            color: {colors["accent"]};
            letter-spacing: -0.3px;
        }}
        .monitor-card {{
            background-color: {colors["surface"]};
            border-radius: 12px;
            border: 1px solid {colors["border"]};
            padding: 16px;
            margin-bottom: 12px;
        }}
        .monitor-title {{
            font-size: 15px;
            font-weight: 700;
            color: {colors["success"]};
        }}
        .monitor-badge {{
            background-color: {colors["surface_elevated"]};
            color: {colors["muted"]};
            border-radius: 6px;
            padding: 3px 8px;
            font-size: 11px;
            font-weight: 600;
        }}
        button {{
            background-color: {colors["surface_elevated"]};
            color: {colors["fg"]};
            border: 1px solid {colors["border"]};
            border-radius: 8px;
            padding: 7px 14px;
            font-weight: 600;
            transition: all 150ms ease;
        }}
        button:hover {{
            background-color: {colors["border"]};
            color: #ffffff;
        }}
        button.suggested-action {{
            background-color: {colors["accent"]};
            color: #0c0e16;
            font-weight: 800;
            border-radius: 8px;
            padding: 8px 18px;
            border: none;
        }}
        button.suggested-action:hover {{
            background-color: {colors["secondary"]};
            color: #ffffff;
        }}
        """
        css_provider.load_from_data(css_data.encode('utf-8'))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.add(main_box)

        # Header
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        title_label = Gtk.Label(label="🖥️ Display & Monitor Settings")
        title_label.get_style_context().add_class("header-title")
        header_box.pack_start(title_label, False, False, 0)

        identify_btn = Gtk.Button(label="🔍 Identify Displays")
        identify_btn.connect("clicked", self.on_identify_clicked)
        header_box.pack_end(identify_btn, False, False, 0)
        main_box.pack_start(header_box, False, False, 0)

        # Scrollable area for monitors
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.monitors_container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        scrolled.add(self.monitors_container)
        main_box.pack_start(scrolled, True, True, 0)

        # Bottom Action Bar
        bottom_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        
        self.status_label = Gtk.Label(label="Ready")
        self.status_label.set_alignment(0, 0.5)
        bottom_box.pack_start(self.status_label, True, True, 0)

        refresh_btn = Gtk.Button(label="🔄 Refresh")
        refresh_btn.connect("clicked", lambda b: self.load_monitors())
        bottom_box.pack_end(refresh_btn, False, False, 0)

        apply_btn = Gtk.Button(label="⚡ Apply Changes")
        apply_btn.get_style_context().add_class("suggested-action")
        apply_btn.connect("clicked", self.on_apply_clicked)
        bottom_box.pack_end(apply_btn, False, False, 0)

        main_box.pack_start(bottom_box, False, False, 0)

        self.monitor_widgets = []
        self.load_monitors()

    def load_monitors(self):
        # Clear existing
        for child in self.monitors_container.get_children():
            self.monitors_container.remove(child)
        self.monitor_widgets.clear()

        monitors = get_hypr_monitors()
        if not monitors:
            no_mon = Gtk.Label(label="No monitors detected via hyprctl.")
            self.monitors_container.pack_start(no_mon, True, True, 20)
            self.monitors_container.show_all()
            return

        for idx, m in enumerate(monitors):
            card = Gtk.Frame()
            card.get_style_context().add_class("monitor-card")
            card_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            card.add(card_box)

            # Monitor Title Row
            title_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            name = m.get('name', f"Screen {idx}")
            desc = m.get('description', m.get('model', 'Generic Monitor'))
            t_label = Gtk.Label(label=f"Display {idx + 1}: {name} ({desc})")
            t_label.get_style_context().add_class("monitor-title")
            title_row.pack_start(t_label, False, False, 0)

            focused = m.get('focused', False)
            if focused:
                badge = Gtk.Label(label="Focused")
                badge.get_style_context().add_class("monitor-badge")
                title_row.pack_start(badge, False, False, 0)

            enable_switch = Gtk.Switch()
            enable_switch.set_active(not m.get('disabled', False))
            switch_label = Gtk.Label(label="Enabled:")
            title_row.pack_end(enable_switch, False, False, 0)
            title_row.pack_end(switch_label, False, False, 0)
            card_box.pack_start(title_row, False, False, 0)

            # Controls Grid
            grid = Gtk.Grid()
            grid.set_column_spacing(16)
            grid.set_row_spacing(8)
            card_box.pack_start(grid, False, False, 0)

            # Resolution & Refresh Rate Combo
            r_label = Gtk.Label(label="Resolution & Rate:")
            r_label.set_alignment(0, 0.5)
            grid.attach(r_label, 0, 0, 1, 1)

            res_combo = Gtk.ComboBoxText()
            modes = m.get('availableModes', [])
            cur_w = m.get('width', 1920)
            cur_h = m.get('height', 1080)
            cur_rate = int(round(m.get('refreshRate', 60.0)))
            cur_mode_str = f"{cur_w}x{cur_h}@{cur_rate}Hz"

            matched_idx = 0
            # Common prioritized modes
            unique_modes = []
            for mode in modes:
                # simplify mode string e.g. 1920x1080@60.00Hz -> 1920x1080@60
                if mode not in unique_modes:
                    unique_modes.append(mode)

            for i, mode in enumerate(unique_modes):
                res_combo.append_text(mode)
                if f"{cur_w}x{cur_h}" in mode and str(cur_rate) in mode:
                    matched_idx = i

            if not unique_modes:
                res_combo.append_text("1920x1080@60")
                matched_idx = 0

            res_combo.set_active(matched_idx)
            grid.attach(res_combo, 1, 0, 1, 1)

            # Scale Combo
            s_label = Gtk.Label(label="Display Scale:")
            s_label.set_alignment(0, 0.5)
            grid.attach(s_label, 2, 0, 1, 1)

            scale_combo = Gtk.ComboBoxText()
            scales = ["1.0", "1.25", "1.5", "1.75", "2.0"]
            cur_scale = str(m.get('scale', 1.0))
            s_active = 0
            for i, sc in enumerate(scales):
                scale_combo.append_text(f"{sc}x")
                if sc in cur_scale:
                    s_active = i
            scale_combo.set_active(s_active)
            grid.attach(scale_combo, 3, 0, 1, 1)

            # Position
            p_label = Gtk.Label(label="Position:")
            p_label.set_alignment(0, 0.5)
            grid.attach(p_label, 0, 1, 1, 1)

            pos_combo = Gtk.ComboBoxText()
            pos_options = [
                ("Primary (0x0)", "0x0"),
                ("Right of Primary (1920x0)", "1920x0"),
                ("Left of Primary (-1920x0)", "-1920x0"),
                ("Above Primary (0x-1080)", "0x-1080"),
                ("Below Primary (0x1080)", "0x1080"),
                ("Automatic Placement", "auto"),
            ]
            cur_x = m.get('x', 0)
            cur_y = m.get('y', 0)
            cur_pos_str = f"{cur_x}x{cur_y}"
            matched = False
            for i, (opt_label, opt_val) in enumerate(pos_options):
                pos_combo.append_text(opt_label)
                if opt_val == cur_pos_str:
                    p_active = i
                    matched = True
            
            # If secondary display is overlapping at 0x0, default dropdown to Right of Primary
            if cur_pos_str == "0x0" and ('sony' in desc.lower() or idx > 0):
                p_active = 1
            pos_combo.set_active(p_active)
            grid.attach(pos_combo, 1, 1, 1, 1)

            self.monitors_container.pack_start(card, False, False, 0)
            self.monitor_widgets.append({
                'name': name,
                'desc': desc,
                'enable_switch': enable_switch,
                'res_combo': res_combo,
                'scale_combo': scale_combo,
                'pos_combo': pos_combo,
                'pos_options': pos_options
            })

        self.monitors_container.show_all()
        self.status_label.set_text(f"Detected {len(monitors)} connected display(s)")

    def on_apply_clicked(self, widget):
        monitors_data = []
        for w in self.monitor_widgets:
            name = w['name']
            desc = w.get('desc', '')
            enabled = w['enable_switch'].get_active()
            raw_res = w['res_combo'].get_active_text() or "1920x1080@60"
            # Normalize res format for hyprctl: e.g. 1920x1080@60.00Hz -> 1920x1080@60
            clean_res = raw_res.replace('Hz', '').split('.')[0] if '.' in raw_res else raw_res.replace('Hz', '')
            raw_scale = w['scale_combo'].get_active_text() or "1.0x"
            clean_scale = raw_scale.replace('x', '')
            pos_idx = w['pos_combo'].get_active()
            clean_pos = w['pos_options'][pos_idx][1] if pos_idx >= 0 else "0x0"

            if not enabled:
                subprocess.run(['hyprctl', 'keyword', 'monitor', f"{name},disable"], check=False)
                monitors_data.append({'name': name, 'desc': desc, 'disabled': True})
            else:
                apply_monitor_setting(name, clean_res, clean_pos, clean_scale)
                monitors_data.append({
                    'name': name,
                    'desc': desc,
                    'res': clean_res,
                    'pos': clean_pos,
                    'scale': clean_scale,
                    'disabled': False
                })

        # Save to hyprland.conf for persistence
        ok, msg = save_to_hyprland_conf(monitors_data)
        self.status_label.set_text("✅ Changes applied & saved to config!")
        # Trigger OSD
        subprocess.run(['iram-osd', '-i', 'video-display', '-m', 'Display settings updated'], check=False)

    def on_identify_clicked(self, widget):
        monitors = get_hypr_monitors()
        for m in monitors:
            name = m.get('name', 'Display')
            desc = m.get('description', m.get('model', 'Monitor'))
            w = m.get('width', 1920)
            h = m.get('height', 1080)
            rate = int(round(m.get('refreshRate', 60.0)))
            scale = m.get('scale', 1.0)
            subprocess.run([
                'notify-send',
                '-t', '5000',
                f"🖥️ {name}: {desc}",
                f"Resolution: {w}x{h} @ {rate}Hz\nScale: {scale}x"
            ], check=False)


def main():
    app = DisplayApp()
    app.connect("destroy", Gtk.main_quit)
    app.show_all()
    Gtk.main()


if __name__ == '__main__':
    main()
