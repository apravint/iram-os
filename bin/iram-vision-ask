#!/usr/bin/env bash
# ==============================================================================
# IRAM OS Screen Vision & OCR Assistant (iram-vision-ask)
# Captures screen region via grim + slurp, extracts text with tesseract,
# and offers action choices in Wofi (Copy, Debug/Explain, Summarize).
# Hotkey: Super + Shift + V
# https://github.com/apravint/iram-os
# ==============================================================================
set -euo pipefail

# 1. Defensive Dependency Verification
for dep in grim slurp wofi tesseract wl-copy; do
    if ! command -v "$dep" >/dev/null 2>&1; then
        msg="Required dependency '$dep' is not installed."
        echo "Error: $msg" >&2
        command -v notify-send >/dev/null 2>&1 && notify-send -u critical "Vision Ask Failed" "$msg"
        exit 1
    fi
done

CAPTURE_IMG="/tmp/iram-capture.png"
rm -f "$CAPTURE_IMG"

# 2. Select region & capture
GEOM=$(slurp -d -b "#00000088" -c "#00f0ff" -w 2 2>/dev/null || true)
if [ -z "${GEOM:-}" ]; then
    exit 0 # User cancelled selection
fi

grim -g "$GEOM" "$CAPTURE_IMG"

if [ ! -f "$CAPTURE_IMG" ]; then
    exit 0
fi

# 3. Perform OCR
LANGS="eng"
if tesseract --list-langs 2>/dev/null | grep -q "tam"; then
    LANGS="eng+tam"
fi

OCR_TEXT=$(tesseract "$CAPTURE_IMG" stdout -l "$LANGS" --oem 1 --psm 6 2>/dev/null | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' || true)

if [ -z "$OCR_TEXT" ]; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "IRAM Vision" "⚠️ No Text Detected" "Tesseract could not find text in the captured region."
    fi
    exit 0
fi

# 4. Wofi Action Menu
MENU_OPTIONS="📋  (a) Copy text to clipboard
🧠  (b) Debug & explain error with AI
📝  (c) Summarize screen snippet with AI"

CHOICE=$(echo -e "$MENU_OPTIONS" | wofi --dmenu --prompt "Vision Action:" --width 480 --height 200 2>/dev/null || true)
[ -z "${CHOICE:-}" ] && exit 0

case "$CHOICE" in
    *"(a)"*|*"Copy text"*)
        echo -n "$OCR_TEXT" | wl-copy
        PREVIEW=$(echo "$OCR_TEXT" | head -n 2 | tr '\n' ' ')
        notify-send -a "IRAM Vision" "✓ Text Copied to Clipboard" "$PREVIEW" -t 3000
        exit 0
        ;;
    *"(b)"*|*"Debug"*)
        ACTION_PROMPT="Diagnose this error or code snippet from my screen and explain how to fix it step-by-step:"
        ;;
    *"(c)"*|*"Summarize"*)
        ACTION_PROMPT="Provide a concise bulleted executive summary of this text captured from my screen:"
        ;;
    *)
        exit 0
        ;;
esac

# 5. Launch AI Agent in floating window
RUNNER=$(mktemp /tmp/iram-vision-runner-XXXXXX.sh)
cat << 'EOF' > "$RUNNER"
#!/usr/bin/env bash
PROMPT_PRE="$1"
OCR="$2"

BOLD='\033[1m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

echo -e "${BLUE}========================================================================${NC}"
echo -e "${BOLD}${CYAN}            IRAM OS - Vision & OCR Intelligence${NC}"
echo -e "${BLUE}========================================================================${NC}\n"

echo -e "${BOLD}${YELLOW}Action:${NC} $PROMPT_PRE\n"

echo -e "${BOLD}Extracted Screen Content:${NC}"
echo -e "\033[2m------------------------------------------------------------------------\033[0m"
echo "$OCR"
echo -e "\033[2m------------------------------------------------------------------------\033[0m\n"

# Copy OCR text automatically
echo -n "$OCR" | wl-copy 2>/dev/null || true
echo -e "${GREEN}✓ Screen text copied to clipboard (wl-copy).${NC}\n"

FULL_PROMPT="$PROMPT_PRE

Content:
$OCR"

# Dispatch to Antigravity (agy) or Ollama
if command -v agy >/dev/null 2>&1 || [ -x "$HOME/.gemini/antigravity-cli/bin/agy" ]; then
    AGY_BIN=$(command -v agy 2>/dev/null || echo "$HOME/.gemini/antigravity-cli/bin/agy")
    echo -e "${GREEN}==> Launching Google Antigravity Agent (agy)...${NC}\n"
    "$AGY_BIN" "$FULL_PROMPT"
elif command -v ollama >/dev/null 2>&1; then
    MODEL=$(ollama list 2>/dev/null | awk 'NR>1 {print $1}' | head -n 1 || echo "")
    if [ -n "$MODEL" ]; then
        echo -e "${GREEN}==> Generating via local Ollama ($MODEL)...${NC}\n"
        echo "$FULL_PROMPT" | ollama run "$MODEL"
    else
        echo -e "${YELLOW}! No Ollama model downloaded. Run 'iram ai-setup' to download one.${NC}"
    fi
else
    echo -e "${YELLOW}! Neither agy nor ollama is installed.${NC}"
fi

echo -e "\n\033[2mPress Enter to close window...\033[0m"
read -r
EOF

chmod +x "$RUNNER"

if command -v alacritty >/dev/null 2>&1; then
    alacritty --class "iram-agy-float" \
              --title "IRAM AI Agent" \
              -e bash "$RUNNER" "$ACTION_PROMPT" "$OCR_TEXT"
else
    foot --app-id "iram-agy-float" \
         --title "IRAM AI Agent" \
         bash "$RUNNER" "$ACTION_PROMPT" "$OCR_TEXT"
fi

rm -f "$RUNNER"
