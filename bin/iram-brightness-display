#!/usr/bin/env bash
# ==============================================================================
# IRAM OS - Universal Display Brightness Orchestrator
# Controls brightness across internal laptop panels (eDP/LVDS), external DDC/CI
# monitors (HDMI/DP/DVI), and software fallback with native OSD progress popups.
# Inspired by Omarchy 4.5 & Enhanced for IRAM OS
# https://github.com/apravint/iram-os
# ==============================================================================
set -euo pipefail

no_osd=0
monitor=""

while (( $# > 0 )); do
    case "$1" in
        --no-osd)
            no_osd=1
            shift
            ;;
        --monitor)
            (( $# >= 2 )) || { echo "Missing argument for --monitor" >&2; exit 1; }
            monitor="$2"
            shift 2
            ;;
        *)
            break
            ;;
    esac
done

# Resolve focused monitor from Hyprland if not explicitly provided
if [[ -z "$monitor" ]]; then
    monitor="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true).name' 2>/dev/null || true)"
    if [[ -z "$monitor" || "$monitor" == "null" ]]; then
        monitor="$(hyprctl monitors -j 2>/dev/null | jq -r '.[0].name' 2>/dev/null || true)"
    fi
fi

monitor_is_internal() {
    [[ "$monitor" =~ ^(eDP|LVDS|DSI)- ]]
}

find_backlight_device() {
    local bl_dir="/sys/class/backlight"
    if [[ ! -d "$bl_dir" ]]; then
        return 1
    fi
    for candidate in "$bl_dir"/intel_backlight "$bl_dir"/amdgpu_bl* "$bl_dir"/apple* "$bl_dir"/acpi_video*; do
        if [[ -e "$candidate" ]]; then
            basename "$candidate"
            return 0
        fi
    done
    local first
    first=$(ls -1 "$bl_dir" 2>/dev/null | head -n 1)
    if [[ -n "$first" ]]; then
        echo "$first"
        return 0
    fi
    return 1
}

get_software_brightness() {
    local cache_file="${XDG_RUNTIME_DIR:-/tmp}/iram_soft_bright_${monitor//[^[:alnum:]_.-]/_}"
    if [[ -r "$cache_file" ]]; then
        cat "$cache_file"
    else
        echo "100"
    fi
}

set_software_brightness() {
    local pct="$1"
    local cache_file="${XDG_RUNTIME_DIR:-/tmp}/iram_soft_bright_${monitor//[^[:alnum:]_.-]/_}"
    echo "$pct" > "$cache_file"

    if command -v xrandr >/dev/null 2>&1 && [[ -n "$monitor" ]]; then
        # Map 1-100% to 0.10 - 1.00 float
        local float_val
        float_val=$(awk "BEGIN { printf \"%.2f\", $pct / 100 }")
        xrandr --output "$monitor" --brightness "$float_val" 2>/dev/null || true
    fi
}

notify_osd() {
    local pct="$1"
    if (( no_osd )); then
        return
    fi
    local icon="display-brightness"
    if (( pct < 30 )); then
        icon="display-brightness-low"
    elif (( pct < 70 )); then
        icon="display-brightness-medium"
    fi
    notify-send -a "IRAM Display" \
                -h "int:value:$pct" \
                -h "string:synchronous:brightness" \
                -i "$icon" \
                -t 1500 \
                "Brightness" "${pct}%" 2>/dev/null || true
}

# 1. DPMS Control
if [[ "${1:-}" == "off" ]]; then
    hyprctl dispatch dpms off >/dev/null 2>&1 || true
    exit 0
elif [[ "${1:-}" == "on" ]]; then
    hyprctl dispatch dpms on >/dev/null 2>&1 || true
    exit 0
fi

# 2. Query Current Brightness
if (( $# == 0 )) || [[ "${1:-}" == "status" ]]; then
    if monitor_is_internal; then
        dev="$(find_backlight_device || true)"
        if [[ -n "$dev" ]] && command -v brightnessctl >/dev/null 2>&1; then
            brightnessctl -d "$dev" -m 2>/dev/null | awk -F, '{ gsub("%", "", $4); print $4; exit }'
            exit 0
        fi
    fi

    # Try DDC
    ddc_script="$(dirname "$0")/iram-brightness-display-ddc"
    if [[ -x "$ddc_script" ]]; then
        val="$("$ddc_script" "$monitor" 2>/dev/null || true)"
        if [[ "$val" =~ ^[0-9]+$ ]]; then
            echo "$val"
            exit 0
        fi
    fi

    # Fallback to software brightness
    get_software_brightness
    exit 0
fi

# 3. Adjust Brightness
step="$1"

# Prevent concurrent race conditions on rapid key repeat
exec {lock_fd}>"${XDG_RUNTIME_DIR:-/tmp}/iram-brightness-display.lock"
flock -n "$lock_fd" || exit 0

new_pct=""

if monitor_is_internal; then
    dev="$(find_backlight_device || true)"
    if [[ -n "$dev" ]] && command -v brightnessctl >/dev/null 2>&1; then
        current=$(brightnessctl -d "$dev" -m 2>/dev/null | awk -F, '{ gsub("%", "", $4); print $4; exit }')
        current="${current:-50}"

        if [[ "$step" == "+5%" ]]; then
            (( target = (current < 5) ? (current + 1) : (current + 5) ))
        elif [[ "$step" == "-5%" || "$step" == "5%-" ]]; then
            (( target = (current <= 5) ? (current - 1) : (current - 5) ))
        elif [[ "$step" =~ ^([0-9]+)%?$ ]]; then
            target="${BASH_REMATCH[1]}"
        else
            target=50
        fi

        (( target < 1 )) && target=1
        (( target > 100 )) && target=100

        brightnessctl -d "$dev" set "${target}%" >/dev/null 2>&1 || true
        new_pct="$target"
    fi
fi

# If internal panel adjustment didn't happen, try DDC/CI
if [[ -z "$new_pct" ]]; then
    ddc_script="$(dirname "$0")/iram-brightness-display-ddc"
    if [[ -x "$ddc_script" ]]; then
        val="$("$ddc_script" "$monitor" "$step" 2>/dev/null || true)"
        if [[ "$val" =~ ^[0-9]+$ ]]; then
            new_pct="$val"
        fi
    fi
fi

# If DDC didn't succeed or unsupported, use software brightness fallback
if [[ -z "$new_pct" ]]; then
    current=$(get_software_brightness)
    if [[ "$step" == "+5%" ]]; then
        (( target = current + 5 ))
    elif [[ "$step" == "-5%" || "$step" == "5%-" ]]; then
        (( target = current - 5 ))
    elif [[ "$step" =~ ^([0-9]+)%?$ ]]; then
        target="${BASH_REMATCH[1]}"
    else
        target=50
    fi

    (( target < 10 )) && target=10
    (( target > 100 )) && target=100
    set_software_brightness "$target"
    new_pct="$target"
fi

if [[ -n "$new_pct" ]]; then
    notify_osd "$new_pct"
    echo "$new_pct%"
fi
