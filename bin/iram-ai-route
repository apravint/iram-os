#!/usr/bin/env python3
"""
IRAM OS Intelligent Model Router & Response Cache (iram-ai-route)
Inspired by RouteLLM, LiteLLM, and GPTCache:
- Evaluates task complexity dynamically
- Routes fast queries to local Ollama qwen2.5:1.5b ($0, 1.2s)
- Routes intermediate queries to local qwen2.5:7b
- Routes complex reasoning tasks to local deepseek-r1:8b or Gemini
- Caches frequent responses locally in ~/.local/state/iram/ai_cache/
- Logs high-impact solutions to IRAM Hindsight
https://github.com/apravint/iram-os
"""

import sys
import os
import re
import json
import time
import hashlib
import urllib.request
import argparse
from typing import Dict, Any, Tuple

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    from iram_ai_core import (
        query_llm,
        is_gemini_healthy,
        hindsight_retain,
        hindsight_recall
    )
except ImportError:
    from iram_os.bin.iram_ai_core import (
        query_llm, is_gemini_healthy, hindsight_retain, hindsight_recall
    )

CACHE_DIR = os.path.expanduser("~/.local/state/iram/ai_cache")
os.makedirs(CACHE_DIR, exist_ok=True)

CYAN = "\033[0;36m"
GREEN = "\033[0;32m"
YELLOW = "\033[1;33m"
BLUE = "\033[0;34m"
MAGENTA = "\033[0;35m"
BOLD = "\033[1m"
NC = "\033[0m"

COMPLEX_KEYWORDS = [
    "architect", "refactor", "security", "concurrency", "deadlock",
    "algorithm", "optimize memory", "race condition", "protocol",
    "design pattern", "verification", "self-heal", "distributed", "prove"
]

SIMPLE_KEYWORDS = [
    "what is", "syntax", "convert", "translate", "list", "format",
    "git status", "kill", "find", "grep", "time", "date"
]


def score_prompt_complexity(prompt: str) -> Tuple[int, str]:
    """Score prompt difficulty from 1 (simple) to 10 (frontier reasoning)."""
    score = 3  # baseline
    lower = prompt.lower()

    for kw in COMPLEX_KEYWORDS:
        if kw in lower:
            score += 2
    for kw in SIMPLE_KEYWORDS:
        if kw in lower:
            score -= 1

    words = len(prompt.split())
    if words > 150:
        score += 2
    elif words < 15:
        score -= 1

    if "```" in prompt or "def " in prompt or "class " in prompt:
        score += 2

    score = max(1, min(10, score))

    if score <= 3:
        tier = "Tier 3: Local Fast Sovereign (qwen2.5:1.5b)"
    elif score <= 6:
        tier = "Tier 2: Balanced Local Standard (qwen2.5:7b)"
    else:
        tier = "Tier 1: High-Reasoning Local Frontier (deepseek-r1:8b)"

    return score, tier


def get_cached_response(prompt: str) -> str:
    h = hashlib.sha256(prompt.strip().encode("utf-8")).hexdigest()
    cache_path = os.path.join(CACHE_DIR, f"{h}.json")
    if os.path.exists(cache_path):
        try:
            with open(cache_path, "r") as f:
                data = json.load(f)
                return data.get("response", "")
        except Exception:
            pass
    return ""


def save_cache_response(prompt: str, response: str, model_used: str):
    h = hashlib.sha256(prompt.strip().encode("utf-8")).hexdigest()
    cache_path = os.path.join(CACHE_DIR, f"{h}.json")
    try:
        with open(cache_path, "w") as f:
            json.dump({
                "prompt": prompt,
                "response": response,
                "model": model_used,
                "timestamp": time.time()
            }, f, indent=2)
    except Exception:
        pass


def route_and_execute(prompt: str, force_tier: int = 0) -> Tuple[str, str]:
    # 1. Check local response cache (GPTCache pattern)
    cached = get_cached_response(prompt)
    if cached:
        return cached, "Local Response Cache (0ms latency, $0 compute)"

    score, tier_desc = score_prompt_complexity(prompt)
    if force_tier > 0:
        score = force_tier * 3

    # Dynamic local model selection based on complexity
    if score <= 3:
        target_model = "qwen2.5:1.5b"
    elif score <= 6:
        target_model = "qwen2.5:7b"
    else:
        target_model = "deepseek-r1:8b"

    output, provider = query_llm(prompt, model=target_model, num_predict=512)

    if output:
        save_cache_response(prompt, output, target_model)
        if score >= 7:
            hindsight_retain(f"Complex solution ({prompt[:40]}): {output[:150]}", category="knowledge", importance=4)
        return output, f"{provider} ({tier_desc}, Complexity: {score}/10)"

    return "[All local and cloud AI providers offline]", "None"


def main():
    parser = argparse.ArgumentParser(description="IRAM OS RouteLLM & GPTCache Intelligent Model Router")
    parser.add_argument("prompt", nargs="*", help="Query to evaluate and route")
    parser.add_argument("--score-only", action="store_true", help="Only calculate and display complexity score")
    parser.add_argument("--clear-cache", action="store_true", help="Clear cached responses")
    args = parser.parse_args()

    if args.clear_cache:
        for f in os.listdir(CACHE_DIR):
            if f.endswith(".json"):
                os.remove(os.path.join(CACHE_DIR, f))
        print(f"{GREEN}✓ Model response cache cleared.{NC}")
        sys.exit(0)

    raw_prompt = " ".join(args.prompt).strip()
    if not raw_prompt:
        parser.print_help()
        sys.exit(1)

    if args.score_only:
        score, tier = score_prompt_complexity(raw_prompt)
        print(f"{BOLD}Prompt:{NC} \"{raw_prompt}\"")
        print(f"{BOLD}Complexity Score:{NC} {score}/10")
        print(f"{BOLD}Assigned Tier:{NC} {tier}")
        sys.exit(0)

    print(f"\n{BOLD}⚡ Smart Routing Task:{NC} \"{raw_prompt}\"")
    output, route_info = route_and_execute(raw_prompt)
    print(f"{BOLD}🎯 Routed to:{NC} {CYAN}{route_info}{NC}\n")
    print(output)


if __name__ == "__main__":
    main()
