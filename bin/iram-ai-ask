#!/usr/bin/env bash
# ==============================================================================
# IRAM OS AI Quick-Prompt with Clipboard Context (iram-ai-ask)
# Prompts via Wofi, captures Wayland clipboard, and launches agy or ollama
# inside the floating iram-agy-float window.
# Hotkey: Super + Shift + Space
# https://github.com/apravint/iram-os
# ==============================================================================
set -euo pipefail

# Defensive dependency checks
if ! command -v wofi >/dev/null 2>&1; then
    msg="wofi is required for the AI prompt bar."
    echo "Error: $msg" >&2
    command -v notify-send >/dev/null 2>&1 && notify-send -u critical "AI Ask Failed" "$msg"
    exit 1
fi

if ! command -v alacritty >/dev/null 2>&1 && ! command -v foot >/dev/null 2>&1; then
    msg="alacritty or foot terminal is required for IRAM AI floating window."
    echo "Error: $msg" >&2
    command -v notify-send >/dev/null 2>&1 && notify-send -u critical "AI Ask Failed" "$msg"
    exit 1
fi

QUERY=$(wofi --dmenu --prompt "Ask IRAM AI (uses clipboard):" --width 720 --height 120 2>/dev/null || true)
[ -z "${QUERY:-}" ] && exit 0

CLIPBOARD_TEXT=""
if command -v wl-paste >/dev/null 2>&1; then
    CLIPBOARD_TEXT=$(wl-paste --no-newline 2>/dev/null || true)
fi

RUNNER=$(mktemp /tmp/iram-ai-ask-runner-XXXXXX.sh)
cat << 'EOF' > "$RUNNER"
#!/usr/bin/env bash
QUERY="$1"
CLIP="$2"

BOLD='\033[1m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

echo -e "${BLUE}========================================================================${NC}"
echo -e "${BOLD}${CYAN}            IRAM OS - Autonomous AI Assistant${NC}"
echo -e "${BLUE}========================================================================${NC}\n"

echo -e "${BOLD}${YELLOW}Task:${NC} $QUERY\n"

if [ -n "$CLIP" ]; then
    echo -e "${BOLD}Clipboard Context:${NC}"
    echo -e "\033[2m------------------------------------------------------------------------\033[0m"
    echo "$CLIP" | head -n 15
    if [ $(echo "$CLIP" | wc -l) -gt 15 ]; then
        echo -e "\033[2m... [truncated] ...\033[0m"
    fi
    echo -e "\033[2m------------------------------------------------------------------------\033[0m\n"
fi

FULL_PROMPT="$QUERY"
if [ -n "$CLIP" ]; then
    FULL_PROMPT="Task: $QUERY

Context from clipboard:
$CLIP"
fi

# Dispatch to Antigravity (agy) if present
if command -v agy >/dev/null 2>&1 || [ -x "$HOME/.gemini/antigravity-cli/bin/agy" ]; then
    AGY_BIN=$(command -v agy 2>/dev/null || echo "$HOME/.gemini/antigravity-cli/bin/agy")
    echo -e "${GREEN}==> Launching Google Antigravity Agent (agy)...${NC}\n"
    "$AGY_BIN" "$FULL_PROMPT"
# Fallback to local Ollama
elif command -v ollama >/dev/null 2>&1; then
    MODEL=$(ollama list 2>/dev/null | awk 'NR>1 {print $1}' | head -n 1 || echo "")
    if [ -n "$MODEL" ]; then
        echo -e "${GREEN}==> Generating response via local Ollama ($MODEL)...${NC}\n"
        echo "$FULL_PROMPT" | ollama run "$MODEL"
    else
        echo -e "${YELLOW}! No Ollama model found. Run 'iram ai-setup' to download one.${NC}"
    fi
else
    echo -e "${YELLOW}! Neither agy nor ollama is installed.${NC}"
    echo -e "Run ${CYAN}iram ai-setup${NC} to install local models."
fi

echo -e "\n\033[2mPress Enter to close window...\033[0m"
read -r
EOF

chmod +x "$RUNNER"

if command -v alacritty >/dev/null 2>&1; then
    alacritty --class "iram-agy-float" \
              --title "IRAM AI Agent" \
              -e bash "$RUNNER" "$QUERY" "$CLIPBOARD_TEXT"
else
    foot --app-id "iram-agy-float" \
         --title "IRAM AI Agent" \
         bash "$RUNNER" "$QUERY" "$CLIPBOARD_TEXT"
fi

rm -f "$RUNNER"
