#!/usr/bin/env bash
# Iram Share Menu via LocalSend
set -euo pipefail

if ! command -v wofi >/dev/null 2>&1; then
    notify-send -u critical "Share Menu" "wofi is not installed." 2>/dev/null || echo "wofi not installed" >&2
    exit 1
fi

CHOICE=$(printf "📋 Share Clipboard\n📄 Share File\n📁 Share Folder\n📥 Open LocalSend (Receive)" | wofi --dmenu --prompt "Share via LocalSend:" --lines 4 -i || true)

[[ -z "$CHOICE" ]] && exit 0

case "$CHOICE" in
  *"Clipboard"*)
    iram share clipboard
    ;;
  *"File"*)
    iram share file
    ;;
  *"Folder"*)
    iram share folder
    ;;
  *"Receive"*)
    if command -v localsend >/dev/null 2>&1; then
      localsend &
    else
      iram-notification-send -g 󰇮 "LocalSend" "LocalSend application is not installed. Run 'iram install app localsend' or download from localsend.org."
    fi
    ;;
esac
