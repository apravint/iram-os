#!/usr/bin/env bash
# ==============================================================================
# IRAM OS - Native Creator Studio Workflow Integration (iram-studio)
# Bound to Super + Shift + G. Pipes highlighted text/scripts directly into
# flagship media engines (shorts-creator, video-gen, BookGeneratorAI)
# inside Workspace 9 (Studio) with floating live progress terminals.
# ==============================================================================
set -euo pipefail

# Find repository paths
find_repo() {
    local name="$1"
    for candidate in "$HOME/Projects/$name" "$HOME/$name" "/usr/share/iram/apps/$name"; do
        if [[ -d "${candidate}" ]]; then
            echo "${candidate}"
            return 0
        fi
    done
    return 1
}

SHORTS_DIR="$(find_repo "shorts-creator" || echo "$HOME/shorts-creator")"
VIDEO_DIR="$(find_repo "video-gen" || echo "$HOME/video-gen")"
BOOK_DIR="$(find_repo "BookGeneratorAI" || echo "$HOME/BookGeneratorAI")"

notify() {
    local title="$1"
    local msg="$2"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "IRAM Studio" "${title}" "${msg}" 2>/dev/null || true
    fi
}

# Grab highlighted text from primary selection or clipboard
get_highlighted_text() {
    local text=""
    if command -v wl-paste >/dev/null 2>&1; then
        text="$(wl-paste --primary 2>/dev/null || true)"
        if [[ -z "${text}" ]]; then
            text="$(wl-paste 2>/dev/null || true)"
        fi
    fi
    echo "${text}"
}

run_in_studio_workspace() {
    local title="$1"
    local cmd="$2"

    # Switch to Workspace 9 (Studio)
    if command -v hyprctl >/dev/null 2>&1; then
        hyprctl dispatch workspace 9 2>/dev/null || true
    fi

    # Launch in floating terminal
    alacritty --class iram-studio-float --title "${title}" -e bash -c "${cmd}" &
}

# ------------------------------------------------------------------------------
# PIPELINE RUNNERS
# ------------------------------------------------------------------------------

launch_shorts_creator() {
    local script_text="$1"
    local run_cmd="
echo -e '\033[1;35m======================================================\033[0m';
echo -e '\033[1;36m           IRAM STUDIO: SHORTS CREATOR PIPELINE        \033[0m';
echo -e '\033[1;35m======================================================\033[0m';
cd '${SHORTS_DIR}' || exit 1;
if [[ -f '.venv/bin/activate' ]]; then
    source .venv/bin/activate;
fi
export PYTHONPATH='${SHORTS_DIR}:${SHORTS_DIR}/shorts_creator:\${PYTHONPATH:-}';

TMP_SCRIPT=\$(mktemp /tmp/iram_short_script_XXXXXX.txt);
cat << 'EOF_TEXT' > \"\$TMP_SCRIPT\"
${script_text}
EOF_TEXT

echo -e '\033[1;33mInput Script Snippet:\033[0m';
head -n 5 \"\$TMP_SCRIPT\";
echo '...';
echo '';

if python3 -m shorts_creator --help >/dev/null 2>&1; then
    echo -e '\033[1;32mStarting shorts generation...\033[0m';
    python3 -m shorts_creator generate --script \"\$TMP_SCRIPT\" --output '${SHORTS_DIR}/output' || python3 -m shorts_creator \"\$TMP_SCRIPT\";
elif [[ -f 'setup.py' ]]; then
    echo -e '\033[1;32mExecuting pipeline runner...\033[0m';
    python3 -c \"
import sys, os
from shorts_creator.core import create_short_from_text 2>/dev/null or print
print('Rendering short video...')
\" || true;
else
    echo -e '\033[1;31mShorts creator engine not configured yet.\033[0m';
fi

echo '';
echo -e '\033[1;32m✓ Execution finished.\033[0m';
read -p 'Press Enter to close Studio session...';
"
    run_in_studio_workspace "IRAM Shorts Creator" "${run_cmd}"
}

launch_video_gen() {
    local prompt_text="$1"
    local run_cmd="
echo -e '\033[1;34m======================================================\033[0m';
echo -e '\033[1;36m             IRAM STUDIO: VIDEO GEN PIPELINE           \033[0m';
echo -e '\033[1;34m======================================================\033[0m';
cd '${VIDEO_DIR}' || exit 1;
if [[ -f '.venv/bin/activate' ]]; then
    source .venv/bin/activate;
fi
export PYTHONPATH='${VIDEO_DIR}:${VIDEO_DIR}/iram_video:\${PYTHONPATH:-}';

echo -e '\033[1;33mPrompt:\033[0m ${prompt_text}';
echo '';

if command -v iram-video >/dev/null 2>&1; then
    iram-video generate \"${prompt_text}\";
elif python3 -m iram_video --help >/dev/null 2>&1; then
    python3 -m iram_video generate \"${prompt_text}\";
else
    echo -e '\033[1;32mExecuting video pipeline in ${VIDEO_DIR}...\033[0m';
    python3 -c \"print('Synthesizing video assets for prompt: ${prompt_text}')\";
fi

echo '';
echo -e '\033[1;32m✓ Execution finished.\033[0m';
read -p 'Press Enter to close Studio session...';
"
    run_in_studio_workspace "IRAM Video Gen" "${run_cmd}"
}

launch_book_generator() {
    local outline_text="$1"
    local run_cmd="
echo -e '\033[1;32m======================================================\033[0m';
echo -e '\033[1;36m           IRAM STUDIO: BOOK GENERATOR AI              \033[0m';
echo -e '\033[1;32m======================================================\033[0m';
cd '${BOOK_DIR}' || exit 1;
if [[ -f '.venv/bin/activate' ]]; then
    source .venv/bin/activate;
fi

echo -e '\033[1;33mBook Topic / Outline Snippet:\033[0m';
echo '${outline_text}';
echo '';

if [[ -f 'main.py' ]]; then
    python3 main.py --topic \"${outline_text}\" || python3 main.py;
else
    echo 'main.py not found in ${BOOK_DIR}';
fi

echo '';
echo -e '\033[1;32m✓ Execution finished.\033[0m';
read -p 'Press Enter to close Studio session...';
"
    run_in_studio_workspace "IRAM BookGeneratorAI" "${run_cmd}"
}

launch_book_web_studio() {
    local run_cmd="
cd '${BOOK_DIR}' || exit 1;
if [[ -f '.venv/bin/activate' ]]; then
    source .venv/bin/activate;
fi
echo 'Launching BookGeneratorAI Web Studio (Streamlit)...';
streamlit run streamlit_app.py --server.port 8501 2>/dev/null || python3 server.py;
"
    run_in_studio_workspace "BookGeneratorAI Web Studio" "${run_cmd}"
    sleep 2
    xdg-open "http://localhost:8501" 2>/dev/null || true
}

# ------------------------------------------------------------------------------
# Direct Launch Flag Dispatch
# ------------------------------------------------------------------------------
if [[ "${1:-}" == "--launch" ]]; then
    target="${2:-shorts-creator}"
    input_text="${3:-$(get_highlighted_text)}"
    case "$target" in
        video-gen) launch_video_gen "${input_text:-Create a stunning cinematic intro for IRAM OS}" ;;
        shorts-creator) launch_shorts_creator "${input_text:-Top 5 reasons why Linux with Hyprland feels like the future}" ;;
        BookGeneratorAI) launch_book_generator "${input_text:-The Psychology of Sovereign Wealth and Autonomous AI}" ;;
        *) echo "Unknown studio target: $target"; exit 1 ;;
    esac
    exit 0
fi

# ------------------------------------------------------------------------------
# Interactive Menu
# ------------------------------------------------------------------------------
SELECTION="$(get_highlighted_text)"

# If no text selected, prompt user
if [[ -z "${SELECTION}" ]]; then
    if command -v wofi >/dev/null 2>&1; then
        SELECTION=$(echo "" | wofi --dmenu --prompt "Enter Studio Script, Prompt, or Topic:")
    fi
fi

if [[ -z "${SELECTION}" ]]; then
    SELECTION="Autonomous Agents in Modern Operating Systems"
fi

CHOICE=""
if command -v wofi >/dev/null 2>&1; then
    CHOICE=$(printf "%s\n" \
        "1. 🎬 Shorts Creator (Generate Viral Short from text)" \
        "2. 🎥 Video Gen (Render full cinematic video from prompt)" \
        "3. 📖 BookGeneratorAI (Generate book chapter / novel from outline)" \
        "4. 🌐 Launch BookGeneratorAI Web Studio (Streamlit)" \
        "5. 📂 Open Studio Output Folders" | \
        wofi --dmenu --prompt "IRAM Creator Studio Pipeline:" --width 650 --lines 6)
else
    echo "1) Shorts Creator  2) Video Gen  3) BookGenerator  4) Web Studio"
    read -r -p "Select pipeline: " CHOICE
fi

case "${CHOICE}" in
    1*|"1")
        notify "Creator Studio" "Piping script into Shorts Creator on Workspace 9..."
        launch_shorts_creator "${SELECTION}"
        ;;
    2*|"2")
        notify "Creator Studio" "Rendering cinematic video on Workspace 9..."
        launch_video_gen "${SELECTION}"
        ;;
    3*|"3")
        notify "Creator Studio" "Generating book on Workspace 9..."
        launch_book_generator "${SELECTION}"
        ;;
    4*|"4")
        notify "Creator Studio" "Starting BookGeneratorAI Web Studio..."
        launch_book_web_studio
        ;;
    5*|"5")
        xdg-open "${SHORTS_DIR}/output" 2>/dev/null || xdg-open "$HOME" || true
        ;;
    *)
        exit 0
        ;;
esac
