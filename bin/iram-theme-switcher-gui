    def build_ui(self):
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        main_box.get_style_context().add_class("main-bg")
        self.add(main_box)

        # 1. Top Header Bar
        top_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title_label = Gtk.Label(label="🎨 IRAM OS Sovereign Theme Studio")
        title_label.get_style_context().add_class("header-title")
        title_label.set_xalign(0)
        title_box.pack_start(title_label, False, False, 0)

        disp_curr = self.current_theme.replace('-', ' ').title()
        self.sub_label = Gtk.Label(label=f"Active palette: {disp_curr} • Loading...")
        self.sub_label.get_style_context().add_class("header-subtitle")
        self.sub_label.set_xalign(0)
        title_box.pack_start(self.sub_label, False, False, 0)
        top_box.pack_start(title_box, False, False, 0)

        # Quick tools right
        tools_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)

        btn_random = Gtk.Button(label="🎲 Random [R]")
        btn_random.get_style_context().add_class("action-tool-btn")
        btn_random.set_tooltip_text("Pick a random theme from current view (R)")
        btn_random.connect("clicked", self.on_random_clicked)
        tools_box.pack_start(btn_random, False, False, 0)

        # Search Bar
        self.search_entry = Gtk.SearchEntry()
        self.search_entry.set_placeholder_text("🔍 Search themes (/)...")
        self.search_entry.set_width_chars(22)
        self.search_entry.connect("search-changed", self.on_search_changed)
        self.search_entry.connect("activate", self.on_search_activate)
        self.search_entry.connect("key-press-event", self.on_search_key_press)
        tools_box.pack_start(self.search_entry, False, False, 0)

        top_box.pack_end(tools_box, False, False, 0)
        main_box.pack_start(top_box, False, False, 0)

        # 2. Category Filter Pills & Live Preview Toggle Row
        nav_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.cat_buttons = {}

        pills = [
            ("all", "🌐 All"),
            ("modern", "✨ Modern Suite"),
            ("cyber", "🔮 Cyber & Sci-Fi"),
            ("earth", "🌿 Earth & Nature"),
            ("minimal", "🌑 Minimal & OLED"),
            ("light", "☀️ Clean Light")
        ]

        for cat_id, cat_title in pills:
            btn = Gtk.Button(label=cat_title)
            btn.get_style_context().add_class("cat-btn")
            if cat_id == "all":
                btn.get_style_context().add_class("cat-btn-active")
            btn.connect("clicked", lambda b, c=cat_id: self.set_category_filter(c))
            self.cat_buttons[cat_id] = btn
            nav_row.pack_start(btn, False, False, 0)

        # Live Preview Toggle Switch
        self.btn_live_preview = Gtk.Button(label="👁️ Live Preview: OFF [Space]")
        self.btn_live_preview.get_style_context().add_class("action-tool-btn")
        self.btn_live_preview.set_tooltip_text("Instant desktop border & accent preview on selection (Space)")
        self.btn_live_preview.connect("clicked", self.toggle_live_preview)
        nav_row.pack_end(self.btn_live_preview, False, False, 0)

        main_box.pack_start(nav_row, False, False, 0)

        # 3. Scrolled FlowBox Grid (Clean 3-column architecture)
        self.scrolled = Gtk.ScrolledWindow()
        self.scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        self.flowbox = Gtk.FlowBox()
        self.flowbox.set_valign(Gtk.Align.START)
        self.flowbox.set_max_children_per_line(3)
        self.flowbox.set_min_children_per_line(3)
        self.flowbox.set_column_spacing(10)
        self.flowbox.set_row_spacing(12)
        self.flowbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.flowbox.set_activate_on_single_click(False)
        self.flowbox.set_homogeneous(True)
        self.flowbox.set_filter_func(self.filter_themes)
        self.flowbox.connect("child-activated", self.on_child_activated)
        self.flowbox.connect("selected-children-changed", self.on_selection_changed)

        self.scrolled.add(self.flowbox)
        main_box.pack_start(self.scrolled, True, True, 0)

        # 4. Bottom Action Bar
        bottom_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

        info_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.info_label = Gtk.Label(label="Select a theme and click Apply (or double-click)")
        self.info_label.set_xalign(0)
        info_box.pack_start(self.info_label, False, False, 0)

        hint_label = Gtk.Label(label="Shortcuts: [Arrows] Navigate • [Enter] Apply • [Space] Live Preview • [/] Search • [W] Next WP • [R] Random • [Esc] Close")
        hint_label.get_style_context().add_class("header-subtitle")
        hint_label.set_xalign(0)
        info_box.pack_start(hint_label, False, False, 0)

        bottom_box.pack_start(info_box, True, True, 0)

        # Next Wallpaper Button
        self.btn_cycle_wp = Gtk.Button(label="🖼️ Next Wallpaper [W]")
        self.btn_cycle_wp.get_style_context().add_class("action-tool-btn")
        self.btn_cycle_wp.connect("clicked", lambda b: self.on_cycle_wallpaper_clicked())
        bottom_box.pack_end(self.btn_cycle_wp, False, False, 0)

        close_btn = Gtk.Button(label="Close (Esc)")
        close_btn.get_style_context().add_class("cancel-btn")
        close_btn.connect("clicked", lambda b: self.close())
        bottom_box.pack_end(close_btn, False, False, 0)

        self.apply_btn = Gtk.Button(label="⚡ Apply Theme")
        self.apply_btn.get_style_context().add_class("suggested-action")
        self.apply_btn.connect("clicked", self.on_apply_clicked)
        bottom_box.pack_end(self.apply_btn, False, False, 0)

        main_box.pack_start(bottom_box, False, False, 0)

    def load_themes(self):
        themes = get_all_themes()
        selected_child = None
        cur_slug = self.current_theme.lower().replace(' ', '-')
        total_count = len(themes)

        counts = {"all": total_count, "modern": 0, "cyber": 0, "earth": 0, "minimal": 0, "light": 0}

        for t in themes:
            theme_name = t['name']
            self.theme_map[theme_name] = t
            for c in t['categories']:
                if c in counts and c != "all":
                    counts[c] += 1

            # Match initial wallpaper index from state
            wps = t.get('wallpapers', [])
            saved_bg = t.get('preview')
            if saved_bg and saved_bg in wps:
                self.theme_wp_indices[theme_name] = wps.index(saved_bg)
            else:
                self.theme_wp_indices[theme_name] = 0

            is_active = (theme_name.lower().replace(' ', '-') == cur_slug)
            card = ThemeCard(
                t,
                is_active=is_active,
                on_focus_cb=self.on_card_focused,
                on_cycle_cb=self.on_cycle_wallpaper_clicked
            )
            self.cards[theme_name] = card
            self.flowbox.add(card)
            if is_active:
                selected_child = card

        # Update pill labels with real counts
        pill_titles = {
            "all": f"🌐 All ({counts['all']})",
            "modern": f"✨ Modern ({counts['modern']})",
            "cyber": f"🔮 Cyber & Sci-Fi ({counts['cyber']})",
            "earth": f"🌿 Earth & Nature ({counts['earth']})",
            "minimal": f"🌑 Minimal & OLED ({counts['minimal']})",
            "light": f"☀️ Clean Light ({counts['light']})"
        }
        for cid, btn in self.cat_buttons.items():
            if cid in pill_titles:
                btn.set_label(pill_titles[cid])

        disp_curr = self.current_theme.replace('-', ' ').title()
        self.sub_label.set_text(f"Active palette: {disp_curr} • {total_count} Sovereign Palettes")

        self.flowbox.show_all()
        if selected_child:
            self.flowbox.select_child(selected_child)
            selected_child.grab_focus()
            self.scroll_to_card(selected_child)

    def scroll_to_card(self, card):
        """Bring card smoothly into view inside ScrolledWindow."""
        def _do_scroll():
            alloc = card.get_allocation()
            adj = self.scrolled.get_vadjustment()
            page_size = adj.get_page_size()
            cur_val = adj.get_value()
            if alloc.y < cur_val:
                adj.set_value(max(0.0, alloc.y - 12))
            elif alloc.y + alloc.height > cur_val + page_size:
                adj.set_value(alloc.y + alloc.height - page_size + 12)
            return False
        GLib.idle_add(_do_scroll)

    def get_first_visible_card(self):
        for child in self.flowbox.get_children():
            if child.get_child_visible():
                return child
        return None

    def on_card_focused(self, card):
        self.flowbox.select_child(card)

    def set_category_filter(self, cat, clear_search=True):
        self.category_filter = cat
        if clear_search and hasattr(self, 'search_entry') and self.search_entry.get_text():
            self.search_entry.set_text("")

        for name, btn in self.cat_buttons.items():
            ctx = btn.get_style_context()
            if name == cat:
                ctx.add_class("cat-btn-active")
            else:
                ctx.remove_class("cat-btn-active")
        self.flowbox.invalidate_filter()

        # Ensure a visible card is selected
        selected = self.flowbox.get_selected_children()
        if not selected or not selected[0].get_child_visible():
            first = self.get_first_visible_card()
            if first:
                self.flowbox.select_child(first)

    def filter_themes(self, child):
        if self.category_filter != "all" and self.category_filter not in child.categories:
            return False
        query = self.search_entry.get_text().strip().lower()
        if not query:
            return True
        return (query in child.theme_name.lower() or
                query in child.primary_tag.lower() or
                any(query in c.lower() for c in child.categories))

    def on_search_changed(self, entry):
        query = entry.get_text().strip()
        if query and self.category_filter != "all":
            self.set_category_filter("all", clear_search=False)
        else:
            self.flowbox.invalidate_filter()

        selected = self.flowbox.get_selected_children()
        if not selected or not selected[0].get_child_visible():
            first = self.get_first_visible_card()
            if first:
                self.flowbox.select_child(first)

    def on_search_activate(self, entry):
        # Enter pressed inside search box: select and apply the first visible theme
        first = self.get_first_visible_card()
        if first:
            self.flowbox.select_child(first)
            self.apply_theme(first.theme_name)

    def on_search_key_press(self, widget, event):
        if event.keyval in (Gdk.KEY_Down, Gdk.KEY_Page_Down):
            first = self.get_first_visible_card()
            if first:
                first.grab_focus()
                self.flowbox.select_child(first)
                return True
        return False

    def on_selection_changed(self, flowbox):
        selected = flowbox.get_selected_children()
        if selected:
            card = selected[0]
            if self.last_selected_card and self.last_selected_card != card:
                self.last_selected_card.card.get_style_context().remove_class("selected-card")
            card.card.get_style_context().add_class("selected-card")
            self.last_selected_card = card

            self.selected_theme_name = card.theme_name
            disp_name = card.theme_name.replace('-', ' ').title()
            t_data = self.theme_map.get(card.theme_name, {})
            wps = t_data.get('wallpapers', [])
            wp_len = len(wps)
            cur_idx = self.theme_wp_indices.get(card.theme_name, 0)

            wp_info = f" • Wallpaper {cur_idx + 1}/{wp_len}" if wp_len > 1 else ""
            self.info_label.set_text(f"Selected: {disp_name} [{t_data.get('primary_tag', '')}]{wp_info}")

            if self.live_preview_enabled:
                self.preview_theme_live(card.theme_name)

    def on_child_activated(self, flowbox, child):
        self.selected_theme_name = child.theme_name
        self.apply_theme(self.selected_theme_name)

    def on_apply_clicked(self, button):
        if self.selected_theme_name:
            self.apply_theme(self.selected_theme_name)

    def on_random_clicked(self, button=None):
        visibles = [c for c in self.flowbox.get_children() if c.get_child_visible()]
        if visibles:
            chosen = random.choice(visibles)
            self.flowbox.select_child(chosen)
            chosen.grab_focus()
            self.scroll_to_card(chosen)

    def on_cycle_wallpaper_clicked(self, theme_name=None):
        target = theme_name or self.selected_theme_name
        if not target:
            return
        t_data = self.theme_map.get(target)
        if not t_data or not t_data.get('wallpapers'):
            return

        wps = t_data['wallpapers']
        cur_idx = self.theme_wp_indices.get(target, 0)
        next_idx = (cur_idx + 1) % len(wps)
        self.theme_wp_indices[target] = next_idx
        chosen = wps[next_idx]

        disp_name = target.replace('-', ' ').title()
        self.info_label.set_text(f"🖼️ Wallpaper: {os.path.basename(chosen)} ({next_idx + 1}/{len(wps)})")

        # Update thumbnail card in the GUI immediately
        card = self.cards.get(target)
        if card:
            card.update_thumbnail(chosen, f"🖼️ {next_idx + 1}/{len(wps)}")

        # Save per-theme wallpaper memory
        try:
            with open(os.path.join(BG_STATE_DIR, target), "w", encoding="utf-8") as sf:
                sf.write(chosen)
        except Exception:
            pass

        # If selected theme is currently active or live preview is on, update desktop live
        if target == self.current_theme or self.live_preview_enabled:
            subprocess.run(['iram-theme-bg-set', chosen], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run(['iram-theme-sync-all'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def toggle_live_preview(self, button=None):
        self.live_preview_enabled = not self.live_preview_enabled
        ctx = self.btn_live_preview.get_style_context()
        if self.live_preview_enabled:
            ctx.add_class("toggle-btn-active")
            self.btn_live_preview.set_label("👁️ Live Preview: ON [Space]")
            if self.selected_theme_name:
                self.preview_theme_live(self.selected_theme_name)
        else:
            ctx.remove_class("toggle-btn-active")
            self.btn_live_preview.set_label("👁️ Live Preview: OFF [Space]")
            self.restore_original_theme_preview()

    def _compute_border(self, theme_name):
        t_data = self.theme_map.get(theme_name)
        if not t_data:
            return "rgba(7aa2f7ee) rgba(bb9af7ee) 45deg"
        colors = t_data.get('colors', {})
        border = colors.get('hyprland_active_border', '')
        if border:
            if 'deg' not in border and ' ' in border:
                border += ' 45deg'
            return border

        acc = colors.get('accent', '#7aa2f7')
        candidates = [
            "secondary", "bright_magenta", "magenta", "bright_cyan", "cyan",
            "bright_blue", "blue", "bright_yellow", "yellow", "orange",
            "bright_green", "green", "bright_red", "red"
        ]
        sec = None
        acc_lower = acc.lower()
        for k in candidates:
            val = colors.get(k)
            if val and isinstance(val, str) and val.startswith('#') and len(val) == 7:
                if val.lower() != acc_lower:
                    sec = val.lower()
                    break

        if not sec:
            r, g, b = hex_to_rgb(acc)
            h, s, v = colorsys.rgb_to_hsv(r / 255.0, g / 255.0, b / 255.0)
            h2 = (h + 0.15) % 1.0
            r2, g2, b2 = colorsys.hsv_to_rgb(h2, max(s, 0.65), max(v, 0.85))
            sec = f"#{int(r2 * 255):02x}{int(g2 * 255):02x}{int(b2 * 255):02x}"

        r1, g1, b1 = hex_to_rgb(acc)
        r2, g2, b2 = hex_to_rgb(sec)
        return f"rgba({r1:02x}{g1:02x}{b1:02x}ee) rgba({r2:02x}{g2:02x}{b2:02x}ee) 45deg"

    def preview_theme_live(self, theme_name):
        border = self._compute_border(theme_name)
        if os.environ.get("WAYLAND_DISPLAY") or os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            subprocess.run(["hyprctl", "keyword", "general:col.active_border", border],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def restore_original_theme_preview(self):
        border = self._compute_border(self.original_theme)
        if os.environ.get("WAYLAND_DISPLAY") or os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            subprocess.run(["hyprctl", "keyword", "general:col.active_border", border],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def apply_theme(self, theme_name):
        if self.is_applying or not theme_name:
            return

        self.is_applying = True
        disp_name = theme_name.replace('-', ' ').title()
        self.apply_btn.set_sensitive(False)
        self.info_label.set_text(f"⏳ Applying {disp_name}...")

        def worker():
            iram_bin = shutil.which('iram') or os.path.expanduser('~/.local/bin/iram')
            subprocess.run([iram_bin, 'theme', 'set', theme_name], check=False)

            def on_done():
                self.is_applying = False
                self.apply_btn.set_sensitive(True)
                theme_slug = theme_name.lower().replace(' ', '-')
                for name, card in self.cards.items():
                    card.set_active_state(name.lower().replace(' ', '-') == theme_slug)

                self.current_theme = theme_slug
                self.original_theme = theme_slug

                # Live self-retheming: morph the Studio CSS into new theme
                t_data = self.theme_map.get(theme_name, {})
                if t_data and t_data.get('colors'):
                    self.update_studio_theme(t_data['colors'])

                total = len(self.theme_map)
                self.sub_label.set_text(f"Active palette: {disp_name} • {total} Sovereign Palettes")
                self.info_label.set_text(f"✅ Applied {disp_name} successfully!")

                osd_bin = shutil.which('iram-osd') or shutil.which('omarchy-osd')
                if osd_bin:
                    try:
                        subprocess.run([
                            osd_bin,
                            '-i', 'preferences-desktop-theme',
                            '-m', f"Theme: {disp_name}"
                        ], check=False)
                    except Exception:
                        pass
                return False

            GLib.idle_add(on_done)

        threading.Thread(target=worker, daemon=True).start()

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            if self.search_entry.has_focus() or self.search_entry.get_text():
                self.search_entry.set_text("")
                self.flowbox.grab_focus()
                return True
            self.close()
            return True
        elif event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            if not self.search_entry.has_focus() and self.selected_theme_name:
                self.apply_theme(self.selected_theme_name)
                return True
        elif event.keyval == Gdk.KEY_space:
            if not self.search_entry.has_focus():
                self.toggle_live_preview(None)
                return True
        elif event.keyval in (Gdk.KEY_w, Gdk.KEY_W):
            if not self.search_entry.has_focus():
                self.on_cycle_wallpaper_clicked()
                return True
        elif event.keyval in (Gdk.KEY_r, Gdk.KEY_R):
            if not self.search_entry.has_focus():
                self.on_random_clicked()
                return True
        elif event.keyval == Gdk.KEY_slash:
            if not self.search_entry.has_focus():
                self.search_entry.grab_focus()
                return True
        return False

    def on_window_close(self, widget):
        if self.live_preview_enabled:
            self.restore_original_theme_preview()
        try:
            THREAD_POOL.shutdown(wait=False, cancel_futures=True)
        except Exception:
            pass


def main():
    app = ThemeSwitcherApp()
    app.connect("destroy", Gtk.main_quit)
    app.show_all()
    Gtk.main()


if __name__ == '__main__':
    main()
