    def build_ui(self):
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        main_box.get_style_context().add_class("main-bg")
        self.add(main_box)

        # Top Header Bar
        top_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title_label = Gtk.Label(label="🎨 IRAM OS Sovereign Theme Studio")
        title_label.get_style_context().add_class("header-title")
        title_label.set_xalign(0)
        title_box.pack_start(title_label, False, False, 0)

        disp_curr = self.current_theme.replace('-', ' ').title()
        self.sub_label = Gtk.Label(label=f"Active palette: {disp_curr} • 43 Curated Palettes")
        self.sub_label.get_style_context().add_class("header-subtitle")
        self.sub_label.set_xalign(0)
        title_box.pack_start(self.sub_label, False, False, 0)
        top_box.pack_start(title_box, False, False, 0)

        # Quick tools right
        tools_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)

        btn_random = Gtk.Button(label="🎲 Random")
        btn_random.get_style_context().add_class("action-tool-btn")
        btn_random.set_tooltip_text("Pick a random theme")
        btn_random.connect("clicked", self.on_random_clicked)
        tools_box.pack_start(btn_random, False, False, 0)

        # Search Bar
        self.search_entry = Gtk.SearchEntry()
        self.search_entry.set_placeholder_text("🔍 Search themes (/)...")
        self.search_entry.set_width_chars(22)
        self.search_entry.connect("search-changed", self.on_search_changed)
        tools_box.pack_start(self.search_entry, False, False, 0)

        top_box.pack_end(tools_box, False, False, 0)
        main_box.pack_start(top_box, False, False, 0)

        # Category Filter Pills & Live Preview Toggle Row
        nav_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.cat_buttons = {}

        pills = [
            ("all", "🌐 All"),
            ("modern", "✨ Modern Suite"),
            ("cyber", "🔮 Cyber & Sci-Fi"),
            ("earth", "🌿 Earth & Nature"),
            ("minimal", "🌑 Minimal & OLED"),
            ("light", "☀️ Clean Light")
        ]

        for cat_id, cat_title in pills:
            btn = Gtk.Button(label=cat_title)
            btn.get_style_context().add_class("cat-btn")
            if cat_id == "all":
                btn.get_style_context().add_class("cat-btn-active")
            btn.connect("clicked", lambda b, c=cat_id: self.set_category_filter(c))
            self.cat_buttons[cat_id] = btn
            nav_row.pack_start(btn, False, False, 0)

        # Live Preview Toggle Switch
        self.btn_live_preview = Gtk.Button(label="👁️ Live Preview: OFF")
        self.btn_live_preview.get_style_context().add_class("action-tool-btn")
        self.btn_live_preview.set_tooltip_text("Instant desktop border & accent preview on selection")
        self.btn_live_preview.connect("clicked", self.toggle_live_preview)
        nav_row.pack_end(self.btn_live_preview, False, False, 0)

        main_box.pack_start(nav_row, False, False, 0)

        # Scrolled FlowBox Grid
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        self.flowbox = Gtk.FlowBox()
        self.flowbox.set_valign(Gtk.Align.START)
        self.flowbox.set_max_children_per_line(3)
        self.flowbox.set_min_children_per_line(2)
        self.flowbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.flowbox.set_activate_on_single_click(False)
        self.flowbox.set_homogeneous(True)
        self.flowbox.set_filter_func(self.filter_themes)
        self.flowbox.connect("child-activated", self.on_child_activated)
        self.flowbox.connect("selected-children-changed", self.on_selection_changed)

        scrolled.add(self.flowbox)
        main_box.pack_start(scrolled, True, True, 0)

        # Bottom Action Bar
        bottom_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

        info_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.info_label = Gtk.Label(label="Select a theme and click Apply (or double-click)")
        self.info_label.set_xalign(0)
        info_box.pack_start(self.info_label, False, False, 0)

        hint_label = Gtk.Label(label="Shortcuts: [Enter] Apply • [Space] Live Preview • [/] Search • [Esc] Close")
        hint_label.get_style_context().add_class("header-subtitle")
        hint_label.set_xalign(0)
        info_box.pack_start(hint_label, False, False, 0)

        bottom_box.pack_start(info_box, True, True, 0)

        # Next Wallpaper Button
        self.btn_cycle_wp = Gtk.Button(label="🖼️ Next Wallpaper")
        self.btn_cycle_wp.get_style_context().add_class("action-tool-btn")
        self.btn_cycle_wp.connect("clicked", self.on_cycle_wallpaper_clicked)
        bottom_box.pack_end(self.btn_cycle_wp, False, False, 0)

        close_btn = Gtk.Button(label="Close (Esc)")
        close_btn.get_style_context().add_class("cancel-btn")
        close_btn.connect("clicked", lambda b: self.close())
        bottom_box.pack_end(close_btn, False, False, 0)

        self.apply_btn = Gtk.Button(label="⚡ Apply Theme")
        self.apply_btn.get_style_context().add_class("suggested-action")
        self.apply_btn.connect("clicked", self.on_apply_clicked)
        bottom_box.pack_end(self.apply_btn, False, False, 0)

        main_box.pack_start(bottom_box, False, False, 0)

    def load_themes(self):
        themes = get_all_themes()
        selected_child = None
        cur_slug = self.current_theme.lower().replace(' ', '-')

        # Update category counts on pills
        counts = {"all": 0, "modern": 0, "cyber": 0, "earth": 0, "minimal": 0, "light": 0}

        for t in themes:
            self.theme_map[t['name']] = t
            for c in t['categories']:
                if c in counts:
                    counts[c] += 1

            is_active = (t['name'].lower().replace(' ', '-') == cur_slug)
            card = ThemeCard(t, is_active=is_active)
            self.cards[t['name']] = card
            self.flowbox.add(card)
            if is_active:
                selected_child = card

        # Update pill labels with real counts
        pill_titles = {
            "all": f"🌐 All ({counts['all']})",
            "modern": f"✨ Modern Suite ({counts['modern']})",
            "cyber": f"🔮 Cyber & Sci-Fi ({counts['cyber']})",
            "earth": f"🌿 Earth & Nature ({counts['earth']})",
            "minimal": f"🌑 Minimal & OLED ({counts['minimal']})",
            "light": f"☀️ Clean Light ({counts['light']})"
        }
        for cid, btn in self.cat_buttons.items():
            if cid in pill_titles:
                btn.set_label(pill_titles[cid])

        self.flowbox.show_all()
        if selected_child:
            self.flowbox.select_child(selected_child)

    def set_category_filter(self, cat):
        self.category_filter = cat
        for name, btn in self.cat_buttons.items():
            ctx = btn.get_style_context()
            if name == cat:
                ctx.add_class("cat-btn-active")
            else:
                ctx.remove_class("cat-btn-active")
        self.flowbox.invalidate_filter()

    def filter_themes(self, child):
        if self.category_filter != "all" and self.category_filter not in child.categories:
            return False
        query = self.search_entry.get_text().strip().lower()
        if not query:
            return True
        return query in child.theme_name.lower() or query in child.primary_tag.lower()

    def on_search_changed(self, entry):
        self.flowbox.invalidate_filter()

    def on_selection_changed(self, flowbox):
        selected = flowbox.get_selected_children()
        if selected:
            card = selected[0]
            self.selected_theme_name = card.theme_name
            disp_name = card.theme_name.replace('-', ' ').title()
            t_data = self.theme_map.get(card.theme_name, {})
            wp_len = len(t_data.get('wallpapers', []))

            self.info_label.set_text(f"Selected: {disp_name} • {t_data.get('primary_tag', '')} ({wp_len} Wallpapers)")

            if self.live_preview_enabled:
                self.preview_theme_live(card.theme_name)

    def on_child_activated(self, flowbox, child):
        self.selected_theme_name = child.theme_name
        self.apply_theme(self.selected_theme_name)

    def on_apply_clicked(self, button):
        if self.selected_theme_name:
            self.apply_theme(self.selected_theme_name)

    def on_random_clicked(self, button):
        if self.cards:
            target_name = random.choice(list(self.cards.keys()))
            card = self.cards[target_name]
            self.flowbox.select_child(card)
            card.grab_focus()

    def on_cycle_wallpaper_clicked(self, button):
        if self.selected_theme_name:
            t_data = self.theme_map.get(self.selected_theme_name)
            if t_data and t_data.get('wallpapers'):
                wps = t_data['wallpapers']
                self.selected_wallpaper_idx = (self.selected_wallpaper_idx + 1) % len(wps)
                chosen = wps[self.selected_wallpaper_idx]
                self.info_label.set_text(f"🖼️ Wallpaper: {os.path.basename(chosen)} ({self.selected_wallpaper_idx + 1}/{len(wps)})")

                # If selected theme is currently active, apply wallpaper immediately
                if self.selected_theme_name == self.current_theme or self.live_preview_enabled:
                    subprocess.run(['iram-theme-bg-set', chosen], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    subprocess.run(['iram-theme-sync-all'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def toggle_live_preview(self, button):
        self.live_preview_enabled = not self.live_preview_enabled
        ctx = self.btn_live_preview.get_style_context()
        if self.live_preview_enabled:
            ctx.add_class("toggle-btn-active")
            self.btn_live_preview.set_label("👁️ Live Preview: ON")
            if self.selected_theme_name:
                self.preview_theme_live(self.selected_theme_name)
        else:
            ctx.remove_class("toggle-btn-active")
            self.btn_live_preview.set_label("👁️ Live Preview: OFF")
            self.restore_original_theme_preview()

    def preview_theme_live(self, theme_name):
        t_data = self.theme_map.get(theme_name)
        if not t_data:
            return
        colors = t_data.get('colors', {})
        acc = colors.get('accent', '#7aa2f7')
        border = colors.get('hyprland_active_border', '')
        if not border:
            r, g, b = hex_to_rgb(acc)
            border = f"rgba({r:02x}{g:02x}{b:02x}ee) rgba({r:02x}{g:02x}{b:02x}aa) 45deg"

        if os.environ.get("WAYLAND_DISPLAY") or os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            subprocess.run(["hyprctl", "keyword", "general:col.active_border", border],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def restore_original_theme_preview(self):
        t_data = self.theme_map.get(self.original_theme)
        if t_data:
            colors = t_data.get('colors', {})
            border = colors.get('hyprland_active_border', '')
            if os.environ.get("WAYLAND_DISPLAY") or os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
                subprocess.run(["hyprctl", "keyword", "general:col.active_border", border],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def apply_theme(self, theme_name):
        if not theme_name:
            return

        disp_name = theme_name.replace('-', ' ').title()
        self.apply_btn.set_sensitive(False)
        self.info_label.set_text(f"⏳ Applying {disp_name}...")

        def worker():
            iram_bin = shutil.which('iram') or os.path.expanduser('~/.local/bin/iram')
            subprocess.run([iram_bin, 'theme', 'set', theme_name], check=False)

            def on_done():
                self.apply_btn.set_sensitive(True)
                theme_slug = theme_name.lower().replace(' ', '-')
                for name, card in self.cards.items():
                    card.set_active_state(name.lower().replace(' ', '-') == theme_slug)

                self.current_theme = theme_slug
                self.original_theme = theme_slug
                self.sub_label.set_text(f"Active palette: {disp_name} • 43 Curated Palettes")
                self.info_label.set_text(f"✅ Applied {disp_name} successfully!")

                osd_bin = shutil.which('iram-osd') or shutil.which('omarchy-osd')
                if osd_bin:
                    try:
                        subprocess.run([
                            osd_bin,
                            '-i', 'preferences-desktop-theme',
                            '-m', f"Theme: {disp_name}"
                        ], check=False)
                    except Exception:
                        pass
                return False

            GLib.idle_add(on_done)

        threading.Thread(target=worker, daemon=True).start()

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.close()
            return True
        elif event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            if self.selected_theme_name:
                self.apply_theme(self.selected_theme_name)
                return True
        elif event.keyval == Gdk.KEY_space:
            self.toggle_live_preview(None)
            return True
        elif event.keyval == Gdk.KEY_slash:
            self.search_entry.grab_focus()
            return True
        return False

    def on_window_close(self, widget):
        if self.live_preview_enabled:
            self.restore_original_theme_preview()


def main():
    app = ThemeSwitcherApp()
    app.connect("destroy", Gtk.main_quit)
    app.show_all()
    Gtk.main()


if __name__ == '__main__':
    main()
