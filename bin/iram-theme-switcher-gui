THEMES_DIRS = [
    os.path.expanduser('~/iram-os/themes'),
    os.path.expanduser('~/.config/iram/themes'),
    os.path.expanduser('~/.config/omarchy/themes'),
    os.path.expanduser('~/.config/omarchy/themes.bak'),
    '/usr/share/iram/themes',
    '/usr/share/omarchy/themes'
]

STATE_FILE = os.path.expanduser('~/.local/state/iram/current/theme.name')
BG_STATE_DIR = os.path.expanduser('~/.local/state/iram/theme-backgrounds')
CACHE_DIR = os.path.expanduser('~/.cache/iram/theme-thumbnails')
os.makedirs(CACHE_DIR, exist_ok=True)
os.makedirs(BG_STATE_DIR, exist_ok=True)

# Asynchronous background thread pool
THREAD_POOL = ThreadPoolExecutor(max_workers=4, thread_name_prefix="ThemeStudioWorker")


def hex_to_rgb_float(hex_code):
    if not hex_code:
        return 0.5, 0.5, 0.5
    hex_code = hex_code.lstrip("#")
    if len(hex_code) in (6, 8):
        try:
            return int(hex_code[0:2], 16) / 255.0, int(hex_code[2:4], 16) / 255.0, int(hex_code[4:6], 16) / 255.0
        except ValueError:
            pass
    elif len(hex_code) == 3:
        try:
            return int(hex_code[0]*2, 16) / 255.0, int(hex_code[1]*2, 16) / 255.0, int(hex_code[2]*2, 16) / 255.0
        except ValueError:
            pass
    return 0.5, 0.5, 0.5


def hex_to_rgb(hex_code):
    if not hex_code:
        return 26, 27, 38
    hex_code = hex_code.lstrip("#")
    if len(hex_code) in (6, 8):
        try:
            return int(hex_code[0:2], 16), int(hex_code[2:4], 16), int(hex_code[4:6], 16)
        except ValueError:
            pass
    elif len(hex_code) == 3:
        try:
            return int(hex_code[0]*2, 16), int(hex_code[1]*2, 16), int(hex_code[2]*2, 16)
        except ValueError:
            pass
    return 26, 27, 38


def get_current_theme():
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, 'r', encoding='utf-8') as f:
                val = f.read().strip()
                if val:
                    return val.lower().replace(' ', '-')
        except Exception:
            pass
    return "tokyo-night"


def read_theme_colors(theme_dir):
    colors = {}
    p = os.path.join(theme_dir, 'colors.toml')
    if os.path.isfile(p):
        try:
            with open(p, 'r', encoding='utf-8') as f:
                for line in f:
                    line = line.strip()
                    if '=' in line and not line.startswith('#'):
                        k, v = line.split('=', 1)
                        colors[k.strip()] = v.strip().strip('\"\'')
        except Exception:
            pass
    return colors


def get_swatches(colors):
    bg = colors.get('background', colors.get('dark_background', '#181825'))
    sel = colors.get('selection', colors.get('lighter_background', '#313244'))
    acc = colors.get('accent', '#89b4fa')
    c1 = colors.get('cyan', colors.get('green', colors.get('blue', '#94e2d5')))
    c2 = colors.get('bright_magenta', colors.get('magenta', colors.get('red', '#f38ba8')))
    return [bg, sel, acc, c1, c2]


def find_theme_preview(theme_path):
    theme_name = os.path.basename(theme_path)
    state_file = os.path.join(BG_STATE_DIR, theme_name)
    if os.path.isfile(state_file):
        try:
            with open(state_file) as f:
                saved = f.read().strip()
                if os.path.isfile(saved):
                    return saved
        except Exception:
            pass

    bg_dir = os.path.join(theme_path, 'backgrounds')
    if os.path.isdir(bg_dir):
        for f in sorted(os.listdir(bg_dir)):
            if f.lower().endswith(('.jpg', '.jpeg', '.png', '.webp')):
                return os.path.join(bg_dir, f)

    for name in ['preview.png', 'preview.jpg', 'preview.jpeg', 'preview.webp']:
        p = os.path.join(theme_path, name)
        if os.path.isfile(p):
            return p
    return None


def get_theme_wallpapers(theme_path):
    bg_dir = os.path.join(theme_path, 'backgrounds')
    wallpapers = []
    if os.path.isdir(bg_dir):
        for f in sorted(os.listdir(bg_dir)):
            if f.lower().endswith(('.jpg', '.jpeg', '.png', '.webp')):
                wallpapers.append(os.path.join(bg_dir, f))
    if not wallpapers:
        prev = find_theme_preview(theme_path)
        if prev:
            wallpapers.append(prev)
    return wallpapers


def get_thumbnail_cache_path(preview_path, w=CARD_IMG_W, h=CARD_IMG_H):
    if not preview_path or not os.path.isfile(preview_path):
        return None
    try:
        mtime = os.path.getmtime(preview_path)
        key = f"{preview_path}_{mtime}_{w}_{h}"
        hashed = hashlib.md5(key.encode('utf-8')).hexdigest()
        return os.path.join(CACHE_DIR, f"{hashed}.png")
    except Exception:
        return None


def get_all_themes():
    themes = {}
    for base_dir in THEMES_DIRS:
        if not os.path.isdir(base_dir):
            continue
        for entry in sorted(os.listdir(base_dir)):
            full_path = os.path.join(base_dir, entry)
            if os.path.isdir(full_path) and entry not in themes:
                colors = read_theme_colors(full_path)
                preview = find_theme_preview(full_path)
                wallpapers = get_theme_wallpapers(full_path)
                swatches = get_swatches(colors)
                mode = colors.get('mode', 'dark').lower()

                # Determine categories
                cats = ["all"]
                if entry in MODERN_THEME_IDS:
                    cats.append("modern")
                if entry in CATEGORY_MAP["cyber"]:
                    cats.append("cyber")
                if entry in CATEGORY_MAP["earth"]:
                    cats.append("earth")
                if entry in CATEGORY_MAP["minimal"]:
                    cats.append("minimal")
                if mode == "light" or entry in CATEGORY_MAP["light"]:
                    cats.append("light")

                if mode == "light" or entry in CATEGORY_MAP["light"]:
                    primary_tag = "LIGHT"
                elif "modern" in cats:
                    primary_tag = "MODERN"
                elif "cyber" in cats:
                    primary_tag = "CYBER"
                elif "earth" in cats:
                    primary_tag = "EARTH"
                elif "minimal" in cats:
                    primary_tag = "OLED"
                else:
                    primary_tag = "PALETTE"

                themes[entry] = {
                    'name': entry,
                    'path': full_path,
                    'preview': preview,
                    'wallpapers': wallpapers,
                    'colors': colors,
                    'swatches': swatches,
                    'categories': cats,
                    'primary_tag': primary_tag,
                    'mode': mode
                }

    # Order: Modern themes first, then others alphabetically
    ordered = []
    for mod_id in MODERN_THEME_IDS:
        if mod_id in themes:
            ordered.append(themes[mod_id])

    others = [t for t in themes.values() if t['name'] not in MODERN_THEME_IDS]
    others.sort(key=lambda x: x['name'])
    ordered.extend(others)

    return ordered


class ColorSwatches(Gtk.DrawingArea):
    """Crisp Cairo drawing for 5 circular color swatches with subtle depth."""
    def __init__(self, hex_colors):
        super().__init__()
        self.hex_colors = hex_colors[:5] if hex_colors else []
        self.set_size_request(96, 18)
        self.connect("draw", self.on_draw)

    def on_draw(self, widget, cr):
        radius = 6.0
        gap = 5.0
        x = radius + 2.0
        y = widget.get_allocated_height() / 2.0

        for hex_code in self.hex_colors:
            r, g, b = hex_to_rgb_float(hex_code)

            # Drop shadow
            cr.set_source_rgba(0.0, 0.0, 0.0, 0.35)
            cr.arc(x, y + 1.0, radius, 0, 2 * 3.14159265)
            cr.fill()

            # Main circle
            cr.set_source_rgb(r, g, b)
            cr.arc(x, y, radius, 0, 2 * 3.14159265)
            cr.fill_preserve()

            # Crisp rim border
            cr.set_source_rgba(1.0, 1.0, 1.0, 0.28)
            cr.set_line_width(1.0)
            cr.stroke()

            x += radius * 2 + gap
        return False


class ThemeCard(Gtk.FlowBoxChild):
    """Modern Theme Card with async thumbnail rendering and interactive wallpaper pill."""
    def __init__(self, theme_data, is_active=False, on_focus_cb=None, on_cycle_cb=None):
        super().__init__()
        self.theme_data = theme_data
        self.theme_name = theme_data['name']
        self.preview_path = theme_data['preview']
        self.wallpapers = theme_data.get('wallpapers', [])
        self.categories = theme_data['categories']
        self.primary_tag = theme_data['primary_tag']
        self.is_active = is_active
        self.on_focus_cb = on_focus_cb
        self.on_cycle_cb = on_cycle_cb
        self.set_can_focus(True)

        # Card container box
        self.card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.card.get_style_context().add_class("theme-card")
        if self.is_active:
            self.card.get_style_context().add_class("active-card")
        self.add(self.card)

        # Thumbnail overlay container
        self.overlay = Gtk.Overlay()

        # Image widget
        self.img_widget = Gtk.Image()
        self.img_widget.set_size_request(CARD_IMG_W, CARD_IMG_H)
        # Immediate in-memory skeleton fallback
        self.img_widget.set_from_pixbuf(self.render_skeleton_pixbuf(CARD_IMG_W, CARD_IMG_H))
        self.overlay.add(self.img_widget)

        # Top-Left: Category Tag Badge
        tag_badge = Gtk.Label(label=self.primary_tag)
        tag_badge.set_halign(Gtk.Align.START)
        tag_badge.set_valign(Gtk.Align.START)
        tag_badge.set_margin_start(8)
        tag_badge.set_margin_top(8)
        badge_cls = "generic-badge"
        if self.primary_tag == "MODERN":
            badge_cls = "modern-badge"
        elif self.primary_tag == "LIGHT":
            badge_cls = "light-badge"
        elif self.primary_tag == "CYBER":
            badge_cls = "cyber-badge"
        elif self.primary_tag == "EARTH":
            badge_cls = "earth-badge"
        elif self.primary_tag == "OLED":
            badge_cls = "oled-badge"
        tag_badge.get_style_context().add_class(badge_cls)
        self.overlay.add_overlay(tag_badge)
        self.overlay.set_overlay_pass_through(tag_badge, True)

        # Top-Right: Active Badge
        self.badge = Gtk.Label(label="✓ ACTIVE")
        self.badge.set_halign(Gtk.Align.END)
        self.badge.set_valign(Gtk.Align.START)
        self.badge.set_margin_end(8)
        self.badge.set_margin_top(8)
        self.badge.get_style_context().add_class("active-badge")
        self.overlay.add_overlay(self.badge)
        self.overlay.set_overlay_pass_through(self.badge, True)
        self.badge.set_visible(self.is_active)

        # Bottom-Right: Interactive Wallpaper Button
        wp_count = len(self.wallpapers)
        init_idx = 1
        if self.preview_path in self.wallpapers:
            init_idx = self.wallpapers.index(self.preview_path) + 1
        self.wp_button = Gtk.Button(label=f"🖼️ {init_idx}/{wp_count}" if wp_count > 1 else "")
        self.wp_button.set_halign(Gtk.Align.END)
        self.wp_button.set_valign(Gtk.Align.END)
        self.wp_button.set_margin_end(8)
        self.wp_button.set_margin_bottom(8)
        self.wp_button.get_style_context().add_class("badge-wp-interactive")
        self.wp_button.set_tooltip_text("Click or press [W] to cycle wallpaper")
        self.wp_button.connect("clicked", self.on_wp_button_clicked)
        self.overlay.add_overlay(self.wp_button)
        if wp_count <= 1:
            self.wp_button.hide()

        self.card.pack_start(self.overlay, False, False, 0)

        # Metadata Row 1: Title
        row1 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        display_name = self.theme_name.replace('-', ' ').title()
        self.title_label = Gtk.Label(label=display_name)
        self.title_label.get_style_context().add_class("theme-title")
        self.title_label.set_xalign(0)
        row1.pack_start(self.title_label, True, True, 2)
        self.card.pack_start(row1, False, False, 0)

        # Metadata Row 2: Swatches + Secondary Info
        row2 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.swatches_widget = ColorSwatches(self.theme_data['swatches'])
        row2.pack_start(self.swatches_widget, False, False, 2)

        self.wp_info_label = Gtk.Label(label=f"{wp_count} Wallpapers" if wp_count > 1 else "1 Wallpaper")
        self.wp_info_label.get_style_context().add_class("wp-counter-label")
        row2.pack_end(self.wp_info_label, False, False, 2)
        self.card.pack_start(row2, False, False, 0)

        self.connect("focus-in-event", self.on_card_focus)

        # Launch async thumbnail loading
        self.load_thumbnail_async()

    def render_skeleton_pixbuf(self, w, h):
        """Ultra-fast in-memory Cairo skeleton gradient."""
        try:
            surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
            cr = cairo.Context(surface)
            swatches = self.theme_data.get('swatches', [])
            bg_hex = swatches[0] if swatches else "#161824"
            acc_hex = swatches[2] if len(swatches) > 2 else "#00f0ff"
            r1, g1, b1 = hex_to_rgb_float(bg_hex)
            r2, g2, b2 = hex_to_rgb_float(acc_hex)

            pat = cairo.LinearGradient(0, 0, w, h)
            pat.add_color_stop_rgb(0, r1 * 0.9, g1 * 0.9, b1 * 0.9)
            pat.add_color_stop_rgb(1, r2 * 0.25, g2 * 0.25, b2 * 0.25)
            cr.set_source(pat)
            cr.rectangle(0, 0, w, h)
            cr.fill()

            # Subtle accent grid
            cr.set_source_rgba(r2, g2, b2, 0.12)
            cr.set_line_width(1.0)
            for gx in range(0, w, 24):
                cr.move_to(gx, 0)
                cr.line_to(gx, h)
            for gy in range(0, h, 24):
                cr.move_to(0, gy)
                cr.line_to(w, gy)
            cr.stroke()

            return Gdk.pixbuf_get_from_surface(surface, 0, 0, w, h)
        except Exception:
            pixbuf = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, False, 8, w, h)
            pixbuf.fill(0x161824ff)
            return pixbuf

    def load_thumbnail_async(self):
        """Asynchronously load, scale, cache, and apply thumbnail."""
        target_path = self.preview_path
        w, h = CARD_IMG_W, CARD_IMG_H

        def worker():
            pixbuf = None
            cache_path = get_thumbnail_cache_path(target_path, w, h)
            if cache_path and os.path.isfile(cache_path):
                try:
                    pixbuf = GdkPixbuf.Pixbuf.new_from_file(cache_path)
                except Exception:
                    pixbuf = None

            if pixbuf is None and target_path and os.path.isfile(target_path):
                try:
                    pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(target_path, w, h, False)
                    if cache_path:
                        try:
                            pixbuf.savev(cache_path, "png", [], [])
                        except Exception:
                            pass
                except Exception:
                    pixbuf = None

            if pixbuf:
                def apply_on_main():
                    if self.preview_path == target_path:
                        self.img_widget.set_from_pixbuf(pixbuf)
                    return False
                GLib.idle_add(apply_on_main)

        THREAD_POOL.submit(worker)

    def update_thumbnail(self, image_path, wp_idx_str=None):
        self.preview_path = image_path
        self.load_thumbnail_async()
        if wp_idx_str and self.wp_button:
            self.wp_button.set_label(wp_idx_str)

    def on_wp_button_clicked(self, button):
        if self.on_cycle_cb:
            self.on_cycle_cb(self.theme_name)

    def on_card_focus(self, widget, event):
        if self.on_focus_cb:
            self.on_focus_cb(self)
        return False

    def set_active_state(self, active):
        self.is_active = active
        ctx = self.card.get_style_context()
        if active:
            ctx.add_class("active-card")
            self.badge.show()
        else:
            ctx.remove_class("active-card")
            self.badge.hide()


class ThemeSwitcherApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="IRAM OS Sovereign Theme Studio")
        self.set_default_size(1040, 720)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(14)

        self.category_filter = "all"
        self.live_preview_enabled = False
        self.is_applying = False
        self.original_theme = get_current_theme()
        self.current_theme = self.original_theme
        self.selected_theme_name = self.current_theme
        self.cards = {}
        self.theme_map = {}
        self.theme_wp_indices = {}
        self.last_selected_card = None

        self.css_provider = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            self.css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_USER
        )

        # Apply initial Studio styling from current theme
        self.update_studio_theme()

        self.build_ui()
        self.load_themes()

        self.connect("key-press-event", self.on_key_press)
        self.connect("destroy", self.on_window_close)

    def update_studio_theme(self, colors_override=None):
        """Dynamic Self-Retheming Engine for the Studio."""
        colors = {}
        if colors_override:
            colors = colors_override
        else:
            toml_path = os.path.expanduser("~/.local/state/iram/current/theme/colors.toml")
            if os.path.exists(toml_path):
                colors = read_theme_colors(os.path.dirname(toml_path))

        is_light = colors.get("mode", "dark").lower() == "light"
        if is_light:
            bg = colors.get("background", "#faf6ec")
            surface = colors.get("dark_background", colors.get("lighter_background", "#f0ebe0"))
            surface_elevated = colors.get("lighter_background", "#ffffff")
            border = colors.get("selection", "#d8d3c5")
            fg = colors.get("bright_foreground", colors.get("foreground", "#121212"))
            muted = colors.get("muted", "#7a776e")
            accent = colors.get("accent", "#205ea6")
            secondary = colors.get("secondary", colors.get("magenta", "#ce5d97"))
            success = colors.get("green", "#28a745")
            text_on_accent = "#ffffff"
            accent_glow = "rgba(32, 94, 166, 0.25)"
        else:
            bg = colors.get("darker_background", colors.get("background", "#0d0f18"))
            surface = colors.get("dark_background", colors.get("background", "#151824"))
            surface_elevated = colors.get("lighter_background", "#1f2335")
            border = colors.get("selection", "#2b3048")
            fg = colors.get("bright_foreground", colors.get("foreground", "#f2f5fc"))
            muted = colors.get("muted", "#7f88a8")
            accent = colors.get("accent", "#00f0ff")
            secondary = colors.get("secondary", colors.get("magenta", "#7000ff"))
            success = colors.get("green", "#05ffa1")
            text_on_accent = "#050b14"
            accent_glow = "rgba(0, 240, 255, 0.28)"

        css_data = f"""
        window, window.background, .main-bg {{
            background-color: {bg};
            color: {fg};
            font-family: "Google Sans", "Inter", sans-serif;
        }}
        .header-title {{
            font-size: 21px;
            font-weight: 800;
            color: {accent};
            letter-spacing: -0.4px;
        }}
        .header-subtitle {{
            font-size: 12px;
            color: {muted};
        }}
        search-entry, entry {{
            background-color: {surface};
            color: {fg};
            border: 1px solid {border};
            border-radius: 12px;
            padding: 7px 14px;
            font-size: 13px;
            transition: all 140ms ease;
        }}
        entry:focus {{
            border-color: {accent};
            box-shadow: 0 0 10px {accent_glow};
        }}
        .cat-btn {{
            background-color: {surface};
            color: {muted};
            border: 1px solid {border};
            border-radius: 20px;
            padding: 6px 14px;
            font-size: 12px;
            font-weight: 700;
            transition: all 140ms ease;
        }}
        .cat-btn:hover {{
            background-color: {surface_elevated};
            color: {fg};
            border-color: {accent};
        }}
        .cat-btn-active {{
            background-color: {accent};
            color: {text_on_accent};
            border-color: {accent};
            font-weight: 800;
