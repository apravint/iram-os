THEMES_DIRS = [
    os.path.expanduser('~/iram-os/themes'),
    os.path.expanduser('~/.config/iram/themes'),
    os.path.expanduser('~/.config/omarchy/themes'),
    os.path.expanduser('~/.config/omarchy/themes.bak'),
    '/usr/share/iram/themes',
    '/usr/share/omarchy/themes'
]

STATE_FILE = os.path.expanduser('~/.local/state/iram/current/theme.name')
CACHE_DIR = os.path.expanduser('~/.cache/iram/theme-thumbnails')
os.makedirs(CACHE_DIR, exist_ok=True)


def hex_to_rgb_float(hex_code):
    hex_code = hex_code.lstrip("#")
    if len(hex_code) == 6:
        return int(hex_code[0:2], 16) / 255.0, int(hex_code[2:4], 16) / 255.0, int(hex_code[4:6], 16) / 255.0
    return 0.5, 0.5, 0.5


def hex_to_rgb(hex_code):
    hex_code = hex_code.lstrip("#")
    if len(hex_code) == 6:
        return int(hex_code[0:2], 16), int(hex_code[2:4], 16), int(hex_code[4:6], 16)
    return 26, 27, 38


def get_current_theme():
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, 'r', encoding='utf-8') as f:
                val = f.read().strip()
                if val:
                    return val.lower().replace(' ', '-')
        except Exception:
            pass
    return "cyberpunk-neon"


def read_theme_colors(theme_dir):
    colors = {}
    p = os.path.join(theme_dir, 'colors.toml')
    if os.path.isfile(p):
        try:
            with open(p, 'r', encoding='utf-8') as f:
                for line in f:
                    line = line.strip()
                    if '=' in line and not line.startswith('#'):
                        k, v = line.split('=', 1)
                        colors[k.strip()] = v.strip().strip('\"\'')
        except Exception:
            pass
    return colors


def get_swatches(colors):
    bg = colors.get('background', colors.get('dark_background', '#181825'))
    sel = colors.get('selection', colors.get('lighter_background', '#313244'))
    acc = colors.get('accent', '#89b4fa')
    c1 = colors.get('cyan', colors.get('green', colors.get('blue', '#94e2d5')))
    c2 = colors.get('magenta', colors.get('red', colors.get('yellow', '#f38ba8')))
    return [bg, sel, acc, c1, c2]


def find_theme_preview(theme_path):
    for name in ['preview.png', 'preview.jpg', 'preview.jpeg', 'preview.webp']:
        p = os.path.join(theme_path, name)
        if os.path.isfile(p):
            return p
    bg_dir = os.path.join(theme_path, 'backgrounds')
    if os.path.isdir(bg_dir):
        for f in sorted(os.listdir(bg_dir)):
            if f.lower().endswith(('.jpg', '.jpeg', '.png', '.webp')):
                return os.path.join(bg_dir, f)
    return None


def get_theme_wallpapers(theme_path):
    bg_dir = os.path.join(theme_path, 'backgrounds')
    wallpapers = []
    if os.path.isdir(bg_dir):
        for f in sorted(os.listdir(bg_dir)):
            if f.lower().endswith(('.jpg', '.jpeg', '.png', '.webp')):
                wallpapers.append(os.path.join(bg_dir, f))
    if not wallpapers:
        prev = find_theme_preview(theme_path)
        if prev:
            wallpapers.append(prev)
    return wallpapers


def get_all_themes():
    themes = {}
    for base_dir in THEMES_DIRS:
        if not os.path.isdir(base_dir):
            continue
        for entry in sorted(os.listdir(base_dir)):
            full_path = os.path.join(base_dir, entry)
            if os.path.isdir(full_path) and entry not in themes:
                colors = read_theme_colors(full_path)
                preview = find_theme_preview(full_path)
                wallpapers = get_theme_wallpapers(full_path)
                swatches = get_swatches(colors)
                mode = colors.get('mode', 'dark').lower()

                # Determine categories
                cats = ["all"]
                if entry in MODERN_THEME_IDS:
                    cats.append("modern")
                if entry in CATEGORY_MAP["cyber"]:
                    cats.append("cyber")
                if entry in CATEGORY_MAP["earth"]:
                    cats.append("earth")
                if entry in CATEGORY_MAP["minimal"]:
                    cats.append("minimal")
                if mode == "light" or entry in CATEGORY_MAP["light"]:
                    cats.append("light")

                primary_tag = "MODERN" if "modern" in cats else ("LIGHT" if "light" in cats else "LEGACY")
                if "cyber" in cats and "modern" not in cats:
                    primary_tag = "CYBER"
                elif "earth" in cats and "modern" not in cats:
                    primary_tag = "EARTH"
                elif "minimal" in cats and "modern" not in cats:
                    primary_tag = "OLED"

                themes[entry] = {
                    'name': entry,
                    'path': full_path,
                    'preview': preview,
                    'wallpapers': wallpapers,
                    'colors': colors,
                    'swatches': swatches,
                    'categories': cats,
                    'primary_tag': primary_tag,
                    'mode': mode
                }

    # Order: Modern themes first, then alphabetical
    ordered = []
    for mod_id in MODERN_THEME_IDS:
        if mod_id in themes:
            ordered.append(themes[mod_id])

    others = [t for t in themes.values() if t['name'] not in MODERN_THEME_IDS]
    others.sort(key=lambda x: x['name'])
    ordered.extend(others)

    return ordered


class ColorSwatches(Gtk.DrawingArea):
    """Native crisp Cairo drawing for 5 circular color swatches."""
    def __init__(self, hex_colors):
        super().__init__()
        self.hex_colors = hex_colors
        self.set_size_request(86, 16)
        self.connect("draw", self.on_draw)

    def on_draw(self, widget, cr):
        radius = 5.5
        gap = 4.5
        x = radius + 2.0
        y = widget.get_allocated_height() / 2.0

        for hex_code in self.hex_colors:
            r, g, b = hex_to_rgb_float(hex_code)
            cr.set_source_rgb(r, g, b)
            cr.arc(x, y, radius, 0, 2 * 3.14159)
            cr.fill_preserve()

            # Subtle rim border
            cr.set_source_rgba(1.0, 1.0, 1.0, 0.28)
            cr.set_line_width(1.0)
            cr.stroke()

            x += radius * 2 + gap
        return False


class ThemeCard(Gtk.FlowBoxChild):
    def __init__(self, theme_data, is_active=False):
        super().__init__()
        self.theme_data = theme_data
        self.theme_name = theme_data['name']
        self.preview_path = theme_data['preview']
        self.categories = theme_data['categories']
        self.primary_tag = theme_data['primary_tag']
        self.is_active = is_active

        # Card container
        self.card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.card.get_style_context().add_class("theme-card")
        if self.is_active:
            self.card.get_style_context().add_class("active-card")
        self.add(self.card)

        # Image thumbnail
        self.img_widget = Gtk.Image()
        self.load_thumbnail()
        self.card.pack_start(self.img_widget, False, False, 0)

        # Row 1: Title + Primary Tag + Active Badge
        row1 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        display_name = self.theme_name.replace('-', ' ').title()
        self.title_label = Gtk.Label(label=display_name)
        self.title_label.get_style_context().add_class("theme-title")
        self.title_label.set_xalign(0)
        self.title_label.set_yalign(0.5)
        row1.pack_start(self.title_label, True, True, 4)

        tag_badge = Gtk.Label(label=self.primary_tag)
        if self.primary_tag == "MODERN":
            tag_badge.get_style_context().add_class("modern-badge")
        elif self.primary_tag == "LIGHT":
            tag_badge.get_style_context().add_class("light-badge")
        elif self.primary_tag == "CYBER":
            tag_badge.get_style_context().add_class("cyber-badge")
        else:
            tag_badge.get_style_context().add_class("generic-badge")
        row1.pack_start(tag_badge, False, False, 2)

        self.badge = Gtk.Label()
        self.badge.get_style_context().add_class("active-badge")
        if self.is_active:
            self.badge.set_text("ACTIVE")
            self.badge.show()
        else:
            self.badge.set_text("")
            self.badge.hide()
        row1.pack_end(self.badge, False, False, 4)
        self.card.pack_start(row1, False, False, 2)

        # Row 2: 5 Cairo Color Swatches + Wallpaper count
        row2 = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.swatches_widget = ColorSwatches(self.theme_data['swatches'])
        row2.pack_start(self.swatches_widget, False, False, 4)

        wp_count = len(self.theme_data['wallpapers'])
        wp_label = Gtk.Label(label=f"🖼️ {wp_count} WP" if wp_count > 1 else "")
        wp_label.get_style_context().add_class("wp-badge")
        row2.pack_end(wp_label, False, False, 4)

        self.card.pack_start(row2, False, False, 2)

    def load_thumbnail(self):
        w, h = 280, 150
        cache_file = os.path.join(CACHE_DIR, f"{self.theme_name}.png")

        # Load from disk cache if fresh
        if os.path.isfile(cache_file):
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file(cache_file)
                self.img_widget.set_from_pixbuf(pixbuf)
                return
            except Exception:
                pass

        if self.preview_path and os.path.isfile(self.preview_path):
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    self.preview_path, w, h, False
                )
                self.img_widget.set_from_pixbuf(pixbuf)
                try:
                    pixbuf.savev(cache_file, "png", [], [])
                except Exception:
                    pass
                return
            except Exception as e:
                print(f"Preview load error for {self.theme_name}: {e}", file=sys.stderr)

        # Fallback dark placeholder
        pixbuf = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, False, 8, w, h)
        pixbuf.fill(0x1a1c28ff)
        self.img_widget.set_from_pixbuf(pixbuf)

    def set_active_state(self, active):
        self.is_active = active
        if active:
            self.card.get_style_context().add_class("active-card")
            self.badge.set_text("ACTIVE")
            self.badge.show()
        else:
            self.card.get_style_context().remove_class("active-card")
            self.badge.set_text("")
            self.badge.hide()


class ThemeSwitcherApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="IRAM OS Sovereign Theme Studio")
        self.set_default_size(1020, 740)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(16)

        self.category_filter = "all"
        self.live_preview_enabled = False
        self.original_theme = get_current_theme()
        self.current_theme = self.original_theme
        self.selected_theme_name = self.current_theme
        self.selected_wallpaper_idx = 0
        self.cards = {}
        self.theme_map = {}

        self.apply_custom_css()
        self.build_ui()
        self.load_themes()

        self.connect("key-press-event", self.on_key_press)
        self.connect("destroy", self.on_window_close)

    def apply_custom_css(self):
        colors = {
            "bg": "#0e1017",
            "surface": "#161824",
            "surface_elevated": "#1e2235",
            "accent": "#00f0ff",
            "secondary": "#7000ff",
            "success": "#05ffa1",
            "fg": "#f0f4fc",
            "muted": "#8f98ba",
            "border": "#28314e"
        }
        toml_path = os.path.expanduser("~/.local/state/iram/current/theme/colors.toml")
        if os.path.exists(toml_path):
            try:
                with open(toml_path, "r", encoding="utf-8") as f:
                    raw = {}
                    for line in f:
                        line = line.strip()
                        if line and not line.startswith("#") and "=" in line:
                            k, v = line.split("=", 1)
                            raw[k.strip()] = v.strip().strip('"').strip("'")
                if raw.get("background"): colors["bg"] = raw["background"]
                if raw.get("darker_background"): colors["bg"] = raw["darker_background"]
                if raw.get("dark_background"): colors["surface"] = raw["dark_background"]
                if raw.get("lighter_background"): colors["surface_elevated"] = raw["lighter_background"]
                if raw.get("accent"): colors["accent"] = raw["accent"]
                if raw.get("secondary"): colors["secondary"] = raw["secondary"]
                if raw.get("green"): colors["success"] = raw["green"]
                if raw.get("bright_foreground"): colors["fg"] = raw["bright_foreground"]
                if raw.get("muted"): colors["muted"] = raw["muted"]
                if raw.get("selection"): colors["border"] = raw["selection"]
            except Exception:
                pass

        css_provider = Gtk.CssProvider()
        css_data = f"""
