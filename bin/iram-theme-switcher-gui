gi.require_version('GdkPixbuf', '2.0')
from gi.repository import Gtk, Gdk, GdkPixbuf, GLib
import cairo

GLib.set_prgname("iram-theme-switcher-gui")
GLib.set_application_name("IRAM Theme Studio")

