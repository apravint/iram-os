#!/usr/bin/env bash
# ==============================================================================
# IRAM OS Pre-Push Adversarial Security & Architecture Gate
# Runs 6-phase adversarial audit and updates architecture maps before git push
# ==============================================================================
set -euo pipefail

REPO_DIR="${1:-.}"
cd "$REPO_DIR"

echo "🛡️  Running IRAM OS Adversarial Pre-Push Audit..."

AUDIT_OUT=$(iram-audit . --json 2>/dev/null || echo '{"confirmed": []}')

# Check for critical or high severity findings
CRITICAL_COUNT=$(echo "$AUDIT_OUT" | jq '[.confirmed[]? | select(.severity == "CRITICAL" or .severity == "HIGH")] | length' 2>/dev/null || echo 0)

if [ "$CRITICAL_COUNT" -gt 0 ]; then
    echo -e "\033[0;31m❌ Push blocked by IRAM Security Gate!\033[0m"
    echo -e "Detected \033[1;31m$CRITICAL_COUNT critical/high vulnerability candidate(s)\033[0m in source code."
    echo "Run 'iram-audit .' to review findings.json before pushing."
    exit 1
fi

echo -e "\033[0;32m✅ Security Audit passed (0 critical/high findings).\033[0m"

# Update architecture diagram
if command -v iram-arch >/dev/null 2>&1; then
    echo "⚡ Updating repository architecture map..."
    iram-arch . >/dev/null 2>&1 || true
fi

echo -e "\033[0;32m✅ IRAM Pre-Push verification complete. Proceeding with push.\033[0m"
exit 0
