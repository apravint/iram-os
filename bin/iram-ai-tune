#!/usr/bin/env python3
"""
IRAM OS Local Inference Tuner (iram-ai-tune)
Picks Ollama models that fit this machine's memory and records them in
~/.config/iram/ai.env, read by iram_ai_core, iram-ai-route and iram-ai-launch.
VRAM decides when a discrete GPU exists; otherwise RAM does, since CPU and
integrated GPUs run models from system memory.
https://github.com/apravint/iram-os
"""

import argparse
import glob
import json
import os
import shutil
import subprocess

# (minimum usable memory in MB, fast tier, standard tier, reasoning tier)
GPU_TIERS = (
    (20000, "qwen2.5:7b", "qwen2.5-coder:14b", "deepseek-r1:14b"),
    (10000, "qwen2.5:1.5b", "qwen2.5-coder:7b", "deepseek-r1:8b"),
    (6000, "qwen2.5:1.5b", "qwen2.5-coder:7b", "qwen2.5-coder:7b"),
    (3500, "qwen2.5:0.5b", "llama3.2:3b", "llama3.2:3b"),
    (0, "qwen2.5:0.5b", "qwen2.5:1.5b", "qwen2.5:1.5b"),
)
RAM_TIERS = (
    (32000, "qwen2.5:1.5b", "qwen2.5-coder:7b", "deepseek-r1:8b"),
    (16000, "qwen2.5:1.5b", "llama3.2:3b", "qwen2.5-coder:7b"),
    (8000, "qwen2.5:0.5b", "qwen2.5:1.5b", "llama3.2:3b"),
    (0, "qwen2.5:0.5b", "qwen2.5:0.5b", "qwen2.5:1.5b"),
)


def read_text(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def detect_gpu(sys_root="/sys"):
    """Returns (vendor, vram_mb) for the GPU with the most dedicated memory."""
    best = ("none", 0)
    if shutil.which("nvidia-smi"):
        try:
            out = subprocess.run(["nvidia-smi", "--query-gpu=memory.total", "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=5).stdout
            for line in out.splitlines():
                if line.strip().isdigit() and int(line) > best[1]:
                    best = ("nvidia", int(line))
        except (OSError, subprocess.TimeoutExpired):
            pass
    for path in glob.glob(os.path.join(sys_root, "class/drm/card[0-9]*/device/mem_info_vram_total")):
        value = read_text(path)
        if value.isdigit() and int(value) // 1048576 > best[1]:
            best = ("amd", int(value) // 1048576)
    return best


def detect_ram_mb(meminfo="/proc/meminfo"):
    for line in read_text(meminfo).splitlines():
        if line.startswith("MemTotal:"):
            return int(line.split()[1]) // 1024
    return 0


def select_models(vendor, vram_mb, ram_mb):
    # An AMD APU reports a small carved-out "VRAM"; under 2 GB treat it as integrated.
    if vendor != "none" and vram_mb >= 2000:
        memory, table, basis = vram_mb, GPU_TIERS, "vram"
    else:
        memory, table, basis = ram_mb, RAM_TIERS, "ram"
    for minimum, fast, standard, reasoning in table:
        if memory >= minimum:
            return {"basis": basis, "memory_mb": memory, "fast": fast, "standard": standard, "reasoning": reasoning}
    raise AssertionError("tier tables end at zero")


def write_env(selection, vendor, path):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("# Generated by iram-ai-tune. Re-run it after changing hardware.\n")
        f.write(f"IRAM_GPU_VENDOR={vendor}\n")
        f.write(f"IRAM_AI_MEMORY_BASIS={selection['basis']}\n")
        f.write(f"OLLAMA_MODEL={selection['fast']}\n")
        f.write(f"IRAM_MODEL_FAST={selection['fast']}\n")
        f.write(f"IRAM_MODEL_STANDARD={selection['standard']}\n")
        f.write(f"IRAM_MODEL_REASONING={selection['reasoning']}\n")
    os.replace(tmp, path)


def main():
    parser = argparse.ArgumentParser(description="Tune local Ollama model selection to this hardware")
    parser.add_argument("--dry-run", action="store_true", help="Print the selection without writing it")
    parser.add_argument("--sys-root", default="/sys", help=argparse.SUPPRESS)
    parser.add_argument("--meminfo", default="/proc/meminfo", help=argparse.SUPPRESS)
    args = parser.parse_args()

    vendor, vram_mb = detect_gpu(args.sys_root)
    selection = select_models(vendor, vram_mb, detect_ram_mb(args.meminfo))
    if not args.dry_run:
        write_env(selection, vendor, os.path.expanduser("~/.config/iram/ai.env"))
    print(json.dumps({"gpu": vendor, "vram_mb": vram_mb, **selection}, indent=2))


if __name__ == "__main__":
    main()
