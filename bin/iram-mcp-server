#!/usr/bin/env python3
"""
Iram FastMCP Desktop & AI Architecture Server (iram-mcp-server)
Model Context Protocol (MCP) server providing high-performance OS control,
embedded Qdrant retrieval, Graphiti knowledge, and Crawl4AI web tools.
https://github.com/apravint/iram-os
"""

import os
import sys
import json
import shutil
import subprocess
import urllib.request
import urllib.parse
from fastmcp import FastMCP

# Initialize FastMCP Server
mcp = FastMCP(
    name="iram-desktop",
    instructions="Native Linux OS, Hyprland window manager, embedded Qdrant retrieval, and Graphiti knowledge control server."
)

@mcp.tool()
def get_windows() -> str:
    """Get all active desktop windows, workspaces, geometry, and window classes in Hyprland."""
    try:
        out = subprocess.check_output(["hyprctl", "clients", "-j"], text=True)
        clients = json.loads(out)
        summary = []
        for c in clients:
            if c.get("mapped"):
                summary.append({
                    "address": c.get("address"),
                    "title": c.get("title"),
                    "class": c.get("class"),
                    "workspace": c.get("workspace", {}).get("name"),
                    "focusHistoryID": c.get("focusHistoryID")
                })
        return json.dumps(summary, indent=2)
    except Exception as e:
        return f"Error querying windows: {e}"

@mcp.tool()
def focus_window(target: str) -> str:
    """Focus a window by class name, title substring, or hex address (e.g. 'Alacritty', 'Chrome', '0x1234abcd')."""
    try:
        out = subprocess.check_output(["hyprctl", "clients", "-j"], text=True)
        clients = json.loads(out)
        target_lower = target.lower()
        matched_addr = None
        for c in clients:
            if (c.get("address") == target or 
                target_lower in c.get("class", "").lower() or 
                target_lower in c.get("title", "").lower()):
                matched_addr = c.get("address")
                break
        if matched_addr:
            subprocess.run(["hyprctl", "dispatch", "focuswindow", f"address:{matched_addr}"], check=True)
            return f"Focused window: {target} ({matched_addr})"
        else:
            return f"No active window matched '{target}'"
    except Exception as e:
        return f"Error focusing window: {e}"

@mcp.tool()
def dispatch_hyprland(dispatcher: str, args: str = "") -> str:
    """Execute any Hyprland dispatch command (e.g. workspace 2, togglefloating, killactive, movetoworkspace)."""
    try:
        cmd = ["hyprctl", "dispatch", dispatcher]
        if args:
            cmd.append(args)
        res = subprocess.run(cmd, capture_output=True, text=True)
        return f"Executed '{' '.join(cmd)}' | Output: {res.stdout.strip()} {res.stderr.strip()}"
    except Exception as e:
        return f"Dispatch error: {e}"

@mcp.tool()
def get_monitors() -> str:
    """List connected display monitors, resolutions, refresh rates, and active focus."""
    try:
        out = subprocess.check_output(["hyprctl", "monitors", "-j"], text=True)
        return out
    except Exception as e:
        return f"Error querying monitors: {e}"

@mcp.tool()
def get_system_health() -> str:
    """Diagnose failed systemd units, PipeWire audio status, system memory, and CPU health."""
    try:
        failed = subprocess.check_output(["systemctl", "--failed", "--no-legend"], text=True).strip()
        failed_user = subprocess.check_output(["systemctl", "--user", "--failed", "--no-legend"], text=True).strip()
        mem = subprocess.check_output(["free", "-h"], text=True).strip()
        return (
            f"=== System Health ===\n"
            f"Systemd System Failures:\n{failed or 'None'}\n\n"
            f"Systemd User Failures:\n{failed_user or 'None'}\n\n"
            f"Memory:\n{mem}\n"
        )
    except Exception as e:
        return f"Health check error: {e}"

@mcp.tool()
def heal_system() -> str:
    """Automatically heal failed user units, restart PipeWire audio if degraded, and verify notifications."""
    actions = []
    try:
        # Check failed user services and restart
        out = subprocess.run(["systemctl", "--user", "--failed", "--no-legend"], capture_output=True, text=True)
        for line in out.stdout.splitlines():
            parts = line.split()
            if parts:
                unit = parts[0]
                subprocess.run(["systemctl", "--user", "reset-failed", unit])
                subprocess.run(["systemctl", "--user", "restart", unit])
                actions.append(f"Restarted failed unit: {unit}")
        
        # Audio check
        audio_test = subprocess.run(["pactl", "info"], capture_output=True, text=True)
        if audio_test.returncode != 0:
            subprocess.run(["systemctl", "--user", "restart", "pipewire", "pipewire-pulse", "wireplumber"])
            actions.append("Restarted PipeWire and WirePlumber stack")
        
        if not actions:
            actions.append("System is fully healthy. No degraded services detected.")
        return "\n".join(actions)
    except Exception as e:
        return f"Error healing system: {e}"

@mcp.tool()
def set_iram_theme(theme_name: str) -> str:
    """Switch the desktop color theme across Waybar, Alacritty, GTK, and Hyprland."""
    try:
        res = subprocess.run(["iram-theme-switch", theme_name], capture_output=True, text=True)
        return f"Theme switch executed for '{theme_name}': {res.stdout.strip()}"
    except Exception as e:
        return f"Theme switch error: {e}"

@mcp.tool()
def get_audio_status() -> str:
    """Get active default audio sink, volume level, and mute status."""
    try:
        sink = subprocess.check_output(["pactl", "get-default-sink"], text=True).strip()
        vol = subprocess.check_output(["pactl", "get-sink-volume", "@DEFAULT_SINK@"], text=True).strip()
        mute = subprocess.check_output(["pactl", "get-sink-mute", "@DEFAULT_SINK@"], text=True).strip()
        return f"Default Sink: {sink}\nVolume: {vol}\nMute: {mute}"
    except Exception as e:
        return f"Audio error: {e}"

@mcp.tool()
def toggle_audio_sink() -> str:
    """Toggle audio output between Motherboard Line Out and TV HDMI."""
    try:
        res = subprocess.run(["iram-audio-toggle"], capture_output=True, text=True)
        return res.stdout.strip() or "Audio sink toggled"
    except Exception as e:
        return f"Error toggling audio: {e}"

@mcp.tool()
def qdrant_search_code(query: str, limit: int = 5) -> str:
    """Semantic vector search across indexed codebase and desktop configurations using embedded Qdrant."""
    try:
        res = subprocess.run(
            ["iram-qdrant", "search", query, "--limit", str(limit)],
            capture_output=True,
            text=True
        )
        return res.stdout.strip()
    except Exception as e:
        return f"Qdrant search error: {e}"

@mcp.tool()
def qdrant_index_path(path: str) -> str:
    """Index a file or repository into local embedded Qdrant vector database."""
    try:
        res = subprocess.run(["iram-qdrant", "index", path], capture_output=True, text=True)
        return res.stdout.strip()
    except Exception as e:
        return f"Qdrant indexing error: {e}"

@mcp.tool()
def graphiti_query_entity(entity_name: str) -> str:
    """Query an entity and its relations from the Iram Knowledge Graph."""
    try:
        res = subprocess.run(["iram-graphiti", "entity", entity_name], capture_output=True, text=True)
        return res.stdout.strip()
    except Exception as e:
        return f"Knowledge graph error: {e}"

@mcp.tool()
def graphiti_record_fact(fact_text: str) -> str:
    """Record a persistent project or system fact in the temporal knowledge graph."""
    try:
        res = subprocess.run(["iram-graphiti", "fact", fact_text], capture_output=True, text=True)
        return res.stdout.strip()
    except Exception as e:
        return f"Error recording fact: {e}"

@mcp.tool()
def crawl_web_markdown(url: str) -> str:
    """Scrape live documentation or website into clean, token-efficient markdown using Crawl4AI."""
    try:
        res = subprocess.run(["iram-crawl", url], capture_output=True, text=True)
        return res.stdout.strip()
    except Exception as e:
        return f"Crawl error: {e}"

@mcp.tool()
def pack_repository(repo_path: str = ".") -> str:
    """Pack an entire repository into a single AI-friendly context bundle using Repomix."""
    try:
        target = os.path.abspath(os.path.expanduser(repo_path))
        res = subprocess.run(["repomix", target, "--style", "markdown"], capture_output=True, text=True)
        return f"Repomix packed {target}:\n{res.stdout.strip()}"
    except Exception as e:
        return f"Repomix error: {e}"

@mcp.tool()
def desktop_notify(title: str, message: str) -> str:
    """Display a native desktop notification."""
    try:
        subprocess.run(["notify-send", "-a", "Iram AI", title, message])
        return f"Notification sent: {title} - {message}"
    except Exception as e:
        return f"Notify error: {e}"

# --- VOICE STUDIO MCP TOOLS ---
@mcp.tool()
def voice_speak(text: str, voice_id: str = "jarvis") -> str:
    """Synthesizes text to spoken audio and plays it through PipeWire speakers (voices: jarvis, samantha, cinema-narrator, tamil-tech)."""
    try:
        res = subprocess.run(["iram-voice", "speak", text, "--voice", voice_id], capture_output=True, text=True)
        return res.stdout.strip() or f"Spoke text using voice '{voice_id}'"
    except Exception as e:
        return f"Voice error: {e}"

@mcp.tool()
def voice_clone(audio_path: str, voice_name: str) -> str:
    """Enrolls a new sovereign voice profile from a short (5-10s) audio sample."""
    try:
        res = subprocess.run(["iram-voice", "clone", audio_path, "--name", voice_name], capture_output=True, text=True)
        return res.stdout.strip()
    except Exception as e:
        return f"Clone error: {e}"

@mcp.tool()
def voice_design(prompt: str, voice_name: str) -> str:
    """Designs a new synthetic voice persona from adjectives (e.g. 'deep authoritative narrator')."""
    try:
        res = subprocess.run(["iram-voice", "design", prompt, "--name", voice_name], capture_output=True, text=True)
        return res.stdout.strip()
    except Exception as e:
        return f"Design error: {e}"

@mcp.tool()
def list_voices() -> str:
    """Lists all available pre-packaged and cloned voices in VoiceStudio."""
    try:
        res = subprocess.run(["iram-voice", "list"], capture_output=True, text=True)
        return res.stdout.strip()
    except Exception as e:
        return f"List voices error: {e}"

# --- 3D SPATIAL & SWARM MCP TOOLS ---
@mcp.tool()
def open_3d_inspector(model_path: str = "") -> str:
    """Launches the Three.js 3D CAD & Mesh Inspector window (optionally loading an STL/OBJ file)."""
    try:
        cmd = ["iram-3d"]
        if model_path:
            cmd.append(model_path)
        subprocess.Popen(cmd)
        return f"Launched 3D CAD Inspector (model: {model_path or 'preset'})"
    except Exception as e:
        return f"3D inspector error: {e}"

@mcp.tool()
def open_agent_swarm_graph() -> str:
    """Launches the live Three.js 3D Multi-Agent Swarm Topology Graph with animated IPC photon conduits."""
    try:
        subprocess.Popen(["iram-agent-graph"])
        return "Launched 3D Multi-Agent Swarm Graph window"
    except Exception as e:
        return f"Agent graph error: {e}"

@mcp.tool()
def open_3d_theme_studio() -> str:
    """Launches the Three.js 3D PBR Material Theme Studio simulating all 18 palettes under dynamic lighting."""
    try:
        subprocess.Popen(["iram-theme-3d"])
        return "Launched 3D Theme Studio window"
    except Exception as e:
        return f"Theme studio error: {e}"

# --- HARNESS² CYCLIC WORKFLOW ---
@mcp.tool()
def run_harness_workflow(task: str) -> str:
    """Runs a complex task through the Harness² cyclic verification loop (Plan -> Act -> Verify -> Reflect)."""
    try:
        res = subprocess.run(["iram-harness2", task], capture_output=True, text=True)
        return res.stdout.strip() or f"Harness² workflow executed for '{task}'"
    except Exception as e:
        return f"Harness² error: {e}"

def main():
    if "--sse" in sys.argv or os.environ.get("IRAM_MCP_TRANSPORT") == "sse":
        port = int(os.environ.get("IRAM_MCP_PORT", 8991))
        mcp.run(transport="sse", host="127.0.0.1", port=port)
    elif "--http" in sys.argv or os.environ.get("IRAM_MCP_TRANSPORT") == "http":
        port = int(os.environ.get("IRAM_MCP_PORT", 8991))
        mcp.run(transport="http", host="127.0.0.1", port=port)
    else:
        mcp.run()

if __name__ == "__main__":
    main()
