#!/usr/bin/env bash
# ==============================================================================
# IRAM OS Unified Super Menu (Super + Space / Super + I)
# Hierarchical control center inspired by Omarchy 4.5
# ==============================================================================
set -euo pipefail

# Clean Toggle: if wofi is currently open, close it and exit cleanly
if pgrep -x wofi >/dev/null 2>&1; then
    pkill -x wofi 2>/dev/null || true
    exit 0
fi

menu_prompt() {
    local prompt="$1"
    shift
    local options=("$@")
    printf '%s\n' "${options[@]}" | wofi --dmenu --prompt "$prompt" --width 540 --lines 12 --style "$HOME/.config/wofi/style.css" -i 2>/dev/null || true
}

submenu_agent() {
    choice=$(menu_prompt "🤖 Agent & AI Subsystem" \
        "1. ⚙️ Switch Default Agent (agy, claude, gemini, codex, kimi, ollama)" \
        "2. 📋 Ask AI with Clipboard Content" \
        "3. 📸 Screen OCR Text Vision" \
        "4. 🎙️ Toggle Voice Dictation" \
        "5. 🛰️ Toggle IRAM Nexus Floating Desktop AI" \
        "6. 🩺 Make Sense of Last Crash" \
        "⬅ Back")

    case "$choice" in
        1*) ~/.local/bin/iram-agent-select ;;
        2*) ~/.local/bin/iram-ai-clipboard ;;
        3*) ~/.local/bin/iram-capture-text ;;
        4*) ~/.local/bin/iram-dictation toggle ;;
        5*) ~/.local/bin/iram-nexus ;;
        6*) ~/.local/bin/iram-crash-debug ;;
        *) return ;;
    esac
}

submenu_style() {
    choice=$(menu_prompt "🎨 Style & Rice Studio" \
        "1. 🎛️ Unified Appearance & Rice Tuner (Super+Alt+R)" \
        "2. 🎭 Sovereign 55-Theme Switcher GUI" \
        "3. 📐 Toggle Traditional vs Tiling Desktop (Super+Shift+D)" \
        "4. 🖼️ Next Wallpaper Background" \
        "5. 🖱️ Cursor Theme Switcher" \
        "6. 🔤 Font & Typography Switcher" \
        "⬅ Back")

    case "$choice" in
        1*) ~/.local/bin/iram-appearance ;;
        2*) ~/.local/bin/iram-theme-switch ;;
        3*) ~/.local/bin/iram-desktop-mode ;;
        4*) iram theme bg next ;;
        5*) ~/.local/bin/iram-cursor-switch ;;
        6*) ~/.local/bin/iram-font-switch ;;
        *) return ;;
    esac
}

submenu_term_editor() {
    choice=$(menu_prompt "💻 Terminal & Editor Switcher" \
        "1. 🖥️ Switch Default Terminal (Alacritty, Foot, Ghostty, Kitty)" \
        "2. 📝 Switch Default Editor (Neovim, VS Code, Cursor, Windsurf, Zed)" \
        "⬅ Back")

    case "$choice" in
        1*) ~/.local/bin/iram-terminal-select ;;
        2*) ~/.local/bin/iram-editor-select ;;
        *) return ;;
    esac
}

submenu_dev_tools() {
    ~/.local/bin/iram-dev-install
}

submenu_system() {
    choice=$(menu_prompt "⚙️ System & Maintenance" \
        "1. 🚀 Run System Update (iram update)" \
        "2. 🩺 Run System Doctor & Diagnostics (iram doctor)" \
        "3. 🛡️ Config Snapshot & Rollback" \
        "4. 🖥️ Display & Monitor Settings" \
        "5. 🔊 Sound & Audio Mixer (Pavucontrol)" \
        "6. 📶 Network & Wi-Fi Settings" \
        "7. ⏻ Power Menu (Lock, Sleep, Shutdown)" \
        "⬅ Back")

    case "$choice" in
        1*) alacritty --class iram-agy-float -e ~/.local/bin/iram update ;;
        2*) alacritty --class iram-agy-float -e ~/.local/bin/iram doctor ;;
        3*) ~/.local/bin/iram-snapshot ;;
        4*) ~/.local/bin/iram-displays-gui ;;
        5*) pavucontrol ;;
        6*) nm-connection-editor ;;
        7*) ~/.local/bin/iram-power-menu ;;
        *) return ;;
    esac
}

# Main Super Menu Loop
MAIN_CHOICE=$(menu_prompt "IRAM OS Super Menu:" \
    "🚀 Apps & Launcher" \
    "🤖 Agent & AI Intelligence" \
    "🎨 Style, Themes & Rice Tuner" \
    "💻 Terminal & Editor Switcher" \
    "🛠️ Install Dev Stack & Tools" \
    "🗄️ Disktree (Storage Usage)" \
    "🌍 Global World Clock" \
    "📋 Clipboard History" \
    "📸 Screen Capture & OCR" \
    "⚙️ System, Doctor & Updates" \
    "⏻ Power Menu")

[ -z "$MAIN_CHOICE" ] && exit 0

case "$MAIN_CHOICE" in
    "🚀"*) ~/.local/bin/iram-app-launcher ;;
    "🤖"*) submenu_agent ;;
    "🎨"*) submenu_style ;;
    "💻"*) submenu_term_editor ;;
    "🛠️"*) submenu_dev_tools ;;
    "🗄️"*) ~/.local/bin/iram-disktree ;;
    "🌍"*) ~/.local/bin/iram-worldclock ;;
    "📋"*) ~/.local/bin/iram-clipboard-menu ;;
    "📸"*) ~/.local/bin/iram-capture-menu ;;
    "⚙️"*) submenu_system ;;
    "⏻"*) ~/.local/bin/iram-power-menu ;;
esac
