#!/bin/bash
# Iram Root Menu Bridge for IRAM OS

# Clean Toggle: if wofi is currently open, close it and exit cleanly
if pgrep -x wofi >/dev/null 2>&1; then
  pkill -x wofi 2>/dev/null || true
  exit 0
fi

if pgrep -x iram-shell >/dev/null 2>&1; then
  exec /usr/share/iram/bin/iram-menu "$@"
fi

verb="${1-toggle}"
route="${2-root}"

case "$route" in
  apps|applications)
    exec ~/.local/bin/iram-app-launcher
    ;;
  theme*|style.theme)
    exec ~/.local/bin/iram-theme-switch
    ;;
  background*|style.background)
    exec iram theme bg next
    ;;
  system|power)
    exec ~/.local/bin/iram-power-menu
    ;;
  clipboard)
    exec ~/.local/bin/iram-clipboard-menu
    ;;
  capture*)
    exec ~/.local/bin/iram-capture-menu
    ;;
  keybindings)
    exec /usr/share/iram/bin/iram-menu-keybindings
    ;;
  reminder*)
    exec ~/.local/bin/iram-reminder-menu
    ;;
  cursor)
    exec ~/.local/bin/iram-cursor-switch
    ;;
  timezone*|setup.timezone)
    exec ~/.local/bin/iram-menu-timezone
    ;;
  close)
    pkill -x wofi 2>/dev/null || true
    exit 0
    ;;
  *)
    # Root menu
    CHOICE=$(printf "🚀 Applications Launcher (All Apps)\n🌐 WorldMonitor Planetary Radar\n🛡️ Adversarial Security Audit\n📈 Financial Valuation (DCF)\n⚡ Visual Architecture Map\n🔬 Reverse Engineer Binary (REA)\n🧠 Long-Term Memory (Hindsight)\n🖥️ Display and Monitor Settings\n🔊 Sound and Audio Control (Pavucontrol)\n⚙️ System Settings\n🎨 Theme Switcher (54 Sovereign Themes)\n🔤 Font Switcher\n🖱️ Cursor Theme Switcher\n🖼️ Next Background Wallpaper\n⌨️ Keybindings Cheat Sheet\n⏱️ Set Reminder\n📸 Screenshot and Screen Recording\n📋 Clipboard History\n📶 Network and Wi-Fi Settings\n󰂯 Bluetooth Devices\n󰃝 Toggle Nightlight (Eye Care)\n⏻ Power Menu (Lock, Sleep, Shutdown)" | wofi --dmenu --prompt "Iram Menu:" --lines 18 --style ~/.config/wofi/style.css -i)
    
    [[ -z "$CHOICE" ]] && exit 0
    
    case "$CHOICE" in
      *"WorldMonitor"*)
        alacritty --class iram-ai-float --title "IRAM WorldMonitor Radar" -e ~/.local/bin/iram-worldmonitor
        ;;
      *"Security Audit"*)
        alacritty --class iram-ai-float --title "IRAM Adversarial Security Audit" -e ~/.local/bin/iram-audit
        ;;
      *"Financial"*)
        alacritty --class iram-ai-float --title "IRAM Financial Intelligence" -e ~/.local/bin/iram-finance dcf NVDA
        ;;
      *"Architecture"*)
        ~/.local/bin/iram-arch --open
        ;;
      *"Reverse Engineer"*)
        alacritty --class iram-ai-float --title "IRAM Reverse Engineering" -e bash -c "read -e -p 'Target file: ' target; iram-reverse \"\$target\"; read -p 'Press enter to exit...'"
        ;;
      *"Long-Term Memory"*)
        alacritty --class iram-ai-float --title "IRAM Hindsight Memory" -e bash -c "iram-hindsight reflect; echo ''; read -e -p 'Search memory (or enter to quit): ' q; [ -n \"\$q\" ] && iram-hindsight recall \"\$q\"; read -p 'Press enter...'"
        ;;
      *"Applications"*)
        exec ~/.local/bin/iram-app-launcher
        ;;
      *"Display"*)
        ~/.local/bin/iram-displays-gui
        ;;
      *"Sound"*|*"Audio"*)
        pavucontrol
        ;;
      *"System Settings"*)
        gnome-control-center 2>/dev/null || systemsettings
        ;;
      *"Theme Switcher"*)
        ~/.local/bin/iram-theme-switch
        ;;
      *"Font Switcher"*)
        ~/.local/bin/iram-font-switch
        ;;
      *"Next Background"*)
        iram theme bg next
        ;;
      *"Keybindings"*)
        ~/.local/bin/iram-menu-keybindings
        ;;
      *"Reminder"*)
        ~/.local/bin/iram-reminder-menu
        ;;
      *"Screenshot"*)
        ~/.local/bin/iram-capture-menu
        ;;
      *"Clipboard"*)
        ~/.local/bin/iram-clipboard-menu
        ;;
      *"Cursor"*)
        ~/.local/bin/iram-cursor-switch
        ;;
      *"Network"*)
        nm-connection-editor
        ;;
      *"Bluetooth"*)
        blueman-manager
        ;;
      *"Nightlight"*)
        ~/.local/bin/iram-toggle-nightlight
        ;;
      *"Power"*)
        ~/.local/bin/iram-power-menu
        ;;
    esac
    ;;
esac
