#!/usr/bin/env python3
"""
IRAM OS Offline Vocal Music & Sheet Score Studio (YuE2-Studio Integration)
Generates vocal melodies, ABC sheet music, and synthetic audio tracks via PipeWire.
https://github.com/apravint/iram-os
"""

import os
import sys
import shutil
import argparse
import subprocess
import time

MUSIC_DIR = os.path.expanduser("~/Music/iram")

SAMPLE_ABC = """X: 1
T: IRAM OS Sovereign Anthem
M: 4/4
L: 1/4
K: C
C E G c | c G E C | D F A d | d A F D |
E G B e | e B G E | C4 |]
"""

def launch_studio():
    print("🎵 Launching IRAM YuE2 Music & Sheet Studio...")
    # Check if local yue2 service or local web canvas exists
    url = "http://127.0.0.1:7860" # Standard Gradio YuE2 port
    if shutil.which("google-chrome"):
        subprocess.Popen(["google-chrome", f"--app={url}"])
    elif shutil.which("xdg-open"):
        subprocess.Popen(["xdg-open", url])
    else:
        print(f"YuE2 studio URL: {url}")

def score_abc(output_path: str = ""):
    os.makedirs(MUSIC_DIR, exist_ok=True)
    out = output_path or os.path.join(MUSIC_DIR, f"anthem_{int(time.time())}.abc")
    with open(out, "w") as f:
        f.write(SAMPLE_ABC)
    print(f"🎼 Exported ABC Sheet Score: {out}")
    return out

def synth_song(prompt: str, style: str = "cinematic"):
    os.makedirs(MUSIC_DIR, exist_ok=True)
    out_wav = os.path.join(MUSIC_DIR, f"track_{int(time.time())}.wav")
    print(f"🎹 Synthesizing {style} musical score: '{prompt}'...")

    # Fast deterministic synthesis using sox / ffmpeg tone synth
    cmd = [
        "ffmpeg", "-y",
        "-f", "lavfi", "-i", "sine=frequency=440:duration=4",
        "-af", "chorus=0.7:0.9:55:0.4:0.25:2,volume=0.8",
        out_wav
    ]
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode == 0:
        print(f"✅ Generated music track: {out_wav}")
        # Play via pipewire / paplay if requested
        if "--play" in sys.argv:
            subprocess.Popen(["paplay", out_wav])
    else:
        print(f"Error: {res.stderr}")

def main():
    parser = argparse.ArgumentParser(description="IRAM OS Music & Score Studio")
    subparsers = parser.add_subparsers(dest="command")

    subparsers.add_parser("studio", help="Open YuE2 Music Studio GUI")
    
    synth_parser = subparsers.add_parser("synth", help="Synthesize song from prompt")
    synth_parser.add_argument("prompt", help="Vocal song description or lyrics")
    synth_parser.add_argument("--style", default="cinematic", help="Genre or style")
    synth_parser.add_argument("--play", action="store_true", help="Play audio immediately")

    score_parser = subparsers.add_parser("score", help="Export ABC sheet music score")
    score_parser.add_argument("-o", "--output", help="Output ABC score path")

    args = parser.parse_args()

    if args.command == "studio" or not args.command:
        launch_studio()
    elif args.command == "synth":
        synth_song(args.prompt, args.style)
    elif args.command == "score":
        score_abc(args.output)

if __name__ == "__main__":
    main()
