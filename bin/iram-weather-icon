#!/usr/bin/env bash
# iram:summary=Returns a weather condition icon, adjusted for live sunrise and sunset.

set -eo pipefail

query=""
LOC_FILE="$HOME/.local/state/iram/settings/weather.json"
LEGACY_LOC_FILE="$HOME/.local/state/omarchy/settings/weather.json"

if [[ -s "$LOC_FILE" || -s "$LEGACY_LOC_FILE" ]]; then
  location=$(iram-weather-location 2>/dev/null || echo "")
  [[ -n $location ]] && query=$(jq -rn --arg location "$location" '$location | @uri' 2>/dev/null || true)
fi

if ! command -v curl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
  echo ""
  exit 0
fi

weather_data=$(curl -fsS --max-time 3 "https://wttr.in/${query}?format=j1" 2>/dev/null | jq -er '[.current_condition[0].weatherCode, .weather[0].astronomy[0].sunrise, .weather[0].astronomy[0].sunset] | select(all(. != null and . != "")) | @tsv' 2>/dev/null) || { echo ""; exit 0; }

IFS=$'\t' read -r weather_code sunrise sunset <<< "$weather_data"
if [[ ! $weather_code =~ ^[0-9]+$ || ! $sunrise =~ ^[0-9]{1,2}:[0-9]{2}\ [AP]M$ || ! $sunset =~ ^[0-9]{1,2}:[0-9]{2}\ [AP]M$ ]]; then
  echo ""
  exit 0
fi

now_epoch=$(date +%s)
sunrise_epoch=$(date -d "today $sunrise" +%s 2>/dev/null || echo 0)
sunset_epoch=$(date -d "today $sunset" +%s 2>/dev/null || echo 0)

if (( sunrise_epoch > 0 && sunset_epoch > 0 && (now_epoch < sunrise_epoch || now_epoch >= sunset_epoch) )); then
  night=true
else
  night=false
fi

case $weather_code in
  113) [[ $night == "true" ]] && icon="" || icon="" ;;
  116) [[ $night == "true" ]] && icon="" || icon="" ;;
  119|122) icon="" ;;
  143|248|260) icon="" ;;
  176|263|353) [[ $night == "true" ]] && icon="" || icon="" ;;
  179|227|230|323|326|368) [[ $night == "true" ]] && icon="" || icon="" ;;
  182|185|281|284|311|314|317|320|350|362|365|374|377) icon="" ;;
  200|386|389|392|395) icon="" ;;
  266|293|296|299|302|305|308|356|359) icon="" ;;
  329|332|335|338|371) icon="" ;;
  *) icon="" ;;
esac

printf '%s\n' "$icon"
