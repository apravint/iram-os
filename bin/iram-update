#!/usr/bin/env bash
# ==============================================================================
# IRAM OS - System & Repository Update Utility (iram update)
# Backs up ~/.config/hypr, pulls latest from upstream, re-runs install.sh,
# reloads user systemd services, restarts UI daemons, and reloads Hyprland.
# https://github.com/apravint/iram-os
# ==============================================================================
set -euo pipefail

BOLD='\033[1m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${BLUE}======================================================${NC}"
echo -e "${BOLD}${CYAN}            IRAM OS SYSTEM UPGRADE${NC}"
echo -e "${BLUE}======================================================${NC}"

# 1. Backup ~/.config/hypr
if [ -d "$HOME/.config/hypr" ]; then
    BACKUP_HYPR="$HOME/.config/hypr.bak.$(date +%Y%m%d_%H%M%S)"
    echo -e "${YELLOW}==> [1/6] Backing up ~/.config/hypr to ${BACKUP_HYPR}...${NC}"
    cp -r "$HOME/.config/hypr" "$BACKUP_HYPR"
    echo -e "${GREEN}✓ Backup completed.${NC}"
fi

# 2. Pull latest repository changes
REPO_DIR="$HOME/iram-os"
[ ! -d "$REPO_DIR" ] && REPO_DIR="${IRAM_PATH:-/usr/share/iram}"

if [ -d "$REPO_DIR/.git" ]; then
    echo -e "${YELLOW}==> [2/6] Pulling latest changes from repository ($REPO_DIR)...${NC}"
    git -C "$REPO_DIR" pull --ff-only || {
        echo -e "${YELLOW}Warning: Git pull failed or has local changes. Continuing with local files.${NC}"
    }
else
    echo -e "${YELLOW}==> [2/6] No git tracking in $REPO_DIR, skipping pull.${NC}"
fi

# 3. Run install.sh
if [ -f "$REPO_DIR/install.sh" ]; then
    echo -e "${YELLOW}==> [3/6] Running installer (${REPO_DIR}/install.sh)...${NC}"
    bash "$REPO_DIR/install.sh" all
else
    echo -e "${RED}Error: ${REPO_DIR}/install.sh not found.${NC}" >&2
    exit 1
fi

# 4. Systemd user daemon-reload
echo -e "${YELLOW}==> [4/6] Reloading systemd user daemon...${NC}"
systemctl --user daemon-reload || true

# 5. Restart essential desktop services
echo -e "${YELLOW}==> [5/6] Restarting waybar.service and swaybg.service...${NC}"
systemctl --user restart waybar.service swaybg.service 2>/dev/null || {
    # If not running as systemd units, restart directly
    pkill -x waybar 2>/dev/null || true
    ~/.local/bin/iram-restart-bar 2>/dev/null || true
    pkill -x swaybg 2>/dev/null || true
    swaybg -i "$HOME/.local/state/iram/current/background" -m fill 2>/dev/null &
}

# 6. Reload Hyprland compositor
echo -e "${YELLOW}==> [6/6] Reloading Hyprland configuration...${NC}"
if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    hyprctl reload || true
    echo -e "${GREEN}✓ Hyprland reloaded.${NC}"
fi

# Send notification if available
if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "IRAM Update" "🎉 Update Complete" "IRAM OS upgraded to latest release." 2>/dev/null || true
fi

echo -e "\n${GREEN}🎉 IRAM OS update complete and all desktop services synchronized!${NC}"
