#!/bin/bash
# Iram Update for IRAM OS

set -e

echo -e "\033[1;34m==> Updating Iram Core (/usr/share/iram)...\033[0m"
if [ -d "/usr/share/iram/.git" ]; then
  sudo git -C /usr/share/iram pull --ff-only 2>/dev/null || true
fi

echo -e "\033[1;34m==> Updating IRAM OS Repository ($HOME/iram-os)...\033[0m"
if [ -d "$HOME/iram-os/.git" ]; then
  git -C "$HOME/iram-os" pull --ff-only 2>/dev/null || true
fi

echo -e "\033[1;34m==> Updating System Core (/usr/share/iram)...\033[0m"
if [ -d "/usr/share/iram" ] && [ -d "$HOME/iram-os" ]; then
  sudo cp -a "$HOME/iram-os/bin" "$HOME/iram-os/config" "$HOME/iram-os/themes" "$HOME/iram-os/system" "$HOME/iram-os/migrations" /usr/share/iram/ 2>/dev/null || true
fi

echo -e "\033[1;34m==> Updating system packages with APT...\033[0m"
if command -v sudo >/dev/null 2>&1; then
  sudo apt-get update && sudo apt-get upgrade -y
else
  apt-get update && apt-get upgrade -y
fi

echo -e "\033[1;34m==> Running post-update lifecycle hooks & migrations...\033[0m"
if command -v iram-lifecycle-dispatch >/dev/null 2>&1; then
  iram-lifecycle-dispatch post-update || true
elif [ -x "$HOME/.local/bin/iram-migrate" ]; then
  "$HOME/.local/bin/iram-migrate" run || true
fi

echo -e "\033[1;34m==> Synchronizing desktop themes...\033[0m"
"$HOME/.local/bin/iram-theme-sync-all" || true

if command -v notify-send >/dev/null 2>&1; then
  notify-send -a "IRAM Update" "🎉 Update Complete" "System packages and IRAM configurations are up to date." 2>/dev/null || true
fi
echo -e "\033[1;32m🎉 IRAM OS and system packages updated successfully!\033[0m"
