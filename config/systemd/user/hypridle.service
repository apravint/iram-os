[Unit]
Description=Hyprland Idle Management Daemon (hypridle)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionPathExists=/usr/bin/hypridle
[Service]
Type=simple
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStartPre=/usr/bin/env iram-wait-compositor 30
ExecStart=/usr/bin/hypridle -c %h/.config/hypr/hypridle.conf
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=graphical-session.target
