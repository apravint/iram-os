[Unit]
Description=IRAM OS Agentic Service Daemon (On-Demand Activation)
Requires=iram-agentd.socket
After=iram-agentd.socket

[Service]
Type=simple
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/env iram-agent-daemon --idle-timeout 900
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
