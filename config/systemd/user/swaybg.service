[Unit]
Description=Swaybg Wallpaper Daemon
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionPathExists=%h/.local/state/iram/current/background
StartLimitIntervalSec=60
StartLimitBurst=15
[Service]
Type=simple
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStartPre=/usr/bin/env iram-wait-compositor 30
ExecStart=/usr/bin/swaybg -i %h/.local/state/iram/current/background -m fill
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=graphical-session.target
